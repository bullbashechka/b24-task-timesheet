&НаКлиенте
Функция РазобратьПараметры(Значение)

	Результат = Новый Структура("out, port, scenario, since, tasks, project, closed, files, days, proxy, texts", "", "1538", "окно", "", "", "0", "", "",
		"", "0", "");
	Для Каждого Часть Из СтрРазделить(Значение, ";") Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 0 Тогда
			Результат.Вставить(Лев(Часть, Позиция - 1), Сред(Часть, Позиция + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

