// Проверка интерфейса без человека. Обработка запускается менеджером тестирования (/TESTMANAGER /Execute) и управляет
// тестовым клиентом (/TESTCLIENT) через ТестируемоеПриложение; scripts/ui-check.sh собирает и запускает её.
// Параметры запуска: out=<файл отчёта>;port=<порт тестового клиента>;scenario=<сценарий>;since=<ггггММддЧЧммсс>.
// Отчёт печатает то, что видит пользователь, ошибки журнала регистрации с момента запуска и заканчивается строкой
// «ИТОГ: ПРОЙДЕНО» или «ИТОГ: НЕ ПРОЙДЕНО». Каждая запись в файл скрывает адреса e-mail и всё, что стоит после «/rest/»,
// поэтому ключа вебхука в отчёте нет; текст с «/rest/» на экране или в журнале проваливает проверку.

&НаКлиенте
Перем Журнал;

&НаКлиенте
Перем Ошибок;

&НаКлиенте
Перем Приложение;

&НаКлиенте
Перем ФайлОтчёта;

&НаКлиенте
Перем ВебхукВОтчёте;

// Номера тестовых задач: ключ из scripts/b24-test-data.ids.json → номер (текстом, как в колонке «№»).
&НаКлиенте
Перем НомераЗадач;

&НаКлиенте
Перем НастройкиЗапуска;

// Текущая строка таблицы табеля, как она была перед последним чтением таблицы (чтение двигает курсор).
&НаКлиенте
Перем ТекущаяПередЧтением;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Журнал = Новый Массив;
	Ошибок = 0;
	ВебхукВОтчёте = Ложь;
	Настройки = РазобратьПараметры(ПараметрЗапуска);
	НастройкиЗапуска = Настройки;
	НомераЗадач = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(Настройки.tasks, ",") Цикл
		Пара = СтрРазделить(Часть, ":");
		Если Пара.Количество() = 2 Тогда
			НомераЗадач.Вставить(Пара[0], Пара[1]);
		КонецЕсли;
	КонецЦикла;
	ФайлОтчёта = Настройки.out;
	// Описание проверки не содержит самой метки: текст с ней проваливает отчёт.
	Проверка(СкрытьВебхуки("x https://p.bitrix24.kz/REST/30/ключ/profile.json"" y") = "x https://p.bitrix24.kz/REST/***"" y",
		"Отчёт скрывает ключ в адресе вебхука");
	Попытка
		Приложение = Новый ТестируемоеПриложение(, Число(Настройки.port));
		Приложение.УстановитьСоединение();
		Если Настройки.scenario = "окно" Тогда
			СценарийОкно();
		ИначеЕсли Настройки.scenario = "строка" Тогда
			СценарийСтрока();
		ИначеЕсли Настройки.scenario = "поиск" Тогда
			СценарийПоиск();
		ИначеЕсли Настройки.scenario = "чужой" Тогда
			СценарийЧужой();
		ИначеЕсли Настройки.scenario = "список" Тогда
			СценарийСписок();
		ИначеЕсли Настройки.scenario = "контрагенты" Тогда
			СценарийКонтрагенты();
		ИначеЕсли Настройки.scenario = "права" Тогда
			СценарийПрава();
		ИначеЕсли Настройки.scenario = "сотрудник" Тогда
			СценарийСотрудник();
		ИначеЕсли Настройки.scenario = "безтеста" Тогда
			СценарийБезТеста();
		ИначеЕсли Настройки.scenario = "безопасность" Тогда
			СценарийБезопасность();
		ИначеЕсли Настройки.scenario = "восстановить" Тогда
			СценарийВосстановить();
		ИначеЕсли Настройки.scenario = "роли" Тогда
			Лог(ВыдатьРолиТестовомуПользователю());
		Иначе
			Проверка(Ложь, "Неизвестный сценарий «" + Настройки.scenario + "»");
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Лог("");
	Лог("== Журнал регистрации с момента запуска");
	УтечкаВебхука = Ложь;
	ЧислоОшибок = 0;
	Для Каждого Строка Из ЗаписиЖурнала(Дата(Настройки.since)) Цикл
		УтечкаВебхука = УтечкаВебхука Или ЕстьАдресВебхука(Строка);
		Если СтрНайти(Строка, "[Ошибка]") > 0 Тогда
			ЧислоОшибок = ЧислоОшибок + 1;
		КонецЕсли;
		Лог("  " + Строка);
	КонецЦикла;
	Проверка(Не УтечкаВебхука, "В журнале нет адреса вебхука");
	Проверка(ЧислоОшибок = 0, "В журнале нет ошибок (записей с уровнем «Ошибка»)");

	Если ВебхукВОтчёте Тогда
		Ошибок = Ошибок + 1;
		Лог("НЕ ПРОЙДЕНО: в отчёте был адрес вебхука");
	КонецЕсли;
	Лог(?(Ошибок = 0, "ИТОГ: ПРОЙДЕНО", "ИТОГ: НЕ ПРОЙДЕНО, ошибок: " + Ошибок));
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область Сценарии

// Табель → «Заполнить из задачи Б24» → окно: проверки Ф2–Ф4 без выбранной задачи (С2, С12, С14), «Отмена».
&НаКлиенте
Процедура СценарийОкно()

	Лог("== Табель");
	ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
	ОкноПриложения.ВыполнитьКоманду("e1cib/command/Документ.гем_Табель.Создать");
	Табель = ЖдатьФорму("Табель (создание)", 60);
	Если Табель = Неопределено Тогда
		Проверка(Ложь, "Открылся новый табель");
		Возврат;
	КонецЕсли;
	Табель.Активизировать();
	Лог("Открыта форма «" + Табель.ТекстЗаголовка + "»");

	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Кнопка = Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24");
	Проверка(Кнопка <> Неопределено, "Кнопка «Заполнить из задачи Б24» есть в командной панели таблицы «Табель»");
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Проверка(Кнопка.ТекущаяДоступность(), "Кнопка доступна (пользователь с полными правами)");
	ИзмененДо = Табель.ТекущаяМодифицированность();
	Лог("Новый табель до нажатия кнопки: изменён = " + ИзмененДо);

	Лог("");
	Лог("== Окно");
	Кнопка.Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Тогда
		Проверка(Ложь, "Окно «Заполнить из задачи Битрикс24» открылось");
		Возврат;
	КонецЕсли;
	Лог("Открыто окно «" + ФормаОкна.ТекстЗаголовка + "»");

	Если Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат;
	КонецЕсли;
	ПроверитьПоляОкна(ФормаОкна);
	ПроверитьВводНомера(ФормаОкна);
	ПроверитьВремя(ФормаОкна);

	Лог("");
	Лог("== Отмена");
	КнопкаОтмены = НайтиКнопку(ФормаОкна, "Отмена");
	Проверка(КнопкаОтмены <> Неопределено, "Кнопка «Отмена» есть");
	Если КнопкаОтмены <> Неопределено Тогда
		КнопкаОтмены.Нажать();
		Закрыто = ФормаОкна.ОжидатьЗакрытие(30);
		Проверка(Закрыто, "Окно закрылось по «Отмена»");
		Табель.Активизировать();
		Лог("Табель после «Отмена»: изменён = " + Табель.ТекущаяМодифицированность());
		Проверка(Табель.ТекущаяМодифицированность() = ИзмененДо, "Табель после «Отмена» в том же состоянии «изменён», что и до окна");
	КонецЕсли;

КонецПроцедуры

// Добавление строки в табель из окна (Ф5, С1, С4, С5, С15): задача с компанией, задача без компании (открывается выбор
// контрагента), повторная задача, строка без окончания, запись и проведение. Номера задач — параметр tasks (две
// своих тестовых задачи: с компанией «Дальстрой» и без компании).
&НаКлиенте
Процедура СценарийСтрока()

	Если Не ЕстьЗадачи("ownDalstroy,ownNoCompany") Тогда
		Возврат;
	КонецЕсли;
	СКомпанией = НомераЗадач["ownDalstroy"];
	БезКомпании = НомераЗадач["ownNoCompany"];
	Комментарий = "[ТЕСТ] ui-check строка";
	УдалитьТабелиСценария(Комментарий);
	ТабелейДо = ЧислоТабелей();

	Лог("== Табель");
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Проверка(СтрокиТаблицы(Таблица).Количество() = 0, "Новый табель пуст");

	Лог("");
	Лог("== Задача с компанией (С1)");
	Если Не ДобавитьИзЗадачи(Табель, СКомпанией, "09:00", "11:00", "12:00") Тогда
		Возврат;
	КонецЕсли;
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 1, "В табеле одна строка");
	Если Строки.Количество() = 1 Тогда
		Первая = Строки[0];
		ПроверитьТекст(Ячейка(Первая, "ID Б24"), СКомпанией, "ID Б24 первой строки");
		ПроверитьТекст(Ячейка(Первая, "Содержание"), "[ТЕСТ] Своя задача — Дальстрой", "Содержание первой строки");
		Проверка(СтрНайти(НРег(Ячейка(Первая, "Контрагент")), "дальстрой") > 0,
			"Контрагент по компании CRM: «" + Ячейка(Первая, "Контрагент") + "»");
		ПроверитьТекст(Время(Ячейка(Первая, "Факт")), "01:00", "Факт первой строки");
	КонецЕсли;
	Проверка(Не ЕстьОкноВыбораКонтрагента(), "Контрагент найден: выбор контрагента не открыт");

	Лог("");
	Лог("== Задача без компании (С15)");
	Если Не ДобавитьИзЗадачи(Табель, БезКомпании, "12:00", "08:00", "08:50", Истина) Тогда
		Возврат;
	КонецЕсли;
	// Табель недоступен, пока открыто окно выбора контрагента: сначала выбор, потом чтение таблицы.
	Выбран = ВыбратьПервогоКонтрагента();
	Проверка(Выбран, "После добавления открылся выбор контрагента, контрагент выбран");
	Табель.Активизировать();
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 2, "В табеле две строки");
	Если Строки.Количество() = 2 Тогда
		ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), БезКомпании, "Новая строка (08:00) встала первой");
		ПроверитьТекст(Ячейка(Строки[1], "ID Б24"), СКомпанией, "Прежняя строка вторая");
	КонецЕсли;
	ПроверитьТекст(Ячейка(ТекущаяПередЧтением, "ID Б24"), БезКомпании, "Текущая строка — новая");
	Проверка(Ячейка(Строки[0], "Контрагент") <> "", "Выбранный контрагент попал в ячейку: «"
		+ Ячейка(Строки[0], "Контрагент") + "»");

	Лог("");
	Лог("== Повторное добавление (С4)");
	ДоПовтора = СтрокаПоНомеру(СтрокиТаблицы(Таблица), СКомпанией);
	Если Не ДобавитьИзЗадачи(Табель, СКомпанией, "12:00", "12:00", "12:30") Тогда
		Возврат;
	КонецЕсли;
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 3, "В табеле три строки");
	Проверка(ПредставлениеСтроки(СтрокаПоНомеру(Строки, СКомпанией)) = ПредставлениеСтроки(ДоПовтора),
		"Первая строка по задаче не изменилась");

	Лог("");
	Лог("== Без времени окончания (С5)");
	Если Не ДобавитьИзЗадачи(Табель, СКомпанией, "12:30", "13:00", "") Тогда
		Возврат;
	КонецЕсли;
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 4, "В табеле четыре строки");
	Если Строки.Количество() = 4 Тогда
		ПроверитьТекст(Время(Ячейка(Строки[3], "Факт")), "", "Факт строки без окончания пуст");
	КонецЕсли;
	ВвестиВЯчейку(Таблица, "ТабельВремяКон", "13:30");
	ТекущаяСтрока = ТекущаяСтрокаТаблицы(Таблица);
	ПроверитьТекст(Время(Ячейка(ТекущаяСтрока, "Факт")), "00:30", "Окончание введено в ячейке: Факт посчитан");

	Лог("");
	Лог("== Табель не записан (Ф5)");
	Проверка(Табель.ТекущаяМодифицированность(), "Табель помечен изменённым");
	Проверка(ЧислоТабелей() = ТабелейДо, "Новый документ в базе не появился");

	Лог("");
	Лог("== Запись и проведение (С1)");
	НайтиПоле(Табель, "Комментарий").ВвестиТекст(Комментарий);
	Таблица.Активизировать();
	Кнопка = НайтиКнопку(Табель, "Провести и закрыть");
	Проверка(Кнопка <> Неопределено, "Кнопка «Провести и закрыть» есть");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Нажать();
		Проверка(Табель.ОжидатьЗакрытие(60), "Табель проведён и закрыт");
	КонецЕсли;
	Проверка(ЧислоТабелей() = ТабелейДо + 1, "В базе появился один табель");
	Лог("Строк в записанном табеле по задаче: " + СтрокЗадачВТабеле(Комментарий));
	Проверка(СтрокЗадачВТабеле(Комментарий) = 4, "В записанном табеле четыре строки с номерами задач");
	УдалитьТабелиСценария(Комментарий);
	Проверка(ЧислоТабелей() = ТабелейДо, "Тестовый табель удалён");

КонецПроцедуры

// Поиск в списке задач: текст в поле поиска не должен пропадать, пока список сокращается.
&НаКлиенте
Процедура СценарийПоиск()

	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24").Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Или Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат;
	КонецЕсли;
	Поиск = НайтиПоле(ФормаОкна, "ТекстПоиска");
	Для Каждого Текст Из СтрРазделить("без; без компании;ё;несуществующее", ";") Цикл
		Поиск.Активизировать();
		Поиск.ВвестиТекст(Текст);
		Пауза(3);
		Отображаемый = "?";
		Попытка
			Отображаемый = Поиск.ПолучитьОтображаемыйТекст();
		Исключение
			Отображаемый = "ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Представление = "?";
		Попытка
			Представление = Поиск.ПолучитьПредставлениеДанных();
		Исключение
			Представление = "ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Лог("  отображаемый текст: «" + Отображаемый + "», представление данных: «" + Представление + "», строк в списке: "
			+ СтрокиТаблицы(НайтиТаблицу(ФормаОкна, "СписокЗадач")).Количество());
		Поиск.Активизировать();
		ПроверитьТекст(ТекстПоля(Поиск), Текст, "Текст в поле поиска после ввода «" + Текст + "»");
		Лог("  страница списка: " + НайтиГруппу(ФормаОкна, "СтраницыСписка").ПолучитьТекущуюСтраницу().Имя);
	КонецЦикла;

КонецПроцедуры

// Чужой табель (С8): тестовый клиент запущен под обычным сотрудником (--user «[ТЕСТ] Сотрудник»), табель создан
// администратором от своего имени. Автор — не этот сотрудник и полных прав у него нет, поэтому «Добавить» недоступна,
// а вместе с ней недоступна и «Заполнить из задачи Б24».
&НаКлиенте
Процедура СценарийЧужой()

	Комментарий = "[ТЕСТ] ui-check чужой";
	УдалитьТабелиСценария(Комментарий);
	Данные = НовыйЧужойТабель(Комментарий);
	Лог("== Чужой табель «" + Данные.Представление + "»");
	Попытка
		ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
		ОкноПриложения.ВыполнитьКоманду(Данные.Навигация);
		Табель = ЖдатьФорму(Данные.Представление, 60);
		Если Табель = Неопределено Тогда
			Проверка(Ложь, "Чужой табель открылся");
			Диагностика();
		Иначе
			Табель.Активизировать();
			Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
			Панель = Таблица.ПолучитьКоманднуюПанель();
			Заполнить = Панель.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24");
			Проверка(Заполнить <> Неопределено, "Кнопка «Заполнить из задачи Б24» есть в панели таблицы");
			// ТекущаяДоступность() кнопки не учитывает выключенную родительскую панель: недоступность проверяется по
			// панели и по тому, что платформа отклоняет нажатие.
			Проверка(Не Панель.ТекущаяДоступность(), "Панель таблицы выключена (не автор без полных прав)");
			Проверка(Заполнить <> Неопределено И НажатиеОтклонено(Заполнить),
				"Не автору без полных прав «Заполнить из задачи Б24» недоступна: платформа отклоняет нажатие");
			Проверка(Не Приложение.ОжидатьОтображениеОбъекта(Тип("ТестируемаяФорма"), "Заполнить из задачи Битрикс24", , 3),
				"Окно «Заполнить из задачи Битрикс24» не открылось");
			Добавить = Панель.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Добавить");
			Проверка(Добавить <> Неопределено, "Кнопка «Добавить» есть в панели таблицы");
			Проверка(Добавить <> Неопределено И НажатиеОтклонено(Добавить),
				"Не автору без полных прав «Добавить» недоступна: платформа отклоняет нажатие");
			Проверка(Не Табель.ТекущаяМодифицированность(), "Табель не изменён");
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	// Форма остаётся открытой: тестовый клиент завершается вместе со сценарием.
	УдалитьТабелиСценария(Комментарий);

КонецПроцедуры

// Список задач (С2 — задача по номеру и ссылке, С3): состав, колонки, сортировки, поиск, выбор щелчком, граница 30 дней.
&НаКлиенте
Процедура СценарийСписок()

	Все = "dalstroy,arkharov,dalstroy2,norq,nobin,kikinda,dup,twoCompanies,noCompany,observer,outside,ownDalstroy,ownNoCompany";
	Если Не ЕстьЗадачи(Все) Тогда
		Возврат;
	КонецЕсли;

	Лог("== Состав списка");
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Видимые = СтрРазделить("dalstroy,arkharov,dalstroy2,norq,nobin,kikinda,dup,twoCompanies,noCompany,ownDalstroy,ownNoCompany", ",");
	Строки = СтрокиСписка(ФормаОкна);
	Проверка(Строки.Количество() = Видимые.Количество(), "В списке " + Видимые.Количество() + " задач (девять задач набора и две свои): "
		+ Строки.Количество());
	Для Каждого Ключ Из Видимые Цикл
		Проверка(СтрокаЗадачи(Строки, Ключ) <> Неопределено, "В списке есть задача " + Ключ);
	КонецЦикла;
	Проверка(СтрокаЗадачи(Строки, "observer") = Неопределено, "В списке нет задачи, где сотрудник только наблюдатель");
	Проверка(СтрокаЗадачи(Строки, "outside") = Неопределено, "В списке нет задачи вне проекта (режим тестирования)");

	Лог("");
	Лог("== Колонки");
	ПроверитьТекст(НРег(Ячейка(СтрокаЗадачи(Строки, "arkharov"), "Моя роль")), "исполнитель", "Моя роль у задачи arkharov");
	ПроверитьТекст(НРег(Ячейка(СтрокаЗадачи(Строки, "ownDalstroy"), "Моя роль")), "постановщик, исполнитель",
		"Моя роль у своей задачи");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "dalstroy"), "Статус"), "Завершена", "Статус завершённой задачи");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "arkharov"), "Статус"), "Ждёт выполнения", "Статус открытой задачи");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "dalstroy"), "Компания CRM"), "[ТЕСТ] Дальстрой", "Компания CRM");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "twoCompanies"), "Компания CRM"), "2 компании", "Компаний две");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "noCompany"), "Компания CRM"), "—", "Компании нет");
	СоСроком = СтрРазделить("arkharov,dalstroy2,kikinda", ",");
	// Портал сам ставит срок «завтра 19:00» задачам, созданным без срока: у остальных задач он одинаковый и раньше трёх своих.
	ОбщийСрок = Ячейка(СтрокаЗадачи(Строки, "norq"), "Крайний срок");
	Проверка(ОбщийСрок <> "" И ОбщийСрок <> "без срока", "У задач без заданного срока срок портала по умолчанию: «" + ОбщийСрок + "»");
	Для Каждого Ключ Из Видимые Цикл
		Срок = Ячейка(СтрокаЗадачи(Строки, Ключ), "Крайний срок");
		Если СоСроком.Найти(Ключ) <> Неопределено Тогда
			Проверка(Срок <> ОбщийСрок И Срок <> "", "У задачи " + Ключ + " свой срок: «" + Срок + "»");
		Иначе
			ПроверитьТекст(Срок, ОбщийСрок, "Срок задачи " + Ключ);
		КонецЕсли;
	КонецЦикла;

	Лог("");
	Лог("== Сортировки");
	Сортировка = НайтиПоле(ФормаОкна, "Сортировка");
	Сортировка.ВыбратьВариант("По номеру");
	Пауза(2);
	Номера = НомераСписка(СтрокиСписка(ФормаОкна, Истина));
	ПроверитьТекст(СтрСоединить(Номера, ","), СтрСоединить(НомераПоУбыванию(Видимые, Новый Массив), ","), "По номеру: сначала больший номер");

	Сортировка.ВыбратьВариант("По крайнему сроку");
	Пауза(2);
	Номера = НомераСписка(СтрокиСписка(ФормаОкна, Истина));
	Остальные = Новый Массив;
	Для Каждого Ключ Из Видимые Цикл
		Если СоСроком.Найти(Ключ) = Неопределено Тогда
			Остальные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Ожидаемый = НомераПоУбыванию(Остальные, Новый Массив);
	Для Каждого Ключ Из СоСроком Цикл
		Ожидаемый.Добавить(НомераЗадач[Ключ]);
	КонецЦикла;
	ПроверитьТекст(СтрСоединить(Номера, ","), СтрСоединить(Ожидаемый, ","),
		"По крайнему сроку: ближайший срок первым, при равных сроках больший номер выше");

	Сортировка.ВыбратьВариант("По активности");
	Пауза(2);
	Строки = СтрокиСписка(ФормаОкна, Истина);
	Порядок = Истина;
	Предыдущая = "";
	Для Каждого Строка Из Строки Цикл
		Ключ = КлючАктивности(Ячейка(Строка, "Активность"));
		Если Предыдущая <> "" И Ключ > Предыдущая Тогда
			Порядок = Ложь;
		КонецЕсли;
		Предыдущая = Ключ;
	КонецЦикла;
	Проверка(Порядок, "По активности: время активности не растёт сверху вниз");

	Лог("");
	Лог("== Поиск");
	Найденные = НайтиВСписке(ФормаОкна, НомераЗадач["dalstroy"]);
	Проверка(Найденные.Количество() = 1 И Ячейка(Найденные[0], "№") = НомераЗадач["dalstroy"], "Поиск по номеру: одна строка");
	Найденные = НайтиВСписке(ФормаОкна, "ДАЛЬСТРОЙ");
	ПроверитьТекст(СтрСоединить(НомераСписка(Найденные), ","), СтрСоединить(НомераПоУбыванию(СтрРазделить("dalstroy,dalstroy2,ownDalstroy",
		","), Новый Массив), ","), "Поиск «ДАЛЬСТРОЙ» без учёта регистра по названию");
	Найденные = НайтиВСписке(ФормаОкна, "несуществующее название");
	Проверка(Найденные.Количество() = 0, "Поиск без совпадений: строк нет");
	Найденные = НайтиВСписке(ФормаОкна, "");
	Лог("После ввода пустого текста строк: " + Найденные.Количество() + ", текст в поле: «" + ТекстПоля(НайтиПоле(ФормаОкна, "ТекстПоиска")) + "»");
	Если Найденные.Количество() = 0 Тогда
		Найденные = НайтиВСписке(ФормаОкна, " ");
		Лог("После ввода пробела строк: " + Найденные.Количество());
	КонецЕсли;
	Проверка(Найденные.Количество() = Видимые.Количество(), "Поиск очищен: снова все задачи");
	ЗакрытьОкно(ФормаОкна);

	Лог("");
	Лог("== Выбор щелчком по строке");
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыбратьЩелчком(ФормаОкна, "arkharov");
	ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "Содержание")), "[ТЕСТ] ИП Архаров — ИИН", "Содержание = название задачи");
	Проверка(СтрНайти(НРег(ТекстПоля(НайтиПоле(ФормаОкна, "Контрагент"))), "архаров") > 0, "Контрагент по компании CRM");
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьКонтрагента")), "найден в 1С по БИН 745105884167", "Пометка контрагента");

	Лог("");
	Лог("== Номер и ссылка (С2)");
	Хост = "https://example.bitrix24.kz";
	Номер = НомераЗадач["dalstroy2"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, "#" + Номер);
	Номер = НомераЗадач["kikinda"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, "№ " + Лев(Номер, 2) + " " + Сред(Номер, 3));
	Номер = НомераЗадач["norq"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, Хост + "/company/personal/user/30/tasks/task/view/" + Номер + "/");
	Номер = НомераЗадач["dup"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, Хост + "/workgroups/group/38/tasks/task/edit/" + Номер + "/");
	ЗакрытьОкно(ФормаОкна);

	Лог("");
	Лог("== Граница 30 дней (С3)");
	Если ПустаяСтрока(НастройкиЗапуска.closed) Тогда
		Проверка(Ложь, "Скрипт передал день завершения задачи dalstroy (параметр closed)");
		Возврат;
	КонецЕсли;
	ДеньЗавершения = Дата(СтрЗаменить(НастройкиЗапуска.closed, "-", "") + "000000");
	Для Каждого Дни Из СтрРазделить("30,31", ",") Цикл
		УстановитьДатуТабеля(Табель, ДеньЗавершения + Число(Дни) * 86400);
		ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
		Если ФормаОкна = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Строки = СтрокиСписка(ФормаОкна, Истина);
		Если Дни = "30" Тогда
			Проверка(СтрокаЗадачи(Строки, "dalstroy") <> Неопределено, "Табель через 30 дней после завершения: задача в списке");
			ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ПодписьСписка")), "Незавершённые задачи и задачи, завершённые с "
				+ Формат(ДеньЗавершения, "ДФ=dd.MM.yyyy") + ", где вы постановщик, исполнитель или соисполнитель", "Подпись под списком");
		Иначе
			Проверка(СтрокаЗадачи(Строки, "dalstroy") = Неопределено, "Табель через 31 день после завершения: задачи в списке нет");
			ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ПодписьСписка")), "Незавершённые задачи и задачи, завершённые с "
				+ Формат(ДеньЗавершения + 86400, "ДФ=dd.MM.yyyy") + ", где вы постановщик, исполнитель или соисполнитель", "Подпись под списком");
			ВвестиНомерЗадачи(ФормаОкна, НомераЗадач["dalstroy"]);
		КонецЕсли;
		ЗакрытьОкно(ФормаОкна);
	КонецЦикла;

КонецПроцедуры

// Контрагент по каждой задаче набора (С6, Ф6): выбор щелчком и сверка имени и текста.
&НаКлиенте
Процедура СценарийКонтрагенты()

	Все = "dalstroy,arkharov,dalstroy2,norq,nobin,kikinda,dup,twoCompanies,noCompany,observer,outside,ownDalstroy,ownNoCompany";
	Если Не ЕстьЗадачи(Все) Тогда
		Возврат;
	КонецЕсли;
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог("== Контрагенты по задачам набора");
	ПроверитьКонтрагента(ФормаОкна, "dalstroy", "Дальстрой", "найден в 1С по БИН 234512612395");
	ПроверитьКонтрагента(ФормаОкна, "arkharov", "Архаров", "найден в 1С по БИН 745105884167");
	ПроверитьКонтрагента(ФормаОкна, "dalstroy2", "Дальстрой", "найден в 1С по БИН 234512612395");
	ПроверитьКонтрагента(ФормаОкна, "kikinda", "Kikinda", "найден в 1С по БИН 452407560239");
	ПроверитьКонтрагента(ФормаОкна, "norq", "", "У компании «[ТЕСТ] Без реквизитов» не заполнен БИН — выберите контрагента вручную");
	ПроверитьКонтрагента(ФормаОкна, "nobin", "", "Контрагент с БИН 990840000017 не найден в 1С — выберите контрагента вручную");
	ПроверитьКонтрагента(ФормаОкна, "dup", "", "В 1С несколько контрагентов с БИН 772824024014 — выберите нужного вручную");
	ПроверитьКонтрагента(ФормаОкна, "twoCompanies", "", "В задаче несколько компаний CRM — выберите контрагента вручную");
	ПроверитьКонтрагента(ФормаОкна, "noCompany", "", "В задаче не указана компания CRM — выберите контрагента вручную");

КонецПроцедуры

// Права и ограничения (С7, С8, С10, С13) под администратором: наблюдатель, задача вне проекта, чужой табель, табель без
// сотрудника, колонка «ID Б24» в строке, добавленной вручную.
&НаКлиенте
Процедура СценарийПрава()

	Если Не ЕстьЗадачи("observer,outside") Тогда
		Возврат;
	КонецЕсли;
	Комментарий = "[ТЕСТ] ui-check права";
	УдалитьТабелиСценария(Комментарий);

	Лог("== Наблюдатель и задача вне проекта (С7, С10)");
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Режим = НайтиДекорацию(ФормаОкна, "НадписьРежимаТестирования");
	Проверка(Режим.ТекущаяВидимость(), "Режим тестирования включён");
	Проект = Сред(Режим.ТекстЗаголовка, СтрНайти(Режим.ТекстЗаголовка, "«") + 1);
	Проект = Лев(Проект, СтрДлина(Проект) - 1);
	ВвестиНомер(ФормаОкна, НомераЗадач["observer"], "Заполнять табель по задаче могут только постановщик, исполнитель и соисполнители");
	Проверка(Не НайтиКнопку(ФормаОкна, "Добавить в табель").ТекущаяДоступность(), "Наблюдатель: «Добавить в табель» недоступна");
	ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "Содержание")), "", "Название задачи, где сотрудник наблюдатель, не показано");
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьКонтрагента")), "", "Контрагент задачи-наблюдателя не показан");
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")), "", "Выбор снят");
	ВвестиНомер(ФормаОкна, НомераЗадач["outside"], "В режиме тестирования доступны только задачи проекта «" + Проект + "»");
	Проверка(Не НайтиКнопку(ФормаОкна, "Добавить в табель").ТекущаяДоступность(), "Задача вне проекта: «Добавить в табель» недоступна");
	ЗакрытьОкно(ФормаОкна);

	Лог("");
	Лог("== Колонка «ID Б24» в строке, добавленной вручную (С13)");
	Табель.Активизировать();
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Добавить").Нажать();
	Пауза(2);
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 1, "Добавлена одна строка");
	Если Строки.Количество() = 1 Тогда
		ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), "", "ID Б24 в строке, добавленной вручную, пуст");
	КонецЕсли;
	ВвестиВЯчейку(Таблица, "Табельб24т_IDБ24", "12345");
	ПроверитьТекст(Ячейка(ТекущаяСтрокаТаблицы(Таблица), "ID Б24"), "12345", "ID Б24 редактируется в строке");

	Лог("");
	Лог("== Чужой табель (С8)");
	Данные = НовыеТабелиПрав(Комментарий);
	ПроверитьОтказТабеля(Данные.Чужой, "Заполнять из задачи Битрикс24 можно только свой табель");
	// Форма сама подставляет в пустое поле «Сотрудник» физическое лицо пользователя: табель без сотрудника получается,
	// только если пользователь очистил поле руками. Отказ «Сначала укажите сотрудника в табеле» проверяет «сотрудник»
	// (у пользователя без физического лица поле остаётся пустым).
	УдалитьТабелиСценария(Комментарий);

КонецПроцедуры

// Пользователь без полных прав проходит Ф2 шаг за шагом (С9) и затем добавляет строку (полный путь). Между шагами
// менеджер меняет данные базы и ждёт 25 секунд: платформа до 20 секунд держит в сеансе прочитанные реквизиты ссылок.
&НаКлиенте
Процедура СценарийСотрудник()

	Если Не ЕстьЗадачи("ownDalstroy") Тогда
		Возврат;
	КонецЕсли;
	Комментарий = "[ТЕСТ] ui-check сотрудник";
	Проект = Число(НастройкиЗапуска.project);
	ВосстановитьБазу(Комментарий, Проект);
	Данные = ПодготовитьСотрудника(Комментарий);
	Если Данные.Ошибка <> "" Тогда
		Проверка(Ложь, Данные.Ошибка);
		Возврат;
	КонецЕсли;
	Лог("Пользователь «[ТЕСТ] Сотрудник» без физического лица, физическое лицо для шагов: «" + Данные.ФИО + "»");

	Попытка
		Лог("");
		Лог("== У пользователя 1С нет физического лица");
		ПроверитьОтказТабеля(Данные.БезСотрудника, "Сначала укажите сотрудника в табеле");
		ПроверитьОтказТабеля(Данные.СоСотрудником, "Ваш пользователь 1С не связан с физическим лицом. Обратитесь к администратору");

		Лог("");
		Лог("== Физическое лицо без e-mail");
		ИзменитьБазуСотрудника("связать");
		Пауза(25);
		ПроверитьОтказТабеля(Данные.СоСотрудником, "В карточке физического лица " + Данные.ФИО + " не указан e-mail. Обратитесь к администратору");

		Лог("");
		Лог("== E-mail, которого нет в Битрикс24");
		ИзменитьБазуСотрудника("почта-нет-в-б24");
		Пауза(25);
		ПроверитьОтказТабеля(Данные.СоСотрудником, "В Битрикс24 нет пользователя с e-mail b24t-nobody@example.com. Обратитесь к администратору");

		Лог("");
		Лог("== Один e-mail у двух физических лиц");
		ИзменитьБазуСотрудника("почта-администратора");
		Пауза(25);
		ПроверитьОтказТабеля(Данные.СоСотрудником, "E-mail " + Данные.ПочтаАдминистратора + " указан в карточках нескольких физических лиц. Обратитесь к администратору");

		Лог("");
		Лог("== Полный путь: пользователь связан с физическим лицом администратора");
		ИзменитьБазуСотрудника("связать-с-администратором");
		Пауза(25);
		Табель = ОткрытьНовыйТабель();
		Если Табель = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если Не ДобавитьИзЗадачи(Табель, НомераЗадач["ownDalstroy"], "09:00", "10:00", "11:00") Тогда
			Возврат;
		КонецЕсли;
		Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
		Строки = СтрокиТаблицы(Таблица);
		Проверка(Строки.Количество() = 1, "В табеле одна строка");
		Если Строки.Количество() = 1 Тогда
			ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), НомераЗадач["ownDalstroy"], "ID Б24 строки");
			Проверка(СтрНайти(НРег(Ячейка(Строки[0], "Контрагент")), "дальстрой") > 0, "Контрагент по компании CRM: «"
				+ Ячейка(Строки[0], "Контрагент") + "»");
			ПроверитьТекст(Время(Ячейка(Строки[0], "Факт")), "01:00", "Факт строки");
		КонецЕсли;
		НайтиПоле(Табель, "Комментарий").ВвестиТекст(Комментарий);
		Таблица.Активизировать();
		Кнопка = НайтиКнопку(Табель, "Провести и закрыть");
		Проверка(Кнопка <> Неопределено, "Кнопка «Провести и закрыть» есть");
		Если Кнопка <> Неопределено Тогда
			Кнопка.Нажать();
			Проверка(Табель.ОжидатьЗакрытие(60), "Табель проведён и закрыт");
		КонецЕсли;
		Проверка(ЧислоПроведённыхТабелей(Комментарий) = 1, "В базе один проведённый табель сценария");
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВосстановитьБазу(Комментарий, Проект);
	Лог("База восстановлена: пользователь «[ТЕСТ] Сотрудник» без физического лица, табели сценария удалены");

КонецПроцедуры

// Режим тестирования выключен (как в рабочей КА): в списке и по номеру доступны задачи вне проекта. Режим
// включается обратно в любом исходе.
&НаКлиенте
Процедура СценарийБезТеста()

	Если Не ЕстьЗадачи("outside") Тогда
		Возврат;
	КонецЕсли;
	Проект = Число(НастройкиЗапуска.project);
	Если Проект = 0 Тогда
		Проверка(Ложь, "Скрипт передал номер проекта для тестирования (параметр project)");
		Возврат;
	КонецЕсли;
	ВосстановитьБазу("", Проект);

	Лог("== Режим тестирования выключен");
	Лог(НастроитьРежимТестирования(Ложь, Проект));
	Пауза(3);
	Попытка
		Табель = ОткрытьНовыйТабель();
		Если Табель <> Неопределено Тогда
			ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
			Если ФормаОкна <> Неопределено Тогда
				Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьРежимаТестирования").ТекущаяВидимость(), "Надписи режима тестирования нет");
				// Задачи сотрудника не печатаются: в отчёт идут только строки с префиксом «[ТЕСТ]».
				Строки = НайтиВСписке(ФормаОкна, "[ТЕСТ]");
				Лог("Задач с «[ТЕСТ]» в списке: " + Строки.Количество());
				Проверка(СтрокаЗадачи(Строки, "outside") <> Неопределено, "Задача вне проекта есть в списке");
				Проверка(СтрокаЗадачи(Строки, "observer") = Неопределено, "Задачи, где сотрудник наблюдатель, в списке нет");
				Для Каждого Ключ Из СтрРазделить("dalstroy,arkharov,twoCompanies,noCompany,ownDalstroy", ",") Цикл
					Проверка(СтрокаЗадачи(Строки, Ключ) <> Неопределено, "Задача проекта " + Ключ + " в списке");
				КонецЦикла;
				ВвестиНомерЗадачи(ФормаОкна, НомераЗадач["outside"]);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Лог(НастроитьРежимТестирования(Истина, Проект));
	Проверка(РежимТестированияВключён(Проект), "Режим тестирования включён обратно, проект " + Проект);

КонецПроцедуры

// Ключ вебхука (из безопасного хранилища) не найден ни в журнале регистрации, ни в файлах (11.1). Ключ не выходит из
// серверной функции тестового расширения, в отчёт идут только числа.
&НаКлиенте
Процедура СценарийБезопасность()

	Если ПустаяСтрока(НастройкиЗапуска.files) Тогда
		Проверка(Ложь, "Скрипт передал список файлов (параметр files)");
		Возврат;
	КонецЕсли;
	Результат = НайтиКлючВебхука(НастройкиЗапуска.files);
	Если Результат.Ошибка <> "" Тогда
		Проверка(Ложь, Результат.Ошибка);
		Возврат;
	КонецЕсли;
	Лог("Проверено записей журнала: " + Результат.ПровереноЗаписей + ", файлов: " + Результат.ПровереноФайлов);
	Лог("Ключ вебхука: в журнале " + Результат.Журнал + ", в файлах " + Результат.Файлы);
	Проверка(Результат.Журнал = 0, "Ключа вебхука нет в журнале регистрации");
	Проверка(Результат.Файлы = 0, "Ключа вебхука нет в файлах");

КонецПроцедуры

// Возвращает базу в исходное состояние после прерванного прогона.
&НаКлиенте
Процедура СценарийВосстановить()

	Проект = Число(НастройкиЗапуска.project);
	Если Проект = 0 Тогда
		Проверка(Ложь, "Скрипт передал номер проекта для тестирования (параметр project)");
		Возврат;
	КонецЕсли;
	Для Каждого Комментарий Из СтрРазделить("сотрудник,права,строка,чужой", ",") Цикл
		ВосстановитьБазу("[ТЕСТ] ui-check " + Комментарий, Проект);
	КонецЦикла;
	Проверка(РежимТестированияВключён(Проект), "Режим тестирования включён, проект " + Проект);
	Проверка(Не ПользовательСвязан(), "Пользователь «[ТЕСТ] Сотрудник» без физического лица");

КонецПроцедуры

#Область ПомощникиСценариев

&НаКлиенте
Функция ЕстьЗадачи(Ключи)

	Все = Истина;
	Для Каждого Ключ Из СтрРазделить(Ключи, ",") Цикл
		Если НомераЗадач[Ключ] = Неопределено Тогда
			Проверка(Ложь, "Есть номер тестовой задачи " + Ключ + " (scripts/b24-test-data.ids.json)");
			Все = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Все;

КонецФункции

// Кнопка «Заполнить из задачи Б24» в табеле: открывает окно.
&НаКлиенте
Функция ОткрытьОкно(Табель)

	Табель.Активизировать();
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24").Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Тогда
		Проверка(Ложь, "Окно «Заполнить из задачи Битрикс24» открылось");
	КонецЕсли;
	Возврат ФормаОкна;

КонецФункции

// Окно открыто, список загружен или показано сообщение об отказе (тогда Неопределено и ошибка в отчёте).
&НаКлиенте
Функция ОткрытьОкноСЗагрузкой(Табель)

	ФормаОкна = ОткрытьОкно(Табель);
	Если ФормаОкна = Неопределено Или Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ФормаОкна;

КонецФункции

&НаКлиенте
Процедура ЗакрытьОкно(ФормаОкна)

	Кнопка = НайтиКнопку(ФормаОкна, "Отмена");
	Если Кнопка = Неопределено Тогда
		Кнопка = НайтиКнопку(ФормаОкна, "Закрыть");
	КонецЕсли;
	Кнопка.Нажать();
	Проверка(ФормаОкна.ОжидатьЗакрытие(30), "Окно закрылось");

КонецПроцедуры

// Строки списка задач окна (чтение двигает курсор и поэтому выбирает каждую строку по очереди).
&НаКлиенте
Функция СтрокиСписка(ФормаОкна, Тихо = Ложь)

	Возврат СтрокиТаблицы(НайтиТаблицу(ФормаОкна, "СписокЗадач"), Тихо);

КонецФункции

&НаКлиенте
Функция СтрокаЗадачи(Строки, Ключ)

	Для Каждого Строка Из Строки Цикл
		Если Ячейка(Строка, "№") = НомераЗадач[Ключ] Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция НомераСписка(Строки)

	Номера = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Номера.Добавить(Ячейка(Строка, "№"));
	КонецЦикла;
	Возврат Номера;

КонецФункции

// Номера задач по ключам: сначала Первые в заданном порядке, затем остальные по убыванию номера.
&НаКлиенте
Функция НомераПоУбыванию(Ключи, Первые)

	Результат = Новый Массив;
	Для Каждого Ключ Из Первые Цикл
		Результат.Добавить(НомераЗадач[Ключ]);
	КонецЦикла;
	Остальные = Новый СписокЗначений;
	Для Каждого Ключ Из Ключи Цикл
		Если Первые.Найти(Ключ) = Неопределено Тогда
			Остальные.Добавить(Число(НомераЗадач[Ключ]));
		КонецЕсли;
	КонецЦикла;
	Остальные.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Для Каждого Элемент Из Остальные Цикл
		Результат.Добавить(Формат(Элемент.Значение, "ЧГ=0"));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// «дд.ММ.гггг ЧЧ:мм» → «ггггММддЧЧмм» для сравнения.
&НаКлиенте
Функция КлючАктивности(Текст)

	Если СтрДлина(Текст) < 16 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Текст, 7, 4) + Сред(Текст, 4, 2) + Лев(Текст, 2) + Сред(Текст, 12, 2) + Сред(Текст, 15, 2);

КонецФункции

// Текст в поле поиска, затем строки списка.
&НаКлиенте
Функция НайтиВСписке(ФормаОкна, Текст)

	Поиск = НайтиПоле(ФормаОкна, "ТекстПоиска");
	Поиск.Активизировать();
	Поиск.ВвестиТекст(Текст);
	Пауза(3);
	Возврат СтрокиСписка(ФормаОкна, Ложь);

КонецФункции

// Щелчок по строке списка: переход к строке с номером задачи (событие «при активизации строки» выбирает задачу).
&НаКлиенте
Процедура ВыбратьЩелчком(ФормаОкна, Ключ)

	Номер = НомераЗадач[Ключ];
	Таблица = НайтиТаблицу(ФормаОкна, "СписокЗадач");
	Таблица.Активизировать();
	Описание = Новый Соответствие;
	Описание.Вставить("№", Номер);
	Перешли = Таблица.ПерейтиКСтроке(Описание);
	Если Не Перешли Тогда
		Перешли = Таблица.ПерейтиКСтроке(Описание, НаправлениеПереходаКСтроке.Вверх);
	КонецЕсли;
	Проверка(Перешли, "Переход к задаче " + Ключ + " в списке");
	ЖдатьТекст(ФормаОкна, "ВыбранаЗадача", "Выбрана задача №" + Номер, "Выбор щелчком: " + Ключ);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКонтрагента(ФормаОкна, Ключ, Имя, Текст)

	ВыбратьЩелчком(ФормаОкна, Ключ);
	ЖдатьТекст(ФормаОкна, "НадписьКонтрагента", Текст, "Текст про контрагента задачи " + Ключ);
	Контрагент = ТекстПоля(НайтиПоле(ФормаОкна, "Контрагент"));
	Если Имя = "" Тогда
		ПроверитьТекст(Контрагент, "", "Контрагент задачи " + Ключ + " пуст");
	Иначе
		Проверка(СтрНайти(НРег(Контрагент), НРег(Имя)) > 0, "Контрагент задачи " + Ключ + ": «" + Контрагент + "»");
	КонецЕсли;

КонецПроцедуры

// Дата табеля вводится в поле «Дата» формы и подтверждается переходом в другое поле.
&НаКлиенте
Процедура УстановитьДатуТабеля(Табель, Дата)

	Табель.Активизировать();
	Поле = НайтиПоле(Табель, "Дата");
	Поле.Активизировать();
	Поле.ВвестиТекст(Формат(Дата, "ДФ=dd.MM.yyyy"));
	НайтиПоле(Табель, "Комментарий").Активизировать();
	Пауза(2);
	Лог("Дата табеля в форме: «" + ТекстПоля(Поле) + "»");

КонецПроцедуры

// Текст отказа, который окно показывает вместо списка (страница отказа), или пометка, если страница не показана.
&НаКлиенте
Функция ТекстОтказа(ФормаОкна, Секунд)

	Страницы = НайтиГруппу(ФормаОкна, "Страницы");
	Конец = ТекущаяДата() + Секунд;
	Пока ТекущаяДата() < Конец Цикл
		Если Страницы.ПолучитьТекущуюСтраницу().Имя = "СтраницаОтказ" Тогда
			Возврат ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьОтказа"));
		КонецЕсли;
		Пауза(1);
	КонецЦикла;
	Возврат "<окно не показало отказ>";

КонецФункции

// Записанный табель (см. НовыйТабель на сервере) открывается по навигационной ссылке; окно должно показать отказ.
&НаКлиенте
Процедура ПроверитьОтказТабеля(Табель, Ожидаемое)

	ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
	ОкноПриложения.ВыполнитьКоманду(Табель.Навигация);
	ФормаТабеля = ЖдатьФорму(Табель.Представление, 60);
	Если ФормаТабеля = Неопределено Тогда
		Проверка(Ложь, "Табель открылся: " + Табель.Представление);
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкно(ФормаТабеля);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПроверитьТекст(ТекстОтказа(ФормаОкна, 90), Ожидаемое, "Отказ окна");
	ЗакрытьОкно(ФормаОкна);

КонецПроцедуры

