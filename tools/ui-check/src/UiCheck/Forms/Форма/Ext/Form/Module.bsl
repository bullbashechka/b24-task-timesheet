// Физическое лицо для шагов сценариев: находит или создаёт; Очистить убирает его адреса e-mail.
&НаСервереБезКонтекста
Функция ФизлицоСценариев(Очистить = Ложь)

	Ссылка = Справочники.ФизическиеЛица.НайтиПоНаименованию(НаименованиеФизлицаСценариев(), Истина);
	Если Ссылка.Пустая() Тогда
		Объект = Справочники.ФизическиеЛица.СоздатьЭлемент();
		Объект.Наименование = НаименованиеФизлицаСценариев();
		Объект.Записать();
		Возврат Объект.Ссылка;
	КонецЕсли;
	Если Очистить Тогда
		Объект = Ссылка.ПолучитьОбъект();
		Объект.КонтактнаяИнформация.Очистить();
		Объект.Записать();
	КонецЕсли;
	Возврат Ссылка;

