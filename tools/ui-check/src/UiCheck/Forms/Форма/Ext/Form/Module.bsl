// Состояние перед шагами «сотрудник»: пользователь без физического лица, два записанных табеля пользователя (без
// сотрудника и с сотрудником — физическим лицом сценария без e-mail). Адрес e-mail администратора остаётся в памяти.
&НаСервереБезКонтекста
Функция ПодготовитьСотрудника(Комментарий)

	Результат = Новый Структура("Ошибка, ФИО, ПочтаАдминистратора, БезСотрудника, СоСотрудником", "");
	Пользователь = ТестовыйПользователь();
	Если Пользователь.Пустая() Тогда
		Результат.Ошибка = "В базе нет пользователя «[ТЕСТ] Сотрудник» (TASKS 9.12)";
		Возврат Результат;
	КонецЕсли;
	Физлицо = ФизлицоСценариев(Истина);
	Результат.ФИО = НаименованиеФизлицаСценариев();
	Результат.ПочтаАдминистратора = ПочтаФизлица(Пользователи.АвторизованныйПользователь().ФизическоеЛицо);
	Если ПустаяСтрока(Результат.ПочтаАдминистратора) Тогда
		Результат.Ошибка = "У физического лица администратора нет e-mail";
		Возврат Результат;
	КонецЕсли;
	Результат.БезСотрудника = НовыйТабель(Комментарий, Пользователь, Неопределено);
	Результат.СоСотрудником = НовыйТабель(Комментарий, Пользователь, Физлицо);
	Возврат Результат;

