// Включает или выключает режим тестирования, не трогая адрес вебхука. Возвращает строку для отчёта.
&НаСервереБезКонтекста
Функция НастроитьРежимТестирования(Включить, Проект)

	Текущие = б24т_Настройки.Настройки();
	Если Текущие.РежимТестирования = Включить И (Не Включить Или Текущие.ПроектДляТестирования = Проект) Тогда
		Возврат "Режим тестирования уже " + ?(Включить, "включён", "выключен");
	КонецЕсли;
	Изменения = Новый Структура;
	Изменения.Вставить("НовыйАдрес", "");
	Изменения.Вставить("УдалитьАдрес", Ложь);
	Изменения.Вставить("РежимТестирования", Включить);
	Изменения.Вставить("ПроектДляТестирования", ?(Включить, Проект, Текущие.ПроектДляТестирования));
	Ошибки = б24т_Настройки.ЗаписатьНастройки(Изменения);
	Если Ошибки.Количество() > 0 Тогда
		Возврат "ОШИБКА записи настроек: " + Ошибки[0].Текст;
	КонецЕсли;
	Возврат "Режим тестирования " + ?(Включить, "включён, проект " + Проект, "выключен");

