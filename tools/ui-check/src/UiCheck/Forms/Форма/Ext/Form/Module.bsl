КонецФункции

// «Заполнить из задачи Б24» → задача по номеру → время → «Добавить в табель». Проверяет время начала по умолчанию
// (ОжидаемоеНачало, пусто — не проверять) и возвращает Истину, если окно закрылось с результатом.
&НаКлиенте
Функция ДобавитьИзЗадачи(Табель, Номер, ОжидаемоеНачало, Начало, Окончание, ВыборОжидается = Ложь)

	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Кнопка = Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24");
	Кнопка.Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Тогда
		Проверка(Ложь, "Окно «Заполнить из задачи Битрикс24» открылось (задача " + Номер + ")");
		Возврат Ложь;
	КонецЕсли;
	Если Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВвестиНомерЗадачи(ФормаОкна, Номер);
	Если Не ПустаяСтрока(ОжидаемоеНачало) Тогда
		ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "ВремяНач")), ОжидаемоеНачало, "Время начала по умолчанию");
	КонецЕсли;
	ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяНач"), Начало, "Содержание");
	Если Не ПустаяСтрока(Окончание) Тогда
		ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяКон"), Окончание, "Содержание");
	КонецЕсли;
	Добавить = НайтиКнопку(ФормаОкна, "Добавить в табель");
	Проверка(Добавить.ТекущаяДоступность(), "«Добавить в табель» доступна");
	Добавить.Нажать();
	Закрыто = ФормаОкна.ОжидатьЗакрытие(60);
	Проверка(Закрыто, "Окно закрылось после «Добавить в табель»");
	Пауза(2);
	Если Не ВыборОжидается Тогда
		Табель.Активизировать();
	КонецЕсли;
	Возврат Закрыто;

КонецФункции

// Номер вводится, поиск начинается, когда фокус уходит из поля. Если первый переход фокуса не сработал (бывает в
// тестовом клиенте), фокус переводится на другое поле ещё раз.
&НаКлиенте
Процедура ВвестиНомерЗадачи(ФормаОкна, Номер, Ввод = Неопределено)

	Ожидаемый = "Выбрана задача №" + Номер;
	НайтиПоле(ФормаОкна, "НомерИлиСсылка").ВвестиТекст(?(Ввод = Неопределено, Номер, Ввод));
	Для Заход = 1 По 3 Цикл
		НайтиПоле(ФормаОкна, ?(Заход = 2, "ТекстПоиска", "Содержание")).Активизировать();
		Конец = ТекущаяДата() + 10;
		Пока ТекущаяДата() < Конец И ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")) <> Ожидаемый Цикл
			Пауза(1);
		КонецЦикла;
		Если ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")) = Ожидаемый Тогда
			Прервать;
		КонецЕсли;
		Лог("Поиск по номеру не начался за 10 с, фокус переводится ещё раз (заход " + Заход + ")");
	КонецЦикла;
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")), Ожидаемый, "Выбор задачи по номеру");

КонецПроцедуры

#Область ТаблицаТабеля

// Строки таблицы как соответствия «заголовок колонки — текст».
&НаКлиенте
Функция СтрокиТаблицы(Таблица, Тихо = Ложь)

	Результат = Новый Массив;
	ТекущаяПередЧтением = Неопределено;
	Таблица.Активизировать();
	Попытка
		Если Таблица.ТекущийРежимРедактирование() Тогда
			Таблица.ЗакончитьРедактированиеСтроки();
			Пауза(1);
		КонецЕсли;
		ТекущаяПередЧтением = ТекущаяСтрокаТаблицы(Таблица);
		Таблица.ПерейтиКПервойСтроке();
		Предыдущая = Неопределено;
		Для Счёт = 1 По 30 Цикл
			Текущая = ТекущаяСтрокаТаблицы(Таблица);
			Если Текущая = Неопределено Или Предыдущая <> Неопределено
				И ПредставлениеСтроки(Текущая) = ПредставлениеСтроки(Предыдущая) И Счёт > 1 Тогда
				Прервать;
			КонецЕсли;
			Результат.Добавить(Текущая);
			Предыдущая = Текущая;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		КонецЦикла;
	Исключение
		Лог("Не удалось прочитать таблицу: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Не Тихо Тогда
		Если Результат.Количество() > 0 Тогда
			Лог("  колонки: " + СтрСоединить(КлючиВМассив(Результат[0]), " | "));
		КонецЕсли;
		Для Каждого Строка Из Результат Цикл
			Лог("  строка: " + ПредставлениеСтроки(Строка));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ТекущаяСтрокаТаблицы(Таблица)

	Выделенные = Таблица.ПолучитьВыделенныеСтроки();
	Возврат ?(Выделенные.Количество() = 0, Неопределено, Выделенные[0]);

КонецФункции

// Значение колонки, заголовок которой начинается с Префикс.
&НаКлиенте
Функция Ячейка(Строка, Префикс)

	Если Строка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Элемент Из Строка Цикл
		Если СтрНачинаетсяС(Элемент.Ключ, Префикс) Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаКлиенте
Функция СтрокаПоНомеру(Строки, Номер)

	Для Каждого Строка Из Строки Цикл
		Если Ячейка(Строка, "ID Б24") = Номер Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Время ячейки таблицы «ч:мм:сс» в «ЧЧ:мм»; пустое остаётся пустым.
&НаКлиенте
Функция Время(Текст)

	Части = СтрРазделить(Текст, ":");
	Если Части.Количество() <> 3 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Прав("0" + Части[0], 2) + ":" + Прав("0" + Части[1], 2);

КонецФункции

&НаКлиенте
Функция ПредставлениеСтроки(Соответствие)

	Части = Новый Массив;
	Если Соответствие <> Неопределено Тогда
		Для Каждого Элемент Из Соответствие Цикл
			Части.Добавить(Элемент.Ключ + "=" + Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Части, " | ");

КонецФункции

&НаКлиенте
Функция КлючиВМассив(Соответствие)

	Результат = Новый Массив;
	Для Каждого Элемент Из Соответствие Цикл
		Результат.Добавить(Элемент.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Вводит текст в ячейку текущей строки таблицы и заканчивает редактирование строки.
&НаКлиенте
Процедура ВвестиВЯчейку(Таблица, ИмяПоля, Текст)

	Таблица.ИзменитьСтроку();
	Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , ИмяПоля);
	Если Поле = Неопределено Тогда
		Проверка(Ложь, "В таблице есть поле " + ИмяПоля);
		Возврат;
	КонецЕсли;
	Поле.Активизировать();
	Поле.ВвестиТекст(Текст);
	Таблица.ЗакончитьРедактированиеСтроки();
	Пауза(1);

