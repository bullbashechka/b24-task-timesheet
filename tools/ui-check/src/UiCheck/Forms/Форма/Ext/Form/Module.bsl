&НаСервереБезКонтекста
Процедура УдалитьТабелиСценария(Комментарий)

	Запрос = Новый Запрос("ВЫБРАТЬ Т.Ссылка КАК Ссылка ИЗ Документ.гем_Табель КАК Т ГДЕ ПОДСТРОКА(Т.Комментарий, 1, 100) = &Комментарий");
	Запрос.УстановитьПараметр("Комментарий", Комментарий);
