// ВвестиТекст только вводит текст; событие «при изменении» срабатывает, когда фокус уходит из поля.
&НаКлиенте
Процедура ВвестиИЗавершить(ФормаОкна, Поле, Текст, ПолеДляПерехода)

	Поле.ВвестиТекст(Текст);
	НайтиПоле(ФормаОкна, ПолеДляПерехода).Активизировать();
	Пауза(1);

КонецПроцедуры

// Вводит текст в поле номера и ждёт ответа: прежнее сообщение остаётся на экране, пока идёт запрос.
&НаКлиенте
Процедура ВвестиНомер(ФормаОкна, Ввод, Ожидаемое)

	ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "НомерИлиСсылка"), Ввод, "ТекстПоиска");
	ЖдатьТекст(ФормаОкна, "СообщениеНомера", Ожидаемое, "Ввод «" + Ввод + "»", 30);

КонецПроцедуры

// Ждёт, пока надпись покажет ожидаемый текст (форма обновляет надписи с задержкой), и проверяет его.
&НаКлиенте
Процедура ЖдатьТекст(ФормаОкна, ИмяДекорации, Ожидаемый, Описание, Секунд = 15)

	Конец = ТекущаяДата() + Секунд;
	Пока Истина Цикл
		Текст = ТекстМетки(НайтиДекорацию(ФормаОкна, ИмяДекорации));
		Если Текст = Ожидаемый Или ТекущаяДата() >= Конец Тогда
			Прервать;
		КонецЕсли;
		Пауза(1);
	КонецЦикла;
	ПроверитьТекст(Текст, Ожидаемый, Описание);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьТекст(Фактический, Ожидаемый, Описание)

	Если Фактический = Ожидаемый Тогда
		Проверка(Истина, Описание + ": «" + Фактический + "»");
	Иначе
		Проверка(Ложь, Описание + ": ожидали «" + Ожидаемый + "», получили «" + Фактический + "»");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Проверка(Условие, Описание)

	Если Условие Тогда
		Лог("ОК: " + Описание);
	Иначе
		Ошибок = Ошибок + 1;
		Лог("ОШИБКА: " + Описание);
	КонецЕсли;

КонецПроцедуры

// Отчёт пишется по ходу: если сценарий зависнет, виден последний шаг. Адрес вебхука замечается в исходном тексте,
// а в файл попадает только скрытым.
&НаКлиенте
Процедура Лог(Текст)

	ВебхукВОтчёте = ВебхукВОтчёте Или ЕстьАдресВебхука(Текст);
	Журнал.Добавить(Текст);
	ЗаписатьОтчёт(СтрСоединить(Журнал, Символы.ПС) + Символы.ПС);

КонецПроцедуры

// Единственное место записи отчёта: e-mail и всё после «/rest/» скрываются здесь.
&НаКлиенте
Процедура ЗаписатьОтчёт(Отчёт)

	Если ПустаяСтрока(ФайлОтчёта) Тогда
		Возврат;
	КонецЕсли;
	Документ = Новый ТекстовыйДокумент;
	Документ.УстановитьТекст(СкрытьВебхуки(СкрытьАдреса(Отчёт)));
	Документ.Записать(ФайлОтчёта);

КонецПроцедуры

&НаКлиенте
Процедура Пауза(Секунд)

	Конец = ТекущаяДата() + Секунд;
	Пока ТекущаяДата() < Конец Цикл
		ОбработкаПрерыванияПользователя();
	КонецЦикла;

КонецПроцедуры

// Надпись без текста возвращает своё имя: считаем её пустой.
&НаКлиенте
Функция ТекстМетки(Метка)

	Текст = Метка.ТекстЗаголовка;
	Возврат ?(Текст = Метка.Имя, "", Текст);

КонецФункции

// Текст, который показывает поле. Пустое поле времени возвращает «Метод не может быть вызван»: тогда берётся
// представление данных; значение времени с датой 01.01.0001 приводится к «ЧЧ:мм».
&НаКлиенте
Функция ТекстПоля(Поле)

	Попытка
		Текст = Поле.ПолучитьОтображаемыйТекст();
	Исключение
		Текст = Поле.ПолучитьПредставлениеДанных();
	КонецПопытки;
	Если СтрНачинаетсяС(Текст, "01.01.0001 ") Тогда
		Текст = Формат(Дата(1, 1, 1) + (Число(Сред(Текст, 12, СтрНайти(Текст, ":") - 12)) * 3600
			+ Число(Сред(Текст, СтрНайти(Текст, ":") + 1, 2)) * 60), "ДФ=HH:mm");
	КонецЕсли;
	Возврат Текст;

КонецФункции

&НаКлиенте
Функция КлючиИЗначения(Значение)

	Результат = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			Результат.Добавить(КлючИЗначение.Ключ + "=" + Строка(КлючИЗначение.Значение));
		КонецЦикла;
	Иначе
		Результат.Добавить(Строка(Значение));
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ВМассивСтрок(Значение)

	Результат = Новый Массив;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) = Тип("Структура") И Элемент.Свойство("ОтображаемыйТекст") Тогда
			Результат.Добавить(Строка(Элемент.ОтображаемыйТекст));
		Иначе
			Результат.Добавить(Строка(Элемент));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Адреса e-mail в отчёте: первый символ и «***» до «@».
&НаКлиенте
Функция СкрытьАдреса(Текст)

	Результат = "";
	Остаток = Текст;
	Пока Истина Цикл
		Позиция = СтрНайти(Остаток, "@");
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		Начало = Позиция;
		Пока Начало > 1 И ЭтоСимволАдреса(Сред(Остаток, Начало - 1, 1)) Цикл
			Начало = Начало - 1;
		КонецЦикла;
		Результат = Результат + Лев(Остаток, Начало - 1);
		Если Начало < Позиция Тогда
			Результат = Результат + Сред(Остаток, Начало, 1) + "***";
		КонецЕсли;
		Остаток = Сред(Остаток, Позиция);
		Позиция = 1;
		Результат = Результат + "@";
		Остаток = Сред(Остаток, 2);
	КонецЦикла;
	Возврат Результат + Остаток;

КонецФункции

&НаКлиенте
Функция ЭтоСимволАдреса(Символ)

	Возврат СтрНайти("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789._-+", Символ) > 0;

КонецФункции

// Адрес вебхука: всё после «/rest/» до пробела, кавычки или конца текста заменяется на «***» (номер создателя и ключ).
&НаКлиенте
Функция СкрытьВебхуки(Текст)

	Метка = МеткаВебхука();
	Результат = "";
	Остаток = Текст;
	Позиция = СтрНайти(НРег(Остаток), Метка);
	Пока Позиция > 0 Цикл
		Результат = Результат + Лев(Остаток, Позиция + СтрДлина(Метка) - 1) + "***";
		Остаток = Сред(Остаток, Позиция + СтрДлина(Метка));
		Конец = 1;
		Пока Конец <= СтрДлина(Остаток) И Не ЭтоКонецАдреса(Сред(Остаток, Конец, 1)) Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Остаток = Сред(Остаток, Конец);
		Позиция = СтрНайти(НРег(Остаток), Метка);
	КонецЦикла;
	Возврат Результат + Остаток;

КонецФункции

&НаКлиенте
Функция ЕстьАдресВебхука(Текст)

	Возврат СтрНайти(НРег(Текст), МеткаВебхука()) > 0;

КонецФункции

&НаКлиенте
Функция МеткаВебхука()

	Возврат "/rest/";

КонецФункции

&НаКлиенте
Функция ЭтоКонецАдреса(Символ)

	Возврат ПустаяСтрока(Символ) Или СтрНайти("""'«»<>", Символ) > 0;

КонецФункции

&НаКлиенте
Функция РазобратьПараметры(Значение)

	Результат = Новый Структура("out, port, scenario, since, tasks, project, closed, files", "", "1538", "окно", "", "", "0", "", "");
	Для Каждого Часть Из СтрРазделить(Значение, ";") Цикл
		Позиция = СтрНайти(Часть, "=");
		Если Позиция > 0 Тогда
			Результат.Вставить(Лев(Часть, Позиция - 1), Сред(Часть, Позиция + 1));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Записи Б24ТабельИзЗадачи.* журнала регистрации с момента запуска. Менеджер тестирования всегда работает под
// пользователем из реестра (администратором), поэтому журнал читается и тогда, когда тестовый клиент запущен под
// обычным сотрудником (--user).
&НаСервереБезКонтекста
Функция ЗаписиЖурнала(Начало)

	Таблица = Новый ТаблицаЗначений;
	События = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Обращение,Ошибка,Доступ,Настройки", ",") Цикл
		События.Добавить("Б24ТабельИзЗадачи." + Имя);
	КонецЦикла;
	ВыгрузитьЖурналРегистрации(Таблица, Новый Структура("ДатаНачала, Событие", Начало, События));
	// Ошибки платформы (исключения в обработчиках) тоже попадают в отчёт.
	Платформа = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Платформа, Новый Структура("ДатаНачала, Уровень", Начало, УровеньЖурналаРегистрации.Ошибка));
	// Первый сеанс, начатый после запуска скрипта, — тестовый клиент. Ошибки более старых сеансов (клиент 1c MCP и другие
	// открытые клиенты разработчика) — не наши.
	НашПервыйСеанс = 0;
	Начала = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Начала, Новый Структура("ДатаНачала, Событие", Начало, "_$Session$_.Start"));
	Для Каждого Строка Из Начала Цикл
		Если Строка.Сеанс > 0 И (НашПервыйСеанс = 0 Или Строка.Сеанс < НашПервыйСеанс) Тогда
			НашПервыйСеанс = Строка.Сеанс;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Платформа Цикл
		// Сеансы тестового клиента и менеджера гасит сам скрипт, это не ошибка.
		Если СтрНачинаетсяС(Строка.Событие, "Б24ТабельИзЗадачи") Или СтрНачинаетсяС(Строка.Событие, "_$Job$_")
			Или СтрНайти(Строка.Комментарий, "Сеанс отсутствует или удален") > 0
			Или НашПервыйСеанс > 0 И Строка.Сеанс < НашПервыйСеанс Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		// Фоновое задание БСП гибнет вместе с сеансом, который гасит скрипт («Сеанс отсутствует или удален» выше): шум платформы.
		Если Строка.Событие = "Длительные операции.Фоновое задание не найдено" Тогда
			НоваяСтрока.Уровень = "Платформа, не считается";
		КонецЕсли;
	КонецЦикла;

	Записи = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Записи.Добавить(Формат(Строка.Дата, "ДФ=HH:mm:ss") + " " + Строка.Событие + " [" + Строка.Уровень + "] "
			+ СтрЗаменить(Строка.Комментарий, Символы.ПС, " "));
	КонецЦикла;
	Возврат Записи;

КонецФункции

#КонецОбласти
