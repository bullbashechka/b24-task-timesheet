	Если Не Приложение.ОжидатьОтображениеОбъекта(Тип("ТестируемаяФорма"), ЗаголовокВыбораКонтрагента(), , 15) Тогда
		Попытка
			Лог("Активное окно: «" + Приложение.ПолучитьАктивноеОкно().Заголовок + "»");
		Исключение
		КонецПопытки;
		Возврат Ложь;
