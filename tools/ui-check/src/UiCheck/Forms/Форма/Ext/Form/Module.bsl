// Роли «Базовые права БСП» и «Гем табель» пользователю «[ТЕСТ] Сотрудник»: после загрузки расширения БСП может снять роли,
// выданные в конфигураторе, и тогда тестовый клиент под ним не запускается («Нет прав на запуск требуемого вида клиента»).
&НаСервереБезКонтекста
Функция ВыдатьРолиТестовомуПользователю()

	Пользователь = ТестовыйПользователь();
	Если Пользователь.Пустая() Тогда
		Возврат "Пользователя «[ТЕСТ] Сотрудник» в базе нет";
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(Пользователь.ИдентификаторПользователяИБ);
	Если ПользовательИБ = Неопределено Тогда
		Возврат "У пользователя «[ТЕСТ] Сотрудник» нет пользователя информационной базы";
	КонецЕсли;
	Выдано = Новый Массив;
	Для Каждого Имя Из СтрРазделить("БазовыеПраваБСП,гем_Табель", ",") Цикл
		Роль = Метаданные.Роли.Найти(Имя);
		Если Роль <> Неопределено И Не ПользовательИБ.Роли.Содержит(Роль) Тогда
			ПользовательИБ.Роли.Добавить(Роль);
			Выдано.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
	Если Выдано.Количество() > 0 Тогда
		ПользовательИБ.Записать();
	КонецЕсли;
	Возврат "Роли «[ТЕСТ] Сотрудник»: выдано " + ?(Выдано.Количество() = 0, "ничего (уже есть)", СтрСоединить(Выдано, ", "));

