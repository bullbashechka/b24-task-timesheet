// Проверка интерфейса без человека. Обработка запускается менеджером тестирования (/TESTMANAGER /Execute) и управляет
// тестовым клиентом (/TESTCLIENT) через ТестируемоеПриложение; scripts/ui-check.sh собирает и запускает её.
// Параметры запуска: out=<файл отчёта>;port=<порт тестового клиента>;scenario=<сценарий>;since=<ггггММддЧЧммсс>.
// Отчёт печатает то, что видит пользователь, ошибки журнала регистрации с момента запуска и заканчивается строкой
// «ИТОГ: ПРОЙДЕНО» или «ИТОГ: НЕ ПРОЙДЕНО». Каждая запись в файл скрывает адреса e-mail и всё, что стоит после «/rest/»,
// поэтому ключа вебхука в отчёте нет; текст с «/rest/» на экране или в журнале проваливает проверку.

&НаКлиенте
Перем Журнал;

&НаКлиенте
Перем Ошибок;

&НаКлиенте
Перем Приложение;

&НаКлиенте
Перем ФайлОтчёта;

&НаКлиенте
Перем ВебхукВОтчёте;

// Номера тестовых задач: ключ из scripts/b24-test-data.ids.json → номер (текстом, как в колонке «№»).
&НаКлиенте
Перем НомераЗадач;

&НаКлиенте
Перем НастройкиЗапуска;

// Текущая строка таблицы табеля, как она была перед последним чтением таблицы (чтение двигает курсор).
&НаКлиенте
Перем ТекущаяПередЧтением;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Журнал = Новый Массив;
	Ошибок = 0;
	ВебхукВОтчёте = Ложь;
	Настройки = РазобратьПараметры(ПараметрЗапуска);
	НастройкиЗапуска = Настройки;
	НомераЗадач = Новый Соответствие;
	Для Каждого Часть Из СтрРазделить(Настройки.tasks, ",") Цикл
		Пара = СтрРазделить(Часть, ":");
		Если Пара.Количество() = 2 Тогда
			НомераЗадач.Вставить(Пара[0], Пара[1]);
		КонецЕсли;
	КонецЦикла;
	ФайлОтчёта = Настройки.out;
	// Описание проверки не содержит самой метки: текст с ней проваливает отчёт.
	Проверка(СкрытьВебхуки("x https://p.bitrix24.kz/REST/30/ключ/profile.json"" y") = "x https://p.bitrix24.kz/REST/***"" y",
		"Отчёт скрывает ключ в адресе вебхука");
	Попытка
		Приложение = Новый ТестируемоеПриложение(, Число(Настройки.port));
		Приложение.УстановитьСоединение();
		Если Настройки.scenario = "окно" Тогда
			СценарийОкно();
		ИначеЕсли Настройки.scenario = "строка" Тогда
			СценарийСтрока();
		ИначеЕсли Настройки.scenario = "поиск" Тогда
			СценарийПоиск();
		ИначеЕсли Настройки.scenario = "чужой" Тогда
			СценарийЧужой();
		ИначеЕсли Настройки.scenario = "список" Тогда
			СценарийСписок();
		ИначеЕсли Настройки.scenario = "контрагенты" Тогда
			СценарийКонтрагенты();
		ИначеЕсли Настройки.scenario = "права" Тогда
			СценарийПрава();
		ИначеЕсли Настройки.scenario = "сотрудник" Тогда
			СценарийСотрудник();
		ИначеЕсли Настройки.scenario = "безтеста" Тогда
			СценарийБезТеста();
		ИначеЕсли Настройки.scenario = "безопасность" Тогда
			СценарийБезопасность();
		ИначеЕсли Настройки.scenario = "восстановить" Тогда
			СценарийВосстановить();
		ИначеЕсли Настройки.scenario = "ии" Тогда
			СценарийИИ();
		ИначеЕсли Настройки.scenario = "ии-настройки" Тогда
			СценарийИИНастройки();
		ИначеЕсли Настройки.scenario = "ии-отказы" Тогда
			СценарийИИОтказы();
		ИначеЕсли Настройки.scenario = "ии-сотрудник" Тогда
			СценарийИИСотрудник();
		ИначеЕсли Настройки.scenario = "роли" Тогда
			Лог(ВыдатьРолиТестовомуПользователю());
		Иначе
			Проверка(Ложь, "Неизвестный сценарий «" + Настройки.scenario + "»");
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Лог("");
	Лог("== Журнал регистрации с момента запуска");
	УтечкаВебхука = Ложь;
	ЧислоОшибок = 0;
	Спровоцировано = 0;
	Для Каждого Строка Из ЗаписиЖурнала(Дата(Настройки.since)) Цикл
		УтечкаВебхука = УтечкаВебхука Или ЕстьАдресВебхука(Строка);
		Если СтрНайти(Строка, "[Ошибка]") > 0 Тогда
			Если ОшибкаСпровоцированаСценарием(Настройки.scenario, Строка) Тогда
				Спровоцировано = Спровоцировано + 1;
			Иначе
				ЧислоОшибок = ЧислоОшибок + 1;
			КонецЕсли;
		КонецЕсли;
		Лог("  " + Строка);
	КонецЦикла;
	Проверка(Не УтечкаВебхука, "В журнале нет адреса вебхука");
	Проверка(ЧислоОшибок = 0, "В журнале нет ошибок (записей с уровнем «Ошибка»)"
		+ ?(Спровоцировано > 0, ", кроме спровоцированных сценарием: " + Спровоцировано, ""));
	Если Настройки.scenario = "ии-отказы" Тогда
		Проверка(Спровоцировано >= 2, "Спровоцированные ошибки OpenAI записаны в журнал: " + Спровоцировано);
	ИначеЕсли Настройки.scenario = "ии-настройки" Тогда
		Проверка(Спровоцировано >= 3, "Спровоцированные ошибки (неверный ключ, модель, проверка права «Чат и уведомления») записаны в журнале: " + Спровоцировано);
	КонецЕсли;

	Если ВебхукВОтчёте Тогда
		Ошибок = Ошибок + 1;
		Лог("НЕ ПРОЙДЕНО: в отчёте был адрес вебхука");
	КонецЕсли;
	Лог(?(Ошибок = 0, "ИТОГ: ПРОЙДЕНО", "ИТОГ: НЕ ПРОЙДЕНО, ошибок: " + Ошибок));
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область Сценарии

// Табель → «Заполнить из задачи Б24» → окно: проверки Ф2–Ф4 без выбранной задачи (С2, С12, С14), «Отмена».
&НаКлиенте
Процедура СценарийОкно()

	Лог("== Табель");
	ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
	ОкноПриложения.ВыполнитьКоманду("e1cib/command/Документ.гем_Табель.Создать");
	Табель = ЖдатьФорму("Табель (создание)", 60);
	Если Табель = Неопределено Тогда
		Проверка(Ложь, "Открылся новый табель");
		Возврат;
	КонецЕсли;
	Табель.Активизировать();
	Лог("Открыта форма «" + Табель.ТекстЗаголовка + "»");

	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Кнопка = Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24");
	Проверка(Кнопка <> Неопределено, "Кнопка «Заполнить из задачи Б24» есть в командной панели таблицы «Табель»");
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Проверка(Кнопка.ТекущаяДоступность(), "Кнопка доступна (пользователь с полными правами)");
	ИзмененДо = Табель.ТекущаяМодифицированность();
	Лог("Новый табель до нажатия кнопки: изменён = " + ИзмененДо);

	Лог("");
	Лог("== Окно");
	Кнопка.Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Тогда
		Проверка(Ложь, "Окно «Заполнить из задачи Битрикс24» открылось");
		Возврат;
	КонецЕсли;
	Лог("Открыто окно «" + ФормаОкна.ТекстЗаголовка + "»");

	Если Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат;
	КонецЕсли;
	ПроверитьПоляОкна(ФормаОкна);
	ПроверитьВводНомера(ФормаОкна);
	ПроверитьВремя(ФормаОкна);

	Лог("");
	Лог("== Отмена");
	КнопкаОтмены = НайтиКнопку(ФормаОкна, "Отмена");
	Проверка(КнопкаОтмены <> Неопределено, "Кнопка «Отмена» есть");
	Если КнопкаОтмены <> Неопределено Тогда
		КнопкаОтмены.Нажать();
		Закрыто = ФормаОкна.ОжидатьЗакрытие(30);
		Проверка(Закрыто, "Окно закрылось по «Отмена»");
		Табель.Активизировать();
		Лог("Табель после «Отмена»: изменён = " + Табель.ТекущаяМодифицированность());
		Проверка(Табель.ТекущаяМодифицированность() = ИзмененДо, "Табель после «Отмена» в том же состоянии «изменён», что и до окна");
	КонецЕсли;

КонецПроцедуры

// Добавление строки в табель из окна (Ф5, С1, С4, С5, С15): задача с компанией, задача без компании (открывается выбор
// контрагента), повторная задача, строка без окончания, запись и проведение. Номера задач — параметр tasks (две
// своих тестовых задачи: с компанией «Дальстрой» и без компании).
&НаКлиенте
Процедура СценарийСтрока()

	Если Не ЕстьЗадачи("ownDalstroy,ownNoCompany") Тогда
		Возврат;
	КонецЕсли;
	СКомпанией = НомераЗадач["ownDalstroy"];
	БезКомпании = НомераЗадач["ownNoCompany"];
	Комментарий = "[ТЕСТ] ui-check строка";
	УдалитьТабелиСценария(Комментарий);
	ТабелейДо = ЧислоТабелей();

	Лог("== Табель");
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Проверка(СтрокиТаблицы(Таблица).Количество() = 0, "Новый табель пуст");

	Лог("");
	Лог("== Задача с компанией (С1)");
	Если Не ДобавитьИзЗадачи(Табель, СКомпанией, "09:00", "11:00", "12:00") Тогда
		Возврат;
	КонецЕсли;
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 1, "В табеле одна строка");
	Если Строки.Количество() = 1 Тогда
		Первая = Строки[0];
		ПроверитьТекст(Ячейка(Первая, "ID Б24"), СКомпанией, "ID Б24 первой строки");
		ПроверитьТекст(Ячейка(Первая, "Содержание"), "[ТЕСТ] Своя задача — Дальстрой", "Содержание первой строки");
		Проверка(СтрНайти(НРег(Ячейка(Первая, "Контрагент")), "дальстрой") > 0,
			"Контрагент по компании CRM: «" + Ячейка(Первая, "Контрагент") + "»");
		ПроверитьТекст(Время(Ячейка(Первая, "Факт")), "01:00", "Факт первой строки");
	КонецЕсли;
	Проверка(Не ЕстьОкноВыбораКонтрагента(), "Контрагент найден: выбор контрагента не открыт");

	Лог("");
	Лог("== Задача без компании (С15)");
	Если Не ДобавитьИзЗадачи(Табель, БезКомпании, "12:00", "08:00", "08:50", Истина) Тогда
		Возврат;
	КонецЕсли;
	// Выбор контрагента сам не открывается (Ф5): сотрудник вводит контрагента в ячейку сам.
	Выбран = ВвестиКонтрагентаВручную(Табель, Таблица);
	Проверка(Выбран, "После добавления выбор контрагента сам не открылся, контрагент введён в ячейку");
	Табель.Активизировать();
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 2, "В табеле две строки");
	Если Строки.Количество() = 2 Тогда
		ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), БезКомпании, "Новая строка (08:00) встала первой");
		ПроверитьТекст(Ячейка(Строки[1], "ID Б24"), СКомпанией, "Прежняя строка вторая");
	КонецЕсли;
	ПроверитьТекст(Ячейка(ТекущаяПередЧтением, "ID Б24"), БезКомпании, "Текущая строка — новая");
	Проверка(Ячейка(Строки[0], "Контрагент") <> "", "Выбранный контрагент попал в ячейку: «"
		+ Ячейка(Строки[0], "Контрагент") + "»");

	Лог("");
	Лог("== Повторное добавление (С4)");
	ДоПовтора = СтрокаПоНомеру(СтрокиТаблицы(Таблица), СКомпанией);
	Если Не ДобавитьИзЗадачи(Табель, СКомпанией, "12:00", "12:00", "12:30") Тогда
		Возврат;
	КонецЕсли;
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 3, "В табеле три строки");
	Проверка(ПредставлениеСтроки(СтрокаПоНомеру(Строки, СКомпанией)) = ПредставлениеСтроки(ДоПовтора),
		"Первая строка по задаче не изменилась");

	Лог("");
	Лог("== Без времени окончания (С5)");
	Если Не ДобавитьИзЗадачи(Табель, СКомпанией, "12:30", "13:00", "") Тогда
		Возврат;
	КонецЕсли;
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 4, "В табеле четыре строки");
	Если Строки.Количество() = 4 Тогда
		ПроверитьТекст(Время(Ячейка(Строки[3], "Факт")), "", "Факт строки без окончания пуст");
	КонецЕсли;
	ВвестиВЯчейку(Таблица, "ТабельВремяКон", "13:30");
	ТекущаяСтрока = ТекущаяСтрокаТаблицы(Таблица);
	ПроверитьТекст(Время(Ячейка(ТекущаяСтрока, "Факт")), "00:30", "Окончание введено в ячейке: Факт посчитан");

	Лог("");
	Лог("== Табель не записан (Ф5)");
	Проверка(Табель.ТекущаяМодифицированность(), "Табель помечен изменённым");
	Проверка(ЧислоТабелей() = ТабелейДо, "Новый документ в базе не появился");

	Лог("");
	Лог("== Запись и проведение (С1)");
	НайтиПоле(Табель, "Комментарий").ВвестиТекст(Комментарий);
	Таблица.Активизировать();
	Кнопка = НайтиКнопку(Табель, "Провести и закрыть");
	Проверка(Кнопка <> Неопределено, "Кнопка «Провести и закрыть» есть");
	Если Кнопка <> Неопределено Тогда
		Кнопка.Нажать();
		Проверка(Табель.ОжидатьЗакрытие(60), "Табель проведён и закрыт");
	КонецЕсли;
	Проверка(ЧислоТабелей() = ТабелейДо + 1, "В базе появился один табель");
	Лог("Строк в записанном табеле по задаче: " + СтрокЗадачВТабеле(Комментарий));
	Проверка(СтрокЗадачВТабеле(Комментарий) = 4, "В записанном табеле четыре строки с номерами задач");
	УдалитьТабелиСценария(Комментарий);
	Проверка(ЧислоТабелей() = ТабелейДо, "Тестовый табель удалён");

КонецПроцедуры

// «Заполнить с помощью ИИ» в окне (Ф9, Ф12, Ф15; С16–С19, С23, С26–С29). Нужны ИИ, включённый в настройках базы ключом
// разработки, и свои тестовые задачи aiUpdate, aiNoValue, aiNoMatch, aiCommentName, aiCommentMany и aiCommentDays (параметр
// tasks; параметр days — дни комментариев aiCommentDays, их считает ui-check.sh по чату задачи). Все окна идут в одном
// табеле без строк, а строка добавляется в самом конце:
//  - С17, С19: задача без значения для места: ответ в поле, «Заполните: …», правка места по мере ввода, «Вернуть прежний
//    текст»;
//  - С18, С23: работа не под формулировку — текст своими словами; в справочник добавляется «[ТЕСТ]»-формулировка, и тот же
//    запрос использует её без обновления расширения (запись удаляется в любом случае);
//  - С29 (живая часть): пока флажок «Передавать ИИ комментарии задачи» снят, к чату задачи обращений нет;
//  - С26, С27, С28: флажок комментариев включается на время проверки и снимается в любом случае: имя пользователя ПК
//    только в комментарии, несколько людей — место «"чей"», работа дня по комментариям дня табеля (две даты табеля);
//  - С16: задача про обновление с черновиком: версия в ответе, надписей нет, строка добавляется в табель с текстом поля.
// Табель не записывается.
&НаКлиенте
Процедура СценарийИИ()

	Если Не ЕстьЗадачи("aiUpdate,aiNoValue,aiNoMatch,aiCommentName,aiCommentMany,aiCommentDays") Тогда
		Возврат;
	КонецЕсли;
	ТабелейДо = ЧислоТабелей();

	Лог("== Табель");
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПроверитьМестоБезЗначения(Табель, НомераЗадач["aiNoValue"]);
		ПроверитьСвоимиСловамиИФормулировку(Табель, НомераЗадач["aiNoMatch"]);

		Лог("");
		Лог("== Комментарии задачи не запрашиваются, пока флажок снят (С29)");
		Проверка(ЧислоЗаписейЖурнала("im.dialog.messages.get") = 0, "За время проверок к чату задачи обращений нет");

		Лог("");
		Лог("== Комментарии задачи (С26, С27, С28)");
		Лог(НастроитьПередачуКомментариев(Истина));
		Попытка
			ПроверитьКомментарииИИ(Табель, НомераЗадач["aiCommentName"]);
			ПроверитьМестоЧей(Табель, НомераЗадач["aiCommentMany"]);
			ПроверитьДниКомментариев(Табель, НомераЗадач["aiCommentDays"]);
		Исключение
			Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		Лог(НастроитьПередачуКомментариев(Ложь));
		Проверка(Не ПередачаКомментариевВключена(), "Флажок «Передавать ИИ комментарии задачи» снят обратно");

		ДобавитьСтрокуПоОбновлению(Табель, НомераЗадач["aiUpdate"]);
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УдалитьТестовуюФормулировку();
	Если ПередачаКомментариевВключена() Тогда
		Лог(НастроитьПередачуКомментариев(Ложь));
	КонецЕсли;
	Проверка(ЧислоТабелей() = ТабелейДо, "Табель не записан");

	Лог("");
	Лог("== Журнал регистрации (С16, С23, С24)");
	ЕстьИтог = Ложь;
	ЕстьФ10 = Ложь;
	ЕстьТестовыйШифр = Ложь;
	Чисто = Истина;
	Для Каждого Запись Из ЗаписиЖурнала(Дата(НастройкиЗапуска.since)) Цикл
		ЕстьИтог = ЕстьИтог Или СтрНайти(Запись, "Содержание от ИИ: написано своими словами") > 0;
		Если СтрНайти(Запись, "Содержание от ИИ:") > 0 И СтрНайти(Запись, "шифры формулировок:") > 0 Тогда
			ЕстьФ10 = ЕстьФ10 Или СтрНайти(Запись, "Ф10") > 0;
			ЕстьТестовыйШифр = ЕстьТестовыйШифр Или СтрНайти(Запись, "[ТЕСТ] Этикетки") > 0;
		КонецЕсли;
		Если СтрНайти(Запись, "sk-") > 0 И СтрНайти(Запись, "sk-***") = 0
			Или СтрНайти(Запись, "3.0.72.1") > 0 Или СтрНайти(Запись, "Анны Петровны") > 0 Тогда
			Чисто = Ложь;
		КонецЕсли;
	КонецЦикла;
	Проверка(ЕстьИтог, "В журнале есть итог «Содержание от ИИ» без текстов");
	Проверка(ЕстьФ10, "В журнале шифр формулировки обновления Ф10 (С16)");
	Проверка(ЕстьТестовыйШифр, "В журнале шифр «[ТЕСТ] Этикетки» из справочника (С23)");
	Проверка(Чисто, "В журнале нет ключа OpenAI, черновика и ответа ИИ");

КонецПроцедуры

// Открытое окно с загруженным списком; Неопределено, если окно не открылось (ошибка уже в отчёте).
&НаКлиенте
Функция ОткрытьОкноСЗадачей(Табель, Номер)

	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ВвестиНомерЗадачи(ФормаОкна, Номер);
	Возврат ФормаОкна;

КонецФункции

// С17, С19. Окно закрывается в конце.
&НаКлиенте
Процедура ПроверитьМестоБезЗначения(Табель, БезЗначения)

	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог("");
	Лог("== Кнопка ИИ (Ф9)");
	КнопкаИИ = НайтиКнопку(ФормаОкна, "Заполнить с помощью ИИ");
	Проверка(КнопкаИИ <> Неопределено И КнопкаИИ.ТекущаяВидимость(),
		"Кнопка «Заполнить с помощью ИИ» видна (ИИ включён в настройках базы)");
	Если КнопкаИИ = Неопределено Тогда
		ЗакрытьОкно(ФормаОкна);
		Возврат;
	КонецЕсли;
	Проверка(Не КнопкаИИ.ТекущаяДоступность(), "Задача не выбрана: кнопка ИИ недоступна");
	Попытка
		Подсказка = КнопкаИИ.ПолучитьТекстПодсказки();
	Исключение
		Подсказка = "<" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ">";
	КонецПопытки;
	ПроверитьТекст(Подсказка, "ИИ составит содержание по задаче и тексту в поле. Можно заранее набрать, что сделано: "
		+ "версию, фамилию, название базы", "Подсказка кнопки ИИ (10А)");
	Проверка(Не КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "Кнопки «Вернуть прежний текст» до нажатия нет");

	Лог("");
	Лог("== Место без значения (С17)");
	ВвестиНомерЗадачи(ФормаОкна, БезЗначения);
	Содержание = НайтиПоле(ФормаОкна, "Содержание");
	Название = ТекстПоля(Содержание);
	Лог("Содержание после выбора задачи: «" + Название + "»");
	Проверка(КнопкаИИ.ТекущаяДоступность(), "Задача выбрана: кнопка ИИ доступна");
	Если Не НажатьИИ(ФормаОкна) Тогда
		ЗакрытьОкно(ФормаОкна);
		Возврат;
	КонецЕсли;
	Ответ = ТекстПоля(Содержание);
	Лог("Ответ ИИ: «" + Ответ + "»");
	Проверка(Ответ <> Название, "Текст поля заменён ответом ИИ");
	Заполните = ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьЗаполните"));
	Проверка(СтрНачинаетсяС(Заполните, "Заполните: "), "Надпись под полем: «" + Заполните + "»");
	Место = Сред(Заполните, СтрДлина("Заполните: ") + 1);
	Если СтрНайти(Место, ", ") > 0 Тогда
		Место = Лев(Место, СтрНайти(Место, ", ") - 1);
	КонецЕсли;
	Проверка(Место <> "" И СтрНайти(Ответ, Место) > 0, "Место «" + Место + "» есть в тексте поля");
	Проверка(КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "Кнопка «Вернуть прежний текст» видна");
	Проверка(НайтиКнопку(ФормаОкна, "Добавить в табель").ТекущаяДоступность(),
		"При надписи «Заполните» «Добавить в табель» доступна");

	Лог("");
	Лог("== Правка места (С17)");
	Заполненный = СтрЗаменить(Ответ, Место, "Анны Петровны");
	Содержание.Активизировать();
	Содержание.ВвестиТекст(Заполненный);
	// Надпись пересчитывается по мере ввода: фокус ещё в поле.
	Конец = ТекущаяДата() + 10;
	Пока ТекущаяДата() < Конец И НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость() Цикл
		Пауза(1);
	КонецЦикла;
	Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость(),
		"Место заполнено: надпись «Заполните» исчезла, пока фокус в поле");
	Попытка
		Набранный = Содержание.ПолучитьТекстРедактирования();
	Исключение
		Набранный = ТекстПоля(Содержание);
	КонецПопытки;
	ПроверитьТекст(Набранный, Заполненный, "Набранный текст остался в поле");
	НайтиПоле(ФормаОкна, "ТипВремени").Активизировать();
	Пауза(1);
	ПроверитьТекст(ТекстПоля(Содержание), Заполненный, "Текст поля после ухода из него");
	Проверка(КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "После правки «Вернуть прежний текст» видна (8А)");

	Лог("");
	Лог("== Вернуть прежний текст (С19)");
	НайтиКнопку(ФормаОкна, "Вернуть прежний текст").Нажать();
	Пауза(1);
	ПроверитьТекст(ТекстПоля(Содержание), Название, "В поле текст до нажатия ИИ");
	Проверка(Не КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "Кнопка «Вернуть прежний текст» исчезла");
	Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость(), "Надписи ИИ исчезли");

	ЗакрытьОкно(ФормаОкна);

КонецПроцедуры

// С18, С23. Окно закрывается в конце, «[ТЕСТ]»-формулировка удаляется в любом случае.
&НаКлиенте
Процедура ПроверитьСвоимиСловамиИФормулировку(Табель, Номер)

	Лог("");
	Лог("== Работа не под формулировку: текст своими словами (С18)");
	УдалитьТестовуюФормулировку();
	ФормаОкна = ОткрытьОкноСЗадачей(Табель, Номер);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Содержание = НайтиПоле(ФормаОкна, "Содержание");
	Название = ТекстПоля(Содержание);
	Попытка
		Если НажатьИИ(ФормаОкна) Тогда
			Ответ = ТекстПоля(Содержание);
			Лог("Ответ ИИ: «" + Ответ + "»");
			Проверка(СтрНайти(НРег(Ответ), "этикет") > 0, "В тексте работа задачи (этикетки)");
			Проверка(СтрНайти(Ответ, "Рекомендовано ознакомиться") = 0, "Чужой формулировки в тексте нет");
			Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость(), "Надписи «Заполните» нет");

			Лог("");
			Лог("== Новая формулировка в справочнике, без обновления расширения (С23)");
			ДобавитьТестовуюФормулировку();
			Проверка(КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "Кнопка «Вернуть прежний текст» видна");
			НайтиКнопку(ФормаОкна, "Вернуть прежний текст").Нажать();
			Пауза(1);
			ПроверитьТекст(ТекстПоля(Содержание), Название, "В поле название задачи");
			Если НажатьИИ(ФормаОкна) Тогда
				Ответ = ТекстПоля(Содержание);
				Лог("Ответ ИИ: «" + Ответ + "»");
				Проверка(СтрНайти(Ответ, "Настройка печати этикеток на термопринтере") > 0,
					"В тексте формулировка из справочника");
				ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьЗаполните")), "Заполните: (модель принтера)",
					"Надпись под полем");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	УдалитьТестовуюФормулировку();
	ЗакрытьОкно(ФормаОкна);

КонецПроцедуры

// С26: окно открывается заново (подсказка кнопки выбирается при открытии), пользователь ПК назван только в комментарии
// задачи, черновик пустой: в ответе его имя, надписей «Заполните» и «ИИ не получил комментарии задачи» нет; в журнале
// число переданных комментариев и ни одного их текста.
&НаКлиенте
Процедура ПроверитьКомментарииИИ(Табель, Номер)

	Начало = ТекущаяДата() - 5;
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	КнопкаИИ = НайтиКнопку(ФормаОкна, "Заполнить с помощью ИИ");
	Если КнопкаИИ = Неопределено Тогда
		Проверка(Ложь, "Кнопка «Заполнить с помощью ИИ» есть");
		ЗакрытьОкно(ФормаОкна);
		Возврат;
	КонецЕсли;
	Попытка
		Подсказка = КнопкаИИ.ПолучитьТекстПодсказки();
	Исключение
		Подсказка = "<" + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ">";
	КонецПопытки;
	ПроверитьТекст(Подсказка, "ИИ составит содержание по задаче, её комментариям и тексту в поле. Можно заранее набрать, "
		+ "что сделано: версию, фамилию, название базы", "Подсказка кнопки ИИ при включённых комментариях (Ф9)");

	ВвестиНомерЗадачи(ФормаОкна, Номер);
	Если НажатьИИ(ФормаОкна) Тогда
		Ответ = ТекстПоля(НайтиПоле(ФормаОкна, "Содержание"));
		Лог("Ответ ИИ: «" + Ответ + "»");
		Проверка(СтрНайти(Ответ, "Анны Петровны") > 0, "Пользователь ПК из комментария в тексте (С26)");
		Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость(), "Надписи «Заполните» нет");
		Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьКомментарииНеПолучены").ТекущаяВидимость(),
			"Надписи «ИИ не получил комментарии задачи» нет");

		ЕстьЧисло = Ложь;
		Чисто = Истина;
		Для Каждого Запись Из ЗаписиЖурнала(Начало) Цикл
			ЕстьЧисло = ЕстьЧисло Или СтрНайти(Запись, "комментарии: передано ") > 0;
			Если СтрНайти(Запись, "Анна Петровна") > 0 Или СтрНайти(Запись, "Анны Петровны") > 0
				Или СтрНайти(Запись, "Договорился") > 0 Тогда
				Чисто = Ложь;
			КонецЕсли;
		КонецЦикла;
		Проверка(ЕстьЧисло, "В журнале число переданных комментариев");
		Проверка(Чисто, "В журнале нет текстов комментариев и ответа ИИ");
	КонецЕсли;
	ЗакрытьОкно(ФормаОкна);

КонецПроцедуры

// С27: в комментариях названо несколько людей, чей ПК — не ясно: место «"чей"» остаётся, под полем «Заполните: "чей"»;
// имя вписывается, надпись исчезает.
&НаКлиенте
Процедура ПроверитьМестоЧей(Табель, Номер)

	Лог("");
	Лог("== Несколько людей в комментариях: чей ПК не ясно (С27)");
	ФормаОкна = ОткрытьОкноСЗадачей(Табель, Номер);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Содержание = НайтиПоле(ФормаОкна, "Содержание");
	Если НажатьИИ(ФормаОкна) Тогда
		Ответ = ТекстПоля(Содержание);
		Лог("Ответ ИИ: «" + Ответ + "»");
		Проверка(СтрНайти(Ответ, """чей""") > 0, "В тексте осталось место «""чей""»");
		ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьЗаполните")), "Заполните: ""чей""",
			"Надпись под полем");
		Заполненный = СтрЗаменить(Ответ, """чей""", "Ирины");
		Содержание.Активизировать();
		Содержание.ВвестиТекст(Заполненный);
		Конец = ТекущаяДата() + 10;
		Пока ТекущаяДата() < Конец И НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость() Цикл
			Пауза(1);
		КонецЦикла;
		Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость(),
			"Имя вписано: надпись «Заполните» исчезла");
	КонецЕсли;
	ЗакрытьОкно(ФормаОкна);

КонецПроцедуры

// С28: работа дня табеля описана в комментарии за этот день, а более ранние комментарии дают только факты; комментарии,
// написанные после дня табеля, на текст не влияют. Две даты табеля: день первой части комментариев aiCommentDays (релиз
// 3.0.70.1, выписки ещё нет) и день второй части (выписка, релиз был раньше). Дата табеля возвращается на сегодня.
&НаКлиенте
Процедура ПроверитьДниКомментариев(Табель, Номер)

	Дни = СтрРазделить(НастройкиЗапуска.days, ",", Ложь);
	Если Дни.Количество() < 2 Тогда
		Проверка(Ложь, "Скрипт передал два дня комментариев задачи aiCommentDays (параметр days)");
		Возврат;
	КонецЕсли;

	Для Заход = 1 По 2 Цикл
		День = Дни[?(Заход = 1, 0, Дни.Количество() - 1)];
		Лог("");
		Лог("== Комментарии разных дней: табель на " + День + " (С28)");
		УстановитьДатуТабеля(Табель, Дата(СтрЗаменить(День, "-", "")));
		ФормаОкна = ОткрытьОкноСЗадачей(Табель, Номер);
		Если ФормаОкна = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Если НажатьИИ(ФормаОкна) Тогда
			Ответ = ТекстПоля(НайтиПоле(ФормаОкна, "Содержание"));
			Лог("Ответ ИИ: «" + Ответ + "»");
			Если Заход = 1 Тогда
				Проверка(СтрНайти(Ответ, "3.0.70.1") > 0, "Работа первого дня: релиз 3.0.70.1 в тексте");
				Проверка(СтрНайти(Ответ, "выписк") = 0, "Комментарий второго дня (после дня табеля) на текст не влияет");
			Иначе
				Проверка(СтрНайти(Ответ, "выписк") > 0, "Работа второго дня: выписка в тексте");
				Проверка(СтрНайти(Ответ, "3.0.70.1") = 0, "Релиз из комментария первого дня в текст не идёт");
			КонецЕсли;
		КонецЕсли;
		ЗакрытьОкно(ФормаОкна);
	КонецЦикла;
	УстановитьДатуТабеля(Табель, ТекущаяДата());

КонецПроцедуры

// С16: задача про обновление с черновиком: версия в ответе, надписей нет, строка добавляется в табель с текстом поля.
&НаКлиенте
Процедура ДобавитьСтрокуПоОбновлению(Табель, Обновление)

	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	ФормаОкна = ОткрытьОкноСЗадачей(Табель, Обновление);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Содержание = НайтиПоле(ФормаОкна, "Содержание");

	Лог("");
	Лог("== Обновление базы с черновиком (С16)");
	ВвестиИЗавершить(ФормаОкна, Содержание, "обновил бк до 3.0.72.1", "ТипВремени");
	Если Не НажатьИИ(ФормаОкна) Тогда
		ЗакрытьОкно(ФормаОкна);
		Возврат;
	КонецЕсли;
	Ответ = ТекстПоля(Содержание);
	Лог("Ответ ИИ: «" + Ответ + "»");
	Проверка(СтрНайти(Ответ, "3.0.72.1") > 0, "Версия из черновика в тексте");
	Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьЗаполните").ТекущаяВидимость(), "Надписи «Заполните» нет");
	Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьНеИзменён").ТекущаяВидимость(), "Надписи «ИИ не изменил текст» нет");

	Лог("");
	Лог("== Строка в табель (С16)");
	ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяКон"), "10:00", "ТипВремени");
	Добавить = НайтиКнопку(ФормаОкна, "Добавить в табель");
	Проверка(Добавить.ТекущаяДоступность(), "«Добавить в табель» доступна");
	Добавить.Нажать();
	Проверка(ФормаОкна.ОжидатьЗакрытие(60), "Окно закрылось после «Добавить в табель»");
	Пауза(2);
	// У задачи нет компании CRM: выбор контрагента сам не открывается (Ф5), контрагент вводится в ячейку руками.
	Проверка(ВвестиКонтрагентаВручную(Табель, Таблица),
		"После добавления выбор контрагента сам не открылся, контрагент введён в ячейку");
	Табель.Активизировать();
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 1, "В табеле одна строка");
	Если Строки.Количество() = 1 Тогда
		ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), Обновление, "ID Б24 строки");
		ПроверитьТекст(Ячейка(Строки[0], "Содержание"), Ответ, "Содержание строки — текст поля");
	КонецЕсли;

КонецПроцедуры

// Нажимает «Заполнить с помощью ИИ» и ждёт, пока уйдёт надпись «ИИ составляет содержание…». Истина — ответ получен
// без сообщения об ошибке.
&НаКлиенте
Функция НажатьИИ(ФормаОкна)

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	НайтиКнопку(ФормаОкна, "Заполнить с помощью ИИ").Нажать();
	Ожидание = НайтиДекорацию(ФормаОкна, "НадписьОжиданияИИ");
	Конец = ТекущаяДата() + 90;
	Пока ТекущаяДата() < Конец И Ожидание.ТекущаяВидимость() Цикл
		Пауза(1);
	КонецЦикла;
	Секунд = Формат((ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000, "ЧДЦ=1; ЧГ=0");
	Проверка(Не Ожидание.ТекущаяВидимость(), "Ответ ИИ пришёл за " + Секунд + " с");
	Сообщение = НайтиДекорацию(ФормаОкна, "НадписьСообщенияИИ");
	Если Сообщение.ТекущаяВидимость() Тогда
		Проверка(Ложь, "Сообщение под полем: «" + ТекстМетки(Сообщение) + "»");
		Возврат Ложь;
	КонецЕсли;
	Возврат Не Ожидание.ТекущаяВидимость();

КонецФункции

&НаКлиенте
Функция КнопкаВидна(Форма, Заголовок)

	Кнопка = НайтиКнопку(Форма, Заголовок);
	Возврат Кнопка <> Неопределено И Кнопка.ТекущаяВидимость();

КонецФункции

// Форма настроек (С22) и право «Чат и уведомления» (С29). Форма ничего не записывает: изменения вводятся и закрываются без
// записи (запись с удалённым ключом стёрла бы ключ разработки). Нужны ИИ, включённый ключом разработки. Окна при других
// настройках ИИ проверяет сценарий «ии-отказы»: в одном клиенте с формой настроек обработчики ожидания окон
// срабатывали ненадёжно, поэтому клиент для них свежий.
&НаКлиенте
Процедура СценарийИИНастройки()

	Исходные = ТекущиеНастройкиИИ();
	Проверка(Исходные.ИИДоступен, "Перед проверкой ИИ в базе доступен (флажок включён, ключ сохранён)");
	Если Не Исходные.ИИДоступен Тогда
		Возврат;
	КонецЕсли;

	Попытка
		ПроверитьФормуНастроек();
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Проверка(ТекущиеНастройкиИИ().ИИДоступен, "После проверки ИИ в базе по-прежнему доступен");
	ПроверитьТекст(ТекущиеНастройкиИИ().МодельИИ, Исходные.МодельИИ, "Модель как была");

КонецПроцедуры

// Форма настроек: закладка «ИИ для содержания» (С22) и право «Чат и уведомления» (С29).
&НаКлиенте
Процедура ПроверитьФормуНастроек()

	Лог("");
	Лог("== Форма настроек (С22)");
	Форма = ОткрытьФормуНастроек();
	Если Форма = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		НайтиГруппу(Форма, "СтраницаИИ").Активизировать();
		Пауза(1);

		Метка = ТекстМетки(НайтиДекорацию(Форма, "НадписьСохранённогоКлюча"));
		Начало = "Ключ сохранён: sk-…";
		Проверка(СтрНачинаетсяС(Метка, Начало) И СтрДлина(Метка) = СтрДлина(Начало) + 4,
			"Под полем ключа «Ключ сохранён: sk-…» и 4 последних знака");
		ПроверитьТекст(ТекстПоля(НайтиПоле(Форма, "НовыйКлючOpenAI")), "", "Поле нового ключа пустое");
		Проверка(ЧислоВхожденийКлючаВТекстах(ТекстыФормы(Форма)) = 0, "Ключа OpenAI нет ни в одном поле и надписи формы");

		Лог("");
		Лог("== Проверить ИИ (Ф13)");
		Модель = ТекстПоля(НайтиПоле(Форма, "МодельИИ"));
		Результат = ПроверитьИИВФорме(Форма);
		Проверка(СтрНачинаетсяС(Результат, "ИИ отвечает. Модель: "), "Сохранённый ключ: «" + Результат + "»");
		ВвестиВПолеФормы(Форма, "НовыйКлючOpenAI", "sk-test-wrong-key-0000000000");
		ПроверитьТекст(ПроверитьИИВФорме(Форма), "OpenAI отклоняет ключ.", "Набранный неверный ключ");
		ВвестиВПолеФормы(Форма, "НовыйКлючOpenAI", "ключ-не-тот");
		ПроверитьТекст(ПроверитьИИВФорме(Форма), "Ключ OpenAI должен начинаться с sk- и не содержать пробелов и русских букв",
			"Ключ неверного вида");
		ВвестиВПолеФормы(Форма, "НовыйКлючOpenAI", " ");
		ВвестиВПолеФормы(Форма, "МодельИИ", "gpt-no-such-model");
		ПроверитьТекст(ПроверитьИИВФорме(Форма), "Модель gpt-no-such-model недоступна для этого ключа.", "Несуществующая модель");
		ВвестиВПолеФормы(Форма, "МодельИИ", Модель);

		Лог("");
		Лог("== Удалить ключ (С22)");
		НайтиКнопку(Форма, "Удалить ключ").Нажать();
		Пауза(1);
		ПроверитьТекст(ТекстМетки(НайтиДекорацию(Форма, "НадписьСохранённогоКлюча")), "Не указан", "После «Удалить ключ»");
		Проверка(Не НайтиКнопку(Форма, "Удалить ключ").ТекущаяДоступность(), "«Удалить ключ» больше не доступна");
		ПроверитьТекст(ПроверитьИИВФорме(Форма), "Не указан ключ OpenAI.", "«Проверить ИИ» без ключа");
		// «Записать и закрыть» с удалённым ключом здесь не нажимается: запись стёрла бы ключ разработки. Отказ записи по
		// флажку без ключа проверяют тесты (ЗаписьИИ_*, б24тТест_НастройкиФормаКлиент).
		Лог("Флажок «Использовать ИИ» после «Удалить ключ»: «" + ТекстПоля(НайтиПоле(Форма, "ИспользоватьИИ")) + "»");
		Проверка(ТекущиеНастройкиИИ().ИИДоступен, "Форма не записана: ИИ в базе по-прежнему доступен (ключ на месте)");

		Лог("");
		Лог("== Проверить подключение: право «Чат и уведомления» (С29)");
		НайтиГруппу(Форма, "СтраницаБитрикс24").Активизировать();
		Пауза(1);
		НайтиКнопку(Форма, "Проверить подключение").Нажать();
		Кнопка = НайтиКнопку(Форма, "Проверить подключение");
		Конец = ТекущаяДата() + 60;
		Пока ТекущаяДата() < Конец И Не Кнопка.ТекущаяДоступность() Цикл
			Пауза(1);
		КонецЦикла;
		Проверка(СтрНайти(ТекстМетки(НайтиДекорацию(Форма, "НадписьРезультатаПроверки")), "Чат и уведомления — есть") > 0,
			"Проверка подключения показывает «Чат и уведомления — есть»");
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Диагностика();
	КонецПопытки;
	ЗакрытьФормуНастроекБезЗаписи(Форма);

КонецПроцедуры

// Окна «Заполнить из задачи» при разных настройках ИИ (С20, С21): флажок снят, флажок сняли при открытом окне, OpenAI
// отказывает (модель, которой нет), нет связи с OpenAI (локальный прокси scripts/block-proxy.py, параметр proxy). Настройки
// базы, которые сценарий меняет (флажок, модель, прокси пользователя), возвращаются в любом случае; ключ не трогается.
&НаКлиенте
Процедура СценарийИИОтказы()

	Если Не ЕстьЗадачи("aiNoValue") Тогда
		Возврат;
	КонецЕсли;
	Исходные = ТекущиеНастройкиИИ();
	Проверка(Исходные.ИИДоступен, "Перед проверкой ИИ в базе доступен (флажок включён, ключ сохранён)");
	Если Не Исходные.ИИДоступен Тогда
		Возврат;
	КонецЕсли;

	Попытка
		Табель = ОткрытьНовыйТабель();
		Если Табель <> Неопределено Тогда
			ПроверитьОкноСОтключённымИИ(Табель, Исходные);
			ПроверитьНеверныйКлючВОкне(Табель, Исходные);
			ПроверитьНетСвязиСOpenAI(Табель);
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Лог("");
	Лог("== Настройки возвращаются");
	Лог(СнятьПроксиДляПроверки());
	Лог(ЗаписатьНастройкиИИ(Новый Структура("ИспользоватьИИ, МодельИИ", Исходные.ИспользоватьИИ, Исходные.МодельИИ)));
	Проверка(ТекущиеНастройкиИИ().ИИДоступен, "После проверки ИИ в базе снова доступен");
	ПроверитьТекст(ТекущиеНастройкиИИ().МодельИИ, Исходные.МодельИИ, "Модель как была");

КонецПроцедуры

// С20: флажок снят — окно как до доработки; флажок сняли при открытом окне — «ИИ не настроен…», ничего не уходит.
&НаКлиенте
Процедура ПроверитьОкноСОтключённымИИ(Табель, Исходные)

	Лог("");
	Лог("== Флажок «Использовать ИИ» снят (С20)");
	Лог(ЗаписатьНастройкиИИ(Новый Структура("ИспользоватьИИ", Ложь)));
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна <> Неопределено Тогда
		Проверка(Не КнопкаВидна(ФормаОкна, "Заполнить с помощью ИИ"), "Кнопки «Заполнить с помощью ИИ» в окне нет");
		Проверка(Не КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "Кнопки «Вернуть прежний текст» нет");
		ВвестиНомерЗадачи(ФормаОкна, НомераЗадач["aiNoValue"]);
		ЗакрытьОкно(ФормаОкна);
	КонецЕсли;

	Лог("");
	Лог("== ИИ выключили, пока окно открыто (Ф13)");
	Лог(ЗаписатьНастройкиИИ(Новый Структура("ИспользоватьИИ", Истина)));
	ФормаОкна = ОткрытьОкноСЗадачей(Табель, НомераЗадач["aiNoValue"]);
	Если ФормаОкна <> Неопределено Тогда
		Проверка(КнопкаВидна(ФормаОкна, "Заполнить с помощью ИИ"), "ИИ включён: кнопка в окне есть");
		Лог(ЗаписатьНастройкиИИ(Новый Структура("ИспользоватьИИ", Ложь)));
		Пауза(2);
		ДоНажатия = ЧислоЗаписейЖурнала("Обращение") + ЧислоЗаписейЖурнала("Содержание");
		Сообщение = НажатьИИОжидаяСообщение(ФормаОкна);
		ПроверитьТекст(Сообщение, "ИИ не настроен. Обратитесь к администратору", "Нажатие после выключения ИИ");
		Проверка(ЧислоЗаписейЖурнала("Обращение") + ЧислоЗаписейЖурнала("Содержание") = ДоНажатия,
			"После нажатия новых обращений к Битрикс24 и OpenAI в журнале нет");
		ЗакрытьОкно(ФормаОкна);
	КонецЕсли;
	Лог(ЗаписатьНастройкиИИ(Новый Структура("ИспользоватьИИ", Исходные.ИспользоватьИИ)));

КонецПроцедуры

// С21: OpenAI отказывает по-настоящему (модель, которой нет): «ИИ не настроен…», текст поля не меняется. Модель
// возвращается в любом случае (сценарий возвращает её и сам, и «восстановить»).
&НаКлиенте
Процедура ПроверитьНеверныйКлючВОкне(Табель, Исходные)

	Лог("");
	Лог("== OpenAI отказывает (несуществующая модель, С21)");
	Лог(ЗаписатьНастройкиИИ(Новый Структура("МодельИИ", "gpt-test-missing-model")));
	ФормаОкна = ОткрытьОкноСЗадачей(Табель, НомераЗадач["aiNoValue"]);
	Если ФормаОкна <> Неопределено Тогда
		Содержание = НайтиПоле(ФормаОкна, "Содержание");
		Название = ТекстПоля(Содержание);
		ПроверитьТекст(НажатьИИОжидаяСообщение(ФормаОкна), "ИИ не настроен. Обратитесь к администратору",
			"Сообщение под полем");
		ПроверитьТекст(ТекстПоля(Содержание), Название, "Текст поля не изменился");
		Проверка(Не КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "«Вернуть прежний текст» не появилась");
		Проверка(НайтиКнопку(ФормаОкна, "Заполнить с помощью ИИ").ТекущаяДоступность(), "Кнопка ИИ снова доступна");
		ЗакрытьОкно(ФормаОкна);
	КонецЕсли;
	Лог(ЗаписатьНастройкиИИ(Новый Структура("МодельИИ", Исходные.МодельИИ)));

КонецПроцедуры

// С21: нет связи с OpenAI. Запросы к api.openai.com идут через локальный прокси, который обрывает только их; портал
// проходит насквозь. Сообщение «ИИ недоступен…», текст поля не меняется, строка добавляется с текстом, набранным вручную.
&НаКлиенте
Процедура ПроверитьНетСвязиСOpenAI(Табель)

	Лог("");
	Лог("== Нет связи с OpenAI (С21)");
	Порт = Число(НастройкиЗапуска.proxy);
	Если Порт = 0 Тогда
		Проверка(Ложь, "Скрипт запустил локальный прокси и передал порт (параметр proxy)");
		Возврат;
	КонецЕсли;
	Результат = УстановитьПроксиДляПроверки(Порт);
	Лог(Результат);
	Если СтрНачинаетсяС(Результат, "ОШИБКА") Тогда
		Проверка(Ложь, Результат);
		Возврат;
	КонецЕсли;
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Попытка
		ФормаОкна = ОткрытьОкноСЗадачей(Табель, НомераЗадач["aiNoValue"]);
		Если ФормаОкна <> Неопределено Тогда
			Содержание = НайтиПоле(ФормаОкна, "Содержание");
			Название = ТекстПоля(Содержание);
			ПроверитьТекст(НажатьИИОжидаяСообщение(ФормаОкна), "ИИ недоступен. Заполните содержание вручную",
				"Сообщение под полем");
			ПроверитьТекст(ТекстПоля(Содержание), Название, "Текст поля не изменился");
			Проверка(Не КнопкаВидна(ФормаОкна, "Вернуть прежний текст"), "«Вернуть прежний текст» не появилась");

			Лог("");
			Лог("== Строка с текстом, набранным вручную (С21)");
			ВвестиИЗавершить(ФормаОкна, Содержание, "Установка 1С-Коннект на ПК Анны.", "ТипВремени");
			ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяНач"), "09:00", "Содержание");
			ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяКон"), "09:30", "Содержание");
			Добавить = НайтиКнопку(ФормаОкна, "Добавить в табель");
			Проверка(Добавить.ТекущаяДоступность(), "«Добавить в табель» доступна");
			Добавить.Нажать();
			Проверка(ФормаОкна.ОжидатьЗакрытие(60), "Окно закрылось после «Добавить в табель»");
			Пауза(2);
			Проверка(ВвестиКонтрагентаВручную(Табель, Таблица),
				"После добавления выбор контрагента сам не открылся, контрагент введён в ячейку");
			Табель.Активизировать();
			Строки = СтрокиТаблицы(Таблица);
			Проверка(Строки.Количество() = 1, "В табеле одна строка");
			Если Строки.Количество() = 1 Тогда
				ПроверитьТекст(Ячейка(Строки[0], "Содержание"), "Установка 1С-Коннект на ПК Анны.", "Содержание строки — текст, набранный вручную");
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Лог(СнятьПроксиДляПроверки());

	ЕстьНетОтвета = Ложь;
	Для Каждого Запись Из ЗаписиЖурнала(Дата(НастройкиЗапуска.since)) Цикл
		ЕстьНетОтвета = ЕстьНетОтвета Или СтрНайти(Запись, "Содержание:") > 0 И СтрНайти(Запись, "нет ответа") > 0;
	КонецЦикла;
	Проверка(ЕстьНетОтвета, "В журнале запись о запросе к OpenAI без ответа");

КонецПроцедуры

// ИИ в окне под «[ТЕСТ] Сотрудник» без полных прав (--user): кнопка видна и работает, строка добавляется. Пользователь
// связывается с физическим лицом администратора, как на последнем шаге сценария «сотрудник»; база возвращается в любом
// случае.
&НаКлиенте
Процедура СценарийИИСотрудник()

	// Своя задача с компанией CRM: контрагент находится сам, окно выбора контрагента не открывается (у «[ТЕСТ] Сотрудник» нет
	// права читать константу «ИспользоватьПроверкуКонтрагентов», которую читает типовая форма выбора контрагента).
	Если Не ЕстьЗадачи("ownDalstroy") Тогда
		Возврат;
	КонецЕсли;
	Обновление = НомераЗадач["ownDalstroy"];
	Комментарий = "[ТЕСТ] ui-check ии-сотрудник";
	Проект = Число(НастройкиЗапуска.project);
	ВосстановитьБазу(Комментарий, Проект);
	Данные = ПодготовитьСотрудника(Комментарий);
	Если Данные.Ошибка <> "" Тогда
		Проверка(Ложь, Данные.Ошибка);
		Возврат;
	КонецЕсли;

	Попытка
		Лог("");
		Лог("== Пользователь связан с физическим лицом администратора");
		ИзменитьБазуСотрудника("связать-с-администратором");
		Пауза(25);
		Табель = ОткрытьНовыйТабель();
		Если Табель <> Неопределено Тогда
			ФормаОкна = ОткрытьОкноСЗадачей(Табель, Обновление);
			Если ФормаОкна <> Неопределено Тогда
				Проверка(КнопкаВидна(ФормаОкна, "Заполнить с помощью ИИ"), "Кнопка «Заполнить с помощью ИИ» видна обычному сотруднику");
				Содержание = НайтиПоле(ФормаОкна, "Содержание");
				ВвестиИЗавершить(ФормаОкна, Содержание, "обновил бк до 3.0.72.1", "ТипВремени");
				Если НажатьИИ(ФормаОкна) Тогда
					Ответ = ТекстПоля(Содержание);
					Лог("Ответ ИИ: «" + Ответ + "»");
					Проверка(СтрНайти(Ответ, "3.0.72.1") > 0, "Версия из черновика в тексте");
					ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяКон"), "10:00", "ТипВремени");
					Добавить = НайтиКнопку(ФормаОкна, "Добавить в табель");
					Проверка(Добавить.ТекущаяДоступность(), "«Добавить в табель» доступна");
					Добавить.Нажать();
					Проверка(ФормаОкна.ОжидатьЗакрытие(60), "Окно закрылось после «Добавить в табель»");
					Пауза(2);
					Проверка(Не ЕстьОкноВыбораКонтрагента(), "Контрагент найден по компании CRM: выбор контрагента не открыт");
					Табель.Активизировать();
					Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
					Строки = СтрокиТаблицы(Таблица);
					Проверка(Строки.Количество() = 1, "В табеле одна строка");
					Если Строки.Количество() = 1 Тогда
						ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), Обновление, "ID Б24 строки");
						Проверка(СтрНайти(НРег(Ячейка(Строки[0], "Контрагент")), "дальстрой") > 0, "Контрагент по компании CRM: «"
							+ Ячейка(Строки[0], "Контрагент") + "»");
						ПроверитьТекст(Ячейка(Строки[0], "Содержание"), Ответ, "Содержание строки — текст поля");
					КонецЕсли;
				Иначе
					ЗакрытьОкно(ФормаОкна);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВосстановитьБазу(Комментарий, Проект);
	Лог("База восстановлена: пользователь «[ТЕСТ] Сотрудник» без физического лица, табели сценария удалены");

КонецПроцедуры

#Область ПомощникиИИ

// Форма настроек по навигационной ссылке общей формы.
&НаКлиенте
Функция ОткрытьФормуНастроек()

	ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
	ОкноПриложения.ВыполнитьКоманду("e1cib/app/ОбщаяФорма.б24т_НастройкиИнтеграции");
	Форма = ЖдатьФорму("Настройки интеграции с Битрикс24", 60);
	Если Форма = Неопределено Тогда
		Проверка(Ложь, "Форма настроек открылась");
		Диагностика();
	КонецЕсли;
	Возврат Форма;

КонецФункции

// Нажимает «Проверить ИИ» и ждёт результат под кнопками. Опрашивается одна только кнопка: после проверки она снова
// доступна (проверено: если опрашивать надпись результата, обработчик ожидания формы молчит до конца ожидания).
&НаКлиенте
Функция ПроверитьИИВФорме(Форма)

	НайтиКнопку(Форма, "Проверить ИИ").Нажать();
	Кнопка = НайтиКнопку(Форма, "Проверить ИИ");
	Конец = ТекущаяДата() + 60;
	Пока ТекущаяДата() < Конец И Не Кнопка.ТекущаяДоступность() Цикл
		Пауза(1);
	КонецЦикла;
	Возврат ТекстМетки(НайтиДекорацию(Форма, "НадписьРезультатаПроверкиИИ"));

КонецФункции

// Поле меняется текстом и подтверждается переходом в другое поле формы. Пробел очищает поле (пустая строка поле не
// меняет).
&НаКлиенте
Процедура ВвестиВПолеФормы(Форма, Имя, Текст)

	Поле = НайтиПоле(Форма, Имя);
	Поле.Активизировать();
	Поле.ВвестиТекст(?(Текст = "", " ", Текст));
	НайтиПоле(Форма, ?(Имя = "МодельИИ", "НовыйКлючOpenAI", "МодельИИ")).Активизировать();
	Пауза(1);

КонецПроцедуры

// Тексты всех полей и надписей формы (для поиска в них ключа).
&НаКлиенте
Функция ТекстыФормы(Форма)

	Тексты = Новый Массив;
	Для Каждого Поле Из Форма.НайтиОбъекты(Тип("ТестируемоеПолеФормы")) Цикл
		Попытка
			Тексты.Добавить(ТекстПоля(Поле));
		Исключение
		КонецПопытки;
	КонецЦикла;
	Для Каждого Метка Из Форма.НайтиОбъекты(Тип("ТестируемаяДекорацияФормы")) Цикл
		Попытка
			Тексты.Добавить(Метка.ТекстЗаголовка);
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Тексты;

КонецФункции

// Закрывает форму настроек, ничего не записывая. Если форма изменена, платформа спрашивает, сохранять ли изменения:
// отвечаем «Не сохранять» (в отчёте названия кнопок вопроса).
&НаКлиенте
Процедура ЗакрытьФормуНастроекБезЗаписи(Форма)

	Попытка
		НайтиКнопку(Форма, "Закрыть").Нажать();
	Исключение
		Лог("Кнопка «Закрыть» не нажалась: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Форма.ОжидатьЗакрытие(5) Тогда
		Проверка(Истина, "Форма настроек закрылась без вопроса");
		Возврат;
	КонецЕсли;

	Названия = Новый Массив;
	Нажата = Ложь;
	Для Каждого ФормаВопроса Из Приложение.НайтиОбъекты(Тип("ТестируемаяФорма")) Цикл
		Если СтрНачинаетсяС(ФормаВопроса.ТекстЗаголовка, "Настройки интеграции") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Кнопка Из ФормаВопроса.НайтиОбъекты(Тип("ТестируемаяКнопкаФормы")) Цикл
			Названия.Добавить(Кнопка.ТекстЗаголовка);
			Если Не Нажата И (Кнопка.ТекстЗаголовка = "Не сохранять" Или Кнопка.ТекстЗаголовка = "Нет"
				Или Кнопка.ТекстЗаголовка = "Не записывать") Тогда
				Кнопка.Нажать();
				Нажата = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Лог("Кнопки вопроса при закрытии: " + СтрСоединить(Названия, " | "));
	Проверка(Нажата И Форма.ОжидатьЗакрытие(15), "Форма настроек закрыта без записи");

КонецПроцедуры

// Нажимает «Заполнить с помощью ИИ» и возвращает сообщение под полем (пусто, если сообщения нет). Для случаев, когда
// ответа ИИ не будет.
&НаКлиенте
Функция НажатьИИОжидаяСообщение(ФормаОкна)

	НайтиКнопку(ФормаОкна, "Заполнить с помощью ИИ").Нажать();
	Ожидание = НайтиДекорацию(ФормаОкна, "НадписьОжиданияИИ");
	// Как в НажатьИИ: пока тестовый клиент опрашивает одну только надпись ожидания, обработчик ожидания окна срабатывает;
	// если опрашивать ещё и надпись сообщения, он молчит до конца ожидания (проверено).
	Конец = ТекущаяДата() + 90;
	Пока ТекущаяДата() < Конец И Ожидание.ТекущаяВидимость() Цикл
		Пауза(1);
	КонецЦикла;
	Сообщение = НайтиДекорацию(ФормаОкна, "НадписьСообщенияИИ");
	Возврат ?(Сообщение.ТекущаяВидимость(), ТекстМетки(Сообщение), "");

КонецФункции

// Сколько записей журнала с начала запуска содержат подстроку.
&НаКлиенте
Функция ЧислоЗаписейЖурнала(Подстрока)

	Найдено = 0;
	Для Каждого Запись Из ЗаписиЖурнала(Дата(НастройкиЗапуска.since)) Цикл
		Если СтрНайти(Запись, Подстрока) > 0 Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

// Настройки ИИ в базе: ИИДоступен (флажок, ключ и блокировка копии), ИспользоватьИИ, МодельИИ (как в форме).
&НаСервереБезКонтекста
Функция ТекущиеНастройкиИИ()

	Данные = б24т_Настройки.ДанныеФормыНастроек();
	Результат = Новый Структура;
	Результат.Вставить("ИИДоступен", б24т_Настройки.Настройки().ИИДоступен);
	Результат.Вставить("ИспользоватьИИ", Данные.ИспользоватьИИ);
	Результат.Вставить("МодельИИ", Данные.МодельИИ);
	Возврат Результат;

КонецФункции

// Меняет свойства настроек ИИ; того, чего нет в Свойства, запись не меняет (ключ в том числе). Поля Битрикс24 берутся
// из текущих настроек. Строка для отчёта.
&НаСервереБезКонтекста
Функция ЗаписатьНастройкиИИ(Свойства)

	Текущие = б24т_Настройки.Настройки();
	Изменения = Новый Структура;
	Изменения.Вставить("НовыйАдрес", "");
	Изменения.Вставить("УдалитьАдрес", Ложь);
	Изменения.Вставить("РежимТестирования", Текущие.РежимТестирования);
	Изменения.Вставить("ПроектДляТестирования", Текущие.ПроектДляТестирования);
	Имена = Новый Массив;
	Для Каждого Свойство Из Свойства Цикл
		Изменения.Вставить(Свойство.Ключ, Свойство.Значение);
		Имена.Добавить(Свойство.Ключ);
	КонецЦикла;
	Ошибки = б24т_Настройки.ЗаписатьНастройки(Изменения);
	Если Ошибки.Количество() > 0 Тогда
		Возврат "ОШИБКА записи настроек: " + Ошибки[0].Текст;
	КонецЕсли;
	Возврат "Настройки ИИ записаны: " + СтрСоединить(Имена, ", ");

КонецФункции

// Сколько раз ключ OpenAI из хранилища найден в текстах (сам ключ наружу не выходит).
&НаСервереБезКонтекста
Функция ЧислоВхожденийКлючаВТекстах(Тексты)

	Возврат б24тТест_ПроверкаУтечки.ЧислоВхожденийКлючаOpenAI(Тексты);

КонецФункции

// Формулировка для С23: период — вчера, в справочнике её нет, пока сценарий не добавит.
&НаСервереБезКонтекста
Процедура ДобавитьТестовуюФормулировку()

	Менеджер = РегистрыСведений.ГЕМ_ШаблоныДляЗаполненияТабелей.СоздатьМенеджерЗаписи();
	Менеджер.Период = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	Менеджер.Шифр = "[ТЕСТ] Этикетки";
	Менеджер.Описание = "Настройка печати этикеток на термопринтере (модель принтера).";
	Менеджер.Записать();

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьТестовуюФормулировку()

	Набор = РегистрыСведений.ГЕМ_ШаблоныДляЗаполненияТабелей.СоздатьНаборЗаписей();
	Набор.Отбор.Шифр.Установить("[ТЕСТ] Этикетки");
	Набор.Записать();

КонецПроцедуры

// Прокси пользователя на время проверки «нет связи с OpenAI»: все соединения идут на локальный прокси, он обрывает
// только openai.com (scripts/block-proxy.py). Чужой прокси пользователя сценарий не трогает.
&НаСервереБезКонтекста
Функция УстановитьПроксиДляПроверки(Порт)

	Прежние = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкаПроксиСервера", "");
	Если Прежние <> Неопределено И Прежние["ИспользоватьПрокси"] = Истина И Прежние["Сервер"] <> "127.0.0.1" Тогда
		Возврат "ОШИБКА: у пользователя уже задан свой прокси, сценарий его не трогает";
	КонецЕсли;
	Настройка = Новый Соответствие;
	Настройка.Вставить("ИспользоватьПрокси", Истина);
	Настройка.Вставить("ИспользоватьСистемныеНастройки", Ложь);
	Настройка.Вставить("Сервер", "127.0.0.1");
	Настройка.Вставить("Порт", Порт);
	Настройка.Вставить("Пользователь", "");
	Настройка.Вставить("Пароль", "");
	Настройка.Вставить("НеИспользоватьПроксиДляЛокальныхАдресов", Ложь);
	Настройка.Вставить("НеИспользоватьПроксиДляАдресов", Новый Массив);
	Настройка.Вставить("ИспользоватьАутентификациюОС", Ложь);
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("НастройкаПроксиСервера", "", Настройка);
	Возврат "Прокси для проверки включён, порт " + Формат(Порт, "ЧГ=0");

КонецФункции

&НаСервереБезКонтекста
Функция СнятьПроксиДляПроверки()

	Текущие = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("НастройкаПроксиСервера", "");
	Если Текущие <> Неопределено И Текущие["Сервер"] = "127.0.0.1" Тогда
		ОбщегоНазначения.ХранилищеОбщихНастроекУдалить("НастройкаПроксиСервера", "", Неопределено);
		Возврат "Прокси для проверки снят";
	КонецЕсли;
	Возврат "Прокси для проверки не задан";

КонецФункции

// Возвращает базу после прерванного прогона «ии-настройки»: прокси проверки, «[ТЕСТ]»-формулировка, модель с тестовым
// именем, флажок «Использовать ИИ» (включается, если ключ сохранён).
&НаСервереБезКонтекста
Функция ВосстановитьНастройкиИИ()

	Результат = Новый Массив;
	Результат.Добавить(СнятьПроксиДляПроверки());
	УдалитьТестовуюФормулировку();
	Данные = б24т_Настройки.ДанныеФормыНастроек();
	Свойства = Новый Структура;
	Если СтрНачинаетсяС(Данные.МодельИИ, "gpt-test-") Или Данные.МодельИИ = "gpt-no-such-model" Тогда
		Свойства.Вставить("МодельИИ", "");
	КонецЕсли;
	Если Не Данные.ИспользоватьИИ И Не ПустаяСтрока(Данные.ПредставлениеКлюча) Тогда
		Свойства.Вставить("ИспользоватьИИ", Истина);
	КонецЕсли;
	Если Свойства.Количество() > 0 Тогда
		Результат.Добавить(ЗаписатьНастройкиИИ(Свойства));
	КонецЕсли;
	Возврат СтрСоединить(Результат, "; ");

КонецФункции

#КонецОбласти

// Поиск в списке задач: текст в поле поиска не должен пропадать, пока список сокращается.
&НаКлиенте
Процедура СценарийПоиск()

	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24").Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Или Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат;
	КонецЕсли;
	Поиск = НайтиПоле(ФормаОкна, "ТекстПоиска");
	Для Каждого Текст Из СтрРазделить("без; без компании;ё;несуществующее", ";") Цикл
		Поиск.Активизировать();
		Поиск.ВвестиТекст(Текст);
		Пауза(3);
		Отображаемый = "?";
		Попытка
			Отображаемый = Поиск.ПолучитьОтображаемыйТекст();
		Исключение
			Отображаемый = "ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Представление = "?";
		Попытка
			Представление = Поиск.ПолучитьПредставлениеДанных();
		Исключение
			Представление = "ошибка: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		Лог("  отображаемый текст: «" + Отображаемый + "», представление данных: «" + Представление + "», строк в списке: "
			+ СтрокиТаблицы(НайтиТаблицу(ФормаОкна, "СписокЗадач")).Количество());
		Поиск.Активизировать();
		ПроверитьТекст(ТекстПоля(Поиск), Текст, "Текст в поле поиска после ввода «" + Текст + "»");
		Лог("  страница списка: " + НайтиГруппу(ФормаОкна, "СтраницыСписка").ПолучитьТекущуюСтраницу().Имя);
	КонецЦикла;

КонецПроцедуры

// Чужой табель (С8): тестовый клиент запущен под обычным сотрудником (--user «[ТЕСТ] Сотрудник»), табель создан
// администратором от своего имени. Автор — не этот сотрудник и полных прав у него нет, поэтому «Добавить» недоступна,
// а вместе с ней недоступна и «Заполнить из задачи Б24».
&НаКлиенте
Процедура СценарийЧужой()

	Комментарий = "[ТЕСТ] ui-check чужой";
	УдалитьТабелиСценария(Комментарий);
	Данные = НовыйЧужойТабель(Комментарий);
	Лог("== Чужой табель «" + Данные.Представление + "»");
	Попытка
		ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
		ОкноПриложения.ВыполнитьКоманду(Данные.Навигация);
		Табель = ЖдатьФорму(Данные.Представление, 60);
		Если Табель = Неопределено Тогда
			Проверка(Ложь, "Чужой табель открылся");
			Диагностика();
		Иначе
			Табель.Активизировать();
			Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
			Панель = Таблица.ПолучитьКоманднуюПанель();
			Заполнить = Панель.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24");
			Проверка(Заполнить <> Неопределено, "Кнопка «Заполнить из задачи Б24» есть в панели таблицы");
			// ТекущаяДоступность() кнопки не учитывает выключенную родительскую панель: недоступность проверяется по
			// панели и по тому, что платформа отклоняет нажатие.
			Проверка(Не Панель.ТекущаяДоступность(), "Панель таблицы выключена (не автор без полных прав)");
			Проверка(Заполнить <> Неопределено И НажатиеОтклонено(Заполнить),
				"Не автору без полных прав «Заполнить из задачи Б24» недоступна: платформа отклоняет нажатие");
			Проверка(Не Приложение.ОжидатьОтображениеОбъекта(Тип("ТестируемаяФорма"), "Заполнить из задачи Битрикс24", , 3),
				"Окно «Заполнить из задачи Битрикс24» не открылось");
			Добавить = Панель.НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Добавить");
			Проверка(Добавить <> Неопределено, "Кнопка «Добавить» есть в панели таблицы");
			Проверка(Добавить <> Неопределено И НажатиеОтклонено(Добавить),
				"Не автору без полных прав «Добавить» недоступна: платформа отклоняет нажатие");
			Проверка(Не Табель.ТекущаяМодифицированность(), "Табель не изменён");
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	// Форма остаётся открытой: тестовый клиент завершается вместе со сценарием.
	УдалитьТабелиСценария(Комментарий);

КонецПроцедуры

// Список задач (С2 — задача по номеру и ссылке, С3): состав, колонки, сортировки, поиск, выбор щелчком, граница 30 дней.
&НаКлиенте
Процедура СценарийСписок()

	Все = "dalstroy,arkharov,dalstroy2,norq,nobin,kikinda,dup,twoCompanies,noCompany,observer,outside,ownDalstroy,ownNoCompany";
	Если Не ЕстьЗадачи(Все) Тогда
		Возврат;
	КонецЕсли;

	Лог("== Состав списка");
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Видимые = СтрРазделить("dalstroy,arkharov,dalstroy2,norq,nobin,kikinda,dup,twoCompanies,noCompany,ownDalstroy,ownNoCompany", ",");
	Строки = СтрокиСписка(ФормаОкна);
	Проверка(Строки.Количество() = Видимые.Количество(), "В списке " + Видимые.Количество() + " задач (девять задач набора и две свои): "
		+ Строки.Количество());
	Для Каждого Ключ Из Видимые Цикл
		Проверка(СтрокаЗадачи(Строки, Ключ) <> Неопределено, "В списке есть задача " + Ключ);
	КонецЦикла;
	Проверка(СтрокаЗадачи(Строки, "observer") = Неопределено, "В списке нет задачи, где сотрудник только наблюдатель");
	Проверка(СтрокаЗадачи(Строки, "outside") = Неопределено, "В списке нет задачи вне проекта (режим тестирования)");

	Лог("");
	Лог("== Колонки");
	ПроверитьТекст(НРег(Ячейка(СтрокаЗадачи(Строки, "arkharov"), "Моя роль")), "исполнитель", "Моя роль у задачи arkharov");
	ПроверитьТекст(НРег(Ячейка(СтрокаЗадачи(Строки, "ownDalstroy"), "Моя роль")), "постановщик, исполнитель",
		"Моя роль у своей задачи");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "dalstroy"), "Статус"), "Завершена", "Статус завершённой задачи");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "arkharov"), "Статус"), "Ждёт выполнения", "Статус открытой задачи");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "dalstroy"), "Компания CRM"), "[ТЕСТ] Дальстрой", "Компания CRM");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "twoCompanies"), "Компания CRM"), "2 компании", "Компаний две");
	ПроверитьТекст(Ячейка(СтрокаЗадачи(Строки, "noCompany"), "Компания CRM"), "—", "Компании нет");
	СоСроком = СтрРазделить("arkharov,dalstroy2,kikinda", ",");
	// Портал сам ставит срок «завтра 19:00» задачам, созданным без срока: у остальных задач он одинаковый и раньше трёх своих.
	ОбщийСрок = Ячейка(СтрокаЗадачи(Строки, "norq"), "Крайний срок");
	Проверка(ОбщийСрок <> "" И ОбщийСрок <> "без срока", "У задач без заданного срока срок портала по умолчанию: «" + ОбщийСрок + "»");
	Для Каждого Ключ Из Видимые Цикл
		Срок = Ячейка(СтрокаЗадачи(Строки, Ключ), "Крайний срок");
		Если СоСроком.Найти(Ключ) <> Неопределено Тогда
			Проверка(Срок <> ОбщийСрок И Срок <> "", "У задачи " + Ключ + " свой срок: «" + Срок + "»");
		Иначе
			ПроверитьТекст(Срок, ОбщийСрок, "Срок задачи " + Ключ);
		КонецЕсли;
	КонецЦикла;

	Лог("");
	Лог("== Сортировки");
	Сортировка = НайтиПоле(ФормаОкна, "Сортировка");
	Сортировка.ВыбратьВариант("По номеру");
	Пауза(2);
	Номера = НомераСписка(СтрокиСписка(ФормаОкна, Истина));
	ПроверитьТекст(СтрСоединить(Номера, ","), СтрСоединить(НомераПоУбыванию(Видимые, Новый Массив), ","), "По номеру: сначала больший номер");

	Сортировка.ВыбратьВариант("По крайнему сроку");
	Пауза(2);
	Номера = НомераСписка(СтрокиСписка(ФормаОкна, Истина));
	Остальные = Новый Массив;
	Для Каждого Ключ Из Видимые Цикл
		Если СоСроком.Найти(Ключ) = Неопределено Тогда
			Остальные.Добавить(Ключ);
		КонецЕсли;
	КонецЦикла;
	Ожидаемый = НомераПоУбыванию(Остальные, Новый Массив);
	Для Каждого Ключ Из СоСроком Цикл
		Ожидаемый.Добавить(НомераЗадач[Ключ]);
	КонецЦикла;
	ПроверитьТекст(СтрСоединить(Номера, ","), СтрСоединить(Ожидаемый, ","),
		"По крайнему сроку: ближайший срок первым, при равных сроках больший номер выше");

	Сортировка.ВыбратьВариант("По активности");
	Пауза(2);
	Строки = СтрокиСписка(ФормаОкна, Истина);
	Порядок = Истина;
	Предыдущая = "";
	Для Каждого Строка Из Строки Цикл
		Ключ = КлючАктивности(Ячейка(Строка, "Активность"));
		Если Предыдущая <> "" И Ключ > Предыдущая Тогда
			Порядок = Ложь;
		КонецЕсли;
		Предыдущая = Ключ;
	КонецЦикла;
	Проверка(Порядок, "По активности: время активности не растёт сверху вниз");

	Лог("");
	Лог("== Поиск");
	Найденные = НайтиВСписке(ФормаОкна, НомераЗадач["dalstroy"]);
	Проверка(Найденные.Количество() = 1 И Ячейка(Найденные[0], "№") = НомераЗадач["dalstroy"], "Поиск по номеру: одна строка");
	Найденные = НайтиВСписке(ФормаОкна, "ДАЛЬСТРОЙ");
	ПроверитьТекст(СтрСоединить(НомераСписка(Найденные), ","), СтрСоединить(НомераПоУбыванию(СтрРазделить("dalstroy,dalstroy2,ownDalstroy",
		","), Новый Массив), ","), "Поиск «ДАЛЬСТРОЙ» без учёта регистра по названию");
	Найденные = НайтиВСписке(ФормаОкна, "несуществующее название");
	Проверка(Найденные.Количество() = 0, "Поиск без совпадений: строк нет");
	Найденные = НайтиВСписке(ФормаОкна, "");
	Лог("После ввода пустого текста строк: " + Найденные.Количество() + ", текст в поле: «" + ТекстПоля(НайтиПоле(ФормаОкна, "ТекстПоиска")) + "»");
	Если Найденные.Количество() = 0 Тогда
		Найденные = НайтиВСписке(ФормаОкна, " ");
		Лог("После ввода пробела строк: " + Найденные.Количество());
	КонецЕсли;
	Проверка(Найденные.Количество() = Видимые.Количество(), "Поиск очищен: снова все задачи");
	ЗакрытьОкно(ФормаОкна);

	Лог("");
	Лог("== Выбор щелчком по строке");
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ВыбратьЩелчком(ФормаОкна, "arkharov");
	ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "Содержание")), "[ТЕСТ] ИП Архаров — ИИН", "Содержание = название задачи");
	Проверка(СтрНайти(НРег(ТекстПоля(НайтиПоле(ФормаОкна, "Контрагент"))), "архаров") > 0, "Контрагент по компании CRM");
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьКонтрагента")), "найден в 1С по БИН 745105884167", "Пометка контрагента");

	Лог("");
	Лог("== Номер и ссылка (С2)");
	Хост = "https://example.bitrix24.kz";
	Номер = НомераЗадач["dalstroy2"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, "#" + Номер);
	Номер = НомераЗадач["kikinda"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, "№ " + Лев(Номер, 2) + " " + Сред(Номер, 3));
	Номер = НомераЗадач["norq"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, Хост + "/company/personal/user/30/tasks/task/view/" + Номер + "/");
	Номер = НомераЗадач["dup"];
	ВвестиНомерЗадачи(ФормаОкна, Номер, Хост + "/workgroups/group/38/tasks/task/edit/" + Номер + "/");
	ЗакрытьОкно(ФормаОкна);

	Лог("");
	Лог("== Граница 30 дней (С3)");
	Если ПустаяСтрока(НастройкиЗапуска.closed) Тогда
		Проверка(Ложь, "Скрипт передал день завершения задачи dalstroy (параметр closed)");
		Возврат;
	КонецЕсли;
	ДеньЗавершения = Дата(СтрЗаменить(НастройкиЗапуска.closed, "-", "") + "000000");
	Для Каждого Дни Из СтрРазделить("30,31", ",") Цикл
		УстановитьДатуТабеля(Табель, ДеньЗавершения + Число(Дни) * 86400);
		ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
		Если ФормаОкна = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Строки = СтрокиСписка(ФормаОкна, Истина);
		Если Дни = "30" Тогда
			Проверка(СтрокаЗадачи(Строки, "dalstroy") <> Неопределено, "Табель через 30 дней после завершения: задача в списке");
			ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ПодписьСписка")), "Незавершённые задачи и задачи, завершённые с "
				+ Формат(ДеньЗавершения, "ДФ=dd.MM.yyyy") + ", где вы постановщик, исполнитель или соисполнитель", "Подпись под списком");
		Иначе
			Проверка(СтрокаЗадачи(Строки, "dalstroy") = Неопределено, "Табель через 31 день после завершения: задачи в списке нет");
			ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ПодписьСписка")), "Незавершённые задачи и задачи, завершённые с "
				+ Формат(ДеньЗавершения + 86400, "ДФ=dd.MM.yyyy") + ", где вы постановщик, исполнитель или соисполнитель", "Подпись под списком");
			ВвестиНомерЗадачи(ФормаОкна, НомераЗадач["dalstroy"]);
		КонецЕсли;
		ЗакрытьОкно(ФормаОкна);
	КонецЦикла;

КонецПроцедуры

// Контрагент по каждой задаче набора (С6, Ф6): выбор щелчком и сверка имени и текста.
&НаКлиенте
Процедура СценарийКонтрагенты()

	Все = "dalstroy,arkharov,dalstroy2,norq,nobin,kikinda,dup,twoCompanies,noCompany,observer,outside,ownDalstroy,ownNoCompany";
	Если Не ЕстьЗадачи(Все) Тогда
		Возврат;
	КонецЕсли;
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Лог("== Контрагенты по задачам набора");
	ПроверитьКонтрагента(ФормаОкна, "dalstroy", "Дальстрой", "найден в 1С по БИН 234512612395");
	ПроверитьКонтрагента(ФормаОкна, "arkharov", "Архаров", "найден в 1С по БИН 745105884167");
	ПроверитьКонтрагента(ФормаОкна, "dalstroy2", "Дальстрой", "найден в 1С по БИН 234512612395");
	ПроверитьКонтрагента(ФормаОкна, "kikinda", "Kikinda", "найден в 1С по БИН 452407560239");
	ПроверитьКонтрагента(ФормаОкна, "norq", "", "У компании «[ТЕСТ] Без реквизитов» не заполнен БИН — выберите контрагента вручную");
	ПроверитьКонтрагента(ФормаОкна, "nobin", "", "Контрагент с БИН 990840000017 не найден в 1С — выберите контрагента вручную");
	ПроверитьКонтрагента(ФормаОкна, "dup", "", "В 1С несколько контрагентов с БИН 772824024014 — выберите нужного вручную");
	ПроверитьКонтрагента(ФормаОкна, "twoCompanies", "", "В задаче несколько компаний CRM — выберите контрагента вручную");
	ПроверитьКонтрагента(ФормаОкна, "noCompany", "", "В задаче не указана компания CRM — выберите контрагента вручную");

КонецПроцедуры

// Права и ограничения (С7, С8, С10, С13) под администратором: наблюдатель, задача вне проекта, чужой табель, табель без
// сотрудника, колонка «ID Б24» в строке, добавленной вручную.
&НаКлиенте
Процедура СценарийПрава()

	Если Не ЕстьЗадачи("observer,outside") Тогда
		Возврат;
	КонецЕсли;
	Комментарий = "[ТЕСТ] ui-check права";
	УдалитьТабелиСценария(Комментарий);

	Лог("== Наблюдатель и задача вне проекта (С7, С10)");
	Табель = ОткрытьНовыйТабель();
	Если Табель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Режим = НайтиДекорацию(ФормаОкна, "НадписьРежимаТестирования");
	Проверка(Режим.ТекущаяВидимость(), "Режим тестирования включён");
	Проект = Сред(Режим.ТекстЗаголовка, СтрНайти(Режим.ТекстЗаголовка, "«") + 1);
	Проект = Лев(Проект, СтрДлина(Проект) - 1);
	ВвестиНомер(ФормаОкна, НомераЗадач["observer"], "Заполнять табель по задаче могут только постановщик, исполнитель и соисполнители");
	Проверка(Не НайтиКнопку(ФормаОкна, "Добавить в табель").ТекущаяДоступность(), "Наблюдатель: «Добавить в табель» недоступна");
	ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "Содержание")), "", "Название задачи, где сотрудник наблюдатель, не показано");
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьКонтрагента")), "", "Контрагент задачи-наблюдателя не показан");
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")), "", "Выбор снят");
	ВвестиНомер(ФормаОкна, НомераЗадач["outside"], "В режиме тестирования доступны только задачи проекта «" + Проект + "»");
	Проверка(Не НайтиКнопку(ФормаОкна, "Добавить в табель").ТекущаяДоступность(), "Задача вне проекта: «Добавить в табель» недоступна");
	ЗакрытьОкно(ФормаОкна);

	Лог("");
	Лог("== Колонка «ID Б24» в строке, добавленной вручную (С13)");
	Табель.Активизировать();
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Добавить").Нажать();
	Пауза(2);
	Строки = СтрокиТаблицы(Таблица);
	Проверка(Строки.Количество() = 1, "Добавлена одна строка");
	Если Строки.Количество() = 1 Тогда
		ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), "", "ID Б24 в строке, добавленной вручную, пуст");
	КонецЕсли;
	ВвестиВЯчейку(Таблица, "Табельб24т_IDБ24", "12345");
	ПроверитьТекст(Ячейка(ТекущаяСтрокаТаблицы(Таблица), "ID Б24"), "12345", "ID Б24 редактируется в строке");

	Лог("");
	Лог("== Чужой табель (С8)");
	Данные = НовыеТабелиПрав(Комментарий);
	ПроверитьОтказТабеля(Данные.Чужой, "Заполнять из задачи Битрикс24 можно только свой табель");
	// Форма сама подставляет в пустое поле «Сотрудник» физическое лицо пользователя: табель без сотрудника получается,
	// только если пользователь очистил поле руками. Отказ «Сначала укажите сотрудника в табеле» проверяет «сотрудник»
	// (у пользователя без физического лица поле остаётся пустым).
	УдалитьТабелиСценария(Комментарий);

КонецПроцедуры

// Пользователь без полных прав проходит Ф2 шаг за шагом (С9) и затем добавляет строку (полный путь). Между шагами
// менеджер меняет данные базы и ждёт 25 секунд: платформа до 20 секунд держит в сеансе прочитанные реквизиты ссылок.
&НаКлиенте
Процедура СценарийСотрудник()

	Если Не ЕстьЗадачи("ownDalstroy") Тогда
		Возврат;
	КонецЕсли;
	Комментарий = "[ТЕСТ] ui-check сотрудник";
	Проект = Число(НастройкиЗапуска.project);
	ВосстановитьБазу(Комментарий, Проект);
	Данные = ПодготовитьСотрудника(Комментарий);
	Если Данные.Ошибка <> "" Тогда
		Проверка(Ложь, Данные.Ошибка);
		Возврат;
	КонецЕсли;
	Лог("Пользователь «[ТЕСТ] Сотрудник» без физического лица, физическое лицо для шагов: «" + Данные.ФИО + "»");

	Попытка
		Лог("");
		Лог("== У пользователя 1С нет физического лица");
		ПроверитьОтказТабеля(Данные.БезСотрудника, "Сначала укажите сотрудника в табеле");
		ПроверитьОтказТабеля(Данные.СоСотрудником, "Ваш пользователь 1С не связан с физическим лицом. Обратитесь к администратору");

		Лог("");
		Лог("== Физическое лицо без e-mail");
		ИзменитьБазуСотрудника("связать");
		Пауза(25);
		ПроверитьОтказТабеля(Данные.СоСотрудником, "В карточке физического лица " + Данные.ФИО + " не указан e-mail. Обратитесь к администратору");

		Лог("");
		Лог("== E-mail, которого нет в Битрикс24");
		ИзменитьБазуСотрудника("почта-нет-в-б24");
		Пауза(25);
		ПроверитьОтказТабеля(Данные.СоСотрудником, "В Битрикс24 нет пользователя с e-mail b24t-nobody@example.com. Обратитесь к администратору");

		Лог("");
		Лог("== Один e-mail у двух физических лиц");
		ИзменитьБазуСотрудника("почта-администратора");
		Пауза(25);
		ПроверитьОтказТабеля(Данные.СоСотрудником, "E-mail " + Данные.ПочтаАдминистратора + " указан в карточках нескольких физических лиц. Обратитесь к администратору");

		Лог("");
		Лог("== Полный путь: пользователь связан с физическим лицом администратора");
		ИзменитьБазуСотрудника("связать-с-администратором");
		Пауза(25);
		Табель = ОткрытьНовыйТабель();
		Если Табель = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если Не ДобавитьИзЗадачи(Табель, НомераЗадач["ownDalstroy"], "09:00", "10:00", "11:00") Тогда
			Возврат;
		КонецЕсли;
		Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
		Строки = СтрокиТаблицы(Таблица);
		Проверка(Строки.Количество() = 1, "В табеле одна строка");
		Если Строки.Количество() = 1 Тогда
			ПроверитьТекст(Ячейка(Строки[0], "ID Б24"), НомераЗадач["ownDalstroy"], "ID Б24 строки");
			Проверка(СтрНайти(НРег(Ячейка(Строки[0], "Контрагент")), "дальстрой") > 0, "Контрагент по компании CRM: «"
				+ Ячейка(Строки[0], "Контрагент") + "»");
			ПроверитьТекст(Время(Ячейка(Строки[0], "Факт")), "01:00", "Факт строки");
		КонецЕсли;
		НайтиПоле(Табель, "Комментарий").ВвестиТекст(Комментарий);
		Таблица.Активизировать();
		Кнопка = НайтиКнопку(Табель, "Провести и закрыть");
		Проверка(Кнопка <> Неопределено, "Кнопка «Провести и закрыть» есть");
		Если Кнопка <> Неопределено Тогда
			Кнопка.Нажать();
			Проверка(Табель.ОжидатьЗакрытие(60), "Табель проведён и закрыт");
		КонецЕсли;
		Проверка(ЧислоПроведённыхТабелей(Комментарий) = 1, "В базе один проведённый табель сценария");
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	ВосстановитьБазу(Комментарий, Проект);
	Лог("База восстановлена: пользователь «[ТЕСТ] Сотрудник» без физического лица, табели сценария удалены");

КонецПроцедуры

// Режим тестирования выключен (как в рабочей КА): в списке и по номеру доступны задачи вне проекта. Режим
// включается обратно в любом исходе.
&НаКлиенте
Процедура СценарийБезТеста()

	Если Не ЕстьЗадачи("outside") Тогда
		Возврат;
	КонецЕсли;
	Проект = Число(НастройкиЗапуска.project);
	Если Проект = 0 Тогда
		Проверка(Ложь, "Скрипт передал номер проекта для тестирования (параметр project)");
		Возврат;
	КонецЕсли;
	ВосстановитьБазу("", Проект);

	Лог("== Режим тестирования выключен");
	Лог(НастроитьРежимТестирования(Ложь, Проект));
	Пауза(3);
	Попытка
		Табель = ОткрытьНовыйТабель();
		Если Табель <> Неопределено Тогда
			ФормаОкна = ОткрытьОкноСЗагрузкой(Табель);
			Если ФормаОкна <> Неопределено Тогда
				Проверка(Не НайтиДекорацию(ФормаОкна, "НадписьРежимаТестирования").ТекущаяВидимость(), "Надписи режима тестирования нет");
				// Задачи сотрудника не печатаются: в отчёт идут только строки с префиксом «[ТЕСТ]».
				Строки = НайтиВСписке(ФормаОкна, "[ТЕСТ]");
				Лог("Задач с «[ТЕСТ]» в списке: " + Строки.Количество());
				Проверка(СтрокаЗадачи(Строки, "outside") <> Неопределено, "Задача вне проекта есть в списке");
				Проверка(СтрокаЗадачи(Строки, "observer") = Неопределено, "Задачи, где сотрудник наблюдатель, в списке нет");
				Для Каждого Ключ Из СтрРазделить("dalstroy,arkharov,twoCompanies,noCompany,ownDalstroy", ",") Цикл
					Проверка(СтрокаЗадачи(Строки, Ключ) <> Неопределено, "Задача проекта " + Ключ + " в списке");
				КонецЦикла;
				ВвестиНомерЗадачи(ФормаОкна, НомераЗадач["outside"]);
			КонецЕсли;
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Лог(НастроитьРежимТестирования(Истина, Проект));
	Проверка(РежимТестированияВключён(Проект), "Режим тестирования включён обратно, проект " + Проект);

КонецПроцедуры

// Ключи вебхука и OpenAI (из безопасного хранилища) не найдены ни в журнале регистрации, ни в файлах (11.1, С24); тексты
// тестовых задач, комментарии, пароли и черновики не найдены в журнале (С24, С30). Ключ не выходит из
// серверной функции тестового расширения, в отчёт идут только числа.
&НаКлиенте
Процедура СценарийБезопасность()

	Если ПустаяСтрока(НастройкиЗапуска.files) Тогда
		Проверка(Ложь, "Скрипт передал список файлов (параметр files)");
		Возврат;
	КонецЕсли;
	Результат = НайтиКлючВебхука(НастройкиЗапуска.files);
	Если Результат.Ошибка <> "" Тогда
		Проверка(Ложь, Результат.Ошибка);
		Возврат;
	КонецЕсли;
	Лог("Проверено записей журнала: " + Результат.ПровереноЗаписей + ", файлов: " + Результат.ПровереноФайлов
		+ ", не прочитано (заняты другим процессом): " + Результат.Непрочитано);
	Лог("Ключ вебхука: в журнале " + Результат.Журнал + ", в файлах " + Результат.Файлы);
	Проверка(Результат.Журнал = 0, "Ключа вебхука нет в журнале регистрации");
	Проверка(Результат.Файлы = 0, "Ключа вебхука нет в файлах");
	Если Результат.ОшибкаOpenAI <> "" Тогда
		Проверка(Ложь, Результат.ОшибкаOpenAI);
	Иначе
		Лог("Ключ OpenAI: в журнале " + Результат.ЖурналOpenAI + ", в файлах " + Результат.ФайлыOpenAI);
		Проверка(Результат.ЖурналOpenAI = 0, "Ключа OpenAI нет в журнале регистрации");
		Проверка(Результат.ФайлыOpenAI = 0, "Ключа OpenAI нет в файлах");
	КонецЕсли;
	Если ПустаяСтрока(НастройкиЗапуска.texts) Тогда
		Проверка(Ложь, "Скрипт передал список текстов (параметр texts)");
	Иначе
		Тексты = ЧислоТекстовВЖурналеИзФайла(НастройкиЗапуска.texts);
		Лог("Тексты задач, комментарии, пароли, черновики: просмотрено записей журнала " + Тексты.ПровереноЗаписей
			+ ", найдено " + Тексты.Найдено);
		Проверка(Тексты.ПровереноЗаписей > 0, "Записи журнала расширения просмотрены");
		Проверка(Тексты.Найдено = 0, "Текстов задач, комментариев, паролей, черновиков и ответов ИИ в журнале нет");
	КонецЕсли;

КонецПроцедуры

// Возвращает базу в исходное состояние после прерванного прогона.
&НаКлиенте
Процедура СценарийВосстановить()

	Проект = Число(НастройкиЗапуска.project);
	Если Проект = 0 Тогда
		Проверка(Ложь, "Скрипт передал номер проекта для тестирования (параметр project)");
		Возврат;
	КонецЕсли;
	Для Каждого Комментарий Из СтрРазделить("сотрудник,права,строка,чужой", ",") Цикл
		ВосстановитьБазу("[ТЕСТ] ui-check " + Комментарий, Проект);
	КонецЦикла;
	Проверка(РежимТестированияВключён(Проект), "Режим тестирования включён, проект " + Проект);
	Проверка(Не ПользовательСвязан(), "Пользователь «[ТЕСТ] Сотрудник» без физического лица");
	Лог(НастроитьПередачуКомментариев(Ложь));
	Проверка(Не ПередачаКомментариевВключена(), "Флажок «Передавать ИИ комментарии задачи» снят");
	Лог(ВосстановитьНастройкиИИ());

КонецПроцедуры

#Область ПомощникиСценариев

&НаКлиенте
Функция ЕстьЗадачи(Ключи)

	Все = Истина;
	Для Каждого Ключ Из СтрРазделить(Ключи, ",") Цикл
		Если НомераЗадач[Ключ] = Неопределено Тогда
			Проверка(Ложь, "Есть номер тестовой задачи " + Ключ + " (scripts/b24-test-data.ids.json)");
			Все = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Все;

КонецФункции

// Кнопка «Заполнить из задачи Б24» в табеле: открывает окно.
&НаКлиенте
Функция ОткрытьОкно(Табель)

	Табель.Активизировать();
	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24").Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Тогда
		Проверка(Ложь, "Окно «Заполнить из задачи Битрикс24» открылось");
	КонецЕсли;
	Возврат ФормаОкна;

КонецФункции

// Окно открыто, список загружен или показано сообщение об отказе (тогда Неопределено и ошибка в отчёте).
&НаКлиенте
Функция ОткрытьОкноСЗагрузкой(Табель)

	ФормаОкна = ОткрытьОкно(Табель);
	Если ФормаОкна = Неопределено Или Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ФормаОкна;

КонецФункции

&НаКлиенте
Процедура ЗакрытьОкно(ФормаОкна)

	Кнопка = НайтиКнопку(ФормаОкна, "Отмена");
	Если Кнопка = Неопределено Тогда
		Кнопка = НайтиКнопку(ФормаОкна, "Закрыть");
	КонецЕсли;
	Кнопка.Нажать();
	Проверка(ФормаОкна.ОжидатьЗакрытие(30), "Окно закрылось");

КонецПроцедуры

// Строки списка задач окна (чтение двигает курсор и поэтому выбирает каждую строку по очереди).
&НаКлиенте
Функция СтрокиСписка(ФормаОкна, Тихо = Ложь)

	Возврат СтрокиТаблицы(НайтиТаблицу(ФормаОкна, "СписокЗадач"), Тихо);

КонецФункции

&НаКлиенте
Функция СтрокаЗадачи(Строки, Ключ)

	Для Каждого Строка Из Строки Цикл
		Если Ячейка(Строка, "№") = НомераЗадач[Ключ] Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

&НаКлиенте
Функция НомераСписка(Строки)

	Номера = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Номера.Добавить(Ячейка(Строка, "№"));
	КонецЦикла;
	Возврат Номера;

КонецФункции

// Номера задач по ключам: сначала Первые в заданном порядке, затем остальные по убыванию номера.
&НаКлиенте
Функция НомераПоУбыванию(Ключи, Первые)

	Результат = Новый Массив;
	Для Каждого Ключ Из Первые Цикл
		Результат.Добавить(НомераЗадач[Ключ]);
	КонецЦикла;
	Остальные = Новый СписокЗначений;
	Для Каждого Ключ Из Ключи Цикл
		Если Первые.Найти(Ключ) = Неопределено Тогда
			Остальные.Добавить(Число(НомераЗадач[Ключ]));
		КонецЕсли;
	КонецЦикла;
	Остальные.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
	Для Каждого Элемент Из Остальные Цикл
		Результат.Добавить(Формат(Элемент.Значение, "ЧГ=0"));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// «дд.ММ.гггг ЧЧ:мм» → «ггггММддЧЧмм» для сравнения.
&НаКлиенте
Функция КлючАктивности(Текст)

	Если СтрДлина(Текст) < 16 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Сред(Текст, 7, 4) + Сред(Текст, 4, 2) + Лев(Текст, 2) + Сред(Текст, 12, 2) + Сред(Текст, 15, 2);

КонецФункции

// Текст в поле поиска, затем строки списка.
&НаКлиенте
Функция НайтиВСписке(ФормаОкна, Текст)

	Поиск = НайтиПоле(ФормаОкна, "ТекстПоиска");
	Поиск.Активизировать();
	Поиск.ВвестиТекст(Текст);
	Пауза(3);
	Возврат СтрокиСписка(ФормаОкна, Ложь);

КонецФункции

// Щелчок по строке списка: переход к строке с номером задачи (событие «при активизации строки» выбирает задачу).
&НаКлиенте
Процедура ВыбратьЩелчком(ФормаОкна, Ключ)

	Номер = НомераЗадач[Ключ];
	Таблица = НайтиТаблицу(ФормаОкна, "СписокЗадач");
	Таблица.Активизировать();
	Описание = Новый Соответствие;
	Описание.Вставить("№", Номер);
	Перешли = Таблица.ПерейтиКСтроке(Описание);
	Если Не Перешли Тогда
		Перешли = Таблица.ПерейтиКСтроке(Описание, НаправлениеПереходаКСтроке.Вверх);
	КонецЕсли;
	Проверка(Перешли, "Переход к задаче " + Ключ + " в списке");
	ЖдатьТекст(ФормаОкна, "ВыбранаЗадача", "Выбрана задача №" + Номер, "Выбор щелчком: " + Ключ);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКонтрагента(ФормаОкна, Ключ, Имя, Текст)

	ВыбратьЩелчком(ФормаОкна, Ключ);
	ЖдатьТекст(ФормаОкна, "НадписьКонтрагента", Текст, "Текст про контрагента задачи " + Ключ);
	Контрагент = ТекстПоля(НайтиПоле(ФормаОкна, "Контрагент"));
	Если Имя = "" Тогда
		ПроверитьТекст(Контрагент, "", "Контрагент задачи " + Ключ + " пуст");
	Иначе
		Проверка(СтрНайти(НРег(Контрагент), НРег(Имя)) > 0, "Контрагент задачи " + Ключ + ": «" + Контрагент + "»");
	КонецЕсли;

КонецПроцедуры

// Дата табеля вводится в поле «Дата» формы и подтверждается переходом в другое поле.
&НаКлиенте
Процедура УстановитьДатуТабеля(Табель, Дата)

	Табель.Активизировать();
	Поле = НайтиПоле(Табель, "Дата");
	Поле.Активизировать();
	Поле.ВвестиТекст(Формат(Дата, "ДФ=dd.MM.yyyy"));
	НайтиПоле(Табель, "Комментарий").Активизировать();
	Пауза(2);
	Лог("Дата табеля в форме: «" + ТекстПоля(Поле) + "»");

КонецПроцедуры

// Текст отказа, который окно показывает вместо списка (страница отказа), или пометка, если страница не показана.
&НаКлиенте
Функция ТекстОтказа(ФормаОкна, Секунд)

	Страницы = НайтиГруппу(ФормаОкна, "Страницы");
	Конец = ТекущаяДата() + Секунд;
	Пока ТекущаяДата() < Конец Цикл
		Если Страницы.ПолучитьТекущуюСтраницу().Имя = "СтраницаОтказ" Тогда
			Возврат ТекстМетки(НайтиДекорацию(ФормаОкна, "НадписьОтказа"));
		КонецЕсли;
		Пауза(1);
	КонецЦикла;
	Возврат "<окно не показало отказ>";

КонецФункции

// Записанный табель (см. НовыйТабель на сервере) открывается по навигационной ссылке; окно должно показать отказ.
&НаКлиенте
Процедура ПроверитьОтказТабеля(Табель, Ожидаемое)

	ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
	ОкноПриложения.ВыполнитьКоманду(Табель.Навигация);
	ФормаТабеля = ЖдатьФорму(Табель.Представление, 60);
	Если ФормаТабеля = Неопределено Тогда
		Проверка(Ложь, "Табель открылся: " + Табель.Представление);
		Возврат;
	КонецЕсли;
	ФормаОкна = ОткрытьОкно(ФормаТабеля);
	Если ФормаОкна = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПроверитьТекст(ТекстОтказа(ФормаОкна, 90), Ожидаемое, "Отказ окна");
	ЗакрытьОкно(ФормаОкна);

КонецПроцедуры

#КонецОбласти

// Платформа отклоняет нажатие недоступной кнопки исключением.
&НаКлиенте
Функция НажатиеОтклонено(Кнопка)

	Попытка
		Кнопка.Нажать();
	Исключение
		Возврат Истина;
	КонецПопытки;
	Возврат Ложь;

КонецФункции

// Новый табель за сегодня.
&НаКлиенте
Функция ОткрытьНовыйТабель()

	ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
	ОкноПриложения.ВыполнитьКоманду("e1cib/command/Документ.гем_Табель.Создать");
	Табель = ЖдатьФорму("Табель (создание)", 60);
	Если Табель = Неопределено Тогда
		Проверка(Ложь, "Открылся новый табель");
		Возврат Неопределено;
	КонецЕсли;
	Табель.Активизировать();
	Лог("Открыта форма «" + Табель.ТекстЗаголовка + "»");
	Возврат Табель;

КонецФункции

// «Заполнить из задачи Б24» → задача по номеру → время → «Добавить в табель». Проверяет время начала по умолчанию
// (ОжидаемоеНачало, пусто — не проверять) и возвращает Истину, если окно закрылось с результатом.
&НаКлиенте
Функция ДобавитьИзЗадачи(Табель, Номер, ОжидаемоеНачало, Начало, Окончание, ВыборОжидается = Ложь)

	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Кнопка = Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24");
	Кнопка.Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Тогда
		Проверка(Ложь, "Окно «Заполнить из задачи Битрикс24» открылось (задача " + Номер + ")");
		Возврат Ложь;
	КонецЕсли;
	Если Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат Ложь;
	КонецЕсли;

	ВвестиНомерЗадачи(ФормаОкна, Номер);
	Если Не ПустаяСтрока(ОжидаемоеНачало) Тогда
		ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "ВремяНач")), ОжидаемоеНачало, "Время начала по умолчанию");
	КонецЕсли;
	ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяНач"), Начало, "Содержание");
	Если Не ПустаяСтрока(Окончание) Тогда
		ВвестиИЗавершить(ФормаОкна, НайтиПоле(ФормаОкна, "ВремяКон"), Окончание, "Содержание");
	КонецЕсли;
	Добавить = НайтиКнопку(ФормаОкна, "Добавить в табель");
	Проверка(Добавить.ТекущаяДоступность(), "«Добавить в табель» доступна");
	Добавить.Нажать();
	Закрыто = ФормаОкна.ОжидатьЗакрытие(60);
	Проверка(Закрыто, "Окно закрылось после «Добавить в табель»");
	Пауза(2);
	Если Не ВыборОжидается Тогда
		Табель.Активизировать();
	КонецЕсли;
	Возврат Закрыто;

КонецФункции

// Номер вводится, поиск начинается, когда фокус уходит из поля. Если первый переход фокуса не сработал (бывает в
// тестовом клиенте), фокус переводится на другое поле ещё раз.
&НаКлиенте
Процедура ВвестиНомерЗадачи(ФормаОкна, Номер, Ввод = Неопределено)

	Ожидаемый = "Выбрана задача №" + Номер;
	НайтиПоле(ФормаОкна, "НомерИлиСсылка").ВвестиТекст(?(Ввод = Неопределено, Номер, Ввод));
	Для Заход = 1 По 3 Цикл
		НайтиПоле(ФормаОкна, ?(Заход = 2, "ТекстПоиска", "Содержание")).Активизировать();
		Конец = ТекущаяДата() + 10;
		Пока ТекущаяДата() < Конец И ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")) <> Ожидаемый Цикл
			Пауза(1);
		КонецЦикла;
		Если ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")) = Ожидаемый Тогда
			Прервать;
		КонецЕсли;
		Лог("Поиск по номеру не начался за 10 с, фокус переводится ещё раз (заход " + Заход + ")");
	КонецЦикла;
	ПроверитьТекст(ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")), Ожидаемый, "Выбор задачи по номеру");

КонецПроцедуры

#Область ТаблицаТабеля

// Строки таблицы как соответствия «заголовок колонки — текст».
&НаКлиенте
Функция СтрокиТаблицы(Таблица, Тихо = Ложь)

	Результат = Новый Массив;
	ТекущаяПередЧтением = Неопределено;
	Таблица.Активизировать();
	Попытка
		Если Таблица.ТекущийРежимРедактирование() Тогда
			Таблица.ЗакончитьРедактированиеСтроки();
			Пауза(1);
		КонецЕсли;
		ТекущаяПередЧтением = ТекущаяСтрокаТаблицы(Таблица);
		Таблица.ПерейтиКПервойСтроке();
		Предыдущая = Неопределено;
		Для Счёт = 1 По 30 Цикл
			Текущая = ТекущаяСтрокаТаблицы(Таблица);
			Если Текущая = Неопределено Или Предыдущая <> Неопределено
				И ПредставлениеСтроки(Текущая) = ПредставлениеСтроки(Предыдущая) И Счёт > 1 Тогда
				Прервать;
			КонецЕсли;
			Результат.Добавить(Текущая);
			Предыдущая = Текущая;
			Попытка
				Таблица.ПерейтиКСледующейСтроке();
			Исключение
				Прервать;
			КонецПопытки;
		КонецЦикла;
	Исключение
		Лог("Не удалось прочитать таблицу: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Не Тихо Тогда
		Если Результат.Количество() > 0 Тогда
			Лог("  колонки: " + СтрСоединить(КлючиВМассив(Результат[0]), " | "));
		КонецЕсли;
		Для Каждого Строка Из Результат Цикл
			Лог("  строка: " + ПредставлениеСтроки(Строка));
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ТекущаяСтрокаТаблицы(Таблица)

	Выделенные = Таблица.ПолучитьВыделенныеСтроки();
	Возврат ?(Выделенные.Количество() = 0, Неопределено, Выделенные[0]);

КонецФункции

// Значение колонки, заголовок которой начинается с Префикс.
&НаКлиенте
Функция Ячейка(Строка, Префикс)

	Если Строка = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Для Каждого Элемент Из Строка Цикл
		Если СтрНачинаетсяС(Элемент.Ключ, Префикс) Тогда
			Возврат Элемент.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

&НаКлиенте
Функция СтрокаПоНомеру(Строки, Номер)

	Для Каждого Строка Из Строки Цикл
		Если Ячейка(Строка, "ID Б24") = Номер Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;

КонецФункции

// Время ячейки таблицы «ч:мм:сс» в «ЧЧ:мм»; пустое остаётся пустым.
&НаКлиенте
Функция Время(Текст)

	Части = СтрРазделить(Текст, ":");
	Если Части.Количество() <> 3 Тогда
		Возврат Текст;
	КонецЕсли;
	Возврат Прав("0" + Части[0], 2) + ":" + Прав("0" + Части[1], 2);

КонецФункции

&НаКлиенте
Функция ПредставлениеСтроки(Соответствие)

	Части = Новый Массив;
	Если Соответствие <> Неопределено Тогда
		Для Каждого Элемент Из Соответствие Цикл
			Части.Добавить(Элемент.Ключ + "=" + Элемент.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Части, " | ");

КонецФункции

&НаКлиенте
Функция КлючиВМассив(Соответствие)

	Результат = Новый Массив;
	Для Каждого Элемент Из Соответствие Цикл
		Результат.Добавить(Элемент.Ключ);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Вводит текст в ячейку текущей строки таблицы и заканчивает редактирование строки.
&НаКлиенте
Процедура ВвестиВЯчейку(Таблица, ИмяПоля, Текст)

	Таблица.ИзменитьСтроку();
	Поле = Таблица.НайтиОбъект(Тип("ТестируемоеПолеФормы"), , ИмяПоля);
	Если Поле = Неопределено Тогда
		Проверка(Ложь, "В таблице есть поле " + ИмяПоля);
		Возврат;
	КонецЕсли;
	Поле.Активизировать();
	Поле.ВвестиТекст(Текст);
	Таблица.ЗакончитьРедактированиеСтроки();
	Пауза(1);

КонецПроцедуры

#КонецОбласти

#Область ВыборКонтрагента

&НаКлиенте
Функция ЗаголовокВыбораКонтрагента()

	Возврат "Контрагенты (юридические или физические лица)";

КонецФункции

&НаКлиенте
Функция ЕстьОкноВыбораКонтрагента()

	Возврат Приложение.ОжидатьОтображениеОбъекта(Тип("ТестируемаяФорма"), ЗаголовокВыбораКонтрагента(), , 3);

КонецФункции

// После добавления строки без контрагента выбор контрагента сам не открывается (Ф5: у сотрудника без права на
// константу проверки контрагентов форма выбора КА падает). Проверяет, что окна выбора нет, и вводит контрагента в ячейку
// новой (текущей) строки так, как это делает сотрудник. Истина — выбор не открылся и контрагент введён. Если выбор
// всё же открылся, закрывает его выбором первого контрагента, чтобы сценарий пошёл дальше, и возвращает Ложь.
&НаКлиенте
Функция ВвестиКонтрагентаВручную(Табель, Таблица)

	Если ЕстьОкноВыбораКонтрагента() Тогда
		ВыбратьПервогоКонтрагентаВОкне();
		Табель.Активизировать();
		Возврат Ложь;
	КонецЕсли;
	Табель.Активизировать();
	ВвестиВЯчейку(Таблица, "ТабельКонтрагент", ИмяКонтрагентаДляВвода());
	Возврат Истина;

КонецФункции

// Выбирает первого контрагента в уже открытом окне выбора.
&НаКлиенте
Функция ВыбратьПервогоКонтрагентаВОкне()

	Если Не Приложение.ОжидатьОтображениеОбъекта(Тип("ТестируемаяФорма"), ЗаголовокВыбораКонтрагента(), , 15) Тогда
		Попытка
			Лог("Активное окно: «" + Приложение.ПолучитьАктивноеОкно().Заголовок + "»");
		Исключение
		КонецПопытки;
		Возврат Ложь;
	КонецЕсли;
	Выбор = Приложение.НайтиОбъект(Тип("ТестируемаяФорма"), ЗаголовокВыбораКонтрагента());
	Таблица = Выбор.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"));
	Таблица.Активизировать();
	Таблица.ПерейтиКПервойСтроке();
	Таблица.Выбрать();
	Выбор.ОжидатьЗакрытие(15);
	Пауза(1);
	Возврат Истина;

