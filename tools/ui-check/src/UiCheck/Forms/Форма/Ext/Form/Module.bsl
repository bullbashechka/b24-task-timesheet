// Наименование контрагента, которое в справочнике одно: ввод его в ячейку выбирает именно этого контрагента без
// открытия формы выбора.
&НаСервереБезКонтекста
Функция ИмяКонтрагентаДляВвода()

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	НЕ К.ПометкаУдаления
		|	И К.Наименование <> """"
		|	И К.Наименование В
		|		(ВЫБРАТЬ
		|			Д.Наименование
		|		ИЗ
		|			Справочник.Контрагенты КАК Д
		|		СГРУППИРОВАТЬ ПО
		|			Д.Наименование
		|		ИМЕЮЩИЕ
		|			КОЛИЧЕСТВО(*) = 1)
		|УПОРЯДОЧИТЬ ПО
		|	К.Наименование");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Наименование, "");

