// Проверка интерфейса без человека. Обработка запускается менеджером тестирования (/TESTMANAGER /Execute) и управляет
// тестовым клиентом (/TESTCLIENT) через ТестируемоеПриложение; scripts/ui-check.sh собирает и запускает её.
// Параметры запуска: out=<файл отчёта>;port=<порт тестового клиента>;scenario=<сценарий>;since=<ггггММддЧЧммсс>.
// Отчёт печатает то, что видит пользователь, ошибки журнала регистрации с момента запуска и заканчивается строкой
// «ИТОГ: ПРОЙДЕНО» или «ИТОГ: НЕ ПРОЙДЕНО». Каждая запись в файл скрывает адреса e-mail и всё, что стоит после «/rest/»,
// поэтому ключа вебхука в отчёте нет; текст с «/rest/» на экране или в журнале проваливает проверку.

&НаКлиенте
Перем Журнал;

&НаКлиенте
Перем Ошибок;

&НаКлиенте
Перем Приложение;

&НаКлиенте
Перем ФайлОтчёта;

&НаКлиенте
Перем ВебхукВОтчёте;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Журнал = Новый Массив;
	Ошибок = 0;
	ВебхукВОтчёте = Ложь;
	Настройки = РазобратьПараметры(ПараметрЗапуска);
	ФайлОтчёта = Настройки.out;
	// Описание проверки не содержит самой метки: текст с ней проваливает отчёт.
	Проверка(СкрытьВебхуки("x https://p.bitrix24.kz/REST/30/ключ/profile.json"" y") = "x https://p.bitrix24.kz/REST/***"" y",
		"Отчёт скрывает ключ в адресе вебхука");
	Попытка
		Приложение = Новый ТестируемоеПриложение(, Число(Настройки.port));
		Приложение.УстановитьСоединение();
		Если Настройки.scenario = "окно" Тогда
			СценарийОкно();
		Иначе
			Проверка(Ложь, "Неизвестный сценарий «" + Настройки.scenario + "»");
		КонецЕсли;
	Исключение
		Проверка(Ложь, "Исключение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	Лог("");
	Лог("== Журнал регистрации с момента запуска");
	УтечкаВебхука = Ложь;
	ЧислоОшибок = 0;
	Для Каждого Строка Из ЗаписиЖурнала(Дата(Настройки.since)) Цикл
		УтечкаВебхука = УтечкаВебхука Или ЕстьАдресВебхука(Строка);
		Если СтрНайти(Строка, "[Ошибка]") > 0 Тогда
			ЧислоОшибок = ЧислоОшибок + 1;
		КонецЕсли;
		Лог("  " + Строка);
	КонецЦикла;
	Проверка(Не УтечкаВебхука, "В журнале нет адреса вебхука");
	Проверка(ЧислоОшибок = 0, "В журнале нет ошибок (записей с уровнем «Ошибка»)");

	Если ВебхукВОтчёте Тогда
		Ошибок = Ошибок + 1;
		Лог("НЕ ПРОЙДЕНО: в отчёте был адрес вебхука");
	КонецЕсли;
	Лог(?(Ошибок = 0, "ИТОГ: ПРОЙДЕНО", "ИТОГ: НЕ ПРОЙДЕНО, ошибок: " + Ошибок));
	ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры

#КонецОбласти

#Область Сценарии

// Табель → «Заполнить из задачи Б24» → окно: проверки Ф2–Ф4 без выбранной задачи (С2, С12, С14), «Отмена».
&НаКлиенте
Процедура СценарийОкно()

	Лог("== Табель");
	ОкноПриложения = Приложение.ПолучитьАктивноеОкно();
	ОкноПриложения.ВыполнитьКоманду("e1cib/command/Документ.гем_Табель.Создать");
	Табель = ЖдатьФорму("Табель (создание)", 60);
	Если Табель = Неопределено Тогда
		Проверка(Ложь, "Открылся новый табель");
		Возврат;
	КонецЕсли;
	Табель.Активизировать();
	Лог("Открыта форма «" + Табель.ТекстЗаголовка + "»");

	Таблица = Табель.НайтиОбъект(Тип("ТестируемаяТаблицаФормы"), , "Табель");
	Кнопка = Таблица.ПолучитьКоманднуюПанель().НайтиОбъект(Тип("ТестируемаяКнопкаФормы"), "Заполнить из задачи Б24");
	Проверка(Кнопка <> Неопределено, "Кнопка «Заполнить из задачи Б24» есть в командной панели таблицы «Табель»");
	Если Кнопка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Проверка(Кнопка.ТекущаяДоступность(), "Кнопка доступна (пользователь с полными правами)");
	ИзмененДо = Табель.ТекущаяМодифицированность();
	Лог("Новый табель до нажатия кнопки: изменён = " + ИзмененДо);

	Лог("");
	Лог("== Окно");
	Кнопка.Нажать();
	ФормаОкна = ЖдатьФорму("Заполнить из задачи Битрикс24", 60);
	Если ФормаОкна = Неопределено Тогда
		Проверка(Ложь, "Окно «Заполнить из задачи Битрикс24» открылось");
		Возврат;
	КонецЕсли;
	Лог("Открыто окно «" + ФормаОкна.ТекстЗаголовка + "»");

	Если Не ПроверитьЗагрузку(ФормаОкна) Тогда
		Возврат;
	КонецЕсли;
	ПроверитьПоляОкна(ФормаОкна);
	ПроверитьВводНомера(ФормаОкна);
	ПроверитьВремя(ФормаОкна);

	Лог("");
	Лог("== Отмена");
	КнопкаОтмены = НайтиКнопку(ФормаОкна, "Отмена");
	Проверка(КнопкаОтмены <> Неопределено, "Кнопка «Отмена» есть");
	Если КнопкаОтмены <> Неопределено Тогда
		КнопкаОтмены.Нажать();
		Закрыто = ФормаОкна.ОжидатьЗакрытие(30);
		Проверка(Закрыто, "Окно закрылось по «Отмена»");
		Табель.Активизировать();
		Лог("Табель после «Отмена»: изменён = " + Табель.ТекущаяМодифицированность());
		Проверка(Табель.ТекущаяМодифицированность() = ИзмененДо, "Табель после «Отмена» в том же состоянии «изменён», что и до окна");
	КонецЕсли;

КонецПроцедуры

// Окно загрузило список или показало отказ (Ф2). Возвращает Ложь, если окно показывает только сообщение.
&НаКлиенте
Функция ПроверитьЗагрузку(ФормаОкна)

	Страницы = НайтиГруппу(ФормаОкна, "Страницы");
	Если Страницы.ПолучитьТекущуюСтраницу().Имя = "СтраницаОтказ" Тогда
		Проверка(Ложь, "Окно показало отказ: «" + НайтиДекорацию(ФормаОкна, "НадписьОтказа").ТекстЗаголовка + "»");
		Возврат Ложь;
	КонецЕсли;

	// Список грузится после показа окна: ждём, пока надпись «Загрузка…» заменит таблица или сообщение.
	Загрузка = "Загрузка задач из Битрикс24…";
	СтраницыСписка = НайтиГруппу(ФормаОкна, "СтраницыСписка");
	Надпись = НайтиДекорацию(ФормаОкна, "НадписьСписка");
	Конец = ТекущаяДата() + 90;
	Пока ТекущаяДата() < Конец Цикл
		Если СтраницыСписка.ПолучитьТекущуюСтраницу().Имя = "СтраницаТаблица" Или Надпись.ТекстЗаголовка <> Загрузка Тогда
			Прервать;
		КонецЕсли;
		Пауза(1);
	КонецЦикла;

	Если СтраницыСписка.ПолучитьТекущуюСтраницу().Имя = "СтраницаТаблица" Тогда
		Таблица = НайтиТаблицу(ФормаОкна, "СписокЗадач");
		Лог("Список загружен, таблица видна");
		Проверка(Таблица.ТекущаяВидимость(), "Таблица списка видна");
	Иначе
		// На месте списка допустим только текст пустого списка (Ф3). Ошибка Битрикс24 вместо списка («вернул ошибку»,
		// «недоступен») — провал, даже если поиск по номеру работает.
		ПроверитьТекст(ТекстМетки(Надпись), б24т_ЗадачиКлиентСервер.ТекстНичегоНеНайдено(), "Вместо списка");
		Если Надпись.ТекстЗаголовка = Загрузка Тогда
			Диагностика();
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;

КонецФункции

// Заголовки, подписи, типы времени и время по умолчанию (С14, С15).
&НаКлиенте
Процедура ПроверитьПоляОкна(ФормаОкна)

	ДатаТабеля = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
	ПроверитьТекст(НайтиГруппу(ФормаОкна, "ГруппаЗадача").ТекстЗаголовка, "Задача", "Заголовок группы");
	ПроверитьТекст(НайтиГруппу(ФормаОкна, "ГруппаСтрока").ТекстЗаголовка, "Строка табеля за " + ДатаТабеля, "Заголовок нижней части");
	ПроверитьТекст(НайтиПоле(ФормаОкна, "ТекстПоиска").ТекстЗаголовка, "Поиск по номеру или названию", "Поле поиска");
	ПроверитьТекст(НайтиПоле(ФормаОкна, "НомерИлиСсылка").ТекстЗаголовка, "или номер / ссылка на задачу", "Поле номера");
	ПроверитьТекст(НайтиПоле(ФормаОкна, "ТипВремени").ТекстЗаголовка, "Тип времени", "Поле типа времени");
	ПроверитьТекст(НайтиПоле(ФормаОкна, "Содержание").ТекстЗаголовка, "Содержание", "Поле содержания");
	ПроверитьТекст(НайтиПоле(ФормаОкна, "Контрагент").ТекстЗаголовка, "Контрагент", "Поле контрагента");

	Подпись = НайтиДекорацию(ФормаОкна, "ПодписьСписка").ТекстЗаголовка;
	ПроверитьТекст(Подпись, "Незавершённые задачи и задачи, завершённые с " + Формат(НачалоДня(ТекущаяДата()) - 30 * 86400,
		"ДФ=dd.MM.yyyy") + ", где вы постановщик, исполнитель или соисполнитель", "Подпись под списком");

	Режим = НайтиДекорацию(ФормаОкна, "НадписьРежимаТестирования");
	Если Режим.ТекущаяВидимость() Тогда
		Проверка(СтрНачинаетсяС(Режим.ТекстЗаголовка, "Режим тестирования: показаны только задачи проекта «"),
			"Надпись режима тестирования: «" + Режим.ТекстЗаголовка + "»");
	Иначе
		Лог("Режим тестирования выключен: надписи нет");
	КонецЕсли;

	// Типы времени (С14): значение по умолчанию и состав списка.
	Тип = НайтиПоле(ФормаОкна, "ТипВремени");
	ПроверитьТекст(ТекстПоля(Тип), "Клиент (УД)", "Тип времени по умолчанию");
	Для Каждого Первый Из Тип.ПолучитьПредставлениеСпискаВыбора() Цикл
		Лог("Первый элемент списка типов: " + СтрСоединить(КлючиИЗначения(Первый), ", "));
		Прервать;
	КонецЦикла;
	Представление = СтрСоединить(ВМассивСтрок(Тип.ПолучитьПредставлениеСпискаВыбора()), "; ");
	Лог("Список типов времени: " + Представление);
	Проверка(ВМассивСтрок(Тип.ПолучитьПредставлениеСпискаВыбора()).Количество() = 13, "В списке 13 типов времени");
	Для Каждого Лишний Из СтрРазделить("Офис (командировка);Офис (собрания);Обед;Дорога;Пропуск", ";") Цикл
		Проверка(СтрНайти(Представление, Лишний) = 0, "В списке типов времени нет «" + Лишний + "»");
	КонецЦикла;
	Для Каждого Нужный Из СтрРазделить("Клиент (УД);Офис (прочее);Офис (задания);Клиент (ЧТ)", ";") Цикл
		Проверка(СтрНайти(Представление, Нужный) > 0, "В списке типов времени есть «" + Нужный + "»");
	КонецЦикла;

	// Время начала: окончание самой поздней строки или 09:00 в пустом табеле (С15); новый табель пуст.
	Лог("Время начала: отображаемый текст «" + ТекстПоля(НайтиПоле(ФормаОкна, "ВремяНач")) + "»");
	ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "ВремяНач")), "09:00", "Время начала по умолчанию");
	ПроверитьТекст(ТекстПоля(НайтиПоле(ФормаОкна, "ВремяКон")), "", "Время окончания по умолчанию");

	// Без выбранной задачи «Добавить в табель» недоступна (С12).
	Добавить = НайтиКнопку(ФормаОкна, "Добавить в табель");
	Проверка(Добавить <> Неопределено, "Кнопка «Добавить в табель» есть");
	Если Добавить <> Неопределено Тогда
		Проверка(Не Добавить.ТекущаяДоступность(), "«Добавить в табель» недоступна, пока задача не выбрана");
	КонецЕсли;
	Проверка(ТекстМетки(НайтиДекорацию(ФормаОкна, "ВыбранаЗадача")) = "", "Надпись «Выбрана задача» пуста");

КонецПроцедуры

// Поиск по номеру и ссылке (С2, С10): не число, несуществующая задача, задача вне проекта режима тестирования.
&НаКлиенте
Процедура ПроверитьВводНомера(ФормаОкна)

	Лог("");
	Лог("== Номер или ссылка");
	Режим = НайтиДекорацию(ФормаОкна, "НадписьРежимаТестирования");
	Проект = "";
	Если Режим.ТекущаяВидимость() Тогда
		Проект = Сред(Режим.ТекстЗаголовка, СтрНайти(Режим.ТекстЗаголовка, "«") + 1);
		Проект = Лев(Проект, СтрДлина(Проект) - 1);
	КонецЕсли;

	ВвестиНомер(ФормаОкна, "abc", "Введите номер задачи или ссылку на задачу Битрикс24");
	ВвестиНомер(ФормаОкна, "999999999", "Задача №999999999 не найдена в Битрикс24");
	Если Проект <> "" Тогда
		// Ссылка на чужую задачу вне тестового проекта: разбор ссылки и проверка проекта раньше роли.
		ВвестиНомер(ФормаОкна, "https://example.bitrix24.kz/workgroups/group/38/tasks/task/view/550/",
			"В режиме тестирования доступны только задачи проекта «" + Проект + "»");
	КонецЕсли;
	Проверка(Не НайтиКнопку(ФормаОкна, "Добавить в табель").ТекущаяДоступность(),
		"После отклонённого номера «Добавить в табель» недоступна");

КонецПроцедуры

// Подсказки у полей времени (С12).
&НаКлиенте
Процедура ПроверитьВремя(ФормаОкна)

	Лог("");
	Лог("== Время");
	Начало = НайтиПоле(ФормаОкна, "ВремяНач");
	Окончание = НайтиПоле(ФормаОкна, "ВремяКон");
	ПодсказкаНачала = НайтиДекорацию(ФормаОкна, "ПодсказкаВремяНач");
	ПодсказкаОкончания = НайтиДекорацию(ФормаОкна, "ПодсказкаВремяКон");

	// 00:00 в табеле значит «не указано».
	ВвестиИЗавершить(ФормаОкна, Начало, "00:00", "Содержание");
	Проверка(ПодсказкаНачала.ТекущаяВидимость(), "Время начала не указано: подсказка видна");
	ЖдатьТекст(ФормаОкна, "ПодсказкаВремяНач", "Укажите время начала", "Подсказка времени начала");

	ВвестиИЗавершить(ФормаОкна, Начало, "10:30", "Содержание");
	ПроверитьТекст(ТекстПоля(Начало), "10:30", "Время начала введено руками");
	Проверка(Не ПодсказкаНачала.ТекущаяВидимость(), "Время начала указано: подсказка скрыта");

	ВвестиИЗавершить(ФормаОкна, Окончание, "10:07", "Содержание");
	ПроверитьТекст(ТекстПоля(Окончание), "10:07", "Время окончания введено руками");
	Проверка(ПодсказкаОкончания.ТекущаяВидимость(), "Окончание раньше начала: подсказка видна");
	ЖдатьТекст(ФормаОкна, "ПодсказкаВремяКон", "Время окончания должно быть позже времени начала",
		"Подсказка времени окончания");

	ВвестиИЗавершить(ФормаОкна, Окончание, "11:00", "Содержание");
	Проверка(Не ПодсказкаОкончания.ТекущаяВидимость(), "Окончание позже начала: подсказка скрыта");

КонецПроцедуры

#КонецОбласти

// Что видит пользователь, когда окно не отвечает: активное окно, его объекты и сообщение об ошибке клиента.
&НаКлиенте
Процедура Диагностика()

	Лог("-- Диагностика");
	Попытка
		Информация = Приложение.ПолучитьТекущуюИнформациюОбОшибке();
		Лог("Ошибка тестируемого приложения: " + ?(Информация = Неопределено, "нет", Строка(Информация)));
	Исключение
		Лог("Информацию об ошибке получить не удалось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Попытка
		Активное = Приложение.ПолучитьАктивноеОкно();
		Лог("Активное окно: «" + Активное.Заголовок + "»");
		Для Каждого Подчинённый Из Активное.ПолучитьПодчиненныеОбъекты() Цикл
			Лог("  " + Строка(ТипЗнч(Подчинённый)) + " «" + Подчинённый.ТекстЗаголовка + "»");
		КонецЦикла;
	Исключение
		Лог("Активное окно получить не удалось: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#Область ПоискЭлементов

&НаКлиенте
Функция ЖдатьФорму(Заголовок, Секунд)

	Если Не Приложение.ОжидатьОтображениеОбъекта(Тип("ТестируемаяФорма"), Заголовок, , Секунд) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Приложение.НайтиОбъект(Тип("ТестируемаяФорма"), Заголовок);

КонецФункции

