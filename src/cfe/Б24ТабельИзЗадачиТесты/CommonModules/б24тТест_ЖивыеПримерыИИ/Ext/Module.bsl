// Запуск живого прогона набора примеров ИИ (задача 18.6) через тестовый клиент, без MCP «1c»:
//
//   cp <params.json> "$LOCALAPPDATA/Temp/b24-live-params.json"
//   TEST_MODULES="б24тТест_ЖивыеПримерыИИ" TIMEOUT_SECONDS=1500 scripts/run-tests.sh
//
// Прогон идёт к настоящему OpenAI и тратит деньги, поэтому тест есть в списке, только если во временном каталоге лежит
// файл b24-live-params.json; в обычном полном прогоне модуль не регистрирует ни одного теста. Тест удаляет файл сразу
// после чтения, чтобы следующий прогон не запустил платный тест по забытому файлу.
//
// Файл параметров (JSON): номера — какие примеры прогнать (пусто — все), прогонов — сколько раз каждый, папка — куда писать
// подробный результат и сводку, файлЗадач — JSON «ключ → название, описание» для примеров без задачи портала, задачи —
// «ключ → номер задачи в Битрикс24» для примеров, которые идут операцией целиком. Сотрудник — физлицо пользователя,
// под которым запущен клиент. Сводка (числа и номера проверок, без текстов) пишется в сводка.txt той же папки; тексты
// ответов — в прогон-*.json.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	Если ПустаяСтрока(ПутьКФайлуПараметров()) Тогда
		Возврат;
	КонецЕсли;

	ЮТТесты
		.ДобавитьСерверныйТест("ПрогонНабора", "Живой прогон набора примеров ИИ по файлу параметров b24-live-params.json");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ПрогонНабора() Экспорт

	Путь = ПутьКФайлуПараметров();
	Данные = ПрочитатьФайлJSON(Путь);
	УдалитьФайлы(Путь);

	Параметры = Новый Структура;
	Параметры.Вставить("Сотрудник", б24т_Доступ.ДанныеПользователя1С(Пользователи.АвторизованныйПользователь()).ФизическоеЛицо);
	Параметры.Вставить("Задачи", ЗначениеИлиПоУмолчанию(Данные, "задачи", Новый Соответствие));
	Параметры.Вставить("Номера", ЗначениеИлиПоУмолчанию(Данные, "номера", Новый Массив));
	Параметры.Вставить("Прогонов", ЗначениеИлиПоУмолчанию(Данные, "прогонов", 5));
	Параметры.Вставить("Папка", ЗначениеИлиПоУмолчанию(Данные, "папка", ""));
	Параметры.Вставить("ФайлЗадач", ЗначениеИлиПоУмолчанию(Данные, "файлЗадач", ""));

	Строки = б24тТест_ЖивойПрогонИИ.ПрогонНабора(Параметры);

	Сводка = Новый ТекстовыйДокумент;
	Сводка.УстановитьТекст(СтрСоединить(Строки, Символы.ПС));
	Сводка.Записать(Параметры.Папка + "/сводка.txt", КодировкаТекста.UTF8);

	НеПрошли = Новый Массив;
	Для Каждого Строка Из Строки Цикл
		Если СтрНайти(Строка, "не прошло") > 0 Тогда
			НеПрошли.Добавить(Лев(Строка, СтрНайти(Строка, ":") - 1));
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(НеПрошли.Количество(), "Примеры, которые прошли не во всех прогонах: " + СтрСоединить(НеПрошли, ", ")).Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПутьКФайлуПараметров()

	Путь = КаталогВременныхФайлов() + "b24-live-params.json";
	Файл = Новый Файл(Путь);
	Возврат ?(Файл.Существует(), Путь, "");

КонецФункции

Функция ПрочитатьФайлJSON(Путь)

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(Путь, "UTF-8");
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

Функция ЗначениеИлиПоУмолчанию(Данные, Ключ, ПоУмолчанию)

	Результат = Данные[Ключ];
	Возврат ?(Результат = Неопределено, ПоУмолчанию, Результат);

КонецФункции

#КонецОбласти
