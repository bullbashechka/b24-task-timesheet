#Область Тесты

Процедура Транспорт_ТолькоOpenAIИлиТестовый() Экспорт

	Для Каждого Транспорт Из СтрРазделить("ОбщегоНазначения,б24т_ТранспортHTTPS", ",") Цикл
		Клиент = б24т_OpenAI.НовыйКлиент(Транспорт);
		ТекстОшибки = Неопределено;
		Попытка
			б24т_OpenAI.Вызвать(Клиент, ЗапросПример(), КлючПример());
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		ЮТест.ОжидаетЧто(ТекстОшибки, "Исключение для " + Транспорт).Заполнено();
		ЮТест.ОжидаетЧто(ТекстОшибки, "Имя транспорта в исключении").Содержит(Транспорт);
		ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, КлючПример()), "Ключ в тексте исключения").Равно(0);
		ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Вызовов для " + Транспорт).Равно(0);
	КонецЦикла;

КонецПроцедуры

