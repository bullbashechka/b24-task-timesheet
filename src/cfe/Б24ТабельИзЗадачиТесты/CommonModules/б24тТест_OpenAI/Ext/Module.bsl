Процедура Запрос_ТелоПоЗапросу() Экспорт

	Клиент = КлиентСОтветом("Успех");
	Запрос = б24т_OpenAI.НовыйЗапрос("Содержание", "gpt-test-1", "УКАЗАНИЯ", "ВХОД", "timesheet_content",
		СхемаПример(), 500);

	б24т_OpenAI.Вызвать(Клиент, Запрос, КлючПример());

	Тело = Клиент.Вызовы[0].Параметры;
	ЮТест.ОжидаетЧто(Тело["model"], "model").Равно("gpt-test-1");
	ЮТест.ОжидаетЧто(Тело["instructions"], "instructions").Равно("УКАЗАНИЯ");
	ЮТест.ОжидаетЧто(Тело["input"], "input").Равно("ВХОД");
	ЮТест.ОжидаетЧто(Тело["store"], "store").Равно(Ложь);
	ЮТест.ОжидаетЧто(Тело["max_output_tokens"], "max_output_tokens").Равно(500);
	ЮТест.ОжидаетЧто(Тело["reasoning"]["effort"], "reasoning.effort").Равно(б24т_OpenAI.УровеньРассуждения());
	Формат = Тело["text"]["format"];
	ЮТест.ОжидаетЧто(Формат["type"], "text.format.type").Равно("json_schema");
	ЮТест.ОжидаетЧто(Формат["name"], "text.format.name").Равно("timesheet_content");
	ЮТест.ОжидаетЧто(Формат["strict"], "text.format.strict").Равно(Истина);
	ЮТест.ОжидаетЧто(Формат["schema"]["required"][0], "Схема ответа").Равно("text");
	ЮТест.ОжидаетЧто(Формат["schema"]["additionalProperties"], "Схема без лишних свойств").Равно(Ложь);

КонецПроцедуры

Процедура Запрос_БезЛишнихПолей() Экспорт

	Клиент = КлиентСОтветом("Успех");

	б24т_OpenAI.Вызвать(Клиент, ЗапросПример(), КлючПример());

	Ключи = Новый Массив;
	Для Каждого Поле Из Клиент.Вызовы[0].Параметры Цикл
		Ключи.Добавить(Поле.Ключ);
	КонецЦикла;
	Допустимые = СтрРазделить("model,instructions,input,store,max_output_tokens,reasoning,text", ",");
	Для Каждого Ключ Из Ключи Цикл
		ЮТест.ОжидаетЧто(Допустимые.Найти(Ключ) <> Неопределено, "Поле тела " + Ключ + " допустимо").Равно(Истина);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Ключи.Количество(), "Полей тела").Равно(7);

