// Есть ли строка в значении на любой глубине: структуры, соответствия и массивы обходятся целиком.
Функция СодержитСтроку(Значение, Искомое)

	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") Тогда
		Возврат СтрНайти(Значение, Искомое) > 0;
	ИначеЕсли ТипЗначения = Тип("Структура") Или ТипЗначения = Тип("Соответствие") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если СодержитСтроку(Элемент.Значение, Искомое) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если СодержитСтроку(Элемент, Искомое) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция ЗаписиЖурнала(Начало, Событие)

