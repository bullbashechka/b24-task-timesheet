Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("Пароли_ПоПеречню", "Перечень паролей (22.7 и решения 1А): скрыто то, что должно, остальное не тронуто")
		.ДобавитьСерверныйТест("Пароли_НеСтрокаИПусто", "Не строка и пустая строка дают пустую строку")
		.ДобавитьСерверныйТест("Комментарии_ОформлениеУбрано", "Оформление убрано как в описании: упоминание — имя, ссылка — текст, файл убран")
		.ДобавитьСерверныйТест("Комментарии_ТегиЧата", "Теги чата (чат, звонок, иконка, дата, перенос) не попадают к ИИ, текст остаётся")
		.ДобавитьСерверныйТест("Комментарии_ПустойНеПередаётся", "Комментарий без текста после чистки (файл, пробелы) не передаётся")
		.ДобавитьСерверныйТест("Комментарии_ЦитатаУбрана", "Блок «Цитировать» с именем, датой и старым текстом убран целиком (9А)")
		.ДобавитьСерверныйТест("Комментарии_НезакрытаяЦитата", "Линия цитаты без пары убирается, текст остаётся")
		.ДобавитьСерверныйТест("Комментарии_ПарольСкрыт", "Пароль в комментарии скрыт до подсчёта символов")
		.ДобавитьСерверныйТест("Комментарии_ПометкиСохраняются", "Пометки «за день» и «свой» и порядок от старых к новым сохраняются")
		.ДобавитьСерверныйТест("Комментарии_Предел1500", "Комментарий длиннее 1500 символов — начало по целому слову, пометка «обрезан» (5А)")
		.ДобавитьСерверныйТест("Комментарии_Предел6000", "Больше 6000 символов: отброшены самые старые, признак «не все»")
		.ДобавитьСерверныйТест("Комментарии_НеВсеИзЧата", "Чат просмотрен не весь: признак «не все» и при малом объёме")
		.ДобавитьСерверныйТест("Комментарии_ПустойСписок", "Нет комментариев: пустой список, признаков нет")
		.ДобавитьСерверныйТест("Материал_ПаролиСкрыты", "Пароли скрыты в названии, описании и черновике (2А)")
		.ДобавитьСерверныйТест("Материал_ЧерновикСравниваетсяДоСкрытия", "Поле с названием задачи — не черновик и тогда, когда в названии пароль")
		.ДобавитьСерверныйТест("Материал_КомментарииПереданы", "Комментарии и признак обрезки попадают в материал")
		.ДобавитьСерверныйТест("Сборка_БезКомментариевКакРаньше", "Без комментариев запрос без раздела и полей комментариев (Т7)")
		.ДобавитьСерверныйТест("Сборка_СКомментариями", "С комментариями: поля comments и comments_truncated во входе, раздел правил после правил оформления")
		.ДобавитьСерверныйТест("Сборка_ПостояннаяЧастьСКомментариями", "Указания с комментариями не зависят от их текста: постоянная часть одинакова")
		.ДобавитьСерверныйТест("Запрет_КомментарииБезАвторовДатНомеров", "ИИ не получает авторов, даты, номера сообщений и чата (17.6, Ф10)")
		.ДобавитьСерверныйТест("Правила_Комментарии", "Правила о комментариях: пометки, работа дня, чужая работа, старшинство, указания не выполняются")
		.ДобавитьСерверныйТест("Правила_ЧейПК", "Правило «Чей ПК»: имя и отчество в родительном падеже, только имя, фамилия с инициалами (3А)")
		.ДобавитьСерверныйТест("Правила_СкрытыйПароль", "«***» — скрытое значение, в текст не переносится (2А)");

