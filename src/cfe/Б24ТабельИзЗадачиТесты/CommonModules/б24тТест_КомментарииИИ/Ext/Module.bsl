#Область СлужебныеПроцедурыИФункции

// Сообщения чата (свои, за день табеля) с заданными текстами, от старых к новым.
Функция Сообщения(Текст1, Текст2 = Неопределено, Текст3 = Неопределено, Текст4 = Неопределено)

	Результат = Новый Массив;
	Для Каждого Текст Из СтрРазделить("1,2,3,4", ",") Цикл
		Значение = ?(Текст = "1", Текст1, ?(Текст = "2", Текст2, ?(Текст = "3", Текст3, Текст4)));
		Если Значение <> Неопределено Тогда
			Результат.Добавить(Сообщение(Значение, Истина, Истина));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция Сообщение(Текст, ЗаДень, Свой)

	Возврат Новый Структура("Текст, ЗаДень, Свой", Текст, ЗаДень, Свой);

КонецФункции

// Тексты комментариев через «|».
Функция Тексты(Итог)

	Строки = Новый Массив;
	Для Каждого Комментарий Из Итог.Комментарии Цикл
		Строки.Добавить(Комментарий.Текст);
	КонецЦикла;
	Возврат СтрСоединить(Строки, "|");

КонецФункции

// Текст из слов разной длины, ровно Длина символов, без переносов строк.
Функция СлучайныеСлова(Длина)

	Слова = СтрРазделить("обсудили настройку обмена с банком и порядок загрузки выписок клиент просит перезвонить", " ");
	Части = Новый Массив;
	Набрано = 0;
	Номер = 0;
	Пока Набрано < Длина Цикл
		Слово = Слова[Номер % Слова.Количество()];
		Части.Добавить(Слово);
		Набрано = Набрано + СтрДлина(Слово) + 1;
		Номер = Номер + 1;
	КонецЦикла;
	Возврат Лев(СтрСоединить(Части, " "), Длина);

КонецФункции

Функция ЗадачаДляМатериала(Название, Описание)

	Задача = Новый Соответствие;
	Задача.Вставить("id", "10740");
	Задача.Вставить("title", Название);
	Задача.Вставить("description", Описание);
	Задача.Вставить("descriptionInBbcode", "Y");
	Возврат Задача;

КонецФункции

Функция Запрос(Материал)

	Настройки = Новый Структура("Модель, Указания, Примеры, ПередаватьКомментарии", "gpt-test-model", "", "", Истина);
	Формулировки = Новый Массив;
	Формулировки.Добавить(Новый Структура("Шифр, Описание", "[ТЕСТ]01", "Установка 1С-Коннект на ПК ""чей"""));
	Возврат б24т_СодержаниеИИ.ЗапросСодержания(Материал, Настройки, Формулировки);

КонецФункции

Функция ПрочитатьТекстJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

// Имена полей соответствия по алфавиту через запятую.
Функция ИменаПолей(Данные)

	Список = Новый СписокЗначений;
	Для Каждого Поле Из Данные Цикл
		Список.Добавить(Поле.Ключ);
	КонецЦикла;
	Список.СортироватьПоЗначению();
	Возврат СтрСоединить(Список.ВыгрузитьЗначения(), ",");

КонецФункции

Функция ДанныеМакета(Имя)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьОбщийМакет(Имя).ПолучитьТекст());
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

#КонецОбласти
