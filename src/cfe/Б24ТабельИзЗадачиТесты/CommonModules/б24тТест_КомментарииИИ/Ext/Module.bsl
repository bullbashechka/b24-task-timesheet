Процедура Комментарии_Предел1500() Экспорт

	Длинный = СлучайныеСлова(2000);
	Итог = б24т_СодержаниеИИ.КомментарииДляИИ(Сообщения(Длинный, "Короткий."), Ложь);

	Первый = Итог.Комментарии[0];
	ЮТест.ОжидаетЧто(СтрДлина(Первый.Текст), "Длина обрезанного").МеньшеИлиРавно(1500);
	ЮТест.ОжидаетЧто(СтрДлина(Первый.Текст), "Обрезан по слову, а не до пустоты").Больше(1400);
	ЮТест.ОжидаетЧто(СтрНайти(Длинный, Первый.Текст), "Начало комментария").Равно(1);
	ЮТест.ОжидаетЧто(Сред(Длинный, СтрДлина(Первый.Текст) + 1, 1), "Обрезан по целому слову").Равно(" ");
	ЮТест.ОжидаетЧто(Первый.Обрезан, "Пометка «обрезан»").Равно(Истина);
	ЮТест.ОжидаетЧто(Итог.Комментарии[1].Обрезан, "Короткий не обрезан").Равно(Ложь);
	ЮТест.ОжидаетЧто(Итог.Обрезаны, "Все комментарии на месте").Равно(Ложь);

