Процедура Сборка_БезКомментариевКакРаньше() Экспорт

	Задача = ЗадачаДляМатериала("Установка 1С-Коннект", "Нужно установить 1С-Коннект.");
	БезПараметра = Запрос(б24т_СодержаниеИИ.МатериалЗадачи(Задача, "поставил коннект"));
	ПустыеКомментарии = Запрос(б24т_СодержаниеИИ.МатериалЗадачи(Задача, "поставил коннект",
		б24т_СодержаниеИИ.КомментарииДляИИ(Новый Массив, Ложь)));

	ЮТест.ОжидаетЧто(ПустыеКомментарии.Указания, "Указания").Равно(БезПараметра.Указания);
	ЮТест.ОжидаетЧто(ПустыеКомментарии.Вход, "Вход").Равно(БезПараметра.Вход);
	ЮТест.ОжидаетЧто(ИменаПолей(ПрочитатьТекстJSON(БезПараметра.Вход)), "Поля входа как на этапе 17")
		.Равно("description,description_truncated,draft,title");
	ЮТест.ОжидаетЧто(БезПараметра.Указания, "Раздела о комментариях нет").НеСодержит("# Комментарии задачи");
	ЮТест.ОжидаетЧто(БезПараметра.Указания, "Слова comments нет").НеСодержит("comments");

КонецПроцедуры

Процедура Сборка_СКомментариями() Экспорт

	Входные = Новый Массив;
	Входные.Добавить(Сообщение("База называется «Маркер-база».", Ложь, Ложь));
	Входные.Добавить(Сообщение("Сделал архив и обновил базу до релиза 3.0.72.1.", Истина, Истина));
	Комментарии = б24т_СодержаниеИИ.КомментарииДляИИ(Входные, Ложь);
	Запрос = Запрос(б24т_СодержаниеИИ.МатериалЗадачи(ЗадачаДляМатериала("Обновление базы", ""), "", Комментарии));

	Вход = ПрочитатьТекстJSON(Запрос.Вход);
	ЮТест.ОжидаетЧто(ИменаПолей(Вход), "Поля входа")
		.Равно("comments,comments_truncated,description,description_truncated,draft,title");
	ЮТест.ОжидаетЧто(Вход["comments"].Количество(), "Комментариев").Равно(2);
	ЮТест.ОжидаетЧто(ИменаПолей(Вход["comments"][0]), "Поля комментария").Равно("own,text,text_truncated,timesheet_day");
	ЮТест.ОжидаетЧто(Вход["comments"][0]["text"], "Первый — старый").Равно("База называется «Маркер-база».");
	ЮТест.ОжидаетЧто(Вход["comments"][0]["timesheet_day"], "Ранний").Равно(Ложь);
	ЮТест.ОжидаетЧто(Вход["comments"][0]["own"], "Чужой").Равно(Ложь);
	ЮТест.ОжидаетЧто(Вход["comments"][1]["timesheet_day"], "Дневной").Равно(Истина);
	ЮТест.ОжидаетЧто(Вход["comments"][1]["own"], "Свой").Равно(Истина);
	ЮТест.ОжидаетЧто(Вход["comments_truncated"], "Не обрезаны").Равно(Ложь);

	Правила = б24т_СодержаниеИИ.ПравилаОформления();
	Указания = Запрос.Указания;
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Указания, Правила), "Правила оформления первыми").ЭтоИстина();
	Позиция = СтрНайти(Указания, "# Комментарии задачи");
	ЮТест.ОжидаетЧто(Позиция > СтрДлина(Правила), "Раздел о комментариях после правил").ЭтоИстина();
	ЮТест.ОжидаетЧто(Позиция < СтрНайти(Указания, "# Стандартные формулировки"), "И до формулировок").ЭтоИстина();
