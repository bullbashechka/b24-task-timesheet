Процедура Расчёт_КлиентСКонтрагентом_ВызовКакПриРучномВводе() Экспорт

	Форма = ОткрытаяФормаНовогоТабеля();
	Контрагент = Неопределено;
	Попытка
		Контрагент = б24тТест_ТабельСтрокаСервер.НовыйКонтрагент("[ТЕСТ] Контрагент расчёта", "991000000002");
		Новая = Форма.б24т_ДобавитьСтроку(
			Данные(10180, ТипВремени("Клиент"), Вр(10, 0), Вр(11, 0), "Новая", Контрагент));

		// Тип «Клиент» с контрагентом: форма добавляет «Вызов» клиента (гем_Сервер.ПолучитьВызовКлиента), и
		// Зарплата = К оплате + Вызов к оплате, как при выборе контрагента вручную.
		ЮТест.ОжидаетЧто(Новая.Факт, "Факт").Равно(Вр(1, 0));
		ЮТест.ОжидаетЧто(Новая.Норма, "Норма").Равно(Вр(1, 0));
		ЮТест.ОжидаетЧто(Новая.КОплате, "К оплате").Равно(Вр(1, 0));
		ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Новая.ВызовКОплате), "Вызов к оплате заполнен").ЭтоИстина();
		ЮТест.ОжидаетЧто(Новая.ВызовКОплате, "Вызов к оплате").Равно(Новая.ВызовНорма);
		Ожидаемая = Вр(1, 0) + Час(Новая.ВызовКОплате) * 3600 + Минута(Новая.ВызовКОплате) * 60;
		ЮТест.ОжидаетЧто(Новая.Зарплата, "Зарплата").Равно(Ожидаемая);
	Исключение
		ЗакрытьБезЗаписи(Форма);
		б24тТест_ТабельСтрокаСервер.УдалитьОбъект(Контрагент);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьБезЗаписи(Форма);
	б24тТест_ТабельСтрокаСервер.УдалитьОбъект(Контрагент);

КонецПроцедуры

