Процедура Место_НеотсортированныйТабель_СтрокаНаСвоёмМесте() Экспорт

	Форма = ОткрытаяФормаНовогоТабеля();
	Попытка
		СтрокаТабеля(Форма, Вр(14, 0), Вр(15, 0), "Д");
		СтрокаТабеля(Форма, Вр(9, 0), Вр(10, 0), "А");
		СтрокаТабеля(Форма, Вр(11, 0), Вр(12, 0), "Б");

		Новая = Форма.б24т_ДобавитьСтроку(Данные(10180, ТипВремени("Офис"), Вр(10, 0), Вр(10, 30), "Новая"));

		ЮТест.ОжидаетЧто(Новая, "Добавленная строка").Существует();
		ЮТест.ОжидаетЧто(Содержания(Форма), "Порядок строк").Равно("А,Новая,Б,Д");
	Исключение
		ЗакрытьБезЗаписи(Форма);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьБезЗаписи(Форма);

КонецПроцедуры

