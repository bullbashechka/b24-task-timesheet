Функция ОткрытаяФормаНовогоТабеля()

	Возврат ОткрытьФорму("Документ.гем_Табель.Форма.ФормаДокумента");

КонецФункции

Процедура ЗакрытьБезЗаписи(Форма)

	Если Форма <> Неопределено И Форма.Открыта() Тогда
		Форма.Модифицированность = Ложь;
		Форма.Закрыть();
	КонецЕсли;

КонецПроцедуры

Функция Вр(Час, Минута)

	Возврат Дата(1, 1, 1, Час, Минута, 0);

КонецФункции

Функция ТипВремени(Имя)

	Возврат ПредопределенноеЗначение("Перечисление.гем_ТипыВремени." + Имя);

КонецФункции

// Результат окна (б24т_ЗаполнениеИзЗадачиКлиентСервер.ДанныеСтроки).
Функция Данные(НомерЗадачи, ТипВремени, Начало, Окончание, Содержание, Контрагент = Неопределено)

	Выбор = б24т_ЗаполнениеИзЗадачиКлиентСервер.НовыйВыбор();
	Выбор.Номер = НомерЗадачи;
	Если Контрагент <> Неопределено Тогда
		Выбор.Контрагент = Контрагент;
	КонецЕсли;
	Возврат б24т_ЗаполнениеИзЗадачиКлиентСервер.ДанныеСтроки(Выбор, ТипВремени, Начало, Окончание, Содержание);

КонецФункции

// Существующая строка табеля со своими значениями во всех колонках, чтобы заметить любое изменение.
Функция СтрокаТабеля(Форма, Начало, Окончание, Содержание)

	Строка = Форма.Объект.Табель.Добавить();
	Строка.ВремяНач = Начало;
	Строка.ВремяКон = Окончание;
	Строка.ТипВремени = ТипВремени("Офис");
	Строка.Содержание = Содержание;
	Строка.Заметки = "Заметка " + Содержание;
	Строка.Проезд = 7;
	Строка.Печать = Истина;
	Строка.Факт = Вр(1, 0);
	Строка.Норма = Вр(1, 15);
	Строка.КОплате = Вр(1, 30);
	Строка.Зарплата = Вр(1, 45);
	Строка.б24т_IDБ24 = "550";
	Возврат Строка;

КонецФункции

// Значения всех колонок строки по её «Содержание» (строка из формы) или самой строки.
Функция Снимок(Источник, Содержание = Неопределено)

	Строка = Источник;
	Если Содержание <> Неопределено Тогда
		Для Каждого Кандидат Из Источник.Объект.Табель Цикл
			Если Кандидат.Содержание = Содержание Тогда
				Строка = Кандидат;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Колонки = "ТипПП,ТипВремени,Контрагент,ВремяКон,ВремяНач,Факт,Проезд,Содержание,Норма,КОплате,Зарплата,Заметки,"
		+ "ВызовНорма,ВызовКОплате,Печать,RAAccessID,б24т_IDБ24";
	Значения = Новый Структура(Колонки);
	ЗаполнитьЗначенияСвойств(Значения, Строка);
	Возврат Значения;

КонецФункции

// «Содержание» строк табеля по порядку, через запятую.
Функция Содержания(Форма)

	Список = Новый Массив;
	Для Каждого Строка Из Форма.Объект.Табель Цикл
		Список.Добавить(Строка.Содержание);
	КонецЦикла;
	Возврат СтрСоединить(Список, ",");

КонецФункции

#КонецОбласти
