Процедура Поля_ПоТаблицеФ5() Экспорт

	Форма = ОткрытаяФормаНовогоТабеля();
	Контрагент = Неопределено;
	Попытка
		Контрагент = б24тТест_ТабельСтрокаСервер.НовыйКонтрагент("[ТЕСТ] Контрагент строки", "991000000001");
		Тип = ТипВремени("ОфисЗадания");

		Новая = Форма.б24т_ДобавитьСтроку(Данные(10180, Тип, Вр(10, 7), Вр(11, 0), "[ТЕСТ] Название задачи", Контрагент));

		ЮТест.ОжидаетЧто(Новая.Контрагент, "Контрагент").Равно(Контрагент);
		ЮТест.ОжидаетЧто(Новая.ТипВремени, "Тип времени").Равно(Тип);
		ЮТест.ОжидаетЧто(Новая.ВремяНач, "Время начала").Равно(Вр(10, 7));
		ЮТест.ОжидаетЧто(Новая.ВремяКон, "Время окончания").Равно(Вр(11, 0));
		ЮТест.ОжидаетЧто(Новая.Содержание, "Содержание").Равно("[ТЕСТ] Название задачи");
		ЮТест.ОжидаетЧто(Новая.б24т_IDБ24, "ID Б24").Равно("10180");
		ЮТест.ОжидаетЧто(Новая.ТипПП, "Тип ПП").Равно(ПредопределенноеЗначение("Перечисление.ГЕМ_ТипПП.ПустаяСсылка"));
		ЮТест.ОжидаетЧто(Новая.Печать, "Печать").ЭтоЛожь();
		ЮТест.ОжидаетЧто(Новая.Проезд, "Проезд").Равно(0);
		ЮТест.ОжидаетЧто(Новая.Заметки, "Заметки").Равно("");
		ЮТест.ОжидаетЧто(Новая.RAAccessID, "RAAccessID").Равно("");
	Исключение
		ЗакрытьБезЗаписи(Форма);
		б24тТест_ТабельСтрокаСервер.УдалитьОбъект(Контрагент);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьБезЗаписи(Форма);
	б24тТест_ТабельСтрокаСервер.УдалитьОбъект(Контрагент);

