#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Вр(Час, Минута)

	Возврат Дата(1, 1, 1, Час, Минута, 0);

КонецФункции

Функция СтрокаТабеля(НомерСтроки, ВремяНач, ВремяКон)

	Возврат Новый Структура("НомерСтроки, ВремяНач, ВремяКон", НомерСтроки, ВремяНач, ВремяКон);

КонецФункции

// Строка списка задач в том виде, как её отдаёт б24т_Задачи.СписокЗадач (нужные окну поля).
Функция СтрокаСписка(Номер, Название)

	Строка = Новый Структура;
	Строка.Вставить("Номер", Номер);
	Строка.Вставить("Название", Название);
	Строка.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Строка.Вставить("БИН", "123456789012");
	Строка.Вставить("ТекстКонтрагента", "найден в 1С по БИН 123456789012");
	Возврат Строка;

КонецФункции

Функция ВыбранаЗадача(Номер)

	Возврат б24т_ЗаполнениеИзЗадачиКлиентСервер.ВыбратьИзСписка(
		б24т_ЗаполнениеИзЗадачиКлиентСервер.НовыйВыбор(), СтрокаСписка(Номер, "[ТЕСТ] Задача " + Формат(Номер, "ЧГ=0")));

КонецФункции

// Результат б24т_Задачи.ЗадачаПоНомеру (нужные окну поля).
Функция РезультатНомера(Итог, Сообщение, Номер, Название)

	Результат = Новый Структура;
	Результат.Вставить("Итог", Итог);
	Результат.Вставить("Сообщение", Сообщение);
	Результат.Вставить("Номер", Номер);
	Если Итог = "Выбрана" Тогда
		Результат.Вставить("Задача", СтрокаСписка(Номер, Название));
		Результат.Задача.Вставить("МояРоль", "Исполнитель");
	Иначе
		Результат.Вставить("Задача", Неопределено);
	КонецЕсли;
	Возврат Результат;

КонецФункции

#КонецОбласти
