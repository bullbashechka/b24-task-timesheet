Процедура ОшибкиВремени_ОкончаниеНеПозжеНачала() Экспорт

	Равные = б24т_ЗаполнениеИзЗадачиКлиентСервер.ОшибкиВремени(Вр(10, 0), Вр(10, 0));
	Раньше = б24т_ЗаполнениеИзЗадачиКлиентСервер.ОшибкиВремени(Вр(10, 0), Вр(9, 0));

	Для Каждого Ошибки Из Новый Структура("Равные, Раньше", Равные, Раньше) Цикл
		ЮТест.ОжидаетЧто(Ошибки.Значение.ОшибкаНачала, "Ошибка начала, " + Ошибки.Ключ).Равно("");
		ЮТест.ОжидаетЧто(Ошибки.Значение.ОшибкаОкончания, "Ошибка окончания, " + Ошибки.Ключ)
			.Равно("Время окончания должно быть позже времени начала");
	КонецЦикла;

