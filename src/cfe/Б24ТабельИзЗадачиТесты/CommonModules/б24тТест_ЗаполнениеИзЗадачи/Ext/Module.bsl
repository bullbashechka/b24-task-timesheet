Процедура ТипыВремени_ТринадцатьЗначенийВПорядкеПеречисления() Экспорт

	Типы = б24т_ЗаполнениеИзЗадачи.ТипыВремениОкна();

	Ожидаемые = "Клиент,КлиентНеоплачиваемаяУстановкаПО,КлиентНеоплачиваемое,КлиентОфис,КлиентТК,КлиентУдаленныйДоступ,"
		+ "КлиентКласс,КлиентВнешниеОтчеты,Офис,ОфисЗадания,ОфисЛинияКонсультации,КлиентОбъем,КлиентЧасыПоТарифу";
	Ожидаемые = СтрРазделить(Ожидаемые, ",");
	ЮТест.ОжидаетЧто(Типы.Количество(), "Количество типов").Равно(Ожидаемые.Количество());
	Для Индекс = 0 По Ожидаемые.ВГраница() Цикл
		ЮТест.ОжидаетЧто(Типы[Индекс], "Тип " + Формат(Индекс + 1, "ЧГ=0"))
			.Равно(Перечисления.гем_ТипыВремени[Ожидаемые[Индекс]]);
	КонецЦикла;

КонецПроцедуры

