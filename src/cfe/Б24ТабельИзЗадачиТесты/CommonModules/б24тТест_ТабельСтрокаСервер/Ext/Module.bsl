// Серверные помощники клиентских тестов добавления строки (б24тТест_ТабельСтрокаИзЗадачиКлиент): данные в базе, которые
// клиентский код создать не может. Тестов в модуле нет. Все данные — «[ТЕСТ]», тест сам их удаляет.

#Область СлужебныйПрограммныйИнтерфейс

Функция НовыйКонтрагент(Наименование, Номер) Экспорт

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ИНН = Номер;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура УдалитьОбъект(Ссылка) Экспорт

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект <> Неопределено Тогда
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЕсли;

КонецПроцедуры

// Записанный (не проведённый) табель с одной строкой, без проверок и подписок.
Функция НовыйЗаписанныйТабель(Комментарий) Экспорт

	Объект = Документы.гем_Табель.СоздатьДокумент();
	Объект.Дата = ТекущаяДатаСеанса();
	Объект.Комментарий = Комментарий;
	Объект.Автор = Пользователи.АвторизованныйПользователь();
	Объект.Сотрудник = Объект.Автор.ФизическоеЛицо;
	Строка = Объект.Табель.Добавить();
	Строка.ВремяНач = Дата(1, 1, 1, 9, 0, 0);
	Строка.ВремяКон = Дата(1, 1, 1, 10, 0, 0);
	Строка.ТипВремени = Перечисления.гем_ТипыВремени.Офис;
	Строка.Содержание = "[ТЕСТ] Существующая строка";
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Функция ЧислоТабелей() Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ Документ.гем_Табель КАК Т");
	Возврат Запрос.Выполнить().Выгрузить()[0].Количество;

КонецФункции

Функция ВерсияДанных(Ссылка) Экспорт

	Запрос = Новый Запрос("ВЫБРАТЬ Т.ВерсияДанных КАК Версия ИЗ Документ.гем_Табель КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выгрузка = Запрос.Выполнить().Выгрузить();
	Возврат ?(Выгрузка.Количество() = 0, "", Выгрузка[0].Версия);

КонецФункции

Функция ЧислоСтрок(Ссылка) Экспорт

	Возврат Ссылка.Табель.Количество();

КонецФункции

#КонецОбласти
