Процедура ЗаписьИИ_ЖурналБезЗначений() Экспорт

	СброситьНастройки();
	Начало = ТекущаяДатаСеанса() - 5;

	Ошибки = б24т_Настройки.ЗаписатьНастройки(ИзмененияИИ(Новый Структура(
		"ИспользоватьИИ, НовыйКлюч, МодельИИ, УказанияДляИИ, ПримерыСтрокТабеля",
		Истина, КлючПример(), "gpt-journal-model", "СекретныеУказанияЖурнала", "СекретныйПримерЖурнала")));
	ЮТест.ОжидаетЧто(ОшибкиТекстом(Ошибки), "Ошибки").Равно("");
	// В журнале могут быть записи других тестов за те же секунды: названия полей ищем хотя бы в одной записи,
	// а отсутствие значений проверяем во всех.
	ЕстьЗаписьОПолях = Ложь;

	ТаблицаЖурнала = Новый ТаблицаЗначений;
	Фильтр = Новый Структура;
	Фильтр.Вставить("ДатаНачала", Начало);
	Фильтр.Вставить("Событие", "Б24ТабельИзЗадачи.Настройки");
	ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Фильтр);

	ЮТест.ОжидаетЧто(ТаблицаЖурнала.Количество(), "Записей журнала").БольшеИлиРавно(1);
	Для Каждого Запись Из ТаблицаЖурнала Цикл
		Текст = Запись.Комментарий + " " + Запись.Данные + " " + Запись.ПредставлениеДанных;
		Если СтрНайти(Текст, "ключ OpenAI") > 0 И СтрНайти(Текст, "использование ИИ") > 0 И СтрНайти(Текст, "модель ИИ") > 0
			И СтрНайти(Текст, "дополнительные указания для ИИ") > 0 И СтрНайти(Текст, "примеры строк табеля") > 0 Тогда
			ЕстьЗаписьОПолях = Истина;
		КонецЕсли;
		ЮТест.ОжидаетЧто(СтрНайти(Текст, "TESTkey"), "Ключ в записи журнала").Равно(0);
		ЮТест.ОжидаетЧто(СтрНайти(Текст, "gpt-journal-model"), "Модель в записи журнала").Равно(0);
		ЮТест.ОжидаетЧто(СтрНайти(Текст, "СекретныеУказанияЖурнала"), "Указания в записи журнала").Равно(0);
		ЮТест.ОжидаетЧто(СтрНайти(Текст, "СекретныйПримерЖурнала"), "Примеры в записи журнала").Равно(0);
	КонецЦикла;
	ЮТест.ОжидаетЧто(ЕстьЗаписьОПолях, "Есть запись с названиями всех изменённых полей ИИ").Равно(Истина);

