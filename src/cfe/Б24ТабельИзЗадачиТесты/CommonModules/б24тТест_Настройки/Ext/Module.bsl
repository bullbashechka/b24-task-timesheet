Процедура Запись_ЖурналБезАдреса() Экспорт

	СброситьНастройки();
	Начало = ТекущаяДатаСеанса() - 5;

	Ошибки = б24т_Настройки.ЗаписатьНастройки(Изменения(АдресПример(), Ложь, Истина, 38));
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Ошибок").Равно(0);

	ТаблицаЖурнала = Новый ТаблицаЗначений;
	Фильтр = Новый Структура;
	Фильтр.Вставить("ДатаНачала", Начало);
	Фильтр.Вставить("Событие", "Б24ТабельИзЗадачи.Настройки");
	ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Фильтр);

