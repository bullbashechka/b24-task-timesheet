Процедура Адрес_НормализуетсяДоКаноническогоВида() Экспорт

	Эталон = АдресПример();
	Случаи = Новый Соответствие;
	Случаи.Вставить(Эталон, Эталон);
	Случаи.Вставить("https://portal.bitrix24.kz/rest/30/abc123token", Эталон);
	Случаи.Вставить("  " + Эталон + " " + Символы.ПС, Эталон);
	Случаи.Вставить(Символы.Таб + Эталон + Символы.ВК + Символы.ПС, Эталон);
	Случаи.Вставить(Эталон + "profile.json", Эталон);
	Случаи.Вставить(Эталон + "user.get", Эталон);
	Случаи.Вставить("HTTPS://Portal.Bitrix24.kz/rest/30/abc123token/", Эталон);
	Случаи.Вставить("https://Company.Bitrix24.Com.Br/rest/1/k1/", "https://company.bitrix24.com.br/rest/1/k1/");
	Случаи.Вставить("https://my-company.bitrix24.ru/rest/1/k1/", "https://my-company.bitrix24.ru/rest/1/k1/");

	Для Каждого Случай Из Случаи Цикл
		ЮТест.ОжидаетЧто(б24т_Настройки.НормализованныйАдресВебхука(Случай.Ключ), "Адрес «" + Случай.Ключ + "»")
			.Равно(Случай.Значение);
	КонецЦикла;

КонецПроцедуры

