// Вызывает функцию общего модуля б24т_Настройки с пользователем в качестве второго параметра (в привилегированном
// режиме: чужого пользователя продукт принимает только от тестов).
// Возвращает краткий текст исключения или Неопределено, если исключения не было.
Функция ТекстИсключения(ИмяМетода, Пользователь, Изменения = Неопределено)

	// Под текущим пользователем — без привилегированного режима: в нём полноправным считается любой.
	ЧужойПользователь = Пользователь <> Неопределено;
	Если ЧужойПользователь Тогда
		УстановитьПривилегированныйРежим(Истина);
	КонецЕсли;
	ТекстОшибки = Неопределено;
	Попытка
		Если ИмяМетода = "ПроверитьПраваНаНастройку" Тогда
			б24т_Настройки.ПроверитьПраваНаНастройку(Пользователь);
		Иначе
			б24т_Настройки.ЗаписатьНастройки(Изменения, Пользователь);
		КонецЕсли;
	Исключение
		ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Если ЧужойПользователь Тогда
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;
	Возврат ТекстОшибки;

КонецФункции

// Имена ролей, у которых есть право на объект, через запятую.
Функция РолиСПравом(Право, ОбъектМетаданных)

	Имена = Новый Массив;
	Для Каждого Роль Из Метаданные.Роли Цикл
		Если ПравоДоступа(Право, ОбъектМетаданных, Роль) Тогда
			Имена.Добавить(Роль.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

// Клиент Битрикс24 с заглушкой, в очереди пять ответов проверки подключения по порядку вызовов:
// user.admin, user.get, tasks.task.list, crm.company.list, sonet_group.get.
//
// Параметры:
//  Замены - Соответствие - номер ответа (с единицы) в случай макета или «ИСКЛЮЧЕНИЕ».
//
Функция КлиентПроверки(Замены = Неопределено)

	Случаи = СтрРазделить("user_admin_Да,user_get_Найден,tasks_task_list_Пусто,crm_company_list_Пусто,sonet_group_get_Проект", ",");
	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	Для Номер = 1 По Случаи.Количество() Цикл
		Случай = Случаи[Номер - 1];
		Если Замены <> Неопределено И Замены[Номер] <> Неопределено Тогда
			Случай = Замены[Номер];
		КонецЕсли;
		Если Случай = "ИСКЛЮЧЕНИЕ" Тогда
			б24тТест_ЗаглушкаТранспорта.ДобавитьИсключение(Клиент, "Таймаут операции");
		Иначе
			б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(Клиент, Случай);
		КонецЕсли;
	КонецЦикла;
	Возврат Клиент;

КонецФункции

Функция Замены(Номер, Случай)

	Результат = Новый Соответствие;
	Результат.Вставить(Номер, Случай);
	Возврат Результат;

КонецФункции

Функция ПараметрыПроверки()

	Возврат Изменения(АдресПример(), Ложь, Истина, 38);

КонецФункции

