// Проверка подключения с заглушкой: свой клиент и чужой пользователь допустимы только в привилегированном режиме.
Функция ПроверитьПодключение(Параметры, Клиент, Пользователь = Неопределено)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Строки = б24т_Настройки.ПроверитьПодключение(Параметры, Пользователь, Клиент);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Строки;

КонецФункции

Функция АдресПример()

	Возврат "https://portal.bitrix24.kz/rest/30/abc123token/";

КонецФункции

Функция Изменения(НовыйАдрес, УдалитьАдрес, РежимТестирования, ПроектДляТестирования)

	Результат = Новый Структура;
	Результат.Вставить("НовыйАдрес", НовыйАдрес);
	Результат.Вставить("УдалитьАдрес", УдалитьАдрес);
	Результат.Вставить("РежимТестирования", РежимТестирования);
	Результат.Вставить("ПроектДляТестирования", ПроектДляТестирования);
	Возврат Результат;

КонецФункции

// Приводит настройки к чистому состоянию внутри транзакции теста. Настоящий вебхук не затрагивается:
// транзакция откатывается.
Процедура СброситьНастройки()

	УстановитьПривилегированныйРежим(Истина);
