	б24т_Настройки.ЗаписатьНастройки(Изменения(АдресПример(), Ложь, Истина, 38));

	ЮТест.ОжидаетЧто(АдресИзХранилища(), "Адрес в безопасном хранилище").Равно(АдресПример());

