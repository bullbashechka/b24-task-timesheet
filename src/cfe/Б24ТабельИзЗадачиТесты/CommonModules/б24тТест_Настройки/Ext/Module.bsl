// Настройки ИИ напрямую в константах и хранилище, минуя ЗаписатьНастройки. Пустой ключ стирает ключ.
Процедура УстановитьИИ(Флажок, Ключ, Модель = "", Указания = "", Примеры = "")

	УстановитьПривилегированныйРежим(Истина);
	Константы.б24т_ИспользоватьИИ.Установить(Флажок);
	Константы.б24т_МодельИИ.Установить(Модель);
	Константы.б24т_УказанияДляИИ.Установить(Указания);
	Константы.б24т_ПримерыСтрокТабеля.Установить(Примеры);
	Если ПустаяСтрока(Ключ) Тогда
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючЗаписиOpenAI());
	Иначе
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецХранилища(), Ключ, КлючЗаписиOpenAI());
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

// Ставит признак блокировки внешних ресурсов БСП (параметр сеанса) и возвращает прежнее значение.
// Откат транзакции параметр сеанса не возвращает: вызывающий код восстанавливает его сам.
Функция УстановитьБлокировкуВнешнихРесурсов(Значение)

	УстановитьПривилегированныйРежим(Истина);
	Прежнее = ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована;
	ПараметрыСеанса.РаботаСВнешнимиРесурсамиЗаблокирована = Значение;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Прежнее;

КонецФункции

// Читает настройки и данные формы при заданной блокировке внешних ресурсов, затем возвращает блокировку как была.
Функция ПрочитатьПриБлокировке(Заблокировано)

	Прежнее = УстановитьБлокировкуВнешнихРесурсов(Заблокировано);
	Результат = Новый Структура;
	Попытка
		Результат.Вставить("Настройки", б24т_Настройки.Настройки());
		Результат.Вставить("Данные", б24т_Настройки.ДанныеФормыНастроек());
	Исключение
		УстановитьБлокировкуВнешнихРесурсов(Прежнее);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьБлокировкуВнешнихРесурсов(Прежнее);
	Возврат Результат;

КонецФункции

Функция ИИДоступенСейчас()

	Возврат ПрочитатьПриБлокировке(Ложь).Настройки.ИИДоступен;

КонецФункции

