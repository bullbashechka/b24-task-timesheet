Функция Изменения(НовыйАдрес, УдалитьАдрес, РежимТестирования, ПроектДляТестирования)

	Результат = Новый Структура;
	Результат.Вставить("НовыйАдрес", НовыйАдрес);
	Результат.Вставить("УдалитьАдрес", УдалитьАдрес);
	Результат.Вставить("РежимТестирования", РежимТестирования);
	Результат.Вставить("ПроектДляТестирования", ПроектДляТестирования);
	Возврат Результат;

КонецФункции

// Приводит настройки к чистому состоянию внутри транзакции теста. Настоящий вебхук не затрагивается:
// транзакция откатывается.
Процедура СброситьНастройки()

	УстановитьПривилегированныйРежим(Истина);
	Константы.б24т_РежимТестирования.Установить(Ложь);
	Константы.б24т_ПроектДляТестирования.Установить(0);
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецХранилища(), "АдресВебхука");
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция АдресИзХранилища()

	УстановитьПривилегированныйРежим(Истина);
	Адрес = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецХранилища(), "АдресВебхука");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Адрес;

КонецФункции

Функция ВладелецХранилища()

	Возврат "Б24ТабельИзЗадачи";

КонецФункции

Функция ТестовыйПользовательБезПрав()

	Пользователь = Справочники.Пользователи.СоздатьЭлемент();
	Пользователь.Наименование = "[ТЕСТ] Пользователь без прав для настроек Б24";
	Пользователь.ОбменДанными.Загрузка = Истина;
	Пользователь.Записать();
	Возврат Пользователь.Ссылка;

КонецФункции

// Вызывает функцию общего модуля б24т_Настройки с пользователем в качестве второго параметра.
// Возвращает краткий текст исключения или Неопределено, если исключения не было.
Функция ТекстИсключения(ИмяМетода, Пользователь, Изменения = Неопределено)

	Попытка
		Если ИмяМетода = "ПроверитьПраваНаНастройку" Тогда
			б24т_Настройки.ПроверитьПраваНаНастройку(Пользователь);
		Иначе
			б24т_Настройки.ЗаписатьНастройки(Изменения, Пользователь);
		КонецЕсли;
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

// Имена ролей, у которых есть право на объект, через запятую.
Функция РолиСПравом(Право, ОбъектМетаданных)

	Имена = Новый Массив;
	Для Каждого Роль Из Метаданные.Роли Цикл
		Если ПравоДоступа(Право, ОбъектМетаданных, Роль) Тогда
			Имена.Добавить(Роль.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Имена, ",");

КонецФункции

#КонецОбласти
