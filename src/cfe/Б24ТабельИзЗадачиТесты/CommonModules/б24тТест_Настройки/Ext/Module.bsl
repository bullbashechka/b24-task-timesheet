	Константы.б24т_ИспользоватьИИ.Установить(Ложь);
	Константы.б24т_МодельИИ.Установить("");
	Константы.б24т_УказанияДляИИ.Установить("");
	Константы.б24т_ПримерыСтрокТабеля.Установить("");
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючЗаписиOpenAI());
	УстановитьПривилегированныйРежим(Ложь);

