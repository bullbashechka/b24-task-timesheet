	Для Каждого Поле Из Настройки Цикл
		ЮТест.ОжидаетЧто(СтрНайти(Строка(Поле.Значение), "abc123token"), "Ключ в поле " + Поле.Ключ).Равно(0);
		ЮТест.ОжидаетЧто(СтрНайти(Строка(Поле.Значение), "portal.bitrix24.kz"), "Адрес в поле " + Поле.Ключ)
			.Равно(0);
	КонецЦикла;

