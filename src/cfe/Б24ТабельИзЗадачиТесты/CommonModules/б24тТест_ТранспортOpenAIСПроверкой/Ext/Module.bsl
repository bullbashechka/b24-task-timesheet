// Транспорт OpenAI «со смотрящим» для живого прогона (этап 20, С30). Перед отправкой смотрит на настоящее тело запроса:
// запрещённый фрагмент (пароль из комментария или описания) в OpenAI не уходит — вместо ответа 400 с ошибкой, а
// обязательный («***» вместо пароля) только отмечается в причинах. Остальное передаёт исходному транспорту
// (б24т_ТранспортOpenAI или заглушка). Причины — только номера проверок: тексты фрагментов в них, в ответе и в журнале не
// попадают. Модуль только для тестового расширения; клиент с этим транспортом создаёт НовыйКлиент.

#Область ПрограммныйИнтерфейс

// Транспорт: проверяет тело запроса и записывает причины в Запрос.Клиент.Проверка.Причины.
//
// Параметры:
//  Запрос - Структура - Тело, Ключ, Таймаут, Клиент (клиент, созданный НовыйКлиент).
//
// Возвращаемое значение:
//  Структура - КодСостояния, Тело, ИдентификаторЗапроса, как у транспорта OpenAI.
//
Функция ВыполнитьЗапрос(Запрос) Экспорт

	Проверка = Запрос.Клиент.Проверка;
	Проверка.Вызовов = Проверка.Вызовов + 1;
	Причины = ПроверкаТела(Запрос.Тело, Проверка.Нельзя, Проверка.Обязано);

	Запрещено = Ложь;
	Для Каждого Причина Из Причины Цикл
		Проверка.Причины.Добавить(Причина);
		Запрещено = Запрещено Или СтрНачинаетсяС(Причина, ПрефиксЗапрещённого());
	КонецЦикла;

	Если Запрещено Тогда
		Возврат Новый Структура("КодСостояния, Тело, ИдентификаторЗапроса", 400, ТелоОшибкиОстановки(), "");
	КонецЕсли;

	Исходный = ОбщегоНазначения.ОбщийМодуль(Проверка.ИсходныйТранспорт);
	Возврат Исходный.ВыполнитьЗапрос(Запрос);

КонецФункции

// Клиент OpenAI с этим транспортом.
//
// Параметры:
//  Нельзя - Массив из Строка - фрагменты, которых в теле запроса быть не должно.
//  Обязано - Массив из Строка - фрагменты, которые в теле запроса должны быть.
//  ИсходныйТранспорт - Строка - общий модуль, которому уходит чистый запрос.
//
// Возвращаемое значение:
//  Структура - клиент б24т_OpenAI; Проверка.Причины и Проверка.Вызовов (сколько запросов дошло до проверки) заполняет
//    транспорт.
//
Функция НовыйКлиент(Нельзя, Обязано, ИсходныйТранспорт = "б24т_ТранспортOpenAI") Экспорт

	Клиент = б24т_OpenAI.НовыйКлиент("б24тТест_ТранспортOpenAIСПроверкой");

	Проверка = Новый Структура;
	Проверка.Вставить("Нельзя", Нельзя);
	Проверка.Вставить("Обязано", Обязано);
	Проверка.Вставить("ИсходныйТранспорт", ИсходныйТранспорт);
	Проверка.Вставить("Причины", Новый Массив);
	Проверка.Вставить("Вызовов", 0);
	Клиент.Вставить("Проверка", Проверка);
	Возврат Клиент;

КонецФункции

// Проверяет тело запроса.
//
// Возвращаемое значение:
//  Массив из Строка - причины с номером фрагмента («в запросе запрещённый фрагмент 1», «в запросе нет обязательного
//    фрагмента 1»); пусто, если всё в порядке.
//
Функция ПроверкаТела(Тело, Нельзя, Обязано) Экспорт

	Причины = Новый Массив;

	Номер = 0;
	Для Каждого Фрагмент Из Нельзя Цикл
		Номер = Номер + 1;
		Если СтрНайти(Тело, Фрагмент) > 0 Тогда
			Причины.Добавить(ПрефиксЗапрещённого() + Формат(Номер, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;

	Номер = 0;
	Для Каждого Фрагмент Из Обязано Цикл
		Номер = Номер + 1;
		Если СтрНайти(Тело, Фрагмент) = 0 Тогда
			Причины.Добавить("в запросе нет обязательного фрагмента " + Формат(Номер, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;

	Возврат Причины;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрефиксЗапрещённого()

	Возврат "в запросе запрещённый фрагмент ";

КонецФункции

// Тело ответа, каким OpenAI отвечает на неверный запрос: клиент б24т_OpenAI разбирает его как обычную ошибку.
Функция ТелоОшибкиОстановки()

	Ошибка = Новый Структура;
	Ошибка.Вставить("message", "Запрос остановлен проверкой тестового транспорта");
	Ошибка.Вставить("type", "invalid_request_error");
	Ошибка.Вставить("code", "test_transport_blocked");

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("error", Ошибка));
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти
