// Даты Битрикс24

Процедура Дата_ПереводитсяСУчётомПояса() Экспорт

	Текст = "2026-10-15T20:40:55+05:00";

	ЮТест.ОжидаетЧто(б24т_Задачи.ДатаБитрикс24(Текст, 5 * 3600), "Пояс +05:00 в +05:00").Равно(Дата(2026, 10, 15, 20, 40, 55));
	ЮТест.ОжидаетЧто(б24т_Задачи.ДатаБитрикс24(Текст, 3 * 3600), "Пояс +05:00 в +03:00").Равно(Дата(2026, 10, 15, 18, 40, 55));
	ЮТест.ОжидаетЧто(б24т_Задачи.ДатаБитрикс24(Текст, 0), "Пояс +05:00 в UTC").Равно(Дата(2026, 10, 15, 15, 40, 55));

КонецПроцедуры

