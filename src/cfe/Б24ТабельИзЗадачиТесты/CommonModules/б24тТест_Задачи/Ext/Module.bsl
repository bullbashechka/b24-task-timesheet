Процедура Роли_НаблюдательНеРоль() Экспорт

	Данные = Новый Соответствие;
	Данные.Вставить("77", Пара("id", "77"));
	Задача = НоваяЗадача(1, Новый Структура("auditors, auditorsData, accomplicesData", МассивСтрок("28"), Данные, Данные));

	ЮТест.ОжидаетЧто(б24т_Задачи.РолиВЗадаче(Задача, 28).Количество(), "Наблюдатель").Равно(0);
	ЮТест.ОжидаетЧто(б24т_Задачи.РолиВЗадаче(Задача, 77).Количество(), "Только в *Data").Равно(0);
	ЮТест.ОжидаетЧто(б24т_Задачи.ПредставлениеРолей(Новый Массив), "Представление без ролей").Равно("");

