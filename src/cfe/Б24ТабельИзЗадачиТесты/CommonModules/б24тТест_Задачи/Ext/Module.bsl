Процедура Компании_Представление() Экспорт

	Названия = Новый Соответствие;
	Названия.Вставить(2926, "[ТЕСТ] Дальстрой");
	Названия.Вставить(2928, "[ТЕСТ] ИП Архаров");

	ЮТест.ОжидаетЧто(б24т_Задачи.ПредставлениеКомпаний(Новый Массив, Названия), "Нет компаний").Равно("—");
	ЮТест.ОжидаетЧто(б24т_Задачи.ПредставлениеКомпаний(МассивЧисел("2926"), Названия), "Одна компания")
		.Равно("[ТЕСТ] Дальстрой");
	ЮТест.ОжидаетЧто(б24т_Задачи.ПредставлениеКомпаний(МассивЧисел("2926, 555"), Названия), "Вторая удалена")
		.Равно("[ТЕСТ] Дальстрой");
	ЮТест.ОжидаетЧто(б24т_Задачи.ПредставлениеКомпаний(МассивЧисел("555"), Названия), "Единственная удалена").Равно("—");
	ЮТест.ОжидаетЧто(б24т_Задачи.ПредставлениеКомпаний(МассивЧисел("2926, 2928"), Названия), "Две").Равно("2 компании");

