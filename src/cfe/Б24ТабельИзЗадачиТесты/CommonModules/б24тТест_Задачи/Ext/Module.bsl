// Список задач с заглушкой и тестовым пользователем: продукт принимает их только в привилегированном режиме.
Функция СписокЗадач(Окружение, ДатаТабеля, Клиент)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = б24т_Задачи.СписокЗадач(Окружение.ФизическоеЛицо, ДатаТабеля, Окружение.Пользователь, Клиент);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

