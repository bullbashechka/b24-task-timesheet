	Задача = НоваяЗадача(1, Новый Структура("ufCrmTask", МассивСтрок("CO_2926, D_5, C_7, CO_2926, CO_x, CO_, L_9, CO_2928")));

	ИДКомпаний = б24т_Задачи.ИДКомпанийЗадачи(Задача);

	ЮТест.ОжидаетЧто(ИДКомпаний.Количество(), "Компаний").Равно(2);
