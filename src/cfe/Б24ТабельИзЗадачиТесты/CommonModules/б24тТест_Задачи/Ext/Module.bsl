#Область СлужебныеПроцедурыИФункции

// Задача в виде ответа tasks.task.list: свойства по умолчанию можно заменить структурой Свойства.
Функция НоваяЗадача(Номер, Свойства = Неопределено)

	Задача = Новый Соответствие;
	Задача.Вставить("id", Формат(Номер, "ЧГ=0"));
	Задача.Вставить("title", "[ТЕСТ] Задача " + Формат(Номер, "ЧГ=0"));
	Задача.Вставить("createdBy", "26");
	Задача.Вставить("responsibleId", "30");
	Задача.Вставить("accomplices", Новый Массив);
	Задача.Вставить("auditors", Новый Массив);
	Задача.Вставить("status", "2");
	Задача.Вставить("groupId", "38");
	Задача.Вставить("ufCrmTask", ПустоеЗначениеJSON());
	Задача.Вставить("closedDate", ПустоеЗначениеJSON());
	Задача.Вставить("deadline", "2026-10-16T19:00:00+05:00");
	Задача.Вставить("activityDate", "2026-10-15T20:40:55+05:00");
	Если Свойства <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Свойства Цикл
			Задача.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Возврат Задача;

КонецФункции

Функция ЗадачаИзШаблона(Случай, Номер)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(б24тТест_ЗаглушкаТранспорта.ТекстМакета(Случай));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Для Каждого Задача Из Данные["result"]["tasks"] Цикл
		Если Задача["id"] = Формат(Номер, "ЧГ=0") Тогда
			Возврат Задача;
		КонецЕсли;
	КонецЦикла;
	ВызватьИсключение "В макете " + Случай + " нет задачи " + Номер;

КонецФункции

