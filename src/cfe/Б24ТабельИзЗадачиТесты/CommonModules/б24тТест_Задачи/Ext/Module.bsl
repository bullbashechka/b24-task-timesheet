// Список задач сотрудника

Процедура СписокЗадач_МетодыИПараметры() Экспорт

	Окружение = НовоеОкружениеЗадач();
	Клиент = КлиентСписка(50, Новый Массив, Новый Массив);

	Результат = СписокЗадач(Окружение, Дата(2026, 10, 22, 15, 0, 0), Клиент);

	ЮТест.ОжидаетЧто(Результат.Успех, "Успех").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Задачи.Количество(), "Задач").Равно(0);
	ЮТест.ОжидаетЧто(б24тТест_Доступ.МетодыВызовов(Клиент), "Методы по порядку").Равно(
		"user.admin,user.get,tasks.task.list,tasks.task.list");

	Постановщики = Клиент.Вызовы[2].Параметры;
	Подфильтр = Постановщики["filter"]["::SUBFILTER-R"];
	ЮТест.ОжидаетЧто(Подфильтр["::LOGIC"], "Логика").Равно("OR");
	ЮТест.ОжидаетЧто(Подфильтр["CREATED_BY"], "Постановщик — ID сотрудника, не владельца вебхука").Равно(50);
	ЮТест.ОжидаетЧто(Подфильтр["RESPONSIBLE_ID"], "Исполнитель — ID сотрудника").Равно(50);
	ЮТест.ОжидаетЧто(Клиент.Вызовы[3].Параметры["filter"]["ACCOMPLICE"], "Соисполнитель — ID сотрудника").Равно(50);

	Для Каждого НомерВызова Из СтрРазделить("2,3", ",") Цикл
		Параметры = Клиент.Вызовы[Число(НомерВызова)].Параметры;
		Статус = Параметры["filter"]["::SUBFILTER-ST"];
		ЮТест.ОжидаетЧто(Статус["::LOGIC"], "Логика статуса " + НомерВызова).Равно("OR");
		ЮТест.ОжидаетЧто(Статус["!REAL_STATUS"], "Не завершена " + НомерВызова).Равно(5);
		// Граница 22.09 минус сутки на разницу часовых поясов, точный отбор делает 1С.
		ЮТест.ОжидаетЧто(Статус[">=CLOSED_DATE"], "Завершена не раньше " + НомерВызова).Равно("21.09.2026 00:00:00");
		ЮТест.ОжидаетЧто(Параметры["filter"].Получить("GROUP_ID"), "Проект не задан " + НомерВызова).Равно(Неопределено);
		ЮТест.ОжидаетЧто(Параметры["order"]["ID"], "Сначала новые " + НомерВызова).Равно("desc");
	КонецЦикла;

