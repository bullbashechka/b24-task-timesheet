Процедура Статус_НазванияПоКоду() Экспорт

	Ожидаемые = Новый Соответствие;
	Ожидаемые.Вставить("1", "Новая");
	Ожидаемые.Вставить("2", "Ждёт выполнения");
	Ожидаемые.Вставить("3", "Выполняется");
	Ожидаемые.Вставить("4", "Ждёт контроля");
	Ожидаемые.Вставить("5", "Завершена");
	Ожидаемые.Вставить("6", "Отложена");
	Ожидаемые.Вставить("7", "Отклонена");
	Ожидаемые.Вставить("99", "99");
	Для Каждого Пара Из Ожидаемые Цикл
		ЮТест.ОжидаетЧто(б24т_Задачи.НазваниеСтатуса(Пара.Ключ), "Статус " + Пара.Ключ).Равно(Пара.Значение);
	КонецЦикла;
	ЮТест.ОжидаетЧто(б24т_Задачи.НазваниеСтатуса(3), "Число вместо строки").Равно("Выполняется");

