	Случаи = СтрРазделить(
		"Успех,ПроверкаИИ,КлючОтклонён,МодельНедоступна,Оборванный,"
		+ "ЛимитЗапросов_Синтетика,НетСредств,ОшибкаСервера_Синтетика,"
		+ "НеJSON_Синтетика,Пустой_Синтетика,Отказ_Синтетика", ",");

	Имена = Новый Массив;
	Для Каждого Случай Из Случаи Цикл
		Имена.Добавить(ПрефиксОтветаИИ() + Случай);
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ЗаписанныеОтветыИИ()

	Имена = Новый Массив;
	Для Каждого Макет Из Метаданные.ОбщиеМакеты Цикл
		Если СтрНачинаетсяС(Макет.Имя, ПрефиксОтветаИИ()) Тогда
			Имена.Добавить(Макет.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ЭтоНеJSONИлиПустой(Имя)

	Возврат Имя = ПрефиксОтветаИИ() + "НеJSON_Синтетика" Или Имя = ПрефиксОтветаИИ() + "Пустой_Синтетика";

КонецФункции

// Ответ как соответствие; Неопределено, если текст не JSON или это не объект.
Функция ОтветКакСоответствие(Имя)

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстОтвета(Имя));
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат ?(ТипЗнч(Значение) = Тип("Соответствие"), Значение, Неопределено);

КонецФункции

Функция ЗначениеПустое(Значение)

	Если Значение = Неопределено Или Значение = Null Тогда
		Возврат Истина;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат ПустаяСтрока(Значение);
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение.Количество() = 0;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Есть ли в тексте строка вида sk-… , не скрытая звёздочками (слова вроде «task-» не считаются).
Функция ЕстьПохожийНаКлюч(Текст)

	Номер = 1;
	Пока Истина Цикл
		Позиция = СтрНайти(Текст, "sk-", , , Номер);
		Если Позиция = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Номер = Номер + 1;
		Если Позиция > 1 И ЭтоБуквоцифра(Сред(Текст, Позиция - 1, 1)) Тогда
			Продолжить;
		КонецЕсли;
		Если Сред(Текст, Позиция + 3, 1) <> "*" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

КонецФункции

Функция ЭтоБуквоцифра(Символ)

	Возврат СтрНайти("abcdefghijklmnopqrstuvwxyzабвгдеёжзийклмнопрстуфхцчшщъыьэюя0123456789_", НРег(Символ)) > 0;

КонецФункции

Функция ПрефиксОтветаИИ()

	Возврат "б24тТест_ОтветИИ_";

КонецФункции

