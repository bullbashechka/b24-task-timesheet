#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ЗаписанныеОтветы_ЕстьВсеНужные",
			"Для каждого метода и случая есть записанный ответ Битрикс24")
		.ДобавитьСерверныйТест("ЗаписанныеОтветы_РазбираютсяКакJSON",
			"Каждый записанный ответ разбирается как JSON-объект")
		.ДобавитьСерверныйТест("ЗаписанныеОтветы_БезАдресаВебхукаИЛичныхДанных",
			"В записанных ответах нет адреса вебхука, домена портала и реальных e-mail")
		.ДобавитьСерверныйТест("ЗаписанныеОтветыИИ_ЕстьВсеНужные",
			"Для каждого случая есть записанный ответ OpenAI")
		.ДобавитьСерверныйТест("ЗаписанныеОтветыИИ_РазбираютсяКакJSON",
			"Ответы OpenAI разбираются как JSON-объект, кроме «не JSON» и «пустого»")
		.ДобавитьСерверныйТест("ЗаписанныеОтветыИИ_НеJSONИПустойНеРазбираются",
			"«Не JSON» и «пустой» ответы OpenAI действительно не разбираются как JSON-объект")
		.ДобавитьСерверныйТест("ЗаписанныеОтветыИИ_БезКлючаУказанийИЛичныхДанных",
			"В ответах OpenAI нет ключа, указаний, адреса вебхука, домена портала и реальных e-mail")
		.ДобавитьСерверныйТест("ЗаписанныеОтветыИИ_УспехЗаписанНаВыдуманнойФормулировке",
			"Успешный ответ OpenAI записан на выдуманной формулировке «[ТЕСТ]», а не на настоящей");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ЗаписанныеОтветы_ЕстьВсеНужные() Экспорт

	Для Каждого Имя Из НужныеОтветы() Цикл
		ЮТест.ОжидаетЧто(Метаданные.ОбщиеМакеты.Найти(Имя), "Нет записанного ответа " + Имя).Существует();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветы_РазбираютсяКакJSON() Экспорт

	Имена = ЗаписанныеОтветы();
	ЮТест.ОжидаетЧто(Имена.Количество(), "Записанных ответов нет").Больше(0);

	Для Каждого Имя Из Имена Цикл
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстОтвета(Имя));
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		ЮТест.ОжидаетЧто(Значение, Имя).ИмеетТип("Соответствие");
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветы_БезАдресаВебхукаИЛичныхДанных() Экспорт

	Имена = ЗаписанныеОтветы();
	ЮТест.ОжидаетЧто(Имена.Количество(), "Записанных ответов нет").Больше(0);

	Для Каждого Имя Из Имена Цикл
		Текст = НРег(ТекстОтвета(Имя));
		ЮТест.ОжидаетЧто(Текст, Имя + ": адрес вебхука").НеСодержит("/rest/");
		ЮТест.ОжидаетЧто(Текст, Имя + ": домен портала").НеСодержит("toofirmagem");
		ЮТест.ОжидаетЧто(СтрЗаменить(Текст, "@example.com", ""), Имя + ": реальный e-mail").НеСодержит("@");
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветыИИ_ЕстьВсеНужные() Экспорт

	Для Каждого Имя Из НужныеОтветыИИ() Цикл
		ЮТест.ОжидаетЧто(Метаданные.ОбщиеМакеты.Найти(Имя), "Нет записанного ответа " + Имя).Существует();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветыИИ_РазбираютсяКакJSON() Экспорт

	Имена = ЗаписанныеОтветыИИ();
	ЮТест.ОжидаетЧто(Имена.Количество(), "Записанных ответов OpenAI нет").Больше(0);

	Для Каждого Имя Из Имена Цикл
		Если ЭтоНеJSONИлиПустой(Имя) Тогда
			Продолжить;
		КонецЕсли;
		ЮТест.ОжидаетЧто(ОтветКакСоответствие(Имя) <> Неопределено, Имя + ": JSON-объект").ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветыИИ_НеJSONИПустойНеРазбираются() Экспорт

	Для Каждого Имя Из ЗаписанныеОтветыИИ() Цикл
		Если ЭтоНеJSONИлиПустой(Имя) Тогда
			ЮТест.ОжидаетЧто(ОтветКакСоответствие(Имя), Имя).Равно(Неопределено);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветыИИ_БезКлючаУказанийИЛичныхДанных() Экспорт

	Имена = ЗаписанныеОтветыИИ();
	ЮТест.ОжидаетЧто(Имена.Количество(), "Записанных ответов OpenAI нет").Больше(0);

	Для Каждого Имя Из Имена Цикл
		ТекстИсходный = ТекстОтвета(Имя);
		Текст = НРег(ТекстИсходный);
		ЮТест.ОжидаетЧто(ЕстьПохожийНаКлюч(ТекстИсходный), Имя + ": ключ OpenAI").ЭтоЛожь();
		ЮТест.ОжидаетЧто(Текст, Имя + ": адрес вебхука").НеСодержит("/rest/");
		ЮТест.ОжидаетЧто(Текст, Имя + ": домен портала").НеСодержит("toofirmagem");
		ЮТест.ОжидаетЧто(СтрЗаменить(Текст, "@example.com", ""), Имя + ": реальный e-mail").НеСодержит("@");

		Ответ = ОтветКакСоответствие(Имя);
		Если Ответ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		// Указания и сведения о пользователе в ответе OpenAI повторяются: записывать их нельзя.
		Для Каждого Поле Из СтрРазделить("instructions,user,safety_identifier,prompt_cache_key,metadata", ",") Цикл
			ЮТест.ОжидаетЧто(ЗначениеПустое(Ответ.Получить(Поле)), Имя + ": поле " + Поле + " пустое").ЭтоИстина();
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветыИИ_УспехЗаписанНаВыдуманнойФормулировке() Экспорт

	ЮТест.ОжидаетЧто(ТекстОтвета(ПрефиксОтветаИИ() + "Успех"), "Успешный ответ").Содержит("[ТЕСТ]");

КонецПроцедуры

