#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ЗаписанныеОтветы_ЕстьВсеНужные",
			"Для каждого метода и случая есть записанный ответ Битрикс24")
		.ДобавитьСерверныйТест("ЗаписанныеОтветы_РазбираютсяКакJSON",
			"Каждый записанный ответ разбирается как JSON-объект")
		.ДобавитьСерверныйТест("ЗаписанныеОтветы_БезАдресаВебхукаИЛичныхДанных",
			"В записанных ответах нет адреса вебхука, домена портала и реальных e-mail");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ЗаписанныеОтветы_ЕстьВсеНужные() Экспорт

	Для Каждого Имя Из НужныеОтветы() Цикл
		ЮТест.ОжидаетЧто(Метаданные.ОбщиеМакеты.Найти(Имя), "Нет записанного ответа " + Имя).Существует();
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветы_РазбираютсяКакJSON() Экспорт

	Имена = ЗаписанныеОтветы();
	ЮТест.ОжидаетЧто(Имена.Количество(), "Записанных ответов нет").Больше(0);

	Для Каждого Имя Из Имена Цикл
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(ТекстОтвета(Имя));
		Значение = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
		ЮТест.ОжидаетЧто(Значение, Имя).ИмеетТип("Соответствие");
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписанныеОтветы_БезАдресаВебхукаИЛичныхДанных() Экспорт

	Имена = ЗаписанныеОтветы();
	ЮТест.ОжидаетЧто(Имена.Количество(), "Записанных ответов нет").Больше(0);

	Для Каждого Имя Из Имена Цикл
		Текст = НРег(ТекстОтвета(Имя));
		ЮТест.ОжидаетЧто(Текст, Имя + ": адрес вебхука").НеСодержит("/rest/");
		ЮТест.ОжидаетЧто(Текст, Имя + ": домен портала").НеСодержит("toofirmagem");
		ЮТест.ОжидаетЧто(СтрЗаменить(Текст, "@example.com", ""), Имя + ": реальный e-mail").НеСодержит("@");
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НужныеОтветы()

	Случаи = СтрРазделить(
		"user_get_Найден,user_get_НеНайден,user_get_Неактивный_Синтетика,user_get_ДваПользователя_Синтетика,"
		+ "tasks_task_list_ПостановщикИлиИсполнитель,tasks_task_list_Соисполнитель,"
		+ "tasks_task_list_Страница1,tasks_task_list_Страница2,"
		+ "tasks_task_get_Найдена,tasks_task_get_НеНайдена,"
		+ "crm_company_get_Найдена,crm_company_get_НеНайдена,crm_company_list_Названия,"
		+ "crm_requisite_list_БИН,crm_requisite_list_ИИН,crm_requisite_list_ДваРеквизита,"
		+ "crm_requisite_list_Пусто,crm_requisite_list_ИНН_Синтетика,"
		+ "sonet_group_get_Проект,"
		+ "Ошибка_НеверныйВебхук,Ошибка_ЛимитЗапросов_Синтетика,Ошибка_Сервер_Синтетика,"
		+ "user_admin_Да,user_admin_Нет_Синтетика,tasks_task_list_Пусто,tasks_task_list_СредняяСтраница_Синтетика,"
		+ "crm_company_list_Пусто,sonet_group_get_НеНайден,Ошибка_НетПрава_Синтетика,Ошибка_МетодНеНайден_Синтетика,"
		+ "Ошибка_ДоступЗапрещён_Синтетика,Ошибка_ВремяМетода_Синтетика,"
		+ "crm_company_list_НаборС6,crm_requisite_list_НаборС6", ",");

	Имена = Новый Массив;
	Для Каждого Случай Из Случаи Цикл
		Имена.Добавить(ПрефиксОтвета() + Случай);
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ЗаписанныеОтветы()

	Имена = Новый Массив;
	Для Каждого Макет Из Метаданные.ОбщиеМакеты Цикл
		Если СтрНачинаетсяС(Макет.Имя, ПрефиксОтвета()) Тогда
			Имена.Добавить(Макет.Имя);
		КонецЕсли;
	КонецЦикла;
	Возврат Имена;

КонецФункции

Функция ТекстОтвета(Имя)

	Возврат ПолучитьОбщийМакет(Имя).ПолучитьТекст();

КонецФункции

Функция ПрефиксОтвета()

	Возврат "б24тТест_Ответ_";

КонецФункции

#КонецОбласти
