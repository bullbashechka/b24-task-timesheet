		+ "tasks_task_get_Описание", ",");

	Имена = Новый Массив;
	Для Каждого Случай Из Случаи Цикл
		Имена.Добавить(ПрефиксОтвета() + Случай);
	КонецЦикла;
	Возврат Имена;

КонецФункции

