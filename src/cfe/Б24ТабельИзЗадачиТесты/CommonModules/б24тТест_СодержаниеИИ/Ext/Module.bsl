	Ожидаемое = "Бухгалтер Тестов Т. Т. сообщил, что в иб не проходит эсф за прошлый месяц. БИН организации 990000000012."
		+ Символы.ПС + "Версия конфигурации в базе 3.0.99.1, платформа 8.3.23.2040. Нужно разобраться с ошибкой при отправке.";
	ЮТест.ОжидаетЧто(Результат.Текст, "Текст").Равно(Ожидаемое);
	ЮТест.ОжидаетЧто(Результат.Обрезано, "Обрезано").ЭтоЛожь();

КонецПроцедуры

Процедура Описание_ДлинноеСОформлением() Экспорт

	Результат = б24т_СодержаниеИИ.ОписаниеЗадачи(ЗадачаИзМакета("tasks_task_get_ОписаниеДлинное"));
	Текст = Результат.Текст;

	Начало = "Что сделать"
		+ Символы.ПС + "- Проверить настройки обмена с банком"
		+ Символы.ПС + "- Загрузить выписку"
		+ Символы.ПС + "- Сверить остатки"
		+ Символы.ПС + "Описание ошибки: ссылка на скриншот"
		+ Символы.ПС + "Постановщик: Тест Пользователь 30"
		+ Символы.ПС + "Клиент: после обновления перестала загружаться выписка."
		+ Символы.ПС + "Счёт | Остаток"
		+ Символы.ПС + "1030 | 100 000"
		+ Символы.ПС + "Файл:"
		+ Символы.ПС + "Проверили загрузку выписки за неделю";
	ЮТест.ОжидаетЧто(СтрНачинаетсяС(Текст, Начало), "Разметка разобрана, начало текста").ЭтоИстина();

	Для Каждого Метка Из СтрРазделить("[B],[I],[LIST],[*],[URL,[USER,[QUOTE],[TABLE],[TR],[TD],[DISK,example.com,n12345", ",") Цикл
		ЮТест.ОжидаетЧто(Текст, "Разметки нет: " + Метка).НеСодержит(Метка);
	КонецЦикла;

	ЮТест.ОжидаетЧто(СтрДлина(Текст) <= 4000, "Не длиннее 4000").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрДлина(Текст) > 3900, "Взято почти всё, что помещается").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Обрезано, "Обрезано").ЭтоИстина();
	ЮТест.ОжидаетЧто(Текст, "Конец за пределом").НеСодержит("КОНЕЦ-ЗА-ПРЕДЕЛОМ");
	// Последнее слово целое: повторяется фраза «…с банком.», обрезки посреди слова в ней нет.
	Слова = СтрРазделить(Текст, " " + Символы.ПС);
	Последнее = Слова[Слова.ВГраница()];
	Целые = СтрРазделить("Проверили|загрузку|выписки|за|неделю,|сверили|остатки|на|счетах|и|настройки|обмена|с|банком.", "|");
	ЮТест.ОжидаетЧто(Целые.Найти(Последнее) <> Неопределено, "Последнее слово целое: " + Последнее).ЭтоИстина();

КонецПроцедуры

