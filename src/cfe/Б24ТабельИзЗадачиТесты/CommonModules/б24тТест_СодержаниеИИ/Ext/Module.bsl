Процедура Места_ПорядокПоявленияИПовторы() Экспорт

	Текст = "Регистрация в ИБ ???. Активация на ПК (чей ПК) на ??? месяцев.";
	Найденные = б24т_СодержаниеИИ.ПроверенныеМеста(Текст, Новый Массив, Новый Массив);
	ЮТест.ОжидаетЧто(СтрСоединить(Найденные, "|"), "Строки мест, порядок первого появления").Равно("???|(чей ПК)");

	// Окно пересчитывает места при вводе: одно и то же место показывается столько раз, сколько оно в тексте (6А).
	Места = б24т_СодержаниеИИКлиентСервер.НезаполненныеМеста(Текст, Найденные);
	ЮТест.ОжидаетЧто(СтрСоединить(Места, "|"), "Все места по порядку в тексте").Равно("???|(чей ПК)|???");

	// Первое «???» заполнено: остались второе и «(чей ПК)».
	Правка = "Регистрация в ИБ Магазин. Активация на ПК (чей ПК) на ??? месяцев.";
	ЮТест.ОжидаетЧто(СтрСоединить(б24т_СодержаниеИИКлиентСервер.НезаполненныеМеста(Правка, Найденные), "|"),
		"Одно место заполнено").Равно("(чей ПК)|???");

	// Заполнены все: список пуст, надписи нет.
	Правка = "Регистрация в ИБ Магазин. Активация на ПК Анны на 12 месяцев.";
	Пусто = б24т_СодержаниеИИКлиентСервер.НезаполненныеМеста(Правка, Найденные);
	ЮТест.ОжидаетЧто(Пусто.Количество(), "Все места заполнены").Равно(0);
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИКлиентСервер.ТекстЗаполните(Пусто), "Надписи нет").Равно("");

