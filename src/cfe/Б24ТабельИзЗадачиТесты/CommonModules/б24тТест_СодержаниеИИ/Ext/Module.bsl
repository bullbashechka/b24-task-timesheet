	ЮТест.ОжидаетЧто(СтрДлина(Результат) <= 1000, "Не длиннее 1000").ЭтоИстина();

	// Необязательное место убирается до обрезки: после этого текст помещается целиком.
	Исходный = Повтор("а", 990) + " (название ИБ) ок.";
