	Результат = б24т_СодержаниеИИ.ОписаниеЗадачи(ЗадачаСОписанием(Описание));

	ЮТест.ОжидаетЧто(Результат.Текст, "Текст").Равно("Первая строка с табом" + Символы.ПС + "Вторая строка" + Символы.ПС + "Третья");

КонецПроцедуры

Процедура Описание_Обрезка() Экспорт

	// Ровно 4000 символов — не обрезается.
	Точно = Повтор("а", 4000);
	Результат = б24т_СодержаниеИИ.ОписаниеЗадачи(ЗадачаСОписанием(Точно));
	ЮТест.ОжидаетЧто(СтрДлина(Результат.Текст), "4000 символов").Равно(4000);
	ЮТест.ОжидаетЧто(Результат.Обрезано, "4000 — не обрезано").ЭтоЛожь();

	// 4001 символ одним словом — обрезается ровно до 4000.
	Результат = б24т_СодержаниеИИ.ОписаниеЗадачи(ЗадачаСОписанием(Точно + "б"));
	ЮТест.ОжидаетЧто(СтрДлина(Результат.Текст), "Одно длинное слово").Равно(4000);
	ЮТест.ОжидаетЧто(Результат.Обрезано, "Одно длинное слово — обрезано").ЭтоИстина();

	// Слова: последнее слово не рвётся, пробела на конце нет.
	Слова = Повтор("слово ", 1000);
	Результат = б24т_СодержаниеИИ.ОписаниеЗадачи(ЗадачаСОписанием(Слова));
	ЮТест.ОжидаетЧто(Результат.Обрезано, "Слова — обрезано").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрДлина(Результат.Текст) <= 4000, "Слова — длина").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрЗаканчиваетсяНа(Результат.Текст, " слово"), "Слова — последнее слово целое").ЭтоИстина();

	// Граница ровно между словами: после 4000 символов идёт пробел — слово остаётся.
	Граница = Повтор("абвгд ", 666) + "абвг";
	ЮТест.ОжидаетЧто(СтрДлина(Граница), "Заготовка").Равно(4000);
	Результат = б24т_СодержаниеИИ.ОписаниеЗадачи(ЗадачаСОписанием(Граница + " хвост"));
	ЮТест.ОжидаетЧто(Результат.Текст, "Слово на границе целиком").Равно(Граница);
	ЮТест.ОжидаетЧто(Результат.Обрезано, "Хвост отрезан").ЭтоИстина();

	// Огромное описание не ломает разбор: берётся начало.
	Результат = б24т_СодержаниеИИ.ОписаниеЗадачи(ЗадачаСОписанием(Повтор("слово [B]жирное[/B] ", 20000)));
	ЮТест.ОжидаетЧто(Результат.Обрезано, "Огромное — обрезано").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрДлина(Результат.Текст) <= 4000, "Огромное — длина").ЭтоИстина();

КонецПроцедуры

