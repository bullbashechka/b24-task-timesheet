Процедура Черновик_ПустоеПолеИлиПробелы() Экспорт

	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик("", "Обновление базы"), "Пустое поле").Равно("");
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик("   " + Символы.ПС + " ", "Обновление базы"), "Пробелы и перенос").Равно("");
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик(Неопределено, "Обновление базы"), "Неопределено").Равно("");

КонецПроцедуры

Процедура Черновик_НазваниеЗадачи() Экспорт

	Название = "[ТЕСТ] ИИ: обновление базы";

	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик(Название, Название), "То же название").Равно("");
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик("  " + Название + "  ", Название), "Пробелы по краям").Равно("");
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик(ВРег(Название), Название), "Другой регистр").Равно("");

КонецПроцедуры

Процедура Черновик_НазваниеСЗаметкой() Экспорт

	Название = "[ТЕСТ] ИИ: обновление базы";
	Поле = Название + " у главбуха";

	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик(Поле, Название), "Название и заметка").Равно(Поле);

КонецПроцедуры

Процедура Черновик_ДругойТекст() Экспорт

	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик("обновил бк до 3.0.72.1", "Обновление базы"), "Текст сотрудника")
		.Равно("обновил бк до 3.0.72.1");
	// Пробелы и переносы внутри и по краям непустого текста не трогаются: «как есть».
	Поле = "  обновил  бк" + Символы.ПС + "до 3.0.72.1 ";
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.Черновик(Поле, "Обновление базы"), "Как есть").Равно(Поле);

