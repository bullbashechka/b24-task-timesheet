	Проверено = 0;
	Для Каждого Место Из МестаИзМакета() Цикл
		Если Место["вид"] <> "не место" Тогда
			Продолжить;
		КонецЕсли;

		Фрагмент = Место["фрагмент"];
		Текст = "Работа " + Фрагмент + " продолжена.";
		// Сама по себе такая запись местом не считается, и даже если ИИ назвал её незаполненной, формулировка
		// с ней есть, а текст её содержит.
		Формулировки = ЗначениеВМассиве(Новый Структура("Шифр, Описание", "Ф", Текст));
		Названные = ЗначениеВМассиве(Фрагмент);
