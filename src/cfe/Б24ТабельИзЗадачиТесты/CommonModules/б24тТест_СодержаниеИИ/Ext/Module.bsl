	// Ровно 1000 символов — не обрезается.
	Точно = Повтор("а", 999) + ".";
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.ПриведенныйТекст(Точно), "Ровно 1000").Равно(Точно);

	// Длиннее: остаются только целые предложения, которые помещаются.
	Предложение = "Это целое предложение из шести слов.";
	Длинный = Повтор(Предложение + " ", 40);
	Ожидается = СокрП(Повтор(Предложение + " ", Цел(1001 / (СтрДлина(Предложение) + 1))));
