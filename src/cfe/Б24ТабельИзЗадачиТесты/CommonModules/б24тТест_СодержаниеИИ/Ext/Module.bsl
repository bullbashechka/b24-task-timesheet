		ЮТест.ОжидаетЧто(Результат.Места.Количество(), "Мест нет: " + Случай.Ключ).Равно(0);
	КонецЦикла;

	ЮТест.ОжидаетЧто(б24т_СодержаниеИИ.РезультатОтвета(Неопределено, "", Формулировки).Разобран, "Неопределено").ЭтоЛожь();

	// В причине нет ни текста ответа, ни текста поля.
	Результат = б24т_СодержаниеИИ.РезультатОтвета("секретный текст ответа", "секретный черновик", Формулировки);
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Причина, "секретный"), "Причина без текстов").Равно(0);

КонецПроцедуры

Процедура Разбор_ШифрыИСвоимиСловами() Экспорт

	Формулировки = ФормулировкиДляТестов();

	Шифры = Новый Массив;
	Шифры.Добавить("[ТЕСТ] А");
	Шифры.Добавить("[ТЕСТ] А");
	Шифры.Добавить("Выдуманный шифр");
	Результат = б24т_СодержаниеИИ.РезультатОтвета(ОтветИИ("Установка.", Шифры), "", Формулировки);
	ЮТест.ОжидаетЧто(СтрСоединить(Результат.Шифры, "|"), "Только шифры из списка, без повторов").Равно("[ТЕСТ] А");
	ЮТест.ОжидаетЧто(Результат.НеизвестныхШифров, "Неизвестный шифр посчитан").Равно(1);

	Результат = б24т_СодержаниеИИ.РезультатОтвета(ОтветИИ("Вопрос по отзыву ЭСФ.", Новый Массив, Истина), "", Формулировки);
	ЮТест.ОжидаетЧто(Результат.СвоимиСловами, "Своими словами").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Шифры.Количество(), "Шифров нет").Равно(0);

	// Список формулировок пуст или не передан: любой шифр неизвестен.
	Результат = б24т_СодержаниеИИ.РезультатОтвета(ОтветИИ("Установка.", ЗначениеВМассиве("[ТЕСТ] А")), "", Неопределено);
	ЮТест.ОжидаетЧто(Результат.Шифры.Количество(), "Без списка шифров нет").Равно(0);
	ЮТест.ОжидаетЧто(Результат.НеизвестныхШифров, "Без списка шифр неизвестен").Равно(1);

КонецПроцедуры

Процедура Разбор_ДлинныйТекстОбрезается() Экспорт

	Длинный = Повтор("Это целое предложение из шести слов. ", 40);
	Результат = б24т_СодержаниеИИ.РезультатОтвета(ОтветИИ(Длинный), "", ФормулировкиДляТестов());

	ЮТест.ОжидаетЧто(Результат.Разобран, "Разобран").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрДлина(Результат.Текст) <= 1000, "Не длиннее 1000").ЭтоИстина();
	ЮТест.ОжидаетЧто(СтрЗаканчиваетсяНа(Результат.Текст, "шести слов."), "Целое предложение").ЭтоИстина();

КонецПроцедуры

// Ответ ИИ по схеме: JSON-объект codes, text, own_words, unfilled.
Функция ОтветИИ(Текст, Шифры = Неопределено, СвоимиСловами = Ложь, Незаполненные = Неопределено)

	Ответ = Новый Структура;
	Ответ.Вставить("codes", ?(Шифры = Неопределено, Новый Массив, Шифры));
	Ответ.Вставить("text", Текст);
	Ответ.Вставить("own_words", СвоимиСловами);
	Ответ.Вставить("unfilled", ?(Незаполненные = Неопределено, Новый Массив, Незаполненные));
	Возврат ТекстJSON(Ответ);

КонецФункции

Функция ОтсортированныеИмена(Коллекция)

	Имена = Новый СписокЗначений;
	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Имена.ЗагрузитьЗначения(Коллекция);
	Иначе
		Для Каждого Элемент Из Коллекция Цикл
			Имена.Добавить(Элемент.Ключ);
		КонецЦикла;
	КонецЕсли;
	Имена.СортироватьПоЗначению();
	Возврат СтрСоединить(Имена.ВыгрузитьЗначения(), ",");

КонецФункции

Функция ТекстJSON(Значение)

	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Значение);
	Возврат Писатель.Закрыть();

КонецФункции

Функция ПрочитатьТекстJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

