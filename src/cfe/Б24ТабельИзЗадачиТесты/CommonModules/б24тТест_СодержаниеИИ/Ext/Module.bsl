// Вспомогательные функции сборки

Функция НастройкиИИ(Указания = "", Примеры = "", Модель = "gpt-test-model")

	Возврат Новый Структура("Модель, Указания, Примеры", Модель, Указания, Примеры);

КонецФункции

Функция ФормулировкиДляТестов()

	Список = Новый Массив;
	Список.Добавить(Новый Структура("Шифр, Описание", "[ТЕСТ] А", "[ТЕСТ] Обновление ИБ БК (название ИБ) до релиза 3.0....."));
	Список.Добавить(Новый Структура("Шифр, Описание", "[ТЕСТ] Б", "[ТЕСТ] Установка 1С-Коннект на ПК ""чей""."));
	Возврат Список;

КонецФункции

Функция ТестовыйЗапрос(Указания = "", Примеры = "", Формулировки = Неопределено, Черновик = "обновил бк до 3.0.72.1")

	Материал = б24т_СодержаниеИИ.МатериалЗадачи(ЗадачаИзМакета("tasks_task_get_Описание"), Черновик);
	Если Формулировки = Неопределено Тогда
		Формулировки = ФормулировкиДляТестов();
	КонецЕсли;
	Возврат б24т_СодержаниеИИ.ЗапросСодержания(Материал, НастройкиИИ(Указания, Примеры), Формулировки);

КонецФункции

Функция ЗначениеВМассиве(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

Функция ОтсортированныеИмена(Коллекция)

	Имена = Новый СписокЗначений;
	Если ТипЗнч(Коллекция) = Тип("Массив") Тогда
		Имена.ЗагрузитьЗначения(Коллекция);
	Иначе
		Для Каждого Элемент Из Коллекция Цикл
			Имена.Добавить(Элемент.Ключ);
		КонецЦикла;
	КонецЕсли;
	Имена.СортироватьПоЗначению();
	Возврат СтрСоединить(Имена.ВыгрузитьЗначения(), ",");

КонецФункции

Функция ТекстJSON(Значение)

	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Значение);
	Возврат Писатель.Закрыть();

КонецФункции

Функция ПрочитатьТекстJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

#КонецОбласти
