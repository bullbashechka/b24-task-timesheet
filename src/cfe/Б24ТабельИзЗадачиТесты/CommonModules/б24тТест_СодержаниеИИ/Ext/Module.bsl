// Схема ответа (17.7)

Процедура Схема_СтрогаяИОбязательныеПоля() Экспорт

	Схема = ПрочитатьТекстJSON(ТекстJSON(б24т_СодержаниеИИ.СхемаОтвета()));

	ЮТест.ОжидаетЧто(Схема["type"], "Тип схемы").Равно("object");
	ЮТест.ОжидаетЧто(Схема["additionalProperties"], "Лишних полей нет").Равно(Ложь);
	Свойства = Схема["properties"];
	ЮТест.ОжидаетЧто(ОтсортированныеИмена(Свойства), "Поля").Равно("codes,own_words,text,unfilled");
	ЮТест.ОжидаетЧто(ОтсортированныеИмена(Схема["required"]), "Все поля обязательны").Равно("codes,own_words,text,unfilled");
	ЮТест.ОжидаетЧто(Свойства["text"]["type"], "text").Равно("string");
	ЮТест.ОжидаетЧто(Свойства["own_words"]["type"], "own_words").Равно("boolean");
	Для Каждого Имя Из СтрРазделить("unfilled,codes", ",") Цикл
		ЮТест.ОжидаетЧто(Свойства[Имя]["type"], Имя + " — массив").Равно("array");
		ЮТест.ОжидаетЧто(Свойства[Имя]["items"]["type"], Имя + " — массив строк").Равно("string");
	КонецЦикла;

КонецПроцедуры

Процедура Схема_ПорядокПолей() Экспорт

	// OpenAI отвечает полями в том порядке, в каком они записаны в схеме: модель сначала выбирает формулировки (codes),
	// потом пишет текст, и только после текста отмечает свои слова и оставшиеся места. Порядок задаёт код, а не случай.
	Текст = ТекстJSON(б24т_СодержаниеИИ.СхемаОтвета());
	Свойства = Сред(Текст, СтрНайти(Текст, """properties"""));

	Предыдущая = 0;
	Для Каждого Имя Из СтрРазделить("codes,text,own_words,unfilled", ",") Цикл
		Позиция = СтрНайти(Свойства, """" + Имя + """:");
		ЮТест.ОжидаетЧто(Позиция > Предыдущая, "Порядок поля " + Имя).ЭтоИстина();
		Предыдущая = Позиция;
	КонецЦикла;

	Обязательные = ПрочитатьТекстJSON(Текст)["required"];
	ЮТест.ОжидаетЧто(СтрСоединить(Обязательные, ","), "Порядок обязательных полей").Равно("codes,text,own_words,unfilled");

КонецПроцедуры

