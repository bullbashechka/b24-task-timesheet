// «Смотрящий» транспорт OpenAI тестового расширения (этап 20, С30): перед отправкой в OpenAI проверяет настоящее тело
// запроса — в нём нет запрещённых фрагментов (пароль из комментария) и есть обязательные («***»). Запрещённое в OpenAI не
// уходит. Наружу идут только номера проверок, тексты фрагментов в результат и в журнал не попадают.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ПроверкаТела_Порядок_ПричинНет", "Запрещённого в теле нет, обязательное есть: причин нет")
		.ДобавитьСерверныйТест("ПроверкаТела_ЗапрещённоеЕсть_ПричинаБезТекста",
			"Запрещённый фрагмент в теле: причина с номером, самого фрагмента в причине нет")
		.ДобавитьСерверныйТест("ПроверкаТела_НетОбязательного_Причина", "Обязательного фрагмента в теле нет: причина с номером")
		.ДобавитьСерверныйТест("ПроверкаТела_ПустыеУсловия_ПричинНет", "Без условий причин нет")
		.ДобавитьСерверныйТест("Транспорт_ЗапрещённоеВТеле_НеОтправляется",
			"Запрещённое в теле: транспорт OpenAI не вызывается, ответ 400, причина записана в клиента")
		.ДобавитьСерверныйТест("Транспорт_ЧистоеТело_ПередаётсяДальше",
			"Чистое тело: запрос уходит исходному транспорту, ответ его, причин нет")
		.ДобавитьСерверныйТест("Транспорт_НетОбязательного_ЗапросУходитПричинаЕсть",
			"Нет обязательного фрагмента: запрос всё же уходит (проверяется только запрещённое), причина записана")
		.ДобавитьСерверныйТест("Клиент_ЧерезВызвать_ЗапрещённоеОстанавливается",
			"Через б24т_OpenAI.Вызвать: запрещённое в запросе даёт ошибку клиента, обращения к OpenAI не было")
		.ДобавитьСерверныйТест("Клиент_ПоУмолчаниюИсходныйТранспортOpenAI",
			"Без указания исходного транспорта проверка передаёт запрос настоящему транспорту OpenAI");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ПроверкаТела_Порядок_ПричинНет() Экспорт

	Причины = б24тТест_ТранспортOpenAIСПроверкой.ПроверкаТела(ТелоПример("пароль ***"), НельзяПример(), ОбязаноПример());

	ЮТест.ОжидаетЧто(Причины.Количество(), "Причин").Равно(0);

КонецПроцедуры

Процедура ПроверкаТела_ЗапрещённоеЕсть_ПричинаБезТекста() Экспорт

	Причины = б24тТест_ТранспортOpenAIСПроверкой.ПроверкаТела(ТелоПример("пароль Qwerty123 и ***"), НельзяПример(),
		ОбязаноПример());

	ЮТест.ОжидаетЧто(Причины.Количество(), "Причин").Равно(1);
	ЮТест.ОжидаетЧто(Причины[0], "Причина").Равно("в запросе запрещённый фрагмент 1");
	ЮТест.ОжидаетЧто(СтрНайти(Причины[0], "Qwerty123"), "Текст фрагмента в причине").Равно(0);

КонецПроцедуры

Процедура ПроверкаТела_НетОбязательного_Причина() Экспорт

	Причины = б24тТест_ТранспортOpenAIСПроверкой.ПроверкаТела(ТелоПример("пароль скрыт"), НельзяПример(), ОбязаноПример());

	ЮТест.ОжидаетЧто(Причины.Количество(), "Причин").Равно(1);
	ЮТест.ОжидаетЧто(Причины[0], "Причина").Равно("в запросе нет обязательного фрагмента 1");

КонецПроцедуры

Процедура ПроверкаТела_ПустыеУсловия_ПричинНет() Экспорт

	Причины = б24тТест_ТранспортOpenAIСПроверкой.ПроверкаТела(ТелоПример("Qwerty123"), Новый Массив, Новый Массив);

	ЮТест.ОжидаетЧто(Причины.Количество(), "Причин").Равно(0);

КонецПроцедуры

Процедура Транспорт_ЗапрещённоеВТеле_НеОтправляется() Экспорт

	Клиент = КлиентСЗаглушкой();

	Результат = б24тТест_ТранспортOpenAIСПроверкой.ВыполнитьЗапрос(ЗапросТранспорту(Клиент, ТелоПример("Qwerty123 и ***")));

	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Обращений к исходному транспорту").Равно(0);
	ЮТест.ОжидаетЧто(Результат.КодСостояния, "Код ответа").Равно(400);
	ЮТест.ОжидаетЧто(СтрНайти(Результат.Тело, "Qwerty123"), "Фрагмент в теле ответа").Равно(0);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Причины.Количество(), "Причин в клиенте").Равно(1);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Причины[0], "Причина").Равно("в запросе запрещённый фрагмент 1");
	ЮТест.ОжидаетЧто(Клиент.Проверка.Вызовов, "Обращений к транспорту проверки").Равно(1);

КонецПроцедуры

Процедура Транспорт_ЧистоеТело_ПередаётсяДальше() Экспорт

	Клиент = КлиентСЗаглушкой();
	б24тТест_ЗаглушкаOpenAI.ДобавитьОтвет(Клиент, "ПроверкаИИ");

	Результат = б24тТест_ТранспортOpenAIСПроверкой.ВыполнитьЗапрос(ЗапросТранспорту(Клиент, ТелоПример("пароль ***")));

	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Обращений к исходному транспорту").Равно(1);
	ЮТест.ОжидаетЧто(Результат.КодСостояния, "Код ответа исходного транспорта").Равно(200);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Причины.Количество(), "Причин в клиенте").Равно(0);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Вызовов, "Обращений к транспорту проверки").Равно(1);

КонецПроцедуры

Процедура Транспорт_НетОбязательного_ЗапросУходитПричинаЕсть() Экспорт

	Клиент = КлиентСЗаглушкой();
	б24тТест_ЗаглушкаOpenAI.ДобавитьОтвет(Клиент, "ПроверкаИИ");

	б24тТест_ТранспортOpenAIСПроверкой.ВыполнитьЗапрос(ЗапросТранспорту(Клиент, ТелоПример("пароль скрыт")));

	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Обращений к исходному транспорту").Равно(1);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Причины.Количество(), "Причин в клиенте").Равно(1);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Причины[0], "Причина").Равно("в запросе нет обязательного фрагмента 1");

КонецПроцедуры

Процедура Клиент_ЧерезВызвать_ЗапрещённоеОстанавливается() Экспорт

	Клиент = КлиентСЗаглушкой();
	Запрос = б24т_OpenAI.НовыйЗапрос("Содержание", "gpt-test-1", "УКАЗАНИЯ", "пароль Qwerty123", "timesheet_content",
		СхемаПример(), 500);

	Ответ = б24т_OpenAI.Вызвать(Клиент, Запрос, "sk-test-OpenAIKeyExample9999");

	ЮТест.ОжидаетЧто(Ответ.Успех, "Успех").Равно(Ложь);
	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Обращений к исходному транспорту").Равно(0);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Причины.Количество(), "Причин в клиенте").Равно(2);

КонецПроцедуры

Процедура Клиент_ПоУмолчаниюИсходныйТранспортOpenAI() Экспорт

	Клиент = б24тТест_ТранспортOpenAIСПроверкой.НовыйКлиент(НельзяПример(), ОбязаноПример());

	ЮТест.ОжидаетЧто(Клиент.Транспорт, "Транспорт клиента").Равно("б24тТест_ТранспортOpenAIСПроверкой");
	ЮТест.ОжидаетЧто(Клиент.Проверка.ИсходныйТранспорт, "Исходный транспорт").Равно("б24т_ТранспортOpenAI");
	ЮТест.ОжидаетЧто(Клиент.Проверка.Причины.Количество(), "Причин сразу после создания").Равно(0);
	ЮТест.ОжидаетЧто(Клиент.Проверка.Вызовов, "Обращений сразу после создания").Равно(0);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НельзяПример()

	Результат = Новый Массив;
	Результат.Добавить("Qwerty123");
	Возврат Результат;

КонецФункции

Функция ОбязаноПример()

	Результат = Новый Массив;
	Результат.Добавить("***");
	Возврат Результат;

КонецФункции

// Тело запроса, каким его собирает б24т_OpenAI: JSON, текст — в поле input.
Функция ТелоПример(Текст)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Новый Структура("model, input", "gpt-test-1", Текст));
	Возврат Запись.Закрыть();

КонецФункции

// Клиент проверки, у которого вместо OpenAI — заглушка с очередью ответов.
Функция КлиентСЗаглушкой()

	Клиент = б24тТест_ТранспортOpenAIСПроверкой.НовыйКлиент(НельзяПример(), ОбязаноПример(), "б24тТест_ЗаглушкаOpenAI");
	Клиент.Вставить("Ответы", Новый Массив);
	Возврат Клиент;

КонецФункции

Функция ЗапросТранспорту(Клиент, Тело)

	Запрос = Новый Структура;
	Запрос.Вставить("Тело", Тело);
	Запрос.Вставить("Ключ", "sk-test-OpenAIKeyExample9999");
	Запрос.Вставить("Таймаут", 30);
	Запрос.Вставить("Клиент", Клиент);
	Возврат Запрос;

КонецФункции

Функция СхемаПример()

	Свойства = Новый Структура("ready", Новый Структура("type", "boolean"));
	Схема = Новый Структура;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", ЗначениеВМассиве("ready"));
	Схема.Вставить("additionalProperties", Ложь);
	Возврат Схема;

КонецФункции

Функция ЗначениеВМассиве(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

#КонецОбласти
