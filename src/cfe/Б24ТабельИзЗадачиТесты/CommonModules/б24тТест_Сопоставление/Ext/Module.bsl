Процедура НормализованныйEmail_БезРегистраИПробеловПоКраям() Экспорт

	Результат = б24т_Сопоставление.НормализованныйEmail("  Ivan.Petrov@Mail.KZ ");

	ЮТест.ОжидаетЧто(Результат).Равно("ivan.petrov@mail.kz");

КонецПроцедуры

Процедура АдресаИзПредставлений_УбираетПробелыПустыеИПовторы() Экспорт

	Представления = Новый Массив;
	Представления.Добавить("  Anna@Mail.kz ");
	Представления.Добавить("");
	Представления.Добавить("anna@mail.KZ");
	Представления.Добавить("boris@mail.kz; carl@mail.kz");
	Представления.Добавить("dina@mail.kz,  eva@mail.kz ");

	Результат = б24т_Сопоставление.АдресаИзПредставлений(Представления);

	ЮТест.ОжидаетЧто(СтрСоединить(Результат, "|"))
		.Равно("Anna@Mail.kz|boris@mail.kz|carl@mail.kz|dina@mail.kz|eva@mail.kz");

КонецПроцедуры

