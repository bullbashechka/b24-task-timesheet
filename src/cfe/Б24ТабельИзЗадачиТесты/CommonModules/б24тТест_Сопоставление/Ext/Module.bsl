#Область СлужебныеПроцедурыИФункции

// Массив result из записанного ответа user.get.
Функция ОтветПользователи(Случай)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(б24тТест_ЗаглушкаТранспорта.ТекстМакета(Случай));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные["result"];

КонецФункции

#КонецОбласти
