Процедура СкрытьАдреса_ОстаётсяПервыйСимволИДомен() Экспорт

	Случаи = Новый Соответствие;
	Случаи.Вставить("test.user@example.com", "t***@example.com");
	Случаи.Вставить("{""EMAIL"":[""a@b.kz"",""Second.Name+tag@Example.com""]}", "{""EMAIL"":[""a***@b.kz"",""S***@Example.com""]}");
	Случаи.Вставить("e-mail: Test.User@Example.com, ID 30", "e-mail: T***@Example.com, ID 30");
	Случаи.Вставить("без адресов", "без адресов");
	Случаи.Вставить("знак @ отдельно и x@ без домена", "знак @ отдельно и x@ без домена");
	Случаи.Вставить("", "");

	Для Каждого Случай Из Случаи Цикл
		ЮТест.ОжидаетЧто(б24т_Сопоставление.СкрытьАдресаЭлектроннойПочты(Случай.Ключ), "Текст «" + Случай.Ключ + "»")
			.Равно(Случай.Значение);
	КонецЦикла;

КонецПроцедуры

Процедура ОбщиеАдреса_БезУчётаРегистраИПробелов() Экспорт

	Адреса = СтрРазделить("test.user@example.com,Second@Example.com,own@example.com", ",");
	Представления = Новый Массив;
	Представления.Добавить("  TEST.USER@example.com ");
	Представления.Добавить("other@example.com; second@example.com");
	Представления.Добавить("notown@example.com");

	Результат = б24т_Сопоставление.ОбщиеАдреса(Адреса, Представления);

	ЮТест.ОжидаетЧто(СтрСоединить(Результат, "|")).Равно("test.user@example.com|Second@Example.com");
	ЮТест.ОжидаетЧто(б24т_Сопоставление.ОбщиеАдреса(Адреса, Новый Массив).Количество(), "Нет других").Равно(0);

КонецПроцедуры

