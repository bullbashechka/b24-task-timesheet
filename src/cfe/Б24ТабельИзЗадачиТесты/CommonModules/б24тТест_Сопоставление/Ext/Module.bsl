#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("НормализованныйEmail_БезРегистраИПробеловПоКраям",
			"E-mail сравнивается без учёта регистра и пробелов по краям")
		.ДобавитьСерверныйТест("АдресаИзПредставлений_УбираетПробелыПустыеИПовторы",
			"Адреса из карточки: без пробелов, пустых и повторов; «;» и «,» разделяют адреса")
		.ДобавитьСерверныйТест("ПодходящиеПользователи_БезУчётаРегистраИПробелов",
			"Адрес сотрудника сравнивается с e-mail пользователя без учёта регистра и пробелов по краям")
		.ДобавитьСерверныйТест("ПодходящиеПользователи_ПодходитЛюбойИзАдресов",
			"Если у физлица несколько адресов, подходит любой из них")
		.ДобавитьСерверныйТест("ПодходящиеПользователи_НеактивныйНеПодходит",
			"Неактивный пользователь Битрикс24 не подходит")
		.ДобавитьСерверныйТест("ПодходящиеПользователи_ШаблонНеПодходит",
			"Знаки «_» и «%» в адресе не заменяют символы: Битрикс24 ищет по шаблону, совпадение проверяем сами")
		.ДобавитьСерверныйТест("ПодходящиеПользователи_ОдинПользовательПоДвумАдресам",
			"Пользователь, подошедший по двум адресам, попадает в результат один раз")
		.ДобавитьСерверныйТест("ПодходящиеПользователи_ДваРазныхПользователя",
			"Два разных пользователя по адресам сотрудника возвращаются оба")
		.ДобавитьСерверныйТест("СкрытьАдреса_ОстаётсяПервыйСимволИДомен",
			"В тексте для журнала у e-mail остаются первый символ и домен")
		.ДобавитьСерверныйТест("ОбщиеАдреса_БезУчётаРегистраИПробелов",
			"Адреса сотрудника, указанные у других физлиц, находятся без учёта регистра и пробелов");

КонецПроцедуры

