#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("ИДБ24_РеквизитЕстьВТабличнойЧастиТабель",
			"В табличной части «Табель» документа гем_Табель есть реквизит «ID Б24»")
		.ДобавитьСерверныйТест("ИДБ24_СтрокаДо20Символов",
			"«ID Б24» — строка переменной длины до 20 символов")
		.ДобавитьСерверныйТест("ИДБ24_ВНовойСтрокеПустой",
			"В новой строке табеля «ID Б24» пустой")
		.ДобавитьСерверныйТест("ИДБ24_СохраняетсяПриЗаписиИПроведении",
			"Табель с номером в «ID Б24» записывается и проводится, номер сохраняется");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура ИДБ24_РеквизитЕстьВТабличнойЧастиТабель() Экспорт

	ЮТест.ОжидаетЧто(РеквизитИДБ24(), "Нет реквизита " + ИмяРеквизита()).Существует();

КонецПроцедуры

Процедура ИДБ24_СтрокаДо20Символов() Экспорт

	Реквизит = РеквизитИДБ24();
	ЮТест.ОжидаетЧто(Реквизит, "Нет реквизита " + ИмяРеквизита()).Существует();

	ЮТест.ОжидаетЧто(Реквизит.Синоним, "Синоним").Равно("ID Б24");
	ТипыРеквизита = Реквизит.Тип.Типы();
	ЮТест.ОжидаетЧто(ТипыРеквизита.Количество(), "Количество типов").Равно(1);
	ЮТест.ОжидаетЧто(ТипыРеквизита[0], "Тип").Равно(Тип("Строка"));
	ЮТест.ОжидаетЧто(Реквизит.Тип.КвалификаторыСтроки.Длина, "Длина").Равно(20);
	ЮТест.ОжидаетЧто(Реквизит.Тип.КвалификаторыСтроки.ДопустимаяДлина, "Допустимая длина")
		.Равно(ДопустимаяДлина.Переменная);

КонецПроцедуры

Процедура ИДБ24_ВНовойСтрокеПустой() Экспорт

	ЮТест.ОжидаетЧто(РеквизитИДБ24(), "Нет реквизита " + ИмяРеквизита()).Существует();

	Табель = Документы.гем_Табель.СоздатьДокумент().Табель;
	НоваяСтрока = Табель.Добавить();

	ЮТест.ОжидаетЧто(НоваяСтрока[ИмяРеквизита()], "Значение в новой строке").Равно("");

КонецПроцедуры

Процедура ИДБ24_СохраняетсяПриЗаписиИПроведении() Экспорт

	НачатьТранзакцию();
	Попытка
		Сотрудник = Справочники.ФизическиеЛица.СоздатьЭлемент();
		Сотрудник.Наименование = "[ТЕСТ] Сотрудник для ID Б24";
		Сотрудник.Записать();

		Табель = Документы.гем_Табель.СоздатьДокумент();
		Табель.Дата = ТекущаяДата();
		Табель.Сотрудник = Сотрудник.Ссылка;
		Табель.Комментарий = "[ТЕСТ] ID Б24";
		Строка1 = Табель.Табель.Добавить();
		Строка1.ВремяНач = Дата(1, 1, 1, 9, 0, 0);
		Строка1.ВремяКон = Дата(1, 1, 1, 10, 0, 0);
		Строка1.ТипВремени = Перечисления.гем_ТипыВремени.Офис;
		Строка1[ИмяРеквизита()] = "12345";
		Строка2 = Табель.Табель.Добавить();
		Строка2.ВремяНач = Дата(1, 1, 1, 10, 0, 0);
		Строка2.ВремяКон = Дата(1, 1, 1, 11, 0, 0);
		Строка2.ТипВремени = Перечисления.гем_ТипыВремени.Офис;

		Табель.Записать(РежимЗаписиДокумента.Проведение);

		Прочитанный = Табель.Ссылка.ПолучитьОбъект();
		ЮТест.ОжидаетЧто(Прочитанный.Проведен, "Проведен").Равно(Истина);
		ЮТест.ОжидаетЧто(Прочитанный.Табель.Количество(), "Строк").Равно(2);
		ЮТест.ОжидаетЧто(Прочитанный.Табель[0][ИмяРеквизита()], "Номер в первой строке").Равно("12345");
		ЮТест.ОжидаетЧто(Прочитанный.Табель[1][ИмяРеквизита()], "Номер во второй строке").Равно("");
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ОтменитьТранзакцию();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяРеквизита()

	Возврат "б24т_IDБ24";

КонецФункции

Функция РеквизитИДБ24()

	Возврат Метаданные.Документы.гем_Табель.ТабличныеЧасти.Табель.Реквизиты.Найти(ИмяРеквизита());

КонецФункции

#КонецОбласти
