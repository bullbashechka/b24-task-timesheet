			"Подсказка под полем адреса совпадает с PRD дословно")
		.ДобавитьКлиентскийТест("Форма_ПолеАдресаПустоеПриОткрытии",
			"При открытии поле ввода адреса пустое")
		.ДобавитьКлиентскийТест("Форма_ПолеАдресаСкрытоКакПароль",
			"Адрес в поле ввода скрыт, как пароль, история ввода не запоминается")
		.ДобавитьКлиентскийТест("Форма_ПредупрежденияПоказаныНадПолями",
			"Предупреждения об установленных тестовых расширениях видны в форме")
