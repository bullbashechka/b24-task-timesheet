Процедура Форма_ПроверкаНеверногоАдресаПоказываетСообщениеИНичегоНеМеняет() Экспорт

	Форма = ФормаНастроек();
	// Неверный адрес проверяется без обращения к Битрикс24, поэтому настоящий вебхук из базы тест не трогает.
	Форма.НовыйАдресВебхука = "не адрес";
	Форма.Модифицированность = Ложь;

	Форма.ПоказатьРезультатПроверки();

	ЮТест.ОжидаетЧто(Элемент(Форма, "НадписьРезультатаПроверки").Видимость, "Результат виден").Равно(Истина);
	ЮТест.ОжидаетЧто(Элемент(Форма, "НадписьРезультатаПроверки").Заголовок, "Текст результата")
		.Равно("Адрес вебхука должен иметь вид https://‹портал›.bitrix24.‹зона›/rest/‹номер›/‹ключ›/");
	ЮТест.ОжидаетЧто(Элемент(Форма, "КнопкаПроверитьПодключение").Доступность, "Кнопка снова доступна").Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Модифицированность, "Форма изменена проверкой").Равно(Ложь);

