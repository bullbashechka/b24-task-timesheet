#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьКлиентскийТест("Форма_ЗаголовокСовпадаетСPRD",
			"Заголовок формы — «Настройки интеграции с Битрикс24»")
		.ДобавитьКлиентскийТест("Форма_ПодписиПолейСовпадаютСPRD",
			"Подписи полей, флажка и кнопок совпадают с PRD дословно")
		.ДобавитьКлиентскийТест("Форма_ПодсказкаСовпадаетСPRD",
			"Подсказка под полем адреса совпадает с PRD дословно")
		.ДобавитьКлиентскийТест("Форма_ПолеАдресаПустоеПриОткрытии",
			"При открытии поле ввода адреса пустое")
		.ДобавитьКлиентскийТест("Форма_НадписьСохранённогоАдресаСкрываетКлюч",
			"Надпись о сохранённом адресе — «Не указан» или «Сохранён: …» со скрытым ключом")
		.ДобавитьКлиентскийТест("Форма_ПолеПроектаДоступноТолькоСФлажком",
			"Поле проекта доступно, только когда стоит флажок «Режим тестирования»")
		.ДобавитьКлиентскийТест("Форма_УдалитьАдресОчищаетПолеИМеняетНадпись",
			"«Удалить адрес» очищает поле ввода, меняет надпись на «Не указан» и помечает форму изменённой");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура Форма_ЗаголовокСовпадаетСPRD() Экспорт

	Форма = ФормаНастроек();

	ЮТест.ОжидаетЧто(Форма.Заголовок, "Заголовок").Равно("Настройки интеграции с Битрикс24");

КонецПроцедуры

Процедура Форма_ПодписиПолейСовпадаютСPRD() Экспорт

	Форма = ФормаНастроек();

	ЮТест.ОжидаетЧто(Элемент(Форма, "НовыйАдресВебхука").Заголовок, "Поле адреса")
		.Равно("Адрес входящего вебхука Битрикс24");
	ЮТест.ОжидаетЧто(Элемент(Форма, "РежимТестирования").Заголовок, "Флажок").Равно("Режим тестирования");
	ЮТест.ОжидаетЧто(Элемент(Форма, "ПроектДляТестирования").Заголовок, "Поле проекта")
		.Равно("Проект для тестирования (ID)");
	ЮТест.ОжидаетЧто(Элемент(Форма, "КнопкаУдалитьАдрес").Заголовок, "Кнопка удаления").Равно("Удалить адрес");
	ЮТест.ОжидаетЧто(Элемент(Форма, "ЗаписатьИЗакрыть").Заголовок, "Кнопка записи").Равно("Записать и закрыть");
	ЮТест.ОжидаетЧто(Элемент(Форма, "Закрыть").Заголовок, "Кнопка закрытия").Равно("Закрыть");

КонецПроцедуры

Процедура Форма_ПодсказкаСовпадаетСPRD() Экспорт

	Форма = ФормаНастроек();

	ЮТест.ОжидаетЧто(Элемент(Форма, "ПодсказкаАдреса").Заголовок, "Подсказка").Равно(
		"Создайте в Битрикс24 входящий вебхук с правами «Задачи», «CRM», «Пользователи» и «Рабочие группы» "
		+ "и вставьте его адрес");

КонецПроцедуры

Процедура Форма_ПолеАдресаПустоеПриОткрытии() Экспорт

	Форма = ФормаНастроек();

	ЮТест.ОжидаетЧто(Форма.НовыйАдресВебхука, "Поле адреса").Равно("");

КонецПроцедуры

Процедура Форма_НадписьСохранённогоАдресаСкрываетКлюч() Экспорт

	Форма = ФормаНастроек();
	Надпись = Элемент(Форма, "НадписьСохранённогоАдреса").Заголовок;

	Если Надпись <> "Не указан" Тогда
		ЮТест.ОжидаетЧто(Лев(Надпись, СтрДлина("Сохранён: ")), "Начало надписи").Равно("Сохранён: ");
		ЮТест.ОжидаетЧто(Прав(Надпись, 5), "Конец надписи").Равно("/***/");
	КонецЕсли;

КонецПроцедуры

Процедура Форма_ПолеПроектаДоступноТолькоСФлажком() Экспорт

	Форма = ФормаНастроек();

	Форма.РежимТестирования = Истина;
	Форма.РежимТестированияПриИзменении(Элемент(Форма, "РежимТестирования"));
	ЮТест.ОжидаетЧто(Элемент(Форма, "ПроектДляТестирования").Доступность, "С флажком").Равно(Истина);

	Форма.РежимТестирования = Ложь;
	Форма.РежимТестированияПриИзменении(Элемент(Форма, "РежимТестирования"));
	ЮТест.ОжидаетЧто(Элемент(Форма, "ПроектДляТестирования").Доступность, "Без флажка").Равно(Ложь);

КонецПроцедуры

Процедура Форма_УдалитьАдресОчищаетПолеИМеняетНадпись() Экспорт

	Форма = ФормаНастроек();
	Форма.НовыйАдресВебхука = "https://portal.example.com/rest/30/abc123token/";

	Форма.УдалитьАдресКоманда(Неопределено);

	ЮТест.ОжидаетЧто(Форма.НовыйАдресВебхука, "Поле адреса").Равно("");
	ЮТест.ОжидаетЧто(Элемент(Форма, "НадписьСохранённогоАдреса").Заголовок, "Надпись").Равно("Не указан");
	ЮТест.ОжидаетЧто(Форма.Модифицированность, "Модифицированность").Равно(Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Форму держим в переменной вызывающего кода: элементы закрытой формы становятся недействительными.
Функция ФормаНастроек()

	Возврат ПолучитьФорму("ОбщаяФорма.б24т_НастройкиИнтеграции");

КонецФункции

Функция Элемент(Форма, Имя)

	Возврат Форма.Элементы.Найти(Имя);

КонецФункции

#КонецОбласти
