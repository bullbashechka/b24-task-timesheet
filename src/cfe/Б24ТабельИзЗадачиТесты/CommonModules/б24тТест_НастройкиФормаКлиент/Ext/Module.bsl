Процедура Форма_ПроверкаИИНеверногоКлючаПоказываетТекстИНичегоНеМеняет() Экспорт

	Форма = ФормаНастроек();
	// Ключ неверного вида в OpenAI не уходит, поэтому настоящий ключ из базы тест не тратит.
	Форма.НовыйКлючOpenAI = "не ключ";
	Форма.Модифицированность = Ложь;

	Форма.ПоказатьРезультатПроверкиИИ();

	Надпись = Элемент(Форма, "НадписьРезультатаПроверкиИИ");
	ЮТест.ОжидаетЧто(Надпись.Видимость, "Результат виден").Равно(Истина);
	ЮТест.ОжидаетЧто(Надпись.Заголовок, "Текст результата")
		.Равно("Ключ OpenAI должен начинаться с sk- и не содержать пробелов и русских букв");
	ЮТест.ОжидаетЧто(Элемент(Форма, "КнопкаПроверитьИИ").Доступность, "Кнопка снова доступна").Равно(Истина);
	ЮТест.ОжидаетЧто(Форма.Модифицированность, "Форма изменена проверкой").Равно(Ложь);
	ЮТест.ОжидаетЧто(Форма.НовыйКлючOpenAI, "Поле ключа").Равно("не ключ");

КонецПроцедуры

Процедура Форма_ПроверкаИИПоказываетОжидание() Экспорт

	Форма = ФормаНастроек();
	// Запрос идёт из обработчика ожидания только в открытой форме; ключ неверного вида — вторая страховка.
	Форма.НовыйКлючOpenAI = "не ключ";

	Форма.ПроверитьИИ(Неопределено);

	Надпись = Элемент(Форма, "НадписьРезультатаПроверкиИИ");
	ЮТест.ОжидаетЧто(Надпись.Видимость, "Надпись видна").Равно(Истина);
	ЮТест.ОжидаетЧто(Надпись.Заголовок, "Текст ожидания").Равно("Проверка ИИ…");
	ЮТест.ОжидаетЧто(Элемент(Форма, "КнопкаПроверитьИИ").Доступность, "Кнопка во время проверки").Равно(Ложь);

КонецПроцедуры

Процедура Форма_РезультатПроверкиИИСкрываетсяПриИзменении() Экспорт

	Форма = ФормаНастроек();
	Надпись = Элемент(Форма, "НадписьРезультатаПроверкиИИ");

	Форма.НовыйКлючOpenAI = "не ключ";
	Форма.ПоказатьРезультатПроверкиИИ();
	ЮТест.ОжидаетЧто(Надпись.Видимость, "Результат после проверки").Равно(Истина);
	Форма.НовыйКлючOpenAI = "sk-proj-new";
	Форма.НовыйКлючOpenAIПриИзменении(Элемент(Форма, "НовыйКлючOpenAI"));
	ЮТест.ОжидаетЧто(Надпись.Видимость, "После изменения ключа").Равно(Ложь);

	Форма.НовыйКлючOpenAI = "не ключ";
	Форма.ПоказатьРезультатПроверкиИИ();
	Форма.МодельИИ = "gpt-other";
	Форма.МодельИИПриИзменении(Элемент(Форма, "МодельИИ"));
	ЮТест.ОжидаетЧто(Надпись.Видимость, "После изменения модели").Равно(Ложь);

	Форма.ПоказатьРезультатПроверкиИИ();
	Форма.УдалитьКлючКоманда(Неопределено);
	ЮТест.ОжидаетЧто(Надпись.Видимость, "После «Удалить ключ»").Равно(Ложь);

КонецПроцедуры

