	Форма.ИспользоватьИИ = Истина;
	Форма.Модифицированность = Ложь;

	Форма.УдалитьКлючКоманда(Неопределено);

	ЮТест.ОжидаетЧто(Форма.НовыйКлючOpenAI, "Поле ключа").Равно("");
	ЮТест.ОжидаетЧто(Форма.ИспользоватьИИ, "Флажок").Равно(Ложь);
	ЮТест.ОжидаетЧто(Элемент(Форма, "НадписьСохранённогоКлюча").Заголовок, "Надпись").Равно("Не указан");
	ЮТест.ОжидаетЧто(Элемент(Форма, "КнопкаУдалитьКлюч").Доступность, "Кнопка после удаления").Равно(Ложь);
	ЮТест.ОжидаетЧто(Форма.Модифицированность, "Модифицированность").Равно(Истина);

КонецПроцедуры

Процедура Форма_НовыйКлючОтменяетУдаление() Экспорт

	Форма = ФормаНастроек();
	Форма.ПредставлениеКлюча = "sk-…abcd";
	Форма.УдалитьКлючКоманда(Неопределено);

	Форма.НовыйКлючOpenAI = "sk-proj-new";
