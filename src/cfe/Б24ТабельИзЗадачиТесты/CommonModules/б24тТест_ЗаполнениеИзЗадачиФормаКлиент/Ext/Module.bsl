	Результат = Форма.ПрименитьПроверкуДоступа(Новый Структура("Успех, Сообщение", Ложь, "Сначала укажите сотрудника в табеле"));

	ЮТест.ОжидаетЧто(Результат, "Окно можно использовать").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Элемент(Форма, "Страницы").ТекущаяСтраница, "Страница").Равно(Элемент(Форма, "СтраницаОтказ"));
	ЮТест.ОжидаетЧто(Элемент(Форма, "НадписьОтказа").Заголовок, "Сообщение").Равно("Сначала укажите сотрудника в табеле");
	ЮТест.ОжидаетЧто(Элемент(Форма, "ДобавитьВТабель").Видимость, "«Добавить в табель» видна").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Элемент(Форма, "Отмена").Заголовок, "Кнопка").Равно("Закрыть");

