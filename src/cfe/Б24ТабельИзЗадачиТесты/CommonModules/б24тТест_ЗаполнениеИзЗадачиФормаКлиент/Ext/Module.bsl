// Обработчик ожидания вызывает сервер; если вызов упал, исключение показывает платформа, а окно снимает надпись
// ожидания и снова работает. Если упала загрузка списка, на его месте текст PRD о неожиданной ошибке Битрикс24,
// а не «Ничего не найдено…»: список не загрузился, а не оказался пустым.
Процедура Окно_ИсключениеСервера_ОкноСноваРабочее() Экспорт

	Форма = ФормаОкна();
	ОткрытьРабочуюСтраницу(Форма);

	// Загрузка списка: надпись «Загрузка…» на месте списка (поиск перерисовывает страницу списка).
	Форма.ЗагрузкаИдёт = Истина;
	Форма.ТекстПоискаПриИзменении(Неопределено);
	ЮТест.ОжидаетЧто(Элемент(Форма, "НадписьСписка").Заголовок, "Надпись загрузки")
		.Равно("Загрузка задач из Битрикс24…");
	Форма.ЗавершитьОжиданиеПослеИсключения();
	ЮТест.ОжидаетЧто(Форма.ЗагрузкаИдёт, "Загрузка идёт").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Элемент(Форма, "НадписьСписка").Заголовок, "Надпись после ошибки загрузки")
		.Равно("Битрикс24 вернул ошибку. Обратитесь к администратору");

	// Поиск по номеру.
	Форма.ПрименитьСписок(РезультатСписка(ЗадачиДляСписка()));
