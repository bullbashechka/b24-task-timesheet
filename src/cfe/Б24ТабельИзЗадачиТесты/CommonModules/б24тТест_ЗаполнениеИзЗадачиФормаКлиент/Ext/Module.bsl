// Результат б24т_Задачи.СписокЗадач.
Функция РезультатСписка(Задачи)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Истина);
	Результат.Вставить("ОтказВДоступе", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Задачи", Задачи);
	Результат.Вставить("Усечено", Ложь);
	Результат.Вставить("Предупреждение", "");
	Результат.Вставить("Подпись",
		"Незавершённые задачи и задачи, завершённые с 22.09.2026, где вы постановщик, исполнитель или соисполнитель");
	Результат.Вставить("НадписьРежимаТестирования", "");
	Возврат Результат;

КонецФункции

// Три задачи в порядке убывания активности: 10182, 10180, 10184. Крайний срок есть у 10180 и 10182 (10182 позже);
// у 10184 срока нет, и контрагент не найден.
Функция ЗадачиДляСписка()

	Задачи = Новый Массив;
	Задачи.Добавить(СтрокаСписка(10182, "[ТЕСТ] ИП Архаров", Дата(2026, 10, 25), Дата(2026, 10, 21, 16, 0, 0),
		"[ТЕСТ] ИП Архаров", "найден в 1С по БИН 123456789012", Истина));
	Задачи.Добавить(СтрокаСписка(10180, "[ТЕСТ] Дальстрой", Дата(2026, 10, 23), Дата(2026, 10, 20, 12, 0, 0),
		"[ТЕСТ] Дальстрой", "найден в 1С по БИН 123456789012", Истина));
	Задачи.Добавить(СтрокаСписка(10184, "[ТЕСТ] Дальстрой ёлка, два реквизита", Дата(1, 1, 1), Дата(2026, 10, 19, 9, 0, 0),
		"[ТЕСТ] Компания без реквизитов",
		"У компании «[ТЕСТ] Компания без реквизитов» не заполнен БИН — выберите контрагента вручную", Ложь));
	Возврат Задачи;

КонецФункции

// Строка списка в том виде, как её отдаёт б24т_Задачи.СписокЗадач. Контрагент в тесте всегда пустая ссылка: наличие
// контрагента определяет признак «Найден» и текст (создавать контрагента в клиентском тесте нечем).
Функция СтрокаСписка(Номер, Название, КрайнийСрок, Активность, Компания, ТекстКонтрагента, Найден)

	ЕстьСрок = ЗначениеЗаполнено(КрайнийСрок);
	Строка = Новый Структура;
	Строка.Вставить("Номер", Номер);
	Строка.Вставить("Название", Название);
	Строка.Вставить("МояРоль", "Исполнитель");
	Строка.Вставить("КрайнийСрок", КрайнийСрок);
	Строка.Вставить("КрайнийСрокПредставление", ?(ЕстьСрок, Формат(КрайнийСрок, "ДФ=dd.MM.yyyy"), "без срока"));
	Строка.Вставить("КлючСрока", ?(ЕстьСрок, КрайнийСрок, Дата(3999, 12, 31, 23, 59, 59)));
	Строка.Вставить("Статус", "Выполняется");
	Строка.Вставить("КомпанияCRM", Компания);
	Строка.Вставить("Активность", Активность);
	Строка.Вставить("КлючПоиска", б24т_ЗадачиКлиентСервер.КлючСтроки(Номер, Название));
	Строка.Вставить("Контрагент", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	Строка.Вставить("БИН", ?(Найден, "123456789012", ""));
	Строка.Вставить("ТекстКонтрагента", ТекстКонтрагента);
	Возврат Строка;

КонецФункции

// Результат б24т_Задачи.ЗадачаПоНомеру.
Функция РезультатНомера(Итог, Сообщение, Номер, Название)

	Результат = Новый Структура;
	Результат.Вставить("Итог", Итог);
	Результат.Вставить("Сообщение", Сообщение);
	Результат.Вставить("Номер", Номер);
	Если Итог = "Выбрана" Тогда
		Задача = Новый Структура;
		Задача.Вставить("Номер", Номер);
		Задача.Вставить("Название", Название);
		Задача.Вставить("МояРоль", "Исполнитель");
		Задача.Вставить("Контрагент", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
		Задача.Вставить("БИН", "");
		Задача.Вставить("ТекстКонтрагента",
			"У компании «" + Название + "» не заполнен БИН — выберите контрагента вручную");
		Результат.Вставить("Задача", Задача);
	Иначе
		Результат.Вставить("Задача", Неопределено);
	КонецЕсли;
	Возврат Результат;

КонецФункции

