// Номера видимых (подошедших под поиск) строк через запятую в порядке списка.
Функция ВидимыеНомера(Форма)

	Номера = Новый Массив;
	Для Каждого Строка Из Форма.СписокЗадач Цикл
		Если Строка.Видна Тогда
			Номера.Добавить(Формат(Строка.Номер, "ЧГ=0"));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Номера, ",");

