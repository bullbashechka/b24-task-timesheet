// Форму держим в переменной вызывающего кода: элементы закрытой формы становятся недействительными.
Функция ФормаОкна(Строки = Неопределено, Сотрудник = Неопределено, ДатаТабеля = Неопределено)

	ПараметрыОкна = Новый Структура;
	ПараметрыОкна.Вставить("ДатаТабеля", ?(ДатаТабеля = Неопределено, Дата(2026, 10, 22), ДатаТабеля));
	ПараметрыОкна.Вставить("Сотрудник", ?(Сотрудник = Неопределено,
		ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка"), Сотрудник));
	ПараметрыОкна.Вставить("СтрокиТабеля", ?(Строки = Неопределено, Новый Массив, Строки));
	Возврат ПолучитьФорму("Документ.гем_Табель.Форма.б24т_ЗаполнениеИзЗадачи", ПараметрыОкна);

