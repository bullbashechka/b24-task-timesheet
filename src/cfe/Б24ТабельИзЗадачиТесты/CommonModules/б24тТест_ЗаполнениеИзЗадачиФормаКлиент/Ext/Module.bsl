Процедура Окно_ПодписиСовпадаютСPRD() Экспорт

	Форма = ФормаОкна();
	ОткрытьРабочуюСтраницу(Форма);

	Подписи = Новый Структура;
	Подписи.Вставить("ГруппаЗадача", "Задача");
	Подписи.Вставить("ГруппаСтрока", "Строка табеля за 22.10.2026");
	Подписи.Вставить("ТекстПоиска", "Поиск по номеру или названию");
	Подписи.Вставить("НомерИлиСсылка", "или номер / ссылка на задачу");
	Подписи.Вставить("ВремяНач", "Время начала");
	Подписи.Вставить("ВремяКон", "Время окончания");
	Подписи.Вставить("ТипВремени", "Тип времени");
	Подписи.Вставить("Содержание", "Содержание");
	Подписи.Вставить("Контрагент", "Контрагент");
	Подписи.Вставить("ДобавитьВТабель", "Добавить в табель");
	Подписи.Вставить("Отмена", "Отмена");
	Для Каждого Подпись Из Подписи Цикл
		ЮТест.ОжидаетЧто(Элемент(Форма, Подпись.Ключ).Заголовок, "Подпись " + Подпись.Ключ).Равно(Подпись.Значение);
	КонецЦикла;

	ЗаголовкиКолонок = Новый Структура;
	ЗаголовкиКолонок.Вставить("СписокЗадачНомер", "№");
	ЗаголовкиКолонок.Вставить("СписокЗадачНазвание", "Задача");
	ЗаголовкиКолонок.Вставить("СписокЗадачМояРоль", "Моя роль");
	ЗаголовкиКолонок.Вставить("СписокЗадачКрайнийСрок", "Крайний срок");
	ЗаголовкиКолонок.Вставить("СписокЗадачСтатус", "Статус");
	ЗаголовкиКолонок.Вставить("СписокЗадачКомпанияCRM", "Компания CRM");
	ЗаголовкиКолонок.Вставить("СписокЗадачАктивность", "Активность");
	Для Каждого Колонка Из ЗаголовкиКолонок Цикл
		ЮТест.ОжидаетЧто(Элемент(Форма, Колонка.Ключ).Заголовок, "Колонка " + Колонка.Ключ).Равно(Колонка.Значение);
	КонецЦикла;

