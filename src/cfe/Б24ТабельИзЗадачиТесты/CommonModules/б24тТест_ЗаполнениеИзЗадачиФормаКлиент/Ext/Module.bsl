Процедура Окно_ПараметрыДоступныНаКлиентеЧерезРеквизиты() Экспорт

	// Сотрудник нового табеля — физическое лицо текущего пользователя: непустая ссылка без записи в базу.
	Сотрудник = ПолучитьФорму("Документ.гем_Табель.Форма.ФормаДокумента").Объект.Сотрудник;
	ЮТест.ОжидаетЧто(ЗначениеЗаполнено(Сотрудник), "У пользователя тестов есть физическое лицо").ЭтоИстина();

	Форма = ФормаОкна(, Сотрудник, Дата(2026, 3, 5));

	// На клиенте у открытого окна в Параметры нет ни сотрудника, ни даты (найдено живой проверкой ui-check):
	// клиентский код читает их из реквизитов, которые заполнил сервер.
	ЮТест.ОжидаетЧто(Форма.ТабельДата, "Дата табеля").Равно(Дата(2026, 3, 5));
	ЮТест.ОжидаетЧто(Форма.ТабельСотрудник, "Сотрудник").Равно(Сотрудник);

