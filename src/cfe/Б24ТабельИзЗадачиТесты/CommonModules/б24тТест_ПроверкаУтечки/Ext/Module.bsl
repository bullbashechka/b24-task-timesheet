// Ключи вебхука и OpenAI (из безопасного хранилища) в журнале регистрации и в текстовых файлах.
//
// Параметры:
//  Файлы - Массив из Строка - пути текстовых файлов.
//  СЖурналом - Булево - просматривать ли журнал регистрации (долго: сотни тысяч записей); тесты отключают.
//
// Возвращаемое значение:
//  Структура:
//   * Журнал - Число - сколько записей журнала регистрации содержат ключ вебхука.
//   * Файлы - Число - в скольких файлах из списка есть ключ вебхука.
//   * ПровереноЗаписей - Число
//   * ПровереноФайлов - Число
//   * Ошибка - Строка - причина, по которой ключ вебхука не искали; пусто, если искали.
//   * ЖурналOpenAI - Число - сколько записей журнала содержат ключ OpenAI.
//   * ФайлыOpenAI - Число - в скольких файлах из списка есть ключ OpenAI.
//   * ОшибкаOpenAI - Строка - причина, по которой ключ OpenAI не искали; пусто, если искали.
//   * Непрочитано - Число - сколько файлов из списка занято другим процессом (например, в них пишется вывод самого прогона)
//     и не прочитано.
Функция ЧислоНаходок(Файлы, СЖурналом = Истина) Экспорт

	Результат = Новый Структура("Журнал, Файлы, ПровереноЗаписей, ПровереноФайлов, Ошибка, ЖурналOpenAI, ФайлыOpenAI, ОшибкаOpenAI, Непрочитано",
		0, 0, 0, 0, "", 0, 0, "", 0);
	Ключ = КлючВебхука();
	КлючИИ = КлючOpenAI();
	Если СтрДлина(Ключ) < 8 Тогда
		Результат.Ошибка = "Адрес вебхука не задан или в нём нет ключа: проверять нечего";
	КонецЕсли;
	Если СтрДлина(КлючИИ) < 8 Тогда
		Результат.ОшибкаOpenAI = "Ключ OpenAI не сохранён: проверять нечего";
	КонецЕсли;
	Если Результат.Ошибка <> "" И Результат.ОшибкаOpenAI <> "" Тогда
		Возврат Результат;
	КонецЕсли;

	Если СЖурналом Тогда
		Записи = Новый ТаблицаЗначений;
		ВыгрузитьЖурналРегистрации(Записи);
		Колонки = Записи.Колонки;
		Для Каждого Запись Из Записи Цикл
			Результат.ПровереноЗаписей = Результат.ПровереноЗаписей + 1;
			НашёлВебхук = Ложь;
			НашёлOpenAI = Ложь;
			Для Каждого Колонка Из Колонки Цикл
				Значение = Запись[Колонка.Имя];
				Если ТипЗнч(Значение) <> Тип("Строка") Тогда
					Продолжить;
				КонецЕсли;
				НашёлВебхук = НашёлВебхук Или (Результат.Ошибка = "" И СтрНайти(Значение, Ключ) > 0);
				НашёлOpenAI = НашёлOpenAI Или (Результат.ОшибкаOpenAI = "" И СтрНайти(Значение, КлючИИ) > 0);
			КонецЦикла;
			Результат.Журнал = Результат.Журнал + ?(НашёлВебхук, 1, 0);
			Результат.ЖурналOpenAI = Результат.ЖурналOpenAI + ?(НашёлOpenAI, 1, 0);
		КонецЦикла;
	КонецЕсли;

	Для Каждого Путь Из Файлы Цикл
		Файл = Новый Файл(Путь);
		Если Не Файл.Существует() Или Файл.ЭтоКаталог() Или Файл.Размер() > 20971520 Тогда
			Продолжить;
		КонецЕсли;
		Текст = Новый ТекстовыйДокумент;
		Попытка
			Текст.Прочитать(Путь, "UTF-8");
		Исключение
			// Файл занят другим процессом (пишется вывод этого же прогона): его не прочитать, и он считается отдельно.
			Результат.Непрочитано = Результат.Непрочитано + 1;
			Продолжить;
		КонецПопытки;
		Результат.ПровереноФайлов = Результат.ПровереноФайлов + 1;
		Содержимое = Текст.ПолучитьТекст();
		Если Результат.Ошибка = "" И СтрНайти(Содержимое, Ключ) > 0 Тогда
			Результат.Файлы = Результат.Файлы + 1;
		КонецЕсли;
		Если Результат.ОшибкаOpenAI = "" И СтрНайти(Содержимое, КлючИИ) > 0 Тогда
			Результат.ФайлыOpenAI = Результат.ФайлыOpenAI + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Сколько раз ключ OpenAI из хранилища встречается в текстах (поля и надписи формы настроек и подобное). Сам ключ
// наружу не выходит.
//
// Параметры:
//  Тексты - Массив из Строка
//
// Возвращаемое значение:
//  Число - число текстов с ключом; -1, если ключа в хранилище нет и проверять нечего.
Функция ЧислоВхожденийКлючаOpenAI(Тексты) Экспорт

	Ключ = КлючOpenAI();
	Если СтрДлина(Ключ) < 8 Тогда
		Возврат -1;
	КонецЕсли;
	Найдено = 0;
	Для Каждого Текст Из Тексты Цикл
		Если ТипЗнч(Текст) = Тип("Строка") И СтрНайти(Текст, Ключ) > 0 Тогда
			Найдено = Найдено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Найдено;

КонецФункции

// Тексты задач, комментарии, пароли, черновики и ответы ИИ в журнале регистрации (С24, С30). Просматриваются только
// события расширения.
//
// Параметры:
//  Фрагменты - Массив из Строка - тексты, которых в журнале быть не должно.
//  Начало - Дата - с какого момента смотреть журнал.
//
// Возвращаемое значение:
//  Структура:
//   * Найдено - Число - сколько записей содержат хотя бы один фрагмент.
//   * ПровереноЗаписей - Число
Функция ЧислоТекстовВЖурнале(Фрагменты, Начало) Экспорт

	Результат = Новый Структура("Найдено, ПровереноЗаписей", 0, 0);
	События = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Обращение,Ошибка,Доступ,Настройки,ИИ", ",") Цикл
		События.Добавить("Б24ТабельИзЗадачи." + Имя);
	КонецЦикла;
	Записи = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Записи, Новый Структура("ДатаНачала, Событие", Начало, События));
	Для Каждого Запись Из Записи Цикл
		Результат.ПровереноЗаписей = Результат.ПровереноЗаписей + 1;
		Для Каждого Фрагмент Из Фрагменты Цикл
			Если Не ПустаяСтрока(Фрагмент) И СтрНайти(Запись.Комментарий, Фрагмент) > 0 Тогда
				Результат.Найдено = Результат.Найдено + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вторая часть адреса после «/rest/»: «‹номер›/‹ключ›/».
Функция КлючВебхука()

	УстановитьПривилегированныйРежим(Истина);
	Адрес = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Б24ТабельИзЗадачи", "АдресВебхука");
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Адрес, "/rest/");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = СтрРазделить(Сред(Адрес, Позиция + 6), "/", Ложь);
	Возврат ?(Части.Количество() < 2, "", Части[1]);

КонецФункции

Функция КлючOpenAI()

	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Б24ТабельИзЗадачи", "КлючOpenAI");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(ТипЗнч(Ключ) = Тип("Строка"), Ключ, "");

КонецФункции

#КонецОбласти
