// Поиск ключа вебхука (из безопасного хранилища) в журнале регистрации и в текстовых файлах. Модуль только для тестового
// расширения и локальной базы разработчика (PRD «Связь с Битрикс24 и безопасность», TASKS 11.1). Адрес и ключ не выходят
// из функции: результат — только числа. Читает хранилище единственный раз и только здесь.

// Возвращаемое значение:
//  Структура:
//   * Журнал - Число - сколько записей журнала регистрации содержат ключ.
//   * Файлы - Число - в скольких файлах из списка есть ключ.
//   * ПровереноЗаписей - Число
//   * ПровереноФайлов - Число
//   * Ошибка - Строка - причина, по которой проверка не выполнена; пусто, если всё проверено.
Функция ЧислоНаходок(Файлы) Экспорт

	Результат = Новый Структура("Журнал, Файлы, ПровереноЗаписей, ПровереноФайлов, Ошибка", 0, 0, 0, 0, "");
	Ключ = КлючВебхука();
	Если СтрДлина(Ключ) < 8 Тогда
		Результат.Ошибка = "Адрес вебхука не задан или в нём нет ключа: проверять нечего";
		Возврат Результат;
	КонецЕсли;

	Записи = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Записи);
	Колонки = Записи.Колонки;
	Для Каждого Запись Из Записи Цикл
		Результат.ПровереноЗаписей = Результат.ПровереноЗаписей + 1;
		Для Каждого Колонка Из Колонки Цикл
			Значение = Запись[Колонка.Имя];
			Если ТипЗнч(Значение) = Тип("Строка") И СтрНайти(Значение, Ключ) > 0 Тогда
				Результат.Журнал = Результат.Журнал + 1;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Для Каждого Путь Из Файлы Цикл
		Файл = Новый Файл(Путь);
		Если Не Файл.Существует() Или Файл.ЭтоКаталог() Или Файл.Размер() > 20971520 Тогда
			Продолжить;
		КонецЕсли;
		Текст = Новый ТекстовыйДокумент;
		Текст.Прочитать(Путь, "UTF-8");
		Результат.ПровереноФайлов = Результат.ПровереноФайлов + 1;
		Если СтрНайти(Текст.ПолучитьТекст(), Ключ) > 0 Тогда
			Результат.Файлы = Результат.Файлы + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Вторая часть адреса после «/rest/»: «‹номер›/‹ключ›/».
Функция КлючВебхука()

	УстановитьПривилегированныйРежим(Истина);
	Адрес = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Б24ТабельИзЗадачи", "АдресВебхука");
	УстановитьПривилегированныйРежим(Ложь);
	Если ТипЗнч(Адрес) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	Позиция = СтрНайти(Адрес, "/rest/");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = СтрРазделить(Сред(Адрес, Позиция + 6), "/", Ложь);
	Возврат ?(Части.Количество() < 2, "", Части[1]);

КонецФункции
