#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьКлиентскийТест("КолонкаИДБ24_ЕстьВТаблицеТабель",
			"В таблице «Табель» формы документа есть колонка «ID Б24»")
		.ДобавитьКлиентскийТест("КолонкаИДБ24_ВидимаИРедактируется",
			"Колонка «ID Б24» видна и доступна для редактирования")
		.ДобавитьКлиентскийТест("КолонкаИДБ24_СтоитПослеСодержания",
			"Колонка «ID Б24» стоит сразу после «Содержание»")
		.ДобавитьКлиентскийТест("КолонкаИДБ24_ПустаВСтрокеОтКнопкиДобавить",
			"В строке, добавленной кнопкой «Добавить», «ID Б24» пустая")
		.ДобавитьКлиентскийТест("КолонкаИДБ24_КопируетсяСоСтрокой",
			"При копировании строки номер копируется вместе с остальными полями")
		.ДобавитьКлиентскийТест("КолонкаИДБ24_ФормаЗаписываетИПроводитТабель",
			"Табель с номером записывается и проводится из формы, номер сохраняется");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура КолонкаИДБ24_ЕстьВТаблицеТабель() Экспорт

	Форма = ФормаДокумента();
	Колонка = КолонкаИДБ24(Форма);

	ЮТест.ОжидаетЧто(Колонка, "Нет колонки " + ИмяКолонки()).Существует();

КонецПроцедуры

Процедура КолонкаИДБ24_ВидимаИРедактируется() Экспорт

	Форма = ФормаДокумента();
	Колонка = КолонкаИДБ24(Форма);

	ЮТест.ОжидаетЧто(Колонка, "Нет колонки " + ИмяКолонки()).Существует();
	ЮТест.ОжидаетЧто(Колонка.Видимость, "Видимость").Равно(Истина);
	ЮТест.ОжидаетЧто(Колонка.Доступность, "Доступность").Равно(Истина);
	ЮТест.ОжидаетЧто(Колонка.ТолькоПросмотр, "Только просмотр").Равно(Ложь);

КонецПроцедуры

Процедура КолонкаИДБ24_СтоитПослеСодержания() Экспорт

	Форма = ФормаДокумента();
	ЮТест.ОжидаетЧто(КолонкаИДБ24(Форма), "Нет колонки " + ИмяКолонки()).Существует();

	Имена = Новый Массив;
	Для Каждого Колонка Из Форма.Элементы.Табель.ПодчиненныеЭлементы Цикл
		Имена.Добавить(Колонка.Имя);
	КонецЦикла;

	ИндексСодержания = Имена.Найти("ТабельСодержание");
	ЮТест.ОжидаетЧто(ИндексСодержания, "Колонка «Содержание» не найдена").НеРавно(Неопределено);
	ЮТест.ОжидаетЧто(Имена.Найти(ИмяКолонки()), "Позиция колонки «ID Б24»").Равно(ИндексСодержания + 1);

КонецПроцедуры

Процедура КолонкаИДБ24_ПустаВСтрокеОтКнопкиДобавить() Экспорт

	Форма = ОткрытаяФормаНовогоТабеля();
	Попытка
		Форма.Элементы.Табель.ДобавитьСтроку();
		ТекущиеДанные = Форма.Элементы.Табель.ТекущиеДанные;
		ЮТест.ОжидаетЧто(ТекущиеДанные = Неопределено, "Строка не добавлена").Равно(Ложь);
		ЮТест.ОжидаетЧто(ТекущиеДанные.б24т_IDБ24, "Номер в новой строке").Равно("");
		Форма.Элементы.Табель.ЗакончитьРедактированиеСтроки(Ложь);
		ЮТест.ОжидаетЧто(Форма.Объект.Табель.Количество(), "Строк").Равно(1);
	Исключение
		ЗакрытьБезЗаписи(Форма);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьБезЗаписи(Форма);

КонецПроцедуры

Процедура КолонкаИДБ24_КопируетсяСоСтрокой() Экспорт

	Форма = ОткрытаяФормаНовогоТабеля();
	Попытка
		Исходная = ДобавитьСтрокуСНомером(Форма, "550");
		Форма.Элементы.Табель.ТекущаяСтрока = Исходная.ПолучитьИдентификатор();
		Форма.Элементы.Табель.СкопироватьСтроку();
		Форма.Элементы.Табель.ЗакончитьРедактированиеСтроки(Ложь);

		ЮТест.ОжидаетЧто(Форма.Объект.Табель.Количество(), "Строк").Равно(2);
		Для Каждого Строка Из Форма.Объект.Табель Цикл
			ЮТест.ОжидаетЧто(Строка.б24т_IDБ24, "Номер в строке " + Строка.НомерСтроки).Равно("550");
			ЮТест.ОжидаетЧто(Строка.Содержание, "Содержание в строке " + Строка.НомерСтроки)
				.Равно("[ТЕСТ] Работа по задаче");
		КонецЦикла;
	Исключение
		ЗакрытьБезЗаписи(Форма);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьБезЗаписи(Форма);

КонецПроцедуры

Процедура КолонкаИДБ24_ФормаЗаписываетИПроводитТабель() Экспорт

	Форма = ОткрытаяФормаНовогоТабеля();
	Ссылка = Неопределено;
	Попытка
		Форма.Объект.Комментарий = "[ТЕСТ] ID Б24 из формы";
		ДобавитьСтрокуСНомером(Форма, "550");
		Записан = Форма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
		Ссылка = Форма.Объект.Ссылка;

		ЮТест.ОжидаетЧто(Записан, "Записан").Равно(Истина);
		ЮТест.ОжидаетЧто(Форма.Объект.Проведен, "Проведен").Равно(Истина);
		ЮТест.ОжидаетЧто(Форма.Объект.Табель[0].б24т_IDБ24, "Номер после записи").Равно("550");
	Исключение
		ЗакрытьБезЗаписи(Форма);
		УдалитьТабель(Ссылка);
		ВызватьИсключение;
	КонецПопытки;
	ЗакрытьБезЗаписи(Форма);
	УдалитьТабель(Ссылка);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИмяКолонки()

	Возврат "Табельб24т_IDБ24";

КонецФункции

Функция ФормаДокумента()

	Возврат ПолучитьФорму("Документ.гем_Табель.Форма.ФормаДокумента");

КонецФункции

Функция ОткрытаяФормаНовогоТабеля()

	Возврат ОткрытьФорму("Документ.гем_Табель.Форма.ФормаДокумента");

КонецФункции

Функция ДобавитьСтрокуСНомером(Форма, Номер)

	Строка = Форма.Объект.Табель.Добавить();
	Строка.ВремяНач = Дата(1, 1, 1, 9, 0, 0);
	Строка.ВремяКон = Дата(1, 1, 1, 10, 0, 0);
	Строка.ТипВремени = ПредопределенноеЗначение("Перечисление.гем_ТипыВремени.Офис");
	Строка.Содержание = "[ТЕСТ] Работа по задаче";
	Строка.б24т_IDБ24 = Номер;
	Возврат Строка;

КонецФункции

Процедура ЗакрытьБезЗаписи(Форма)

	Если Форма.Открыта() Тогда
		Форма.Модифицированность = Ложь;
		Форма.Закрыть();
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьТабель(Ссылка)

	Если ЗначениеЗаполнено(Ссылка) Тогда
		ЮТест.Данные().Удалить(Ссылка);
	КонецЕсли;

КонецПроцедуры

Функция КолонкаИДБ24(Форма)

	Возврат Форма.Элементы.Найти(ИмяКолонки());

КонецФункции

#КонецОбласти
