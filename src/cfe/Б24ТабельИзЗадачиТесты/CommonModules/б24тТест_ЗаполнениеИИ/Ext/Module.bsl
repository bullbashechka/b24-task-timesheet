	Результат = Операция(Окружение, ПараметрыОперации(Окружение, "черновик"), КлиентБитрикс24, КлиентИИ);
	ЮТест.ОжидаетЧто(Результат.Итог, "Итог при чтении задачи").Равно("Ошибка");
	ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщение при чтении задачи").Равно(Недоступен);
	ЮТест.ОжидаетЧто(КлиентИИ.Вызовы.Количество(), "OpenAI при чтении задачи").Равно(0);

