	ЮТест.ОжидаетЧто(Результат.Итог, "Итог при проверке доступа").Равно("Ошибка");
	ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщение при проверке доступа").Равно(Недоступен);
	ЮТест.ОжидаетЧто(КлиентИИ.Вызовы.Количество(), "OpenAI при проверке доступа").Равно(0);

	// Не ответил при чтении задачи.
	КлиентБитрикс24 = б24тТест_Задачи.КлиентПоНомеру(30);
	б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(КлиентБитрикс24, "Ошибка_Сервер_Синтетика");
	б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(КлиентБитрикс24, "Ошибка_Сервер_Синтетика");
