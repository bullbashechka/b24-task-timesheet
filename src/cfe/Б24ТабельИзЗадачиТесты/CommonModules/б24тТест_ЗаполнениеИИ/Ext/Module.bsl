Функция Операция(Окружение, Параметры, КлиентБитрикс24, КлиентИИ)

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = б24т_ЗаполнениеИИ.СодержаниеОтИИ(Параметры, Окружение.Пользователь, КлиентБитрикс24, КлиентИИ);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

КонецФункции

// Ошибка OpenAI: один запрос без повторов, текст для сотрудника по Ф12, текста поля в результате нет.
