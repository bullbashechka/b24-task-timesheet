Процедура Операция_ПределВремениБитрикс24() Экспорт

	Окружение = НовоеОкружение();
	КлиентБитрикс24 = НовыйКлиентБитрикс24(ЗадачаДляТеста());
	КлиентИИ = НовыйКлиентИИ(ОтветМодели("Текст."));

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Операция(Окружение, ПараметрыОперации(Окружение), КлиентБитрикс24, КлиентИИ);

	// Срок один на все запросы Битрикс24: 15 секунд от начала операции.
	ЮТест.ОжидаетЧто(ТипЗнч(КлиентБитрикс24.СрокОкончания) = Тип("Число"), "Срок задан").ЭтоИстина();
	Запас = КлиентБитрикс24.СрокОкончания - Начало;
	ЮТест.ОжидаетЧто(Запас >= 15000 И Запас < 17000, "Срок — около 15 секунд, сейчас " + Запас + " мс").ЭтоИстина();
	// OpenAI ждёт свои 30 секунд независимо от Битрикс24.
