Процедура Операция_БитриксНедоступен() Экспорт

	Окружение = НовоеОкружение();
	Недоступен = "Битрикс24 недоступен. Попробуйте позже";

	// Не ответил при проверке доступа сотрудника.
	КлиентБитрикс24 = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(КлиентБитрикс24, "Ошибка_Сервер_Синтетика");
