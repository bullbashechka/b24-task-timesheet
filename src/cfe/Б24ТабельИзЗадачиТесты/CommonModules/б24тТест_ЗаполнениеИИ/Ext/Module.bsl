// Текст, который модель пишет в поле text ответа: JSON по схеме codes, text, own_words, unfilled.
Функция ОтветМодели(Текст, Шифры = Неопределено, СвоимиСловами = Ложь, Незаполненные = Неопределено)

	Ответ = Новый Структура;
	Ответ.Вставить("codes", ?(Шифры = Неопределено, Новый Массив, Шифры));
	Ответ.Вставить("text", Текст);
	Ответ.Вставить("own_words", СвоимиСловами);
	Ответ.Вставить("unfilled", ?(Незаполненные = Неопределено, Новый Массив, Незаполненные));
	Возврат ТекстJSON(Ответ);

