Процедура Операция_ИИНеДоступен() Экспорт

	Окружение = НовоеОкружение();
	НеНастроен = "ИИ не настроен. Обратитесь к администратору";

	// Флажок снят, ключ сохранён.
	ИзменитьНастройкиИИ(Новый Структура("ИспользоватьИИ", Ложь));
	КлиентБитрикс24 = НовыйКлиентБитрикс24(ЗадачаДляТеста());
	КлиентИИ = НовыйКлиентИИ(ОтветМодели("Текст."));
	Результат = Операция(Окружение, ПараметрыОперации(Окружение), КлиентБитрикс24, КлиентИИ);
	ЮТест.ОжидаетЧто(Результат.Итог, "Итог при снятом флажке").Равно("Ошибка");
	ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщение при снятом флажке").Равно(НеНастроен);
	ЮТест.ОжидаетЧто(КлиентБитрикс24.Вызовы.Количество(), "Обращений к Битрикс24 при снятом флажке").Равно(0);
	ЮТест.ОжидаетЧто(КлиентИИ.Вызовы.Количество(), "Обращений к OpenAI при снятом флажке").Равно(0);

	// Ключ удалён.
	ИзменитьНастройкиИИ(Новый Структура("УдалитьКлюч, ИспользоватьИИ", Истина, Ложь));
	КлиентБитрикс24 = НовыйКлиентБитрикс24(ЗадачаДляТеста());
	КлиентИИ = НовыйКлиентИИ(ОтветМодели("Текст."));
	Результат = Операция(Окружение, ПараметрыОперации(Окружение), КлиентБитрикс24, КлиентИИ);
	ЮТест.ОжидаетЧто(Результат.Итог, "Итог без ключа").Равно("Ошибка");
	ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщение без ключа").Равно(НеНастроен);
	ЮТест.ОжидаетЧто(КлиентБитрикс24.Вызовы.Количество(), "Обращений к Битрикс24 без ключа").Равно(0);
	ЮТест.ОжидаетЧто(КлиентИИ.Вызовы.Количество(), "Обращений к OpenAI без ключа").Равно(0);

КонецПроцедуры

Процедура Операция_НеверныйНомер() Экспорт

	Окружение = НовоеОкружение();
	Для Каждого Номер Из СтрРазделить("0,-5", ",") Цикл
		Параметры = ПараметрыОперации(Окружение);
		Параметры.Номер = Число(Номер);
		КлиентБитрикс24 = НовыйКлиентБитрикс24(ЗадачаДляТеста());
		КлиентИИ = НовыйКлиентИИ(ОтветМодели("Текст."));

		Результат = Операция(Окружение, Параметры, КлиентБитрикс24, КлиентИИ);

		ЮТест.ОжидаетЧто(Результат.Итог, "Итог, номер " + Номер).Равно("Отклонена");
		ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщение, номер " + Номер)
			.Равно("Введите номер задачи или ссылку на задачу Битрикс24");
		ЮТест.ОжидаетЧто(КлиентБитрикс24.Вызовы.Количество() + КлиентИИ.Вызовы.Количество(), "Обращений, номер " + Номер).Равно(0);
	КонецЦикла;

	Параметры = ПараметрыОперации(Окружение);
	Параметры.Номер = Неопределено;
	ЮТест.ОжидаетЧто(Операция(Окружение, Параметры, НовыйКлиентБитрикс24(ЗадачаДляТеста()), НовыйКлиентИИ(ОтветМодели("Текст."))).Итог,
		"Номер не указан").Равно("Отклонена");

