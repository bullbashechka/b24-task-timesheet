// Тесты операции «содержание от ИИ» (этап 18: Ф9, Ф11, Ф12, Ф14): задача перечитывается и проверяется в Битрикс24, затем один
// запрос к OpenAI, результат для окна. Битрикс24 и OpenAI — заглушки транспорта на записанных ответах; все тесты идут
// в транзакции: окружение, ключ и настройки не остаются в базе.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("Операция_Успех", "Задача перечитана с описанием, один запрос к OpenAI, готовый результат для окна")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_РежимТестирования", "В режиме тестирования операция работает так же, плюс проверка проекта")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_ИИНеДоступен", "ИИ выключен или ключ удалён: «не настроен», ни одного обращения к Битрикс24 и OpenAI")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_НеверныйНомер", "Номер задачи не указан: отказ без обращений")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_БитриксНедоступен", "Битрикс24 не ответил: сообщение Ф9, к OpenAI ни одного обращения")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_ЗадачаНеНайдена", "Задачи больше нет: отказ, к OpenAI ни одного обращения")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_НетРоли", "У сотрудника нет роли в задаче: отказ, к OpenAI ни одного обращения")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_ДругойПроектВРежимеТестирования", "Задача другого проекта в режиме тестирования: отказ, к OpenAI ни одного обращения")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_ПределВремениБитрикс24", "На проверки Битрикс24 отведено 15 секунд на все запросы")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_ОшибкиИИ", "Ошибки OpenAI дают два текста Ф12, один запрос без повторов, текст не возвращается")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_ОтветНеРазобран", "Ответ модели нельзя разобрать: «ИИ недоступен», причина в журнале без текстов")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_Черновик", "Черновик — текст поля; название задачи из окна и новое название черновиком не считаются")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Операция_ФормулировкиИМеста", "Формулировки на дату табеля уходят ИИ; оставшиеся места и шифры — в результате и журнале")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Инварианты_БитриксТолькоЧтение", "В Битрикс24 уходят только запросы на чтение")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Инварианты_БазаНеМеняется", "Операция не пишет в базу: настройки, формулировки и очередь не меняются")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Инварианты_РезультатБезСекретов", "В результате нет номера сотрудника в Битрикс24, ключа, сырого ответа и шифров")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Инварианты_ЖурналБезТекстов", "В журнале только «своими словами» и шифры из списка: ни названия, ни описания, ни черновика, ни ответа")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_ФлажокСнят", "Флажок комментариев снят: к чату ни одного запроса, запрос к ИИ прежний, надписи нет")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_ПередаютсяИИ", "Флажок включён: чат читается тем же клиентом, комментарии с пометками уходят ИИ, в журнале их число")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_НетПрава", "Нет права «Чат и уведомления»: ИИ без комментариев, «не получены» в результате, причина в журнале")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_ОбрывНаВторойПорции", "Сбой на второй порции: передаётся полученное с пометкой «не все», надписи нет (7А)")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_ОбрывБезПереданных", "Сбой, а передать нечего: надпись «не получены» (7А)")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_ЗадачаБезЧата", "У задачи нет чата: запросов к чату нет, надписи нет")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_БитриксНеОтветилНаПроверку", "Битрикс24 не ответил на проверку задачи: как раньше, без чата и без ИИ")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_ФлажокЧитаетсяПриНажатии", "Флажок, снятый между нажатиями, действует со следующего нажатия (8А)")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Комментарии_ЖурналБезТекстов", "Текстов комментариев нет ни в одном событии расширения (Ф14)")
			.ВТранзакции();

КонецПроцедуры

