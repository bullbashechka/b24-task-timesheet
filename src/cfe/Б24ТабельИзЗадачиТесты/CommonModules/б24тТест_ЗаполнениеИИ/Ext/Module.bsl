	КлиентИИ = б24тТест_ЗаглушкаOpenAI.НовыйКлиент();
	Если ЭтоИсключение Тогда
		б24тТест_ЗаглушкаOpenAI.ДобавитьИсключение(КлиентИИ, "Нет связи");
	Иначе
		б24тТест_ЗаглушкаOpenAI.ДобавитьОтвет(КлиентИИ, Случай);
	КонецЕсли;
	Название = ?(ЭтоИсключение, "нет ответа", Случай);

	Результат = Операция(Окружение, ПараметрыОперации(Окружение, "черновик"), НовыйКлиентБитрикс24(ЗадачаДляТеста()), КлиентИИ);

	ЮТест.ОжидаетЧто(Результат.Итог, "Итог: " + Название).Равно("Ошибка");
	ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщение: " + Название).Равно(Ожидается);
	ЮТест.ОжидаетЧто(Результат.Текст, "Текста нет: " + Название).Равно("");
	ЮТест.ОжидаетЧто(КлиентИИ.Вызовы.Количество(), "Один запрос без повторов: " + Название).Равно(1);

КонецПроцедуры

