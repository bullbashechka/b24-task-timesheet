#Область Тесты

Процедура Операция_Успех() Экспорт

	Окружение = НовоеОкружение();
	Метка = НоваяМетка();
	Задача = ЗадачаДляТеста(Новый Структура("title, description", "Обновление " + Метка,
		"[B]Важное[/B] описание " + Метка));
	КлиентБитрикс24 = НовыйКлиентБитрикс24(Задача);
	КлиентИИ = НовыйКлиентИИ(ОтветМодели("Установка платформы на ПК Анны."));

	Результат = Операция(Окружение, ПараметрыОперации(Окружение, "обновил бк"), КлиентБитрикс24, КлиентИИ);

	ЮТест.ОжидаетЧто(Результат.Итог, "Итог").Равно("Готово");
	ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщения нет").Равно("");
	ЮТест.ОжидаетЧто(Результат.Текст, "Текст").Равно("Установка платформы на ПК Анны.");
	ЮТест.ОжидаетЧто(Результат.Места.Количество(), "Мест нет").Равно(0);
	ЮТест.ОжидаетЧто(Результат.НеИзменён, "Текст изменён").ЭтоЛожь();

	// Битрикс24: проверки доступа, затем одно перечитывание задачи с описанием. Компании и реквизиты ИИ не нужны.
	ЮТест.ОжидаетЧто(б24тТест_Доступ.МетодыВызовов(КлиентБитрикс24), "Методы Битрикс24")
		.Равно("user.admin,user.get,tasks.task.get");
	ВызовЗадачи = КлиентБитрикс24.Вызовы[2];
	ЮТест.ОжидаетЧто(ВызовЗадачи.Параметры["taskId"], "Номер задачи").Равно(НомерЗадачи());
	ЮТест.ОжидаетЧто(ВызовЗадачи.Параметры["select"].Найти("DESCRIPTION") <> Неопределено, "Описание запрашивается").ЭтоИстина();

	// OpenAI: ровно один запрос; в нём название, описание без разметки и черновик.
	ЮТест.ОжидаетЧто(КлиентИИ.Вызовы.Количество(), "Запросов к OpenAI").Равно(1);
	Вход = ВходЗапроса(КлиентИИ);
	ЮТест.ОжидаетЧто(Вход["title"], "Название").Равно("Обновление " + Метка);
	ЮТест.ОжидаетЧто(Вход["description"], "Описание без разметки").Равно("Важное описание " + Метка);
	ЮТест.ОжидаетЧто(Вход["draft"], "Черновик").Равно("обновил бк");

КонецПроцедуры

