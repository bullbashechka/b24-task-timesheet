// Всё, что операция могла бы изменить в базе: настройки и очередь формулировок. Сравнивается до и после.
Функция СнимокБазы()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Формулировки.Период КАК Период,
	|	Формулировки.Шифр КАК Шифр,
	|	Формулировки.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.ГЕМ_ШаблоныДляЗаполненияТабелей КАК Формулировки
	|УПОРЯДОЧИТЬ ПО
	|	Шифр, Период";
	Записи = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Записи.Добавить(Формат(Выборка.Период, "ДФ=yyyyMMdd") + "|" + Выборка.Шифр + "|" + Выборка.Описание);
	КонецЦикла;

	Настройки = б24т_Настройки.Настройки();
	ДляЗапроса = б24т_Настройки.НастройкиЗапросаИИ();
	Возврат СтрШаблон("%1;%2;%3;%4;%5;%6;%7", Настройки.Настроено, Настройки.РежимТестирования,
		Настройки.ПроектДляТестирования, Настройки.ИИДоступен, ДляЗапроса.Модель + ДляЗапроса.Указания + ДляЗапроса.Примеры,
		Записи.Количество(), СтрСоединить(Записи, "#"));

КонецФункции

// Есть ли строка в значении на любой глубине: структуры, соответствия и массивы обходятся целиком.
Функция СодержитСтроку(Значение, Искомое)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СтрНайти(Значение, Искомое) > 0;
	ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			Если СодержитСтроку(КлючИЗначение.Ключ, Искомое) Или СодержитСтроку(КлючИЗначение.Значение, Искомое) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Если СодержитСтроку(Элемент, Искомое) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

