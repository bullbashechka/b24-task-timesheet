// Заглушка транспорта клиента OpenAI: отвечает записанными ответами из макетов б24тТест_ОтветИИ_* и запоминает вызовы.
// Транспорт в клиенте задаётся именем общего модуля с функцией ВыполнитьЗапрос(Запрос); клиент создаёт НовыйКлиент().
// Ключ в журнал вызовов не кладётся: только последние четыре символа, по ним тесты различают ключи.

#Область ПрограммныйИнтерфейс

// Транспорт: берёт следующий ответ из очереди клиента и записывает запрос в Клиент.Вызовы.
//
// Параметры:
//  Запрос - Структура - Тело, Ключ, Таймаут, Клиент.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число
//   * Тело - Строка
//   * ИдентификаторЗапроса - Строка
//
Функция ВыполнитьЗапрос(Запрос) Экспорт

	Клиент = Запрос.Клиент;

	Поля = Новый Массив;
	Для Каждого Поле Из Запрос Цикл
		Поля.Добавить(Поле.Ключ);
	КонецЦикла;

	Вызов = Новый Структура;
	Вызов.Вставить("Тело", Запрос.Тело);
	Вызов.Вставить("Параметры", ПараметрыИзТела(Запрос.Тело));
	Вызов.Вставить("Таймаут", Запрос.Таймаут);
	Вызов.Вставить("ОкончаниеКлюча", Прав(Запрос.Ключ, 4));
	Вызов.Вставить("ПоляЗапроса", СтрСоединить(Поля, ","));
	Клиент.Вызовы.Добавить(Вызов);

	Если Клиент.Ответы.Количество() = 0 Тогда
		ВызватьИсключение "Заглушка OpenAI: нет ответа в очереди";
	КонецЕсли;

	Ответ = Клиент.Ответы[0];
	Клиент.Ответы.Удалить(0);

	Если Ответ.ТекстИсключения <> Неопределено Тогда
		ВызватьИсключение Ответ.ТекстИсключения;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Тело", Ответ.Тело);
	Результат.Вставить("ИдентификаторЗапроса", "req_test0001");
	Возврат Результат;

КонецФункции

// Клиент OpenAI с этой заглушкой вместо HTTPS.
//
// Возвращаемое значение:
//  Структура - клиент б24т_OpenAI с очередью Ответы.
//
Функция НовыйКлиент() Экспорт

	Клиент = б24т_OpenAI.НовыйКлиент("б24тТест_ЗаглушкаOpenAI");
	Клиент.Вставить("Ответы", Новый Массив);
	Возврат Клиент;

КонецФункции

// Ставит в очередь ответ из записанного макета.
//
// Параметры:
//  Клиент - Структура
//  Случай - Строка - часть имени макета после «б24тТест_ОтветИИ_».
//  КодСостояния - Число, Неопределено - по умолчанию тот, с которым OpenAI отдаёт этот ответ.
//
Процедура ДобавитьОтвет(Клиент, Случай, КодСостояния = Неопределено) Экспорт

	Если КодСостояния = Неопределено Тогда
		КодСостояния = КодСостоянияПоУмолчанию(Случай);
	КонецЕсли;
	ДобавитьСыройОтвет(Клиент, КодСостояния, ТекстМакета(Случай));

КонецПроцедуры

// Ставит в очередь ответ с произвольным телом.
Процедура ДобавитьСыройОтвет(Клиент, КодСостояния, Тело) Экспорт

	Клиент.Ответы.Добавить(НовыйОтвет(КодСостояния, Тело, Неопределено));

КонецПроцедуры

// Ставит в очередь успешный ответ модели с заданным текстом (JSON по схеме ответа). В теле ровно то, что разбирает клиент:
// статус, модель, текст модели и использование токенов; записанный ответ «Успех» для этого не нужен.
//
// Параметры:
//  Клиент - Структура
//  ТекстМодели - Строка - то, что модель пишет в поле text ответа: JSON-объект codes, text, own_words, unfilled или
//    любой другой текст.
//
Процедура ДобавитьОтветМодели(Клиент, ТекстМодели) Экспорт

	Содержимое = Новый Массив;
	Содержимое.Добавить(Новый Структура("type, text", "output_text", ТекстМодели));
	Вывод = Новый Массив;
	Вывод.Добавить(Новый Структура("type, content", "message", Содержимое));
	Использование = Новый Структура("input_tokens, output_tokens, input_tokens_details, output_tokens_details", 100, 50,
		Новый Структура("cached_tokens", 0), Новый Структура("reasoning_tokens", 10));
	Тело = Новый Структура("status, model, output, usage", "completed", "gpt-test-model", Вывод, Использование);

	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку();
	ЗаписатьJSON(Писатель, Тело);
	ДобавитьСыройОтвет(Клиент, 200, Писатель.Закрыть());

КонецПроцедуры

// Ставит в очередь исключение транспорта (нет связи, нет ответа за таймаут).
Процедура ДобавитьИсключение(Клиент, Текст) Экспорт

	Клиент.Ответы.Добавить(НовыйОтвет(0, "", Текст));

КонецПроцедуры

// Текст записанного ответа.
Функция ТекстМакета(Случай) Экспорт

	Возврат ПолучитьОбщийМакет("б24тТест_ОтветИИ_" + Случай).ПолучитьТекст();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОтвет(КодСостояния, Тело, ТекстИсключения)

	Ответ = Новый Структура;
	Ответ.Вставить("КодСостояния", КодСостояния);
	Ответ.Вставить("Тело", Тело);
	Ответ.Вставить("ТекстИсключения", ТекстИсключения);
	Возврат Ответ;

КонецФункции

// Коды состояния, с которыми OpenAI отдаёт записанные ошибки (TASKS 14.7).
Функция КодСостоянияПоУмолчанию(Случай)

	Коды = Новый Соответствие;
	Коды.Вставить("КлючОтклонён", 401);
	Коды.Вставить("МодельНедоступна", 404);
	Коды.Вставить("НетСредств", 429);
	Коды.Вставить("ЛимитЗапросов_Синтетика", 429);
	Коды.Вставить("ОшибкаСервера_Синтетика", 500);
	Коды.Вставить("НеJSON_Синтетика", 502);

	Код = Коды[Случай];
	Возврат ?(Код = Неопределено, 200, Код);

КонецФункции

Функция ПараметрыИзТела(Тело)

	Если ПустаяСтрока(Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Параметры = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Параметры;

КонецФункции

#КонецОбласти
