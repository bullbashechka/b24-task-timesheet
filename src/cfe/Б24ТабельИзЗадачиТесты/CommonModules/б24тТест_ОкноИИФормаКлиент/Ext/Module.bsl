// Форму держим в переменной вызывающего кода: элементы закрытой формы становятся недействительными.
Функция ФормаОкна()

	ПараметрыОкна = Новый Структура;
	ПараметрыОкна.Вставить("ДатаТабеля", Дата(2026, 10, 22));
	ПараметрыОкна.Вставить("Сотрудник", ПредопределенноеЗначение("Справочник.ФизическиеЛица.ПустаяСсылка"));
	ПараметрыОкна.Вставить("СтрокиТабеля", Новый Массив);
	Возврат ПолучитьФорму("Документ.гем_Табель.Форма.б24т_ЗаполнениеИзЗадачи", ПараметрыОкна);

