// Надписи ИИ под полем «Содержание»: пустой ожидаемый текст — надпись скрыта.
// Комментарии — ожидаемая надпись «ИИ не получил комментарии задачи»; по умолчанию её нет.
Процедура ПроверитьНадписи(Форма, Ожидание, Заполните, НеИзменён, Сообщение, Комментарии = "")

	Ожидаемые = Новый Структура;
	Ожидаемые.Вставить("НадписьОжиданияИИ", Ожидание);
	Ожидаемые.Вставить("НадписьЗаполните", Заполните);
	Ожидаемые.Вставить("НадписьНеИзменён", НеИзменён);
	Ожидаемые.Вставить("НадписьКомментарииНеПолучены", Комментарии);
	Ожидаемые.Вставить("НадписьСообщенияИИ", Сообщение);
	Для Каждого Надпись Из Ожидаемые Цикл
		Видна = Элемент(Форма, Надпись.Ключ).Видимость;
		ЮТест.ОжидаетЧто(Видна, "Видимость " + Надпись.Ключ).Равно(Не ПустаяСтрока(Надпись.Значение));
		Если Видна Тогда
			ЮТест.ОжидаетЧто(Элемент(Форма, Надпись.Ключ).Заголовок, "Текст " + Надпись.Ключ).Равно(Надпись.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция Вр(Час, Минута)

	Возврат Дата(1, 1, 1, Час, Минута, 0);

КонецФункции

Функция МассивСтрок(Строка1, Строка2 = Неопределено, Строка3 = Неопределено)

	Массив = Новый Массив;
	Массив.Добавить(Строка1);
	Если Строка2 <> Неопределено Тогда
		Массив.Добавить(Строка2);
	КонецЕсли;
	Если Строка3 <> Неопределено Тогда
		Массив.Добавить(Строка3);
	КонецЕсли;
	Возврат Массив;

КонецФункции

// Результат «Готово» операции б24т_ЗаполнениеИИ.СодержаниеОтИИ.
Функция РезультатГотово(Текст, ИскомыеМеста = Неопределено, НеИзменён = Ложь, КомментарииНеПолучены = Ложь)

	Места = ?(ИскомыеМеста = Неопределено, Новый Массив, ИскомыеМеста);
	Результат = Новый Структура;
	Результат.Вставить("Итог", "Готово");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("ИскомыеМеста", Места);
	Результат.Вставить("Места", б24т_СодержаниеИИКлиентСервер.НезаполненныеМеста(Текст, Места));
	Результат.Вставить("НеИзменён", НеИзменён);
	Результат.Вставить("КомментарииНеПолучены", КомментарииНеПолучены);
	Возврат Результат;

КонецФункции

// Результат «Ошибка» или «Отклонена» операции.
Функция РезультатОшибки(Итог, Сообщение)

	Результат = Новый Структура;
	Результат.Вставить("Итог", Итог);
	Результат.Вставить("Сообщение", Сообщение);
	Результат.Вставить("Текст", "");
