Процедура Места_НаКлиенте_ПорядокПовторыИГраницы() Экспорт

	Текст = "Версия 3.0..... на ПК (чей ПК) и ??? ???";
	Искомые = МассивСтрок("???", "(чей ПК)", "3.0.....");

	Места = б24т_СодержаниеИИКлиентСервер.НезаполненныеМеста(Текст, Искомые);

	ЮТест.ОжидаетЧто(СтрСоединить(Места, "|"), "Места").Равно("3.0.....|(чей ПК)|???|???");
	ЮТест.ОжидаетЧто(б24т_СодержаниеИИКлиентСервер.ТекстЗаполните(Места), "Надпись")
		.Равно("Заполните: 3.0....., (чей ПК), ???, ???");
	Границы = б24т_СодержаниеИИКлиентСервер.ГраницыПервогоМеста(Текст, Искомые);
	ЮТест.ОжидаетЧто(Границы.Начало, "Начало выделения").Равно(8);
	ЮТест.ОжидаетЧто(Границы.Конец, "Конец выделения").Равно(16);
	Надписи = б24т_СодержаниеИИКлиентСервер.НадписиИИ(б24т_СодержаниеИИКлиентСервер.НовоеСостояниеИИ(), Текст, Ложь);
	ЮТест.ОжидаетЧто(Надписи.Заполните, "Без ответа ИИ мест нет").Равно("");

