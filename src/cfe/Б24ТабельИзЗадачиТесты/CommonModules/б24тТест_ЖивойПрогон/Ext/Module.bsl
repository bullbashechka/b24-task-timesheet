// Разовый живой прогон (задача 5.6): вызывает каждый из восьми методов клиента через настоящий вебхук из настроек
// и сверяет структуру ответа с записанным макетом. YAxUnit этот модуль не запускает (ИсполняемыеСценарии нет):
// его вызывают вручную, например через MCP «1c»: б24тТест_ЖивойПрогон.Прогон(Данные).
// Каждый вызов — чтение; адрес вебхука в результат не попадает.

#Область ПрограммныйИнтерфейс

// Параметры:
//  Данные - Структура - ID тестовых данных из scripts/b24-test-data.ids.json:
//   * Владелец - Число - ID пользователя Битрикс24, создавшего вебхук.
//   * Проект - Число
//   * Компания - Число - компания с реквизитами.
//   * Задача - Число
//
// Возвращаемое значение:
//  Массив из Строка - по строке на метод: «OK» или чего не хватает в живом ответе.
//
Функция Прогон(Данные) Экспорт

	Клиент = б24т_Битрикс24.НовыйКлиент();
	Строки = Новый Массив;
	Строки.Добавить("Настроен вебхук: " + ?(б24т_Настройки.Настройки().Настроено, "да", "нет"));

	Отбор = Новый Соответствие;
	Отбор.Вставить("ID", Данные.Владелец);
	Проверить(Строки, Клиент, "user.get", Новый Структура("FILTER", Отбор), "user_get_Найден");
	Проверить(Строки, Клиент, "user.admin", Неопределено, "user_admin_Да");
	Проверить(Строки, Клиент, "tasks.task.list", ПараметрыСпискаЗадач(Данные),
		"tasks_task_list_ПостановщикИлиИсполнитель");
	Проверить(Строки, Клиент, "tasks.task.get", Новый Структура("taskId, select", Данные.Задача, ПоляЗадачи()),
		"tasks_task_get_Найдена");
	Проверить(Строки, Клиент, "crm.company.get", Новый Структура("id", Данные.Компания), "crm_company_get_Найдена");

	Отбор = Новый Соответствие;
	Отбор.Вставить("ID", СтрРазделить(Формат(Данные.Компания, "ЧГ=0"), ","));
	Проверить(Строки, Клиент, "crm.company.list", Новый Структура("filter, select", Отбор, СтрРазделить("ID,TITLE", ",")),
		"crm_company_list_Названия");

	Отбор = Новый Соответствие;
	Отбор.Вставить("ENTITY_TYPE_ID", 4);
	Отбор.Вставить("ENTITY_ID", Данные.Компания);
	Порядок = Новый Соответствие;
	Порядок.Вставить("SORT", "ASC");
	Порядок.Вставить("ID", "ASC");
	Проверить(Строки, Клиент, "crm.requisite.list", Новый Структура("filter, select, order", Отбор,
		СтрРазделить("ID,ENTITY_TYPE_ID,ENTITY_ID,PRESET_ID,NAME,SORT,ACTIVE,RQ_BIN,RQ_IIN,RQ_INN", ","), Порядок),
		"crm_requisite_list_БИН");

	Отбор = Новый Соответствие;
	Отбор.Вставить("ID", Данные.Проект);
	Проверить(Строки, Клиент, "sonet_group.get", Новый Структура("FILTER", Отбор), "sonet_group_get_Проект");

	Возврат Строки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура Проверить(Строки, Клиент, Метод, Параметры, Случай)

	Ответ = б24т_Битрикс24.Вызвать(Клиент, Метод, Параметры);
	Если Не Ответ.Успех Тогда
		Строки.Добавить(СтрШаблон("%1: ОШИБКА %2 %3 (%4)", Метод, Ответ.Ошибка.Вид, Ответ.Ошибка.Код, Ответ.Ошибка.Описание));
		Возврат;
	КонецЕсли;

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(б24тТест_ЗаглушкаТранспорта.ТекстМакета(Случай));
	Записанный = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();

	Отличия = Новый Массив;
	СравнитьСтруктуру(Записанный["result"], Ответ.Результат, "result", Отличия);
	Если Записанный["total"] <> Неопределено И Ответ.Всего = Неопределено Тогда
		Отличия.Добавить("нет поля total");
	КонецЕсли;

	Строки.Добавить(Метод + ": " + ?(Отличия.Количество() = 0, "OK", "НЕТ В ЖИВОМ ОТВЕТЕ: " + СтрСоединить(Отличия, "; ")));

КонецПроцедуры

// Каждый ключ записанного ответа должен быть в живом; для массивов сравниваются первые элементы.
Процедура СравнитьСтруктуру(Записанный, Живой, Путь, Отличия)

	Если ТипЗнч(Записанный) = Тип("Соответствие") Тогда
		Если ТипЗнч(Живой) <> Тип("Соответствие") Тогда
			Отличия.Добавить(Путь + " — не объект");
			Возврат;
		КонецЕсли;
		Для Каждого КлючИЗначение Из Записанный Цикл
			Если Живой.Получить(КлючИЗначение.Ключ) = Неопределено И КлючИЗначение.Значение <> Неопределено Тогда
				Отличия.Добавить(Путь + "." + КлючИЗначение.Ключ);
			Иначе
				СравнитьСтруктуру(КлючИЗначение.Значение, Живой.Получить(КлючИЗначение.Ключ), Путь + "." + КлючИЗначение.Ключ, Отличия);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли ТипЗнч(Записанный) = Тип("Массив") И Записанный.Количество() > 0 Тогда
		Если ТипЗнч(Живой) <> Тип("Массив") Тогда
			Отличия.Добавить(Путь + " — не массив");
		ИначеЕсли Живой.Количество() > 0 Тогда
			СравнитьСтруктуру(Записанный[0], Живой[0], Путь + "[]", Отличия);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция ПоляЗадачи()

	Возврат СтрРазделить("ID,TITLE,CREATED_BY,RESPONSIBLE_ID,ACCOMPLICES,AUDITORS,STATUS,REAL_STATUS,GROUP_ID,UF_CRM_TASK,"
		+ "DEADLINE,CLOSED_DATE,ACTIVITY_DATE,CREATED_DATE", ",");

КонецФункции

// Тот же запрос, что записывает scripts/b24-record-responses.sh для макета «ПостановщикИлиИсполнитель».
Функция ПараметрыСпискаЗадач(Данные)

	Подфильтр = Новый Соответствие;
	Подфильтр.Вставить("::LOGIC", "OR");
	Подфильтр.Вставить("CREATED_BY", Данные.Владелец);
	Подфильтр.Вставить("RESPONSIBLE_ID", Данные.Владелец);

	Статус = Новый Соответствие;
	Статус.Вставить("::LOGIC", "OR");
	Статус.Вставить("!REAL_STATUS", 5);
	Статус.Вставить(">=CLOSED_DATE", Формат(НачалоДня(ТекущаяДатаСеанса()) - 30 * 86400, "ДФ='dd.MM.yyyy HH:mm:ss'"));

	Отбор = Новый Соответствие;
	Отбор.Вставить("GROUP_ID", Данные.Проект);
	Отбор.Вставить("::SUBFILTER-R", Подфильтр);
	Отбор.Вставить("::SUBFILTER-ST", Статус);

	Возврат Новый Структура("filter, select", Отбор, ПоляЗадачи());

КонецФункции

#КонецОбласти
