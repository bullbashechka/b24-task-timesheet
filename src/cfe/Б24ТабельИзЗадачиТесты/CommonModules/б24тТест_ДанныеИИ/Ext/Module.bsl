// Данные для живых прогонов ИИ и для тестов этапа 17: записи регистра «ГЕМ Шаблоны для заполнения табелей».
// Модуль только в тестовом расширении, то есть только в локальной базе. YAxUnit запускает тесты ниже;
// ЗагрузитьФормулировки вызывают вручную, например через MCP «1c»: текст берут из .local/ai/register.json
// (его делает scripts/ai-register.py из выгрузки регистра): массив объектов {period, code, text}.

#Область ПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("Загрузка_ЗаписываетЗаписиСПериодами",
			"Записи разных периодов одного шифра читаются срезом на нужную дату")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Загрузка_ЗаменяетСодержимоеРегистра",
			"С заменой прежние записи регистра исчезают, без замены остаются")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Загрузка_ЗаписьБезШифраНичегоНеМеняет",
			"Запись без шифра: исключение, регистр не изменился даже при замене")
			.ВТранзакции()
		.ДобавитьСерверныйТест("Макеты_РазбираютсяИНеПустые",
			"Макеты данных ИИ (места, выдуманные формулировки, набор проверки) — непустые JSON-массивы")
		.ДобавитьСерверныйТест("Макеты_МестаТолькоИзВидов",
			"У каждого места вид «обязательное», «необязательное» или «не место»")
		.ДобавитьСерверныйТест("Макеты_ФормулировкиВыдуманные",
			"Формулировки для автотестов выдуманные: шифр и текст начинаются с «[ТЕСТ]»");

КонецПроцедуры

// Загружает формулировки из JSON в регистр «ГЕМ Шаблоны для заполнения табелей».
// Весь текст разбирается до первой записи: при ошибке в нём регистр не меняется.
//
// Параметры:
//  ТекстJSON - Строка - массив объектов {period: "ГГГГ-ММ-ДД", code, text}.
//  Заменить - Булево - стереть все записи регистра перед загрузкой.
//
// Возвращаемое значение:
//  Число - сколько записей записано.
//
Функция ЗагрузитьФормулировки(ТекстJSON, Заменить = Ложь) Экспорт

	Записи = РазобратьЗаписи(ТекстJSON);

	НачатьТранзакцию();
	Попытка
		Если Заменить Тогда
			РегистрыСведений.ГЕМ_ШаблоныДляЗаполненияТабелей.СоздатьНаборЗаписей().Записать();
		КонецЕсли;
		Для Каждого ОписаниеЗаписи Из Записи Цикл
			Набор = РегистрыСведений.ГЕМ_ШаблоныДляЗаполненияТабелей.СоздатьНаборЗаписей();
			Набор.Отбор.Период.Установить(ОписаниеЗаписи.Период);
			Набор.Отбор.Шифр.Установить(ОписаниеЗаписи.Шифр);
			ЗаписьНабора = Набор.Добавить();
			ЗаписьНабора.Период = ОписаниеЗаписи.Период;
			ЗаписьНабора.Шифр = ОписаниеЗаписи.Шифр;
			ЗаписьНабора.Описание = ОписаниеЗаписи.Описание;
			Набор.Записать();
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Возврат Записи.Количество();

КонецФункции

#КонецОбласти

#Область Тесты

Процедура Загрузка_ЗаписываетЗаписиСПериодами() Экспорт

	ТекстJSON = "[{""period"":""2024-01-01"",""code"":""[ТЕСТ]А"",""text"":""Старая""},"
		+ "{""period"":""2024-06-01"",""code"":""[ТЕСТ]А"",""text"":""Новая""},"
		+ "{""period"":""2024-01-01"",""code"":""[ТЕСТ]Б"",""text"":""Другая""}]";

	Записано = ЗагрузитьФормулировки(ТекстJSON);

	ЮТест.ОжидаетЧто(Записано, "Записано").Равно(3);
	ЮТест.ОжидаетЧто(ОписаниеНаДату("[ТЕСТ]А", Дата(2024, 3, 1)), "Старая редакция").Равно("Старая");
	ЮТест.ОжидаетЧто(ОписаниеНаДату("[ТЕСТ]А", Дата(2024, 7, 1)), "Новая редакция").Равно("Новая");
	ЮТест.ОжидаетЧто(ОписаниеНаДату("[ТЕСТ]Б", Дата(2024, 7, 1)), "Другой шифр").Равно("Другая");

КонецПроцедуры

Процедура Загрузка_ЗаменяетСодержимоеРегистра() Экспорт

	Прежних = ЧислоЗаписей();
	ЗагрузитьФормулировки("[{""period"":""2024-01-01"",""code"":""[ТЕСТ]А"",""text"":""Первая""}]");
	ЗагрузитьФормулировки("[{""period"":""2024-01-01"",""code"":""[ТЕСТ]Б"",""text"":""Вторая""}]");
	ЮТест.ОжидаетЧто(ЧислоЗаписей(), "Без замены записи остались").Равно(Прежних + 2);

	ЗагрузитьФормулировки("[{""period"":""2024-01-01"",""code"":""[ТЕСТ]В"",""text"":""Третья""}]", Истина);

	ЮТест.ОжидаетЧто(ЧислоЗаписей(), "С заменой осталась одна запись").Равно(1);
	ЮТест.ОжидаетЧто(ОписаниеНаДату("[ТЕСТ]В", Дата(2024, 7, 1)), "Новая запись").Равно("Третья");

КонецПроцедуры

Процедура Загрузка_ЗаписьБезШифраНичегоНеМеняет() Экспорт

	ЗагрузитьФормулировки("[{""period"":""2024-01-01"",""code"":""[ТЕСТ]А"",""text"":""Была""}]");
	Прежних = ЧислоЗаписей();

	ТекстОшибки = Неопределено;
	Попытка
		ЗагрузитьФормулировки("[{""period"":""2024-01-01"",""code"":""[ТЕСТ]Б"",""text"":""Да""},"
			+ "{""period"":""2024-01-01"",""text"":""Без шифра""}]", Истина);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;

	ЮТест.ОжидаетЧто(ТекстОшибки, "Исключение").Содержит("шифра");
	ЮТест.ОжидаетЧто(ЧислоЗаписей(), "Регистр не изменился").Равно(Прежних);
	ЮТест.ОжидаетЧто(ОписаниеНаДату("[ТЕСТ]А", Дата(2024, 7, 1)), "Прежняя запись цела").Равно("Была");

КонецПроцедуры

Процедура Макеты_РазбираютсяИНеПустые() Экспорт

	Для Каждого Имя Из СтрРазделить("б24тТест_МестаФормулировок,б24тТест_ФормулировкиИИ,б24тТест_ПримерыИИ", ",") Цикл
		ЮТест.ОжидаетЧто(Метаданные.ОбщиеМакеты.Найти(Имя), "Нет макета " + Имя).Существует();
		Данные = ДанныеМакета(Имя);
		ЮТест.ОжидаетЧто(ТипЗнч(Данные) = Тип("Массив"), Имя + ": массив").ЭтоИстина();
		ЮТест.ОжидаетЧто(Данные.Количество(), Имя + ": элементов").Больше(0);
	КонецЦикла;

КонецПроцедуры

Процедура Макеты_МестаТолькоИзВидов() Экспорт

	Виды = СтрРазделить("обязательное,необязательное,не место", ",");
	Для Каждого Место Из ДанныеМакета("б24тТест_МестаФормулировок") Цикл
		ЮТест.ОжидаетЧто(Виды.Найти(Место.Получить("вид")) <> Неопределено,
			"Вид места " + Место.Получить("фрагмент")).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

Процедура Макеты_ФормулировкиВыдуманные() Экспорт

	Для Каждого Формулировка Из ДанныеМакета("б24тТест_ФормулировкиИИ") Цикл
		ЮТест.ОжидаетЧто(Формулировка.Получить("code"), "Шифр").Содержит("[ТЕСТ]");
		ЮТест.ОжидаетЧто(СтрНачинаетсяС(Формулировка.Получить("text"), "[ТЕСТ]"), Формулировка.Получить("code")).ЭтоИстина();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеМакета(Имя)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ПолучитьОбщийМакет(Имя).ПолучитьТекст());
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;

КонецФункции

Функция РазобратьЗаписи(ТекстJSON)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(ТекстJSON);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Если ТипЗнч(Данные) <> Тип("Массив") Тогда
		ВызватьИсключение НСтр("ru = 'Ожидался JSON-массив записей {period, code, text}.'");
	КонецЕсли;

	Результат = Новый Массив;
	Для Каждого Элемент Из Данные Цикл
		Шифр = Элемент.Получить("code");
		Если Не ЗначениеЗаполнено(Шифр) Тогда
			ВызватьИсключение НСтр("ru = 'В записи нет шифра (code).'");
		КонецЕсли;
		ТекстПериода = Элемент.Получить("period");
		Если Не ЗначениеЗаполнено(ТекстПериода) Или СтрДлина(ТекстПериода) < 10 Тогда
			ВызватьИсключение СтрШаблон(НСтр("ru = 'У шифра ""%1"" нет периода (period ГГГГ-ММ-ДД).'"), Шифр);
		КонецЕсли;
		Период = Дата(Лев(ТекстПериода, 4) + Сред(ТекстПериода, 6, 2) + Сред(ТекстПериода, 9, 2));
		Описание = Элемент.Получить("text");
		Результат.Добавить(Новый Структура("Период, Шифр, Описание", Период, Шифр, ?(Описание = Неопределено, "", Описание)));
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ОписаниеНаДату(Шифр, Дата)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Срез.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.ГЕМ_ШаблоныДляЗаполненияТабелей.СрезПоследних(&Дата, Шифр = &Шифр) КАК Срез";
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Шифр", Шифр);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Описание, Неопределено);

КонецФункции

Функция ЧислоЗаписей()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.ГЕМ_ШаблоныДляЗаполненияТабелей КАК Записи";
	Возврат Запрос.Выполнить().Выгрузить()[0].Количество;

КонецФункции

#КонецОбласти
