Процедура Реквизиты_БезЦифрНеНомер() Экспорт

	// Поле «-» не заполнено: в этом же реквизите берётся следующее поле.
	Прочерк = Реквизит(1, 7, 10, "-", "222222222222");
	ЮТест.ОжидаетЧто(б24т_Контрагенты.НомерИзРеквизитов(СтрокаВМассив(Прочерк), 7), "Следующее поле").Равно("222222222222");

	// Реквизит, где все поля без цифр, пропускается целиком.
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Реквизит(1, 7, 10, "нет", "-", " "));
	Реквизиты.Добавить(Реквизит(2, 7, 20, "444444444444"));
	ЮТест.ОжидаетЧто(б24т_Контрагенты.НомерИзРеквизитов(Реквизиты, 7), "Следующий реквизит").Равно("444444444444");

	// Пробелы и точка внутри номера не мешают.
	Грязный = Реквизит(1, 7, 10, " 2345 1261 2395. ");
	ЮТест.ОжидаетЧто(б24т_Контрагенты.НомерИзРеквизитов(СтрокаВМассив(Грязный), 7), "Грязный номер").Равно("234512612395");

