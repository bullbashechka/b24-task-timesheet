// Контрагент 1С; запись без обработчиков и проверок, откат транзакции теста убирает его из базы.
Функция НовыйКонтрагент(Наименование, Номер, ПометкаУдаления = Ложь) Экспорт

	Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ИНН = Номер;
	Объект.ПометкаУдаления = ПометкаУдаления;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Возврат Объект.Ссылка;

КонецФункции

Процедура ПроверитьЧтоНомеровНетВБазе(Номера) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		|	К.ИНН КАК ИНН
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	СокрЛП(К.ИНН) В (&Номера)";
	Запрос.УстановитьПараметр("Номера", Номера);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВызватьИсключение "В базе уже есть контрагент с тестовым номером " + Выборка.ИНН + ": тест подменил бы его";
	КонецЕсли;

КонецПроцедуры

