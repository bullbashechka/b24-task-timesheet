	НеНайден = б24т_Контрагенты.РезультатПоНомеру("990840000017", Новый Массив);
	ЮТест.ОжидаетЧто(НеНайден.Текст, "Не найден").Равно("Контрагент с БИН 990840000017 не найден в 1С — выберите контрагента вручную");
