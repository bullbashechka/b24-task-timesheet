	Несколько.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	Несколько.Добавить(Справочники.Контрагенты.ПустаяСсылка());
	ДваКонтрагента = б24т_Контрагенты.РезультатПоНомеру("772824024014", Несколько);
	ЮТест.ОжидаетЧто(ДваКонтрагента.Текст, "Несколько").Равно("В 1С несколько контрагентов с БИН 772824024014 — выберите нужного вручную");
	ЮТест.ОжидаетЧто(ДваКонтрагента.Контрагент, "Контрагент при двух").Равно(Справочники.Контрагенты.ПустаяСсылка());

