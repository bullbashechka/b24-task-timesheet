	ЮТест.ОжидаетЧто(б24т_Контрагенты.ТекстНетНомера("[ТЕСТ] Без реквизитов"), "Нет номера").Равно(
		"У компании «[ТЕСТ] Без реквизитов» не заполнен БИН — выберите контрагента вручную");
	ЮТест.ОжидаетЧто(б24т_Контрагенты.ТекстНетНомера(""), "Нет номера, компания без названия").Равно(
