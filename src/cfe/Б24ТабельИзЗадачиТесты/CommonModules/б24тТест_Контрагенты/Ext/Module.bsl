// Реквизит в виде ответа Битрикс24: поля в строках, как их присылает портал.
Функция Реквизит(ИД, ИДКомпании, Сортировка, БИН, ИИН = "", ИНН = "")

	Реквизит = Новый Соответствие;
	Реквизит.Вставить("ID", Формат(ИД, "ЧГ=0"));
	Реквизит.Вставить("ENTITY_TYPE_ID", "4");
	Реквизит.Вставить("ENTITY_ID", Формат(ИДКомпании, "ЧГ=0"));
	Реквизит.Вставить("SORT", Формат(Сортировка, "ЧГ=0"));
	Реквизит.Вставить("ACTIVE", "Y");
	Реквизит.Вставить("RQ_BIN", ?(БИН = "", Неопределено, БИН));
	Реквизит.Вставить("RQ_IIN", ?(ИИН = "", Неопределено, ИИН));
	Реквизит.Вставить("RQ_INN", ?(ИНН = "", Неопределено, ИНН));
	Возврат Реквизит;

КонецФункции

