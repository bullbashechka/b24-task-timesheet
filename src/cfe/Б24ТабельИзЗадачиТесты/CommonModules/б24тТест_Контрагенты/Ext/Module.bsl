// Задача в виде ответа tasks.task.list; Элементы CRM — через запятую («CO_2926, D_5») или не заданы.
Функция НоваяЗадача(Номер, ЭлементыCRM = Неопределено)

	Задача = Новый Соответствие;
	Задача.Вставить("id", Формат(Номер, "ЧГ=0"));
	Задача.Вставить("title", "[ТЕСТ] Задача " + Формат(Номер, "ЧГ=0"));
