Процедура Реквизиты_ПорядокКарточки() Экспорт

	// В ответе порядок перепутан: сначала SORT 20, потом 10; при равном SORT меньший ID, 9 раньше 10 (как числа, не как строки).
	Реквизиты = Новый Массив;
	Реквизиты.Добавить(Реквизит(5, 7, 20, "555555555555"));
	Реквизиты.Добавить(Реквизит(10, 7, 10, "101010101010"));
	Реквизиты.Добавить(Реквизит(9, 7, 10, "090909090909"));

	ЮТест.ОжидаетЧто(б24т_Контрагенты.НомерИзРеквизитов(Реквизиты, 7), "Номер").Равно("090909090909");

