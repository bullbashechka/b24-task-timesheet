// Поиск контрагента в 1С

Процедура Поиск_Один() Экспорт

	Контрагент = НовыйКонтрагент("[ТЕСТ] Один", "991111111111");

	Найденные = б24т_Контрагенты.КонтрагентыПоНомерам(СтрокиВМассив("991111111111"));

	ЮТест.ОжидаетЧто(Найденные["991111111111"].Количество(), "Найдено").Равно(1);
