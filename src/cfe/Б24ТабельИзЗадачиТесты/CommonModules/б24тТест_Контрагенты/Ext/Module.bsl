// Контрагенты задач (Битрикс24 — заглушка)

Процедура Задачи_НазванияНеУчаствуют() Экспорт

	// Есть контрагенты с названием компании и с названием задачи, но у компании нет реквизитов.
	НовыйКонтрагент("[ТЕСТ] Без реквизитов", "991111111115");
	НовыйКонтрагент("Задача про контрагента", "991111111116");
	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(Клиент, "crm_requisite_list_Пусто");
	Названия = Новый Соответствие;
	Названия.Вставить(2932, "[ТЕСТ] Без реквизитов");
	Задача = НоваяЗадача(1, "CO_2932");
	Задача.Вставить("title", "Задача про контрагента");

	Результат = б24т_Контрагенты.КонтрагентыЗадач(Клиент, МассивЭлементов(Задача), Названия);

	ЮТест.ОжидаетЧто(Результат.Успех, "Успех").ЭтоИстина();
	ЮТест.ОжидаетЧто(Результат.Контрагенты[1].Контрагент, "Контрагент").Равно(Справочники.Контрагенты.ПустаяСсылка());
	ЮТест.ОжидаетЧто(Результат.Контрагенты[1].Текст, "Текст").Равно(
		"У компании «[ТЕСТ] Без реквизитов» не заполнен БИН — выберите контрагента вручную");

КонецПроцедуры

Процедура Задачи_НаборС6() Экспорт

	Контрагенты = НовыеКонтрагентыНабора();
	Клиент = КлиентНабора();
	ЗадачиСписка = ЗадачиНабора();

	Результат = б24т_Контрагенты.КонтрагентыЗадач(Клиент, ЗадачиСписка, НазванияНабора());

