// Тесты чтения комментариев задачи из чата Битрикс24 (Ф15, 23.4) на записанных ответах этапа 22.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("Чтение_ОбычныйЧат", "Обычный чат: комментарии от старых к новым, системное сообщение отброшено, один запрос")
		.ДобавитьСерверныйТест("Чтение_ТолькоСистемные", "Чат из одних системных сообщений: комментариев нет, они получены")
		.ДобавитьСерверныйТест("Чтение_ПустойЧат", "Пустой чат: комментариев нет, они получены")
		.ДобавитьСерверныйТест("Чтение_ДвеПорции", "Вторая порция по LAST_ID, короткая порция — конец чата")
		.ДобавитьСерверныйТест("Чтение_Предел200", "Не больше 200 сообщений: четыре полные порции, пятой нет, признак «не все»")
		.ДобавитьСерверныйТест("Чтение_ГраницаДня", "Комментарии после дня табеля не передаются, пометка дня по времени 1С")
		.ДобавитьСерверныйТест("Чтение_ГраницаДняСмещение", "Граница дня считается по смещению 1С, а не по поясу чата")
		.ДобавитьСерверныйТест("Чтение_СвойИЧужие", "Пометка «свой» — по номеру сотрудника в Битрикс24")
		.ДобавитьСерверныйТест("Чтение_ФайлИЦитата", "Сообщение-файл и ответ передаются дальше на чистку, системное отброшено")
		.ДобавитьСерверныйТест("Чтение_УдалённыеИБоты", "Удалённые сообщения и сообщения ботов не передаются")
		.ДобавитьСерверныйТест("Чтение_НетПрава", "Нет права «Чат и уведомления»: комментарии не получены, причина без текстов")
		.ДобавитьСерверныйТест("Чтение_НетДоступа", "Битрикс24 отказал в доступе к чату: комментарии не получены")
		.ДобавитьСерверныйТест("Чтение_СрокИстёк", "Общий срок истёк до запроса: запроса нет, комментарии не получены")
		.ДобавитьСерверныйТест("Чтение_ОбрывНаВторойПорции", "Сбой на второй порции: передаётся первая, признаки обрыва и «не все»")
		.ДобавитьСерверныйТест("Чтение_ЗадачаБезЧата", "У задачи нет чата: запросов нет, комментариев нет, надписи не будет")
		.ДобавитьСерверныйТест("Чтение_НетПоляНомераЧата", "В ответе о задаче нет поля номера чата: комментарии не получены")
		.ДобавитьСерверныйТест("Чтение_НомерЧатаСтрокой", "Номер чата строкой (как в списке задач) тоже читается")
		.ДобавитьСерверныйТест("Чтение_ТолькоТекстИПометки", "Комментарий — только текст и две пометки: ни автора, ни даты, ни номеров");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура Чтение_ОбычныйЧат() Экспорт

	Клиент = КлиентСОтветами("im_dialog_messages_get_Обычный");
	Итог = Прочитать(Клиент, ЗадачаСЧатом(6034), Дата(2026, 11, 20));

	ПроверитьПризнаки(Итог, Истина, Ложь, Ложь);
	ЮТест.ОжидаетЧто(Итог.Сообщения.Количество(), "Комментариев").Равно(2);
	ЮТест.ОжидаетЧто(Итог.Сообщения[0].Текст, "Первый — самый старый")
		.Равно("Ирина Сергеевна и Пётр Николаевич просят установить 1С-Коннект, но не сказали, на чей компьютер.");
	ЮТест.ОжидаетЧто(Итог.Сообщения[1].Текст, "Последний — самый новый")
		.Равно("Звонила Мария: нужно кому-то из бухгалтерии, кому именно, она уточнит.");
	ЮТест.ОжидаетЧто(Итог.Сообщения[0].ЗаДень, "За день табеля").Равно(Истина);
	ЮТест.ОжидаетЧто(Итог.Сообщения[0].Свой, "Свой").Равно(Истина);
	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Запросов").Равно(1);
	Вызов = Клиент.Вызовы[0];
	ЮТест.ОжидаетЧто(Вызов.Метод, "Метод").Равно("im.dialog.messages.get");
	ЮТест.ОжидаетЧто(Вызов.Параметры["DIALOG_ID"], "Чат задачи").Равно("chat6034");
	ЮТест.ОжидаетЧто(Вызов.Параметры["LIMIT"], "Порция").Равно(50);
	ЮТест.ОжидаетЧто(Вызов.Параметры["LAST_ID"], "Первая порция без LAST_ID").Равно(Неопределено);

