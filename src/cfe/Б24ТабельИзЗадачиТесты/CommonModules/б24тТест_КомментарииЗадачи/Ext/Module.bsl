#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Чтение с часовым смещением 1С, равным поясу чата (+03:00), если не задано другое.
Функция Прочитать(Клиент, Задача, ДатаТабеля, ИДСотрудника = 30, Смещение = 10800)

	Возврат б24т_КомментарииЗадачи.КомментарииЗадачи(Клиент, Задача, ДатаТабеля, ИДСотрудника, Смещение);

КонецФункции

Функция КлиентСОтветами(Случаи)

	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	Для Каждого Случай Из СтрРазделить(Случаи, ",") Цикл
		б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(Клиент, Случай);
	КонецЦикла;
	Возврат Клиент;

КонецФункции

Функция ЗадачаСЧатом(НомерЧата)

	Задача = Новый Соответствие;
	Задача.Вставить("id", "10742");
	Задача.Вставить("title", "[ТЕСТ] Задача");
	Задача.Вставить("chatId", НомерЧата);
	Возврат Задача;

КонецФункции

Функция ЗадачаИзМакета(Случай)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(б24тТест_ЗаглушкаТранспорта.ТекстМакета(Случай));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные["result"]["task"];

КонецФункции

Процедура ПроверитьПризнаки(Итог, Получены, Оборвано, НеВсе)

	ЮТест.ОжидаетЧто(Итог.Получены, "Получены").Равно(Получены);
	ЮТест.ОжидаетЧто(Итог.Оборвано, "Оборвано").Равно(Оборвано);
	ЮТест.ОжидаетЧто(Итог.НеВсе, "Не все").Равно(НеВсе);

КонецПроцедуры

// «текст|день или ранний|свой или чужой» через «;» от старых к новым.
Функция ТекстыИПометки(Итог)

	Строки = Новый Массив;
	Для Каждого Сообщение Из Итог.Сообщения Цикл
		Строки.Добавить(Сообщение.Текст + "|" + ?(Сообщение.ЗаДень, "день", "ранний") + "|"
			+ ?(Сообщение.Свой, "свой", "чужой"));
	КонецЦикла;
	Возврат СтрСоединить(Строки, ";");

КонецФункции

#КонецОбласти
