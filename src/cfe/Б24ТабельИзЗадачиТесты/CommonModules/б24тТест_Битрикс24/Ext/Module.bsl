// Краткий текст исключения вызова клиента или Неопределено, если исключения не было.
Функция ТекстИсключения(Клиент, Метод)

	Попытка
		б24т_Битрикс24.Вызвать(Клиент, Метод, ПараметрыПользователя());
	Исключение
		Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Неопределено;

КонецФункции

Функция ЗаписиЖурнала(Начало, Событие)

	Таблица = Новый ТаблицаЗначений;
	Фильтр = Новый Структура;
	Фильтр.Вставить("ДатаНачала", Начало);
	Фильтр.Вставить("Событие", Событие);
	ВыгрузитьЖурналРегистрации(Таблица, Фильтр);
	Возврат Таблица;

КонецФункции

Функция НазваниеПервойКомпании()

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(б24тТест_ЗаглушкаТранспорта.ТекстМакета("crm_company_list_Названия"));
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные["result"][0]["TITLE"];

КонецФункции

