Процедура Ошибка_НеJSONНедоступен() Экспорт

	// Страница прокси при сбое: повторяется как ошибка сервера.
	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	б24тТест_ЗаглушкаТранспорта.ДобавитьСыройОтвет(Клиент, 502, "<html><body>Bad Gateway</body></html>");
	б24тТест_ЗаглушкаТранспорта.ДобавитьСыройОтвет(Клиент, 502, "<html><body>Bad Gateway</body></html>");
	Ответ = б24т_Битрикс24.Вызвать(Клиент, "user.get", ПараметрыПользователя());
	ЮТест.ОжидаетЧто(Ответ.Ошибка.Вид, "Вид, 502").Равно(б24т_Битрикс24.ВидОшибкиНедоступен());
	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Запросов, 502").Равно(2);

	// Страница вместо JSON при кодe 200: повтор не поможет.
	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	б24тТест_ЗаглушкаТранспорта.ДобавитьСыройОтвет(Клиент, 200, "<html><body>Вход на портал</body></html>");
	Ответ = б24т_Битрикс24.Вызвать(Клиент, "user.get", ПараметрыПользователя());
	ЮТест.ОжидаетЧто(Ответ.Ошибка.Вид, "Вид, 200").Равно(б24т_Битрикс24.ВидОшибкиНедоступен());
	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Запросов, 200").Равно(1);

	// JSON без result и error.
	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	б24тТест_ЗаглушкаТранспорта.ДобавитьСыройОтвет(Клиент, 200, "{""foo"": 1}");
	Ответ = б24т_Битрикс24.Вызвать(Клиент, "user.get", ПараметрыПользователя());
	ЮТест.ОжидаетЧто(Ответ.Ошибка.Вид, "Вид, чужой JSON").Равно(б24т_Битрикс24.ВидОшибкиНедоступен());

КонецПроцедуры

