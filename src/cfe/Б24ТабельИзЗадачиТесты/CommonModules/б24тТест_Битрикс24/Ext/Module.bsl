Процедура Вызов_ПараметрыПередаютсяВТеле() Экспорт

	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(Клиент, "tasks_task_list_Пусто");

	Подфильтр = Новый Соответствие;
	Подфильтр.Вставить("::LOGIC", "OR");
	Подфильтр.Вставить("CREATED_BY", 30);
	Подфильтр.Вставить("RESPONSIBLE_ID", 30);
	Отбор = Новый Соответствие;
	Отбор.Вставить("::SUBFILTER-R", Подфильтр);
	Параметры = Новый Структура;
	Параметры.Вставить("filter", Отбор);
	Параметры.Вставить("select", СтрРазделить("ID,TITLE", ","));

	б24т_Битрикс24.Вызвать(Клиент, "tasks.task.list", Параметры);

	Передано = Клиент.Вызовы[0].Параметры;
	ЮТест.ОжидаетЧто(Передано["filter"]["::SUBFILTER-R"]["::LOGIC"], "Логика подфильтра").Равно("OR");
	ЮТест.ОжидаетЧто(Передано["filter"]["::SUBFILTER-R"]["CREATED_BY"], "Постановщик в подфильтре").Равно(30);
	ЮТест.ОжидаетЧто(Передано["select"].Количество(), "Поля выборки").Равно(2);

КонецПроцедуры

