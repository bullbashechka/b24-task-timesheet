Процедура Метод_НеИзСпискаВызываетИсключениеБезЗапроса() Экспорт

	Для Каждого Метод Из СтрРазделить("batch,tasks.task.add,Tasks.Task.Add,user.current,crm.company.delete,tasks.task.update", ",") Цикл
		Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
		б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(Клиент, "user_get_Найден");
		ТекстОшибки = ТекстИсключения(Клиент, Метод);
		ЮТест.ОжидаетЧто(ТекстОшибки, "Исключение для " + Метод).Заполнено();
		ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Вызовов транспорта для " + Метод).Равно(0);
		ЮТест.ОжидаетЧто(СтрНайти(ТекстОшибки, "abc123token"), "Ключ в тексте исключения").Равно(0);
	КонецЦикла;

