// Заглушка транспорта REST-клиента Битрикс24: отвечает записанными ответами из макетов и запоминает вызовы.
// Транспорт в клиенте задаётся именем общего модуля с функцией ВыполнитьЗапрос(Запрос); клиент создаёт НовыйКлиент().

#Область ПрограммныйИнтерфейс

// Транспорт: берёт следующий ответ из очереди клиента и записывает запрос в Клиент.Вызовы.
//
// Параметры:
//  Запрос - Структура - Метод, Адрес, Тело, Таймаут, Клиент.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число
//   * Тело - Строка
//
Функция ВыполнитьЗапрос(Запрос) Экспорт

	Клиент = Запрос.Клиент;

	Вызов = Новый Структура;
	Вызов.Вставить("Метод", Запрос.Метод);
	Вызов.Вставить("Адрес", Запрос.Адрес);
	Вызов.Вставить("Тело", Запрос.Тело);
	Вызов.Вставить("Таймаут", Запрос.Таймаут);
	Вызов.Вставить("Параметры", ПараметрыИзТела(Запрос.Тело));
	Клиент.Вызовы.Добавить(Вызов);

	Если Клиент.Ответы.Количество() = 0 Тогда
		ВызватьИсключение "Заглушка транспорта: нет ответа для метода " + Запрос.Метод;
	КонецЕсли;

	Ответ = Клиент.Ответы[0];
	Клиент.Ответы.Удалить(0);

	Если Ответ.ТекстИсключения <> Неопределено Тогда
		ВызватьИсключение Ответ.ТекстИсключения;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", Ответ.КодСостояния);
	Результат.Вставить("Тело", Ответ.Тело);
	Возврат Результат;

КонецФункции

// Клиент Битрикс24 с этой заглушкой вместо HTTPS и без паузы перед повтором.
//
// Параметры:
//  АдресВебхука - Строка
//
// Возвращаемое значение:
//  Структура - клиент б24т_Битрикс24 с очередью Ответы.
//
Функция НовыйКлиент(АдресВебхука = "https://portal.bitrix24.kz/rest/30/abc123token/") Экспорт

	Клиент = б24т_Битрикс24.НовыйКлиент("б24тТест_ЗаглушкаТранспорта", АдресВебхука);
	Клиент.ПаузаПовтора = 0;
	Клиент.Вставить("Ответы", Новый Массив);
	Возврат Клиент;

КонецФункции

// Ставит в очередь ответ из записанного макета.
//
// Параметры:
//  Клиент - Структура
//  Случай - Строка - часть имени макета после «б24тТест_Ответ_».
//  КодСостояния - Число, Неопределено - по умолчанию по случаю: ошибки как у Битрикс24, иначе 200.
//
Процедура ДобавитьОтвет(Клиент, Случай, КодСостояния = Неопределено) Экспорт

	Если КодСостояния = Неопределено Тогда
		КодСостояния = КодСостоянияПоУмолчанию(Случай);
	КонецЕсли;
	ДобавитьСыройОтвет(Клиент, КодСостояния, ТекстМакета(Случай));

КонецПроцедуры

// Ставит в очередь ответ с произвольным телом (например, HTML-страницу прокси).
Процедура ДобавитьСыройОтвет(Клиент, КодСостояния, Тело) Экспорт

	Клиент.Ответы.Добавить(НовыйОтвет(КодСостояния, Тело, Неопределено));

КонецПроцедуры

// Ставит в очередь исключение транспорта (нет ответа за таймаут, обрыв соединения).
Процедура ДобавитьИсключение(Клиент, Текст) Экспорт

	Клиент.Ответы.Добавить(НовыйОтвет(0, "", Текст));

КонецПроцедуры

// Текст записанного ответа.
Функция ТекстМакета(Случай) Экспорт

	Возврат ПолучитьОбщийМакет("б24тТест_Ответ_" + Случай).ПолучитьТекст();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйОтвет(КодСостояния, Тело, ТекстИсключения)

	Ответ = Новый Структура;
	Ответ.Вставить("КодСостояния", КодСостояния);
	Ответ.Вставить("Тело", Тело);
	Ответ.Вставить("ТекстИсключения", ТекстИсключения);
	Возврат Ответ;

КонецФункции

// Коды состояния, с которыми Битрикс24 отдаёт записанные ошибки.
Функция КодСостоянияПоУмолчанию(Случай)

	Коды = Новый Соответствие;
	Коды.Вставить("Ошибка_НеверныйВебхук", 401);
	Коды.Вставить("Ошибка_НетПрава_Синтетика", 401);
	Коды.Вставить("Ошибка_ДоступЗапрещён_Синтетика", 403);
	Коды.Вставить("Ошибка_МетодНеНайден_Синтетика", 404);
	Коды.Вставить("Ошибка_ВремяМетода_Синтетика", 429);
	Коды.Вставить("Ошибка_Сервер_Синтетика", 500);
	Коды.Вставить("Ошибка_ЛимитЗапросов_Синтетика", 503);
	Коды.Вставить("crm_company_get_НеНайдена", 400);

	Код = Коды[Случай];
	Возврат ?(Код = Неопределено, 200, Код);

КонецФункции

Функция ПараметрыИзТела(Тело)

	Если ПустаяСтрока(Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Тело);
	Параметры = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Параметры;

КонецФункции

#КонецОбласти
