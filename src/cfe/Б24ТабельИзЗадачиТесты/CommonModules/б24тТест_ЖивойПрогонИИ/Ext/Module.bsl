// Живой прогон набора примеров для текста ИИ (задачи 14.9, 18.6). YAxUnit этот модуль не запускает (ИсполняемыеСценарии
// нет): его вызывают вручную, например через MCP «1c»: б24тТест_ЖивойПрогонИИ.ПрогонНабора(Параметры).
//
// Что делает: берёт примеры из макета б24тТест_ПримерыИИ и прогоняет каждый нужное число раз через настоящий OpenAI с
// ключом из настроек. Пример с задачей Битрикс24 идёт операцией целиком (б24т_ЗаполнениеИИ.СодержаниеОтИИ: перечитывание
// задачи, запрос, разбор), пример с выдуманной задачей — теми же функциями без перечитывания (задачи нет на портале).
// Проверяет «обязано», «нельзя», места для заполнения и общие правила (одна строка, не длиннее 1000 символов, знак в
// конце). Пример проходит, если верный ответ получен во всех прогонах (решение 12 TASKS).
//
// Возвращаемое значение содержит только числа и номера проверок. Тексты ответов — только в файле в папке из параметров
// (в .local/, вне git): в них настоящие формулировки справочника.

#Область ПрограммныйИнтерфейс

// Параметры:
//  Параметры - Структура:
//   * Сотрудник - СправочникСсылка.ФизическиеЛица - физлицо разработчика: его e-mail есть у пользователя Битрикс24.
//   * Задачи - Соответствие - ключ тестовой задачи (aiUpdate, aiNoValue…) → номер в Битрикс24
//     (scripts/b24-test-data.ids.json).
//   * Номера - Массив из Число - какие примеры прогнать; пусто — все.
//   * Прогонов - Число - сколько раз прогнать каждый пример.
//   * Папка - Строка - куда записать подробный результат (по одному файлу на вызов).
//   * ФайлЗадач - Строка - необязательно: JSON «ключ → название, описание». Пример, чьей задачи нет среди Задачи,
//     идёт по этим данным без Битрикс24 (подбор правил до настоящего прогона по порталу).
//
// Возвращаемое значение:
//  Массив из Строка - первая строка — уровень рассуждения и модель, затем по строке на пример.
//
Функция ПрогонНабора(Параметры) Экспорт

	Примеры = ПрочитатьТекстJSON(ПолучитьОбщийМакет("б24тТест_ПримерыИИ").ПолучитьТекст());

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон("Уровень рассуждения: %1, модель: %2, прогонов на пример: %3",
		б24т_OpenAI.УровеньРассуждения(), б24т_Настройки.НастройкиЗапросаИИ().Модель, Параметры.Прогонов));

	НачалоПрогона = ТекущаяДатаСеанса() - 5;
	Описания = ОписанияЗадач(Параметры);
	Подробно = Новый Массив;
	Для Каждого Пример Из Примеры Цикл
		Если Не ПримерВыбран(Пример, Параметры.Номера) Тогда
			Продолжить;
		КонецЕсли;

		Итоги = ПрогнатьПример(Параметры, Описания, Пример);

		Прошло = 0;
		Секунд = 0;
		Причины = Новый Массив;
		Для Каждого Итог Из Итоги Цикл
			Прошло = Прошло + ?(Итог.Прошёл, 1, 0);
			Секунд = Секунд + Итог.Секунд;
			Для Каждого Причина Из Итог.Причины Цикл
				Если Причины.Найти(Причина) = Неопределено Тогда
					Причины.Добавить(Причина);
				КонецЕсли;
			КонецЦикла;
			Подробно.Добавить(Итог);
		КонецЦикла;

		Строки.Добавить(СтрШаблон("Пример %1 (%2): %3 из %4, в среднем %5 с%6", Формат(Пример["номер"], "ЧГ=0"), Пример["сценарий"],
			Прошло, Итоги.Количество(), Формат(Секунд / Итоги.Количество(), "ЧДЦ=1; ЧН=0"),
			?(Причины.Количество() = 0, "", "; не прошло: " + СтрСоединить(Причины, ", "))));
	КонецЦикла;

	ЗаписатьПодробно(Параметры.Папка, Подробно);

	// С24: после прогона в журнале регистрации нет ключа OpenAI и текстов ответов.
	Утечек = ЧислоУтечекВЖурнале(НачалоПрогона, Подробно);
	Строки.Добавить(СтрШаблон("Журнал регистрации: утечек ключа и текстов ответов — %1%2", Утечек,
		?(Утечек = 0, "", "; не прошло")));
	Возврат Строки;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Задачи из файла «ключ → название, описание»; нет файла — пустое соответствие.
Функция ОписанияЗадач(Параметры)

	ФайлЗадач = "";
	Параметры.Свойство("ФайлЗадач", ФайлЗадач);
	Если ПустаяСтрока(ФайлЗадач) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;

	Документ = Новый ТекстовыйДокумент;
	Документ.Прочитать(ФайлЗадач, КодировкаТекста.UTF8);
	Возврат ПрочитатьТекстJSON(Документ.ПолучитьТекст());

КонецФункции

Функция ПримерВыбран(Пример, Номера)

	Возврат ТипЗнч(Номера) <> Тип("Массив") Или Номера.Количество() = 0 Или Номера.Найти(Пример["номер"]) <> Неопределено;

КонецФункции

// Прогоны одного примера. Формулировка примера (С23) добавляется в регистр на время прогонов в транзакции, которая
// в конце отменяется: запись в справочнике не остаётся.
Функция ПрогнатьПример(Параметры, Описания, Пример)

	Итоги = Новый Массив;

	НачатьТранзакцию();
	Попытка
		Если Пример["формулировка_в_регистр"] <> Неопределено Тогда
			ДобавитьФормулировку(Пример["формулировка_в_регистр"]);
		КонецЕсли;
		Для НомерПрогона = 1 По Параметры.Прогонов Цикл
			Итог = ОдинПрогон(Параметры, Описания, Пример);
			Итог.Вставить("Пример", Пример["номер"]);
			Итог.Вставить("Прогон", НомерПрогона);
			Итоги.Добавить(Итог);
		КонецЦикла;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	ОтменитьТранзакцию();

	Возврат Итоги;

КонецФункции

Процедура ДобавитьФормулировку(Формулировка)

	Менеджер = РегистрыСведений.ГЕМ_ШаблоныДляЗаполненияТабелей.СоздатьМенеджерЗаписи();
	Менеджер.Период = НачалоДня(ТекущаяДатаСеанса()) - 86400;
	Менеджер.Шифр = Формулировка["code"];
	Менеджер.Описание = Формулировка["text"];
	Менеджер.Записать();

КонецПроцедуры

// Один прогон: ответ ИИ по примеру и результат проверок.
Функция ОдинПрогон(Параметры, Описания, Пример)

	Итог = Новый Структура;
	Итог.Вставить("Прошёл", Ложь);
	Итог.Вставить("Причины", Новый Массив);
	Итог.Вставить("Текст", "");
	Итог.Вставить("Места", Новый Массив);
	Итог.Вставить("Секунд", 0);
	Итог.Вставить("Токены", Неопределено);

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Если ТипЗнч(Пример["задача"]) = Тип("Строка") И Параметры.Задачи[Пример["задача"]] <> Неопределено Тогда
		Разбор = ПрогонСЗадачейБитрикс24(Параметры, Пример);
	Иначе
		Разбор = ПрогонБезБитрикс24(Описания, Пример);
	КонецЕсли;
	Итог.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	Итог.Токены = Разбор.Токены;

	Если Не Разбор.Успех Тогда
		Итог.Причины.Добавить("не получен ответ: " + Разбор.Причина);
		Возврат Итог;
	КонецЕсли;

	Итог.Текст = Разбор.Текст;
	Итог.Места = Разбор.Места;
	Итог.Причины = ПроверкаПримера(Пример, Разбор.Текст, Разбор.Места);
	Итог.Прошёл = Итог.Причины.Количество() = 0;
	Возврат Итог;

КонецФункции

// Пример с настоящей задачей портала: вся операция, как у сотрудника (перечитывание, роль, запрос, разбор).
Функция ПрогонСЗадачейБитрикс24(Параметры, Пример)

	Номер = Параметры.Задачи[Пример["задача"]];
	Если Номер = Неопределено Тогда
		ВызватьИсключение "В параметрах нет номера задачи " + Пример["задача"];
	КонецЕсли;

	Операция = Новый Структура;
	Операция.Вставить("Сотрудник", Параметры.Сотрудник);
	Операция.Вставить("ДатаТабеля", ТекущаяДатаСеанса());
	Операция.Вставить("Номер", Номер);
	Операция.Вставить("ТекстПоля", Пример["черновик"]);
	Операция.Вставить("НазваниеВОкне", "");
	Результат = б24т_ЗаполнениеИИ.СодержаниеОтИИ(Операция);

	Разбор = НовыйРазбор();
	Если Результат.Итог <> "Готово" Тогда
		Разбор.Причина = Результат.Итог + ": " + Результат.Сообщение;
		Возврат Разбор;
	КонецЕсли;
	Разбор.Успех = Истина;
	Разбор.Текст = Результат.Текст;
	Разбор.Места = Результат.Места;
	Возврат Разбор;

КонецФункции

// Пример без задачи портала: название и описание — из макета примера или из файла задач. Те же функции, что у операции,
// но без перечитывания в Битрикс24 и без проверки роли.
Функция ПрогонБезБитрикс24(Описания, Пример)

	Данные = Пример["задача"];
	Если ТипЗнч(Данные) = Тип("Строка") Тогда
		Ключ = Данные;
		Данные = Описания[Ключ];
		Если Данные = Неопределено Тогда
			ВызватьИсключение "Нет данных задачи " + Ключ;
		КонецЕсли;
	КонецЕсли;

	Задача = Новый Соответствие;
	Задача.Вставить("title", Данные["название"]);
	Задача.Вставить("description", Данные["описание"]);
	Задача.Вставить("descriptionInBbcode", "Y");

	Дата = ТекущаяДатаСеанса();
	Формулировки = б24т_СодержаниеИИ.Формулировки(Дата);
	Материал = б24т_СодержаниеИИ.МатериалЗадачи(Задача, Пример["черновик"]);
	Запрос = б24т_СодержаниеИИ.ЗапросСодержания(Материал, б24т_Настройки.НастройкиЗапросаИИ(), Формулировки);
	Ответ = б24т_OpenAI.Вызвать(б24т_OpenAI.НовыйКлиент(), Запрос);

	Разбор = НовыйРазбор();
	Если Не Ответ.Успех Тогда
		Разбор.Причина = б24т_OpenAI.ТекстОшибки(Ответ.Ошибка);
		Возврат Разбор;
	КонецЕсли;
	Разбор.Токены = Ответ.Токены;

	Результат = б24т_СодержаниеИИ.РезультатОтвета(Ответ.Текст, Пример["черновик"], Формулировки);
	Если Не Результат.Разобран Тогда
		Разбор.Причина = Результат.Причина;
		Возврат Разбор;
	КонецЕсли;
	Разбор.Успех = Истина;
	Разбор.Текст = Результат.Текст;
	Разбор.Места = Результат.Места;
	Возврат Разбор;

КонецФункции

Функция НовыйРазбор()

	Разбор = Новый Структура;
	Разбор.Вставить("Успех", Ложь);
	Разбор.Вставить("Причина", "");
	Разбор.Вставить("Текст", "");
	Разбор.Вставить("Места", Новый Массив);
	Разбор.Вставить("Токены", Неопределено);
	Возврат Разбор;

КонецФункции

// Проверки примера. Причины — номера проверок без текстов ответа.
Функция ПроверкаПримера(Пример, Текст, Места)

	Причины = Новый Массив;

	// Обязательный фрагмент — строка или массив равноценных вариантов (любой из них): «…3.0.75.1, установка патчей» и
	// «…3.0.75.1. Установка патчей.» одинаково допустимы по Ф11.
	Номер = 0;
	Для Каждого Фрагмент Из Пример["обязано"] Цикл
		Номер = Номер + 1;
		Варианты = ?(ТипЗнч(Фрагмент) = Тип("Массив"), Фрагмент, ЗначениеВМассиве(Фрагмент));
		Найден = Ложь;
		Для Каждого Вариант Из Варианты Цикл
			Найден = Найден Или СтрНайти(Текст, Вариант) > 0;
		КонецЦикла;
		Если Не Найден Тогда
			Причины.Добавить("нет обязательного фрагмента " + Номер);
		КонецЕсли;
	КонецЦикла;

	Номер = 0;
	Для Каждого Фрагмент Из Пример["нельзя"] Цикл
		Номер = Номер + 1;
		Если СтрНайти(Текст, Фрагмент) > 0 Тогда
			Причины.Добавить("есть запрещённый фрагмент " + Номер);
		КонецЕсли;
	КонецЦикла;

	Ожидаемые = Пример["заполните"];
	Если Места.Количество() <> Ожидаемые.Количество() Тогда
		Причины.Добавить(СтрШаблон("мест для заполнения: ожидалось %1, получено %2", Ожидаемые.Количество(), Места.Количество()));
	Иначе
		Номер = 0;
		Для Каждого Место Из Ожидаемые Цикл
			Номер = Номер + 1;
			Если Места.Найти(Место) = Неопределено Тогда
				Причины.Добавить("нет ожидаемого места " + Номер);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если СтрДлина(Текст) > 1000 Тогда
		Причины.Добавить("длиннее 1000 символов");
	КонецЕсли;
	Если СтрНайти(Текст, Символы.ПС) > 0 Или СтрНайти(Текст, Символы.ВК) > 0 Тогда
		Причины.Добавить("есть перенос строки");
	КонецЕсли;
	Если СтрНайти(".!?…", Прав(Текст, 1)) = 0 Тогда
		Причины.Добавить("нет знака в конце");
	КонецЕсли;

	Возврат Причины;

КонецФункции

// Записи журнала регистрации с начала прогона: кусок «sk-…» без маски и полный текст ответа ИИ. Ключ маскируется как
// «sk-***» (б24т_OpenAI.СкрытьКлючи), поэтому подозрительно «sk-» с любым другим знаком после него.
Функция ЧислоУтечекВЖурнале(Начало, Подробно)

	Таблица = Новый ТаблицаЗначений;
	ВыгрузитьЖурналРегистрации(Таблица, Новый Структура("ДатаНачала", Начало));

	Тексты = Новый Массив;
	Для Каждого Итог Из Подробно Цикл
		Если СтрДлина(Итог.Текст) >= 20 Тогда
			Тексты.Добавить(Итог.Текст);
		КонецЕсли;
	КонецЦикла;

	Утечек = 0;
	Для Каждого Запись Из Таблица Цикл
		Комментарий = Запись.Комментарий;
		Позиция = СтрНайти(Комментарий, "sk-");
		Пока Позиция > 0 Цикл
			// «task-…» и подобное — не ключ: ключ начинается с «sk-» в начале слова.
			Предыдущий = ?(Позиция = 1, "", Сред(Комментарий, Позиция - 1, 1));
			НачалоСлова = Предыдущий = "" Или (ВРег(Предыдущий) = НРег(Предыдущий) И СтрНайти("0123456789", Предыдущий) = 0);
			Если НачалоСлова И Сред(Комментарий, Позиция + 3, 1) <> "*" Тогда
				Утечек = Утечек + 1;
			КонецЕсли;
			Если Позиция + 3 > СтрДлина(Комментарий) Тогда
				Прервать;
			КонецЕсли;
			Позиция = СтрНайти(Комментарий, "sk-", , Позиция + 3);
		КонецЦикла;
		Для Каждого Текст Из Тексты Цикл
			Если СтрНайти(Комментарий, Текст) > 0 Тогда
				Утечек = Утечек + 1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Утечек;

КонецФункции

Функция ЗначениеВМассиве(Значение)

	Массив = Новый Массив;
	Массив.Добавить(Значение);
	Возврат Массив;

КонецФункции

Функция ПрочитатьТекстJSON(Текст)

	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Результат;

КонецФункции

// Подробный результат — в файл папки: тексты ответов не возвращаются в вызывающий код и не попадают в переписку.
Процедура ЗаписатьПодробно(Папка, Подробно)

	Если ПустаяСтрока(Папка) Или Подробно.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Каталог = Новый Файл(Папка);
	Если Не Каталог.Существует() Тогда
		СоздатьКаталог(Папка);
	КонецЕсли;

	Писатель = Новый ЗаписьJSON;
	Писатель.ОткрытьФайл(Папка + "/прогон-" + Формат(ТекущаяДатаСеанса(), "ДФ=yyyyMMdd-HHmmss") + ".json", "UTF-8", Ложь,
		Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Unix, "  "));
	ЗаписатьJSON(Писатель, Подробно);
	Писатель.Закрыть();

КонецПроцедуры

#КонецОбласти
