Процедура СменаВыбора_ДругаяЗадача_Сброс() Экспорт

	Ответ = б24т_СодержаниеИИКлиентСервер.ПрименитьОтветИИ(б24т_СодержаниеИИКлиентСервер.НовоеСостояниеИИ(), "черновик",
