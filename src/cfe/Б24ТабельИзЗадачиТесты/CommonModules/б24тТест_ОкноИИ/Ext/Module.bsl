#Область СлужебныеПроцедурыИФункции

// Результат «Готово» операции б24т_ЗаполнениеИИ.СодержаниеОтИИ.
Функция РезультатГотово(Текст, ИскомыеМеста = Неопределено, НеИзменён = Ложь)

	Места = ?(ИскомыеМеста = Неопределено, Новый Массив, ИскомыеМеста);
	Результат = Новый Структура;
	Результат.Вставить("Итог", "Готово");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Текст", Текст);
	Результат.Вставить("ИскомыеМеста", Места);
	Результат.Вставить("Места", б24т_СодержаниеИИКлиентСервер.НезаполненныеМеста(Текст, Места));
	Результат.Вставить("НеИзменён", НеИзменён);
	Возврат Результат;

КонецФункции

// Результат «Ошибка» операции: ИИ или Битрикс24 недоступны, ИИ не настроен.
Функция РезультатОшибки(Сообщение)

	Результат = Новый Структура;
	Результат.Вставить("Итог", "Ошибка");
	Результат.Вставить("Сообщение", Сообщение);
	Результат.Вставить("Текст", "");
	Результат.Вставить("ИскомыеМеста", Новый Массив);
	Результат.Вставить("Места", Новый Массив);
	Результат.Вставить("НеИзменён", Ложь);
	Возврат Результат;

КонецФункции

Процедура ПроверитьНадписи(Надписи, Ожидание, Заполните, НеИзменён, Сообщение, ВернутьВидна)

	ЮТест.ОжидаетЧто(Надписи.Ожидание, "Надпись ожидания").Равно(Ожидание);
	ЮТест.ОжидаетЧто(Надписи.Заполните, "Надпись «Заполните»").Равно(Заполните);
	ЮТест.ОжидаетЧто(Надписи.НеИзменён, "Надпись «ИИ не изменил текст»").Равно(НеИзменён);
	ЮТест.ОжидаетЧто(Надписи.Сообщение, "Сообщение").Равно(Сообщение);
	ЮТест.ОжидаетЧто(Надписи.ВернутьВидна, "Кнопка «Вернуть прежний текст»").Равно(ВернутьВидна);

КонецПроцедуры

Функция ЗначенияВМассиве(Значение1, Значение2 = Неопределено, Значение3 = Неопределено)

	Массив = Новый Массив;
	Для Каждого Значение Из ЗначенияСписком(Значение1, Значение2, Значение3) Цикл
		Если Значение <> Неопределено Тогда
			Массив.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Массив;

КонецФункции

Функция ЗначенияСписком(Значение1, Значение2, Значение3)

	Список = Новый Массив;
	Список.Добавить(Значение1);
	Список.Добавить(Значение2);
	Список.Добавить(Значение3);
	Возврат Список;

КонецФункции

#КонецОбласти
