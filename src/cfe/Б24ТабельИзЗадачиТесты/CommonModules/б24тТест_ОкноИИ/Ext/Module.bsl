// Правила окна для «Заполнить с помощью ИИ» (Ф9, Ф12, решения 1А–10А этапа 19): ответ, возврат прежнего текста,
// ошибки, смена выбора и надписи под полем «Содержание». Функции работают на простых структурах, без формы и без сети.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьСерверныйТест("Состояние_Новое_НетНадписей", "До нажатия кнопки ИИ надписей и кнопки возврата нет")
		.ДобавитьСерверныйТест("Ответ_ЗаменяетТекстИЗапоминаетПрежний",
			"Ответ ИИ заменяет текст поля, прежний текст запомнен, кнопка возврата видна (Ф12)")
		.ДобавитьСерверныйТест("Ответ_МестаВНадписиЗаполните", "Места из ответа — в надписи «Заполните: …» (С17)")
		.ДобавитьСерверныйТест("Ответ_НеИзменён_НадписьБезКнопкиВозврата",
			"Ответ совпал с полем: «ИИ не изменил текст», кнопки возврата нет, места — тоже в надписи")
		.ДобавитьСерверныйТест("Ответ_НеИзменён_ПерваяПравкаУбираетНадпись",
			"«ИИ не изменил текст» видна, пока текст поля совпадает с ответом (7А)")
		.ДобавитьСерверныйТест("Ответ_Второй_ПомнитсяОдинПрежнийТекст", "Помнится только один прежний текст (Ф12)")
		.ДобавитьСерверныйТест("Ответ_ВторойНеИзменён_КнопкаВозвратаИсчезает",
			"Следующий ответ, совпавший с полем, убирает кнопку возврата (Ф12)")
		.ДобавитьСерверныйТест("Ответ_УбираетПрежнееСообщение", "Новый ответ убирает сообщение об ошибке прошлого нажатия")
		.ДобавитьСерверныйТест("Правка_ПересчитываетЗаполните",
			"Место, заполненное в поле, исчезает из надписи; заполнены все — надписи нет (С17)")
		.ДобавитьСерверныйТест("Возврат_ПрежнийТекстНадписиУбраны",
			"«Вернуть прежний текст»: прежний текст в поле, надписи и кнопка убраны (С19)")
		.ДобавитьСерверныйТест("Возврат_ПослеПравки_ТекстДоНажатияИИ", "Возврат и после правки поля — текст до нажатия ИИ (8А)")
		.ДобавитьСерверныйТест("Ошибка_ПолеИРезультатПрошлогоНажатияОстаются",
			"Ошибка ИИ: поле не меняется, «Вернуть прежний текст» и «Заполните» остаются, сообщение видно (5А, С21)")
		.ДобавитьСерверныйТест("Ошибка_СкрываетНеИзменён", "Ошибка скрывает «ИИ не изменил текст» прошлого нажатия (5А)")
		.ДобавитьСерверныйТест("Ошибка_БезПрошлогоОтвета_ТолькоСообщение", "Первая же ошибка: только сообщение под полем")
		.ДобавитьСерверныйТест("Отклонена_СнимаетВыборИУбираетРезультат",
			"Задача больше не подходит: выбор снимается, результат ИИ убран, сообщение видно, поле не меняется (Ф9)")
		.ДобавитьСерверныйТест("СменаВыбора_ДругаяЗадача_Сброс", "Выбор другой задачи убирает надписи и кнопку возврата (9А)")
		.ДобавитьСерверныйТест("СменаВыбора_СнятиеВыбора_Сброс", "Снятие выбора убирает надписи и кнопку возврата (9А)")
		.ДобавитьСерверныйТест("СменаВыбора_ТаЖеЗадача_БезИзменений", "Повторный выбор той же задачи ничего не меняет (9А)")
		.ДобавитьСерверныйТест("Ожидание_ТолькоНадписьОжидания",
			"Пока идёт запрос: «ИИ составляет содержание…», остальные надписи и кнопка возврата скрыты (Ф9)")
		.ДобавитьСерверныйТест("МожноЗапросить_ПоУсловиям",
			"Кнопка ИИ доступна, только если ИИ доступен, задача выбрана и окно не ждёт ответа (Ф9)")
		.ДобавитьСерверныйТест("ГраницыМеста_ПервоеМестоВыделяется", "Курсор: выделено первое незаполненное место (6А)")
		.ДобавитьСерверныйТест("ГраницыМеста_НетМест_КурсорВКонце", "Курсор: мест нет — в конце текста (6А)")
		.ДобавитьСерверныйТест("Правила_НеМеняютИсходноеСостояние",
			"Правила возвращают новое состояние и не меняют переданное");

КонецПроцедуры

