Процедура В1С_EmailУДругогоФизлица() Экспорт

	Окружение = НовоеОкружение("test.user@example.com;own@example.com");
	НастроитьПодключение();
	Другой = НовоеФизлицо("[ТЕСТ] Другой сотрудник Доступ Б24");
	УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Другой, " Test.User@Example.com ",
		Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица, , Ложь);
	Начало = ТекущаяДатаСеанса() - 10;
	Было = ЗаписиЖурнала(Начало).Количество();

	Результат = ПроверитьДоступВ1С(Окружение.ФизическоеЛицо, Окружение.Пользователь);

	ПроверитьОтказВ1С(Результат,
		"E-mail test.user@example.com указан в карточках нескольких физических лиц. Обратитесь к администратору");
	Запись = НоваяЗаписьЖурнала(Начало, Было);
	ЮТест.ОжидаетЧто(Запись.Комментарий, "Другое физлицо в журнале").Содержит("[ТЕСТ] Другой сотрудник Доступ Б24");
	ЮТест.ОжидаетЧто(Запись.Комментарий, "Полный e-mail в журнале").НеСодержит("test.user@example.com");

