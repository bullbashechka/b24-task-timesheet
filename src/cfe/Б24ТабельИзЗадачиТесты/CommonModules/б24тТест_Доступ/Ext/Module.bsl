// Записывает настройки подключения (в транзакции теста, поэтому настоящий вебхук не затрагивается).
Процедура НастроитьПодключение(ЕстьАдрес = Истина, РежимТестирования = Ложь, Проект = 0)

	УстановитьПривилегированныйРежим(Истина);
	Константы.б24т_РежимТестирования.Установить(Ложь);
	Константы.б24т_ПроектДляТестирования.Установить(0);
	ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища("Б24ТабельИзЗадачи", "АдресВебхука");
	УстановитьПривилегированныйРежим(Ложь);

	Изменения = Новый Структура;
	Изменения.Вставить("НовыйАдрес", ?(ЕстьАдрес, АдресПример(), ""));
	Изменения.Вставить("УдалитьАдрес", Ложь);
	Изменения.Вставить("РежимТестирования", РежимТестирования);
	Изменения.Вставить("ПроектДляТестирования", Проект);
	Ошибки = б24т_Настройки.ЗаписатьНастройки(Изменения);
	ЮТест.ОжидаетЧто(Ошибки.Количество(), "Ошибок записи настроек").Равно(0);

КонецПроцедуры

// Физическое лицо и пользователь 1С с этим физлицом. Адреса через «;» добавляются отдельными записями.
Функция НовоеОкружение(Адреса)

	Физлицо = НовоеФизлицо(НаименованиеФизлица());
	Если Не ПустаяСтрока(Адреса) Тогда
		Для Каждого Адрес Из СтрРазделить(Адреса, ";") Цикл
			УправлениеКонтактнойИнформацией.ДобавитьКонтактнуюИнформацию(Физлицо, Адрес,
				Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица, , Ложь);
		КонецЦикла;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ФизическоеЛицо", Физлицо);
	Результат.Вставить("Пользователь", НовыйПользователь(Физлицо));
	Возврат Результат;

КонецФункции

Функция НовоеФизлицо(Наименование)

	Физлицо = Справочники.ФизическиеЛица.СоздатьЭлемент();
	Физлицо.Наименование = Наименование;
	Физлицо.Записать();
	Возврат Физлицо.Ссылка;

КонецФункции

Функция НовыйПользователь(Физлицо)

	Пользователь = Справочники.Пользователи.СоздатьЭлемент();
	Пользователь.Наименование = "[ТЕСТ] Пользователь Доступ Б24";
	Пользователь.ФизическоеЛицо = Физлицо;
	Пользователь.ОбменДанными.Загрузка = Истина;
	Пользователь.Записать();
	Возврат Пользователь.Ссылка;

КонецФункции

// Клиент с заглушкой: ответы из макетов в порядке вызовов.
Функция КлиентСОтветами(Случаи)

	Клиент = б24тТест_ЗаглушкаТранспорта.НовыйКлиент();
	Для Каждого Случай Из СтрРазделить(Случаи, ",") Цикл
		б24тТест_ЗаглушкаТранспорта.ДобавитьОтвет(Клиент, Случай);
	КонецЦикла;
	Возврат Клиент;

КонецФункции

Функция МетодыВызовов(Клиент)

	Методы = Новый Массив;
	Для Каждого Вызов Из Клиент.Вызовы Цикл
		Методы.Добавить(Вызов.Метод);
	КонецЦикла;
	Возврат СтрСоединить(Методы, ",");

КонецФункции

Процедура ПроверитьОтказ(Результат, Клиент, Сообщение, ЧислоВызовов)

	ЮТест.ОжидаетЧто(Результат.Успех, "Успех").ЭтоЛожь();
	ЮТест.ОжидаетЧто(Результат.Сообщение, "Сообщение").Равно(Сообщение);
	ЮТест.ОжидаетЧто(Результат.Контекст, "Контекст").Равно(Неопределено);
	ЮТест.ОжидаетЧто(Клиент.Вызовы.Количество(), "Обращений к Битрикс24").Равно(ЧислоВызовов);

КонецПроцедуры

// Единственная запись «Доступ», появившаяся после вызова: в окно журнала попадают и записи соседних тестов.
Функция НоваяЗаписьЖурнала(Начало, БылоЗаписей)

	Записи = ЗаписиЖурнала(Начало);
	ЮТест.ОжидаетЧто(Записи.Количество() - БылоЗаписей, "Новых записей «Доступ»").Равно(1);
	Возврат Записи[Записи.Количество() - 1];

КонецФункции

Функция ЗаписиЖурнала(Начало)

	Таблица = Новый ТаблицаЗначений;
	Фильтр = Новый Структура;
	Фильтр.Вставить("ДатаНачала", Начало);
	Фильтр.Вставить("Событие", "Б24ТабельИзЗадачи.Доступ");
	ВыгрузитьЖурналРегистрации(Таблица, Фильтр);
	Возврат Таблица;

КонецФункции

#КонецОбласти
