// Уровень рассуждения модели для всех запросов, проверочный тоже. Выбран по живому прогону набора примеров (18.6): на
// уровне «low» все 13 примеров прошли 5 раз из 5, на «none» два примера, где модель не должна ничего выдумывать
// (место остаётся незаполненным), один раз из пяти дали выдуманное значение; «none» быстрее (1,4 с против 2,7 с).
//
// Возвращаемое значение:
//  Строка - значение reasoning.effort.
//
Функция УровеньРассуждения() Экспорт

	Возврат "low";

КонецФункции

// Создаёт клиента OpenAI. Клиент живёт только на сервере: не передавать его на клиент 1С и не хранить в данных формы.
// Ключа в клиенте нет: модуль читает его сам перед каждым запросом, явный ключ передаётся в Вызвать.
//
// Параметры:
//  Транспорт - Строка - имя общего модуля с функцией ВыполнитьЗапрос(Запрос): б24т_ТранспортOpenAI или
//    тестовая заглушка (имя с префиксом б24тТест_).
//
// Возвращаемое значение:
//  Структура:
//   * Транспорт - Строка
//   * Таймаут - Число - секунд на запрос.
//   * МаксимумРазмераОтвета - Число - символов в теле ответа; больший ответ не разбирается («недоступен»).
//   * Вызовы - Массив - заполняет заглушка транспорта.
//
Функция НовыйКлиент(Транспорт = "б24т_ТранспортOpenAI") Экспорт

	Клиент = Новый Структура;
	Клиент.Вставить("Транспорт", Транспорт);
	Клиент.Вставить("Таймаут", 30);
	// Ответ OpenAI повторяет указания запроса, поэтому предел взят с запасом над размером запроса.
	Клиент.Вставить("МаксимумРазмераОтвета", 1024 * 1024);
	Клиент.Вставить("Вызовы", Новый Массив);
	Возврат Клиент;

КонецФункции

// Описывает запрос к модели. Тело запроса собирает Вызвать: так у всех запросов одни и те же параметры.
//
// Параметры:
//  Назначение - Строка - для журнала регистрации: «Проверка ИИ», «Содержание».
//  Модель - Строка
//  Указания - Строка - instructions; пусто — не передаются.
//  Вход - Строка - input.
//  ИмяСхемы - Строка - имя схемы ответа.
//  Схема - Соответствие, Структура - JSON Schema ответа; модель отвечает строго по ней и полями в её порядке
//    (порядок хранит только Структура).
//  МаксимумТокенов - Число - max_output_tokens; токены рассуждения входят в него.
//
// Возвращаемое значение:
//  Структура - с теми же полями, что параметры.
//
Функция НовыйЗапрос(Назначение, Модель, Указания, Вход, ИмяСхемы, Схема, МаксимумТокенов) Экспорт

	Запрос = Новый Структура;
	Запрос.Вставить("Назначение", Назначение);
	Запрос.Вставить("Модель", Модель);
	Запрос.Вставить("Указания", Указания);
	Запрос.Вставить("Вход", Вход);
	Запрос.Вставить("ИмяСхемы", ИмяСхемы);
	Запрос.Вставить("Схема", Схема);
	Запрос.Вставить("МаксимумТокенов", МаксимумТокенов);
	Возврат Запрос;

КонецФункции

// Короткий запрос для кнопки «Проверить ИИ» (Ф13). Параметры те же, что у запроса содержания, поэтому модель, которая
// их не принимает, видна уже в проверке. Данных задач и компании в нём нет.
//
// Параметры:
//  Модель - Строка
//
// Возвращаемое значение:
//  Структура - см. НовыйЗапрос.
//
Функция ПроверочныйЗапрос(Модель) Экспорт

	Признак = Новый Соответствие;
	Признак.Вставить("type", "boolean");
	Свойства = Новый Соответствие;
	Свойства.Вставить("ready", Признак);
	Схема = Новый Соответствие;
	Схема.Вставить("type", "object");
	Схема.Вставить("properties", Свойства);
	Схема.Вставить("required", СтрРазделить("ready", ","));
	Схема.Вставить("additionalProperties", Ложь);

	Возврат НовыйЗапрос("Проверка ИИ", Модель, "", "Ответь одним словом: готов", "check", Схема, 1000);

КонецФункции

// Отправляет запрос в OpenAI: ровно один запрос, без повторов. Ошибки исключениями не бросаются, они возвращаются
// в Ошибка. Каждое обращение пишется в журнал регистрации; ключ, тексты запроса и ответа в журнал не попадают.
//
// Параметры:
//  Клиент - см. НовыйКлиент
//  Запрос - см. НовыйЗапрос
//  ЯвныйКлюч - Строка, Неопределено - ключ из поля формы настроек («Проверить ИИ»); Неопределено — сохранённый ключ.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Текст - Строка - текст ответа модели (по схеме — JSON одной строкой).
//   * Модель - Строка - модель, которая ответила, как её назвал OpenAI.
//   * Токены - Структура - Вход, ИзКэша, Выход, Рассуждения.
//   * Ошибка - Неопределено, Структура:
//    ** Вид - Строка - см. ВидОшибки*.
//    ** Причина - Строка - см. Причина*.
//    ** Код - Строка - код ошибки OpenAI или свой код (RESPONSE_TOO_LARGE, NOT_JSON, refusal, …).
//    ** Тип - Строка - тип ошибки OpenAI.
//    ** Описание - Строка - без ключа.
//    ** КодСостояния - Число - HTTP, 0 если ответа не было.
//
Функция Вызвать(Клиент, Запрос, ЯвныйКлюч = Неопределено) Экспорт

	ПроверитьТранспорт(Клиент.Транспорт);

	Ключ = ?(ЯвныйКлюч = Неопределено, КлючИзХранилища(), СокрЛП(ЯвныйКлюч));
	Если ПустаяСтрока(Ключ) Тогда
		Результат = НовыйРезультат();
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНеНастроено(), ПричинаНетКлюча(), "", "",
			НСтр("ru = 'Ключ OpenAI не указан, запрос не отправлен'"), 0);
		ЗаписатьОбращение(Запрос, Неопределено, Результат, Ключ);
		Возврат Результат;
	КонецЕсли;

	Ответ = ОтправитьЗапрос(Клиент, ТелоЗапроса(Запрос), Ключ);
	Результат = РазобранныйОтвет(Клиент, Ответ, Ключ);
	ЗаписатьОбращение(Запрос, Ответ, Результат, Ключ);
	Возврат Результат;

КонецФункции

// Текст для сотрудника по ошибке ИИ (Ф12).
//
// Параметры:
//  Ошибка - см. Вызвать
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОшибки(Ошибка) Экспорт

	Если Ошибка.Вид = ВидОшибкиНеНастроено() Тогда
		Возврат НСтр("ru = 'ИИ не настроен. Обратитесь к администратору'");
	КонецЕсли;
	Возврат НСтр("ru = 'ИИ недоступен. Заполните содержание вручную'");

КонецФункции

// Прячет ключи OpenAI в тексте (журнал регистрации, исключение платформы, ошибка OpenAI): ключ целиком и любой
// фрагмент, который начинается с «sk-» в начале слова. OpenAI в ошибке 401 повторяет начало и конец ключа.
//
// Параметры:
//  Текст - Строка
//  Ключ - Строка - ключ, которым шёл запрос; пусто — прячутся только фрагменты «sk-…».
//
// Возвращаемое значение:
//  Строка
//
Функция СкрытьКлючи(Знач Текст, Ключ = "") Экспорт

	Если ПустаяСтрока(Текст) Тогда
		Возврат Текст;
	КонецЕсли;
	Если Не ПустаяСтрока(Ключ) Тогда
		Текст = СтрЗаменить(Текст, СокрЛП(Ключ), "sk-***");
	КонецЕсли;

	Результат = "";
	Начало = 1;
	Длина = СтрДлина(Текст);
	Пока Начало <= Длина Цикл
		Найдено = СтрНайти(Текст, "sk-", НаправлениеПоиска.СНачала, Начало);
		Если Найдено = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Найдено > 1 И ЭтоСимволСлова(Сред(Текст, Найдено - 1, 1)) Тогда
			// «task-», «risk-» и подобные слова — не ключ.
			Результат = Результат + Сред(Текст, Начало, Найдено + 3 - Начало);
			Начало = Найдено + 3;
			Продолжить;
		КонецЕсли;
		Конец = Найдено + 3;
		Пока Конец <= Длина И ПродолжаетКлюч(Текст, Конец) Цикл
			Конец = Конец + 1;
		КонецЦикла;
		Результат = Результат + Сред(Текст, Начало, Найдено - Начало) + "sk-***";
		Начало = Конец;
	КонецЦикла;

	Возврат Результат + Сред(Текст, Начало);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Транспорт задаётся именем общего модуля; любое другое имя, кроме транспорта OpenAI и тестовых заглушек, — исключение.
Процедура ПроверитьТранспорт(Транспорт)

	Если Транспорт = "б24т_ТранспортOpenAI" Или СтрНачинаетсяС(Транспорт, "б24тТест_") Тогда
		Возврат;
	КонецЕсли;
	ВызватьИсключение СтрШаблон(НСтр("ru = 'Транспорт OpenAI ""%1"" не разрешён'"), Транспорт);

КонецПроцедуры

// Ключ OpenAI из безопасного хранилища. Наружу модуля не отдаётся и в клиенте не хранится.
// Тот же владелец и ключ записи пишет б24т_Настройки.ЗаписатьНастройки.
Функция КлючИзХранилища()

	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища("Б24ТабельИзЗадачи", "КлючOpenAI");
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(Ключ = Неопределено, "", Ключ);

КонецФункции

Функция ТелоЗапроса(Запрос)

	Формат = Новый Соответствие;
	Формат.Вставить("type", "json_schema");
	Формат.Вставить("name", Запрос.ИмяСхемы);
	Формат.Вставить("strict", Истина);
	Формат.Вставить("schema", Запрос.Схема);
	ФорматОтвета = Новый Соответствие;
	ФорматОтвета.Вставить("format", Формат);
	Рассуждение = Новый Соответствие;
	Рассуждение.Вставить("effort", УровеньРассуждения());

	// Идентификатор сотрудника (user, safety_identifier) не передаётся: Ф10.
	Данные = Новый Соответствие;
	Данные.Вставить("model", Запрос.Модель);
	Если Не ПустаяСтрока(Запрос.Указания) Тогда
		Данные.Вставить("instructions", Запрос.Указания);
	КонецЕсли;
	Данные.Вставить("input", Запрос.Вход);
	Данные.Вставить("store", Ложь);
	Данные.Вставить("max_output_tokens", Запрос.МаксимумТокенов);
	Данные.Вставить("reasoning", Рассуждение);
	Данные.Вставить("text", ФорматОтвета);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();

КонецФункции

// Один обмен с транспортом. Исключение транспорта (нет связи, таймаут) превращается в текст без ключа.
Функция ОтправитьЗапрос(Клиент, Тело, Ключ)

	Транспорт = ОбщегоНазначения.ОбщийМодуль(Клиент.Транспорт);

	Запрос = Новый Структура;
	Запрос.Вставить("Тело", Тело);
	Запрос.Вставить("Ключ", Ключ);
	Запрос.Вставить("Таймаут", Клиент.Таймаут);
	Запрос.Вставить("Клиент", Клиент);

	Ответ = Новый Структура("КодСостояния, Тело, ИдентификаторЗапроса, ТекстИсключения, Секунд", 0, "", "",
		Неопределено, 0);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Результат = Транспорт.ВыполнитьЗапрос(Запрос);
		Ответ.КодСостояния = Результат.КодСостояния;
		Ответ.Тело = ?(Результат.Тело = Неопределено, "", Результат.Тело);
		Идентификатор = "";
		Если Результат.Свойство("ИдентификаторЗапроса", Идентификатор) И Идентификатор <> Неопределено Тогда
			Ответ.ИдентификаторЗапроса = Идентификатор;
		КонецЕсли;
	Исключение
		Ответ.ТекстИсключения = СкрытьКлючи(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Ключ);
	КонецПопытки;
	Ответ.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	Возврат Ответ;

КонецФункции

// Превращает ответ транспорта в результат вызова.
Функция РазобранныйОтвет(Клиент, Ответ, Ключ)

	Результат = НовыйРезультат();
	Статус = Ответ.КодСостояния;

	Если Ответ.ТекстИсключения <> Неопределено Тогда
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНедоступен(), ПричинаНетОтвета(), "", "", Ответ.ТекстИсключения, 0);
		Возврат Результат;
	КонецЕсли;

	Если СтрДлина(Ответ.Тело) > Клиент.МаксимумРазмераОтвета Тогда
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНедоступен(), ПричинаНедоступен(), "RESPONSE_TOO_LARGE", "",
			НСтр("ru = 'Ответ больше допустимого размера'"), Статус);
		Возврат Результат;
	КонецЕсли;

	Данные = ПрочитатьТелоОтвета(Ответ.Тело);
	Если Статус < 200 Или Статус >= 300 Тогда
		Результат.Ошибка = ОшибкаПоОтвету(Статус, Данные, Ключ);
		Возврат Результат;
	КонецЕсли;

	Если Данные = Неопределено Тогда
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНедоступен(), ПричинаНедоступен(), "NOT_JSON", "",
			НСтр("ru = 'Ответ не в формате JSON или пустой'"), Статус);
		Возврат Результат;
	КонецЕсли;

	Если ТипЗнч(Данные["error"]) = Тип("Соответствие") Или Данные["status"] <> "completed" Тогда
		Результат.Ошибка = ОшибкаНезавершённогоОтвета(Статус, Данные, Ключ);
		Возврат Результат;
	КонецЕсли;

	Сообщение = СообщениеМодели(Данные["output"]);
	Если Сообщение.Отказ <> Неопределено Тогда
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНедоступен(), ПричинаНедоступен(), "refusal", "",
			НСтр("ru = 'Модель отказалась отвечать'"), Статус);
		Возврат Результат;
	КонецЕсли;
	Если Сообщение.Текст = Неопределено Тогда
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНедоступен(), ПричинаНедоступен(), "NO_TEXT", "",
			НСтр("ru = 'В ответе нет текста модели'"), Статус);
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Текст = Сообщение.Текст;
	Результат.Модель = СтрокаИлиПусто(Данные["model"]);
	Результат.Токены = ТокеныОтвета(Данные["usage"]);
	Возврат Результат;

КонецФункции

// Ошибка по HTTP-статусу и телу ошибки OpenAI. «Не настроен» — то, что исправляет только администратор.
Функция ОшибкаПоОтвету(Статус, Данные, Ключ)

	Код = "";
	ТипОшибки = "";
	Описание = СтрШаблон(НСтр("ru = 'HTTP %1, ответ не в формате OpenAI'"), Формат(Статус, "ЧГ=0"));
	Если Данные <> Неопределено И ТипЗнч(Данные["error"]) = Тип("Соответствие") Тогда
		Код = СтрокаИлиПусто(Данные["error"]["code"]);
		ТипОшибки = СтрокаИлиПусто(Данные["error"]["type"]);
		Описание = СкрытьКлючи(СтрокаИлиПусто(Данные["error"]["message"]), Ключ);
	КонецЕсли;

	Если Статус = 401 Или Статус = 403 Тогда
		Возврат НоваяОшибка(ВидОшибкиНеНастроено(), ПричинаКлючОтклонён(), Код, ТипОшибки, Описание, Статус);
	ИначеЕсли Статус = 404 Или Статус = 400 Или Код = "model_not_found" Тогда
		Возврат НоваяОшибка(ВидОшибкиНеНастроено(), ПричинаМодельНедоступна(), Код, ТипОшибки, Описание, Статус);
	ИначеЕсли Статус = 429 И ЭтоНехваткаСредств(Код, ТипОшибки) Тогда
		Возврат НоваяОшибка(ВидОшибкиНеНастроено(), ПричинаНетСредств(), Код, ТипОшибки, Описание, Статус);
	КонецЕсли;
	Возврат НоваяОшибка(ВидОшибкиНедоступен(), ПричинаНедоступен(), Код, ТипОшибки, Описание, Статус);

КонецФункции

// Два 429 различаются только кодом: «лимит запросов» проходит сам, «нет средств» и «лимит расходов» — нет.
Функция ЭтоНехваткаСредств(Код, ТипОшибки)

	Возврат Код = "insufficient_quota" Или Код = "credit_balance_exhausted" Или ТипОшибки = "insufficient_quota"
		Или СтрЗаканчиваетсяНа(Код, "_spend_limit_exceeded");

КонецФункции

// Ответ 200, но модель не закончила: оборван на пределе токенов, сбой или ошибка внутри ответа.
Функция ОшибкаНезавершённогоОтвета(Статус, Данные, Ключ)

	Код = "";
	Описание = СтрШаблон(НСтр("ru = 'Ответ не завершён, status: %1'"), СтрокаИлиПусто(Данные["status"]));
	Если ТипЗнч(Данные["error"]) = Тип("Соответствие") Тогда
		Код = СтрокаИлиПусто(Данные["error"]["code"]);
		Описание = Описание + ". " + СкрытьКлючи(СтрокаИлиПусто(Данные["error"]["message"]), Ключ);
	ИначеЕсли ТипЗнч(Данные["incomplete_details"]) = Тип("Соответствие") Тогда
		Код = "incomplete";
		Описание = Описание + ", reason: " + СтрокаИлиПусто(Данные["incomplete_details"]["reason"]);
	КонецЕсли;
	Возврат НоваяОшибка(ВидОшибкиНедоступен(), ПричинаНедоступен(), Код, "", Описание, Статус);

КонецФункции

// Текст ответа модели: части output_text всех сообщений подряд; отказ модели — отдельно.
//
// Возвращаемое значение:
//  Структура:
//   * Текст - Строка, Неопределено - Неопределено, если текста нет.
//   * Отказ - Строка, Неопределено
//
Функция СообщениеМодели(Вывод)

	Результат = Новый Структура("Текст, Отказ");
	Если ТипЗнч(Вывод) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого Элемент Из Вывод Цикл
		Если ТипЗнч(Элемент) <> Тип("Соответствие") Или Элемент["type"] <> "message"
			Или ТипЗнч(Элемент["content"]) <> Тип("Массив") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Часть Из Элемент["content"] Цикл
			Если ТипЗнч(Часть) <> Тип("Соответствие") Тогда
				Продолжить;
			КонецЕсли;
			Если Часть["type"] = "output_text" И ТипЗнч(Часть["text"]) = Тип("Строка") Тогда
				Результат.Текст = ?(Результат.Текст = Неопределено, "", Результат.Текст) + Часть["text"];
			ИначеЕсли Часть["type"] = "refusal" Тогда
				Результат.Отказ = СтрокаИлиПусто(Часть["refusal"]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;

КонецФункции

Функция ТокеныОтвета(Использование)

	Токены = Новый Структура("Вход, ИзКэша, Выход, Рассуждения", 0, 0, 0, 0);
	Если ТипЗнч(Использование) <> Тип("Соответствие") Тогда
		Возврат Токены;
	КонецЕсли;
	Токены.Вход = ЧислоИлиНоль(Использование["input_tokens"]);
	Токены.Выход = ЧислоИлиНоль(Использование["output_tokens"]);
	Если ТипЗнч(Использование["input_tokens_details"]) = Тип("Соответствие") Тогда
		Токены.ИзКэша = ЧислоИлиНоль(Использование["input_tokens_details"]["cached_tokens"]);
	КонецЕсли;
	Если ТипЗнч(Использование["output_tokens_details"]) = Тип("Соответствие") Тогда
		Токены.Рассуждения = ЧислоИлиНоль(Использование["output_tokens_details"]["reasoning_tokens"]);
	КонецЕсли;
	Возврат Токены;

КонецФункции

// Тело ответа как Соответствие или Неопределено, если это не JSON-объект (страница прокси, пустое тело).
Функция ПрочитатьТелоОтвета(Тело)

	Если ПустаяСтрока(Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные, Неопределено);

КонецФункции

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Текст", "");
	Результат.Вставить("Модель", "");
	Результат.Вставить("Токены", Новый Структура("Вход, ИзКэша, Выход, Рассуждения", 0, 0, 0, 0));
	Результат.Вставить("Ошибка", Неопределено);
	Возврат Результат;

КонецФункции

Функция НоваяОшибка(Вид, Причина, Код, ТипОшибки, Описание, КодСостояния)

	Ошибка = Новый Структура;
	Ошибка.Вставить("Вид", Вид);
	Ошибка.Вставить("Причина", Причина);
	Ошибка.Вставить("Код", Код);
	Ошибка.Вставить("Тип", ТипОшибки);
	Ошибка.Вставить("Описание", Описание);
	Ошибка.Вставить("КодСостояния", КодСостояния);
	Возврат Ошибка;

КонецФункции

// Пишет запись об обращении и, если оно не удалось, запись об ошибке. Ни ключа, ни текстов запроса и ответа в записях
// нет: только назначение, модель, статус, время, итог и число токенов.
Процедура ЗаписатьОбращение(Запрос, Ответ, Результат, Ключ)

	Если Ответ = Неопределено Тогда
		Статус = НСтр("ru = 'запрос не отправлен'");
		Секунд = 0;
	ИначеЕсли Ответ.ТекстИсключения <> Неопределено Тогда
		Статус = НСтр("ru = 'нет ответа'");
		Секунд = Ответ.Секунд;
	Иначе
		Статус = "HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0");
		Секунд = Ответ.Секунд;
	КонецЕсли;

	Текст = СтрШаблон("%1: модель %2, %3, %4 с, %5", Запрос.Назначение, Запрос.Модель, Статус,
		Формат(Секунд, "ЧДЦ=2; ЧН=0; ЧГ=0"), ИтогДляЖурнала(Результат));
	Если Результат.Успех Тогда
		Токены = Результат.Токены;
		Текст = Текст + СтрШаблон(". Токены: вход %1 (из кэша %2), выход %3 (рассуждения %4)",
			Формат(Токены.Вход, "ЧН=0; ЧГ=0"), Формат(Токены.ИзКэша, "ЧН=0; ЧГ=0"),
			Формат(Токены.Выход, "ЧН=0; ЧГ=0"), Формат(Токены.Рассуждения, "ЧН=0; ЧГ=0"));
	КонецЕсли;
	Если Ответ <> Неопределено И Не ПустаяСтрока(Ответ.ИдентификаторЗапроса) Тогда
		Текст = Текст + ". Запрос " + Ответ.ИдентификаторЗапроса;
	КонецЕсли;
	ЗаписьЖурналаРегистрации(ИмяСобытияОбращения(), УровеньЖурналаРегистрации.Информация, , ,
		СкрытьКлючи(Текст, Ключ));

	Если Результат.Успех Тогда
		Возврат;
	КонецЕсли;

	Ошибка = Результат.Ошибка;
	ТекстОшибки = СтрШаблон("%1: модель %2, %3, код ""%4"", тип ""%5"": %6. Вид ошибки: %7, причина: %8",
		Запрос.Назначение, Запрос.Модель, Статус, Ошибка.Код, Ошибка.Тип, Ошибка.Описание, Ошибка.Вид, Ошибка.Причина);
	ЗаписьЖурналаРегистрации(ИмяСобытияОшибки(), УровеньЖурналаРегистрации.Ошибка, , , СкрытьКлючи(ТекстОшибки, Ключ));

КонецПроцедуры

Функция ИтогДляЖурнала(Результат)

	Если Результат.Успех Тогда
		Возврат НСтр("ru = 'успех'");
	ИначеЕсли Результат.Ошибка.Вид = ВидОшибкиНеНастроено() Тогда
		Возврат НСтр("ru = 'не настроен'");
	КонецЕсли;
	Возврат НСтр("ru = 'недоступен'");

КонецФункции

Функция ИмяСобытияОбращения()

	Возврат "Б24ТабельИзЗадачи.ИИ";

КонецФункции

Функция ИмяСобытияОшибки()

	Возврат "Б24ТабельИзЗадачи.Ошибка";

КонецФункции

// Буква (латинская или русская), цифра или «_»: перед таким символом «sk-» — часть слова, а не начало ключа.
Функция ЭтоСимволСлова(Символ)

	Возврат НРег(Символ) <> ВРег(Символ) Или СтрНайти("0123456789_", Символ) > 0;

КонецФункции

// Продолжается ли ключ на этой позиции: латиница, цифры, «-», «_», звёздочки и многоточие, которыми OpenAI заменяет
// середину ключа. Точка — только если за ней ключ продолжается («abc...wxyz»), а не кончается предложение.
Функция ПродолжаетКлюч(Текст, Позиция)

	Символ = Сред(Текст, Позиция, 1);
	Если СтрНайти(СимволыКлюча(), Символ) > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	Если Символ = "." Тогда
		Следующий = Сред(Текст, Позиция + 1, 1);
		Возврат Следующий = "." Или (Следующий <> "" И СтрНайти(СимволыКлюча(), Следующий) > 0);
	КонецЕсли;
	Возврат Ложь;

КонецФункции

Функция СимволыКлюча()

	Возврат "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_*…";

КонецФункции

Функция СтрокаИлиПусто(Значение)

	Возврат ?(Значение = Неопределено, "", Строка(Значение));

КонецФункции

Функция ЧислоИлиНоль(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Число"), Значение, 0);

КонецФункции

#КонецОбласти
