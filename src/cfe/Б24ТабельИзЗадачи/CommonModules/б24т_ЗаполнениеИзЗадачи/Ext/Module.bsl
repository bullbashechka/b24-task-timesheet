#Область ПрограммныйИнтерфейс

// Типы времени, которые можно выбрать в окне «Заполнить из задачи Битрикс24» (Ф4): значения перечисления «Типы времени»,
// название которых начинается с «Клиент» или «Офис», в порядке перечисления, кроме «Офис (командировка)» и
// «Офис (собрания)» — при этих типах табель не допускает контрагента.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.гем_ТипыВремени
//
Функция ТипыВремениОкна() Экспорт

	Типы = Новый Массив;
	Для Каждого Значение Из Метаданные.Перечисления.гем_ТипыВремени.ЗначенияПеречисления Цикл
		Если Значение.Имя = "ОфисКомандировка" Или Значение.Имя = "ОфисСобрания" Тогда
			Продолжить;
		КонецЕсли;
		Ссылка = Перечисления.гем_ТипыВремени[Значение.Имя];
		Название = Строка(Ссылка);
		Если СтрНачинаетсяС(Название, "Клиент") Или СтрНачинаетсяС(Название, "Офис") Тогда
			Типы.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Типы;

КонецФункции

// Тип времени в окне по умолчанию: «Клиент (УД)».
//
// Возвращаемое значение:
//  ПеречислениеСсылка.гем_ТипыВремени
//
Функция ТипВремениПоУмолчанию() Экспорт

	Возврат Перечисления.гем_ТипыВремени.КлиентУдаленныйДоступ;

КонецФункции

// Доступен ли ИИ в окне (Ф9, Ф13): флажок «Использовать ИИ» включён, ключ сохранён и база не заблокирована как копия.
// Окно читает признак один раз при создании; ключ на клиент не передаётся. Формы не вызывают б24т_Настройки
// (scripts/security-check.sh), поэтому признак отдаёт этот модуль.
//
// Возвращаемое значение:
//  Булево
//
Функция ИИДоступен() Экспорт

	Возврат б24т_Настройки.Настройки().ИИДоступен;

КонецФункции

// Передаёт ли ИИ комментарии задачи (Ф15): ИИ доступен и включён флажок «Передавать ИИ комментарии задачи». По нему
// окно при создании выбирает подсказку кнопки ИИ; сама операция читает флажок заново при каждом нажатии (8А).
//
// Возвращаемое значение:
//  Булево
//
Функция КомментарииПередаютсяИИ() Экспорт

	Возврат ИИДоступен() И б24т_Настройки.НастройкиЗапросаИИ().ПередаватьКомментарии;

КонецФункции

// Подсказка кнопки «Заполнить с помощью ИИ» (Ф9): второй вариант — когда ИИ получает и комментарии задачи.
//
// Параметры:
//  Комментарии - Булево - см. КомментарииПередаютсяИИ.
//
// Возвращаемое значение:
//  Строка
//
Функция ПодсказкаКнопкиИИ(Комментарии) Экспорт

	Если Комментарии Тогда
		Возврат НСтр("ru = 'ИИ составит содержание по задаче, её комментариям и тексту в поле. Можно заранее набрать, что сделано: версию, фамилию, название базы'");
	КонецЕсли;
	Возврат НСтр("ru = 'ИИ составит содержание по задаче и тексту в поле. Можно заранее набрать, что сделано: версию, фамилию, название базы'");

КонецФункции

#КонецОбласти
