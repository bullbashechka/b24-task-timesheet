#Область ПрограммныйИнтерфейс

// Типы времени, которые можно выбрать в окне «Заполнить из задачи Битрикс24» (Ф4): значения перечисления «Типы времени»,
// название которых начинается с «Клиент» или «Офис», в порядке перечисления, кроме «Офис (командировка)» и
// «Офис (собрания)» — при этих типах табель не допускает контрагента.
//
// Возвращаемое значение:
//  Массив из ПеречислениеСсылка.гем_ТипыВремени
//
Функция ТипыВремениОкна() Экспорт

	Типы = Новый Массив;
	Для Каждого Значение Из Метаданные.Перечисления.гем_ТипыВремени.ЗначенияПеречисления Цикл
		Если Значение.Имя = "ОфисКомандировка" Или Значение.Имя = "ОфисСобрания" Тогда
			Продолжить;
		КонецЕсли;
		Ссылка = Перечисления.гем_ТипыВремени[Значение.Имя];
		Название = Строка(Ссылка);
		Если СтрНачинаетсяС(Название, "Клиент") Или СтрНачинаетсяС(Название, "Офис") Тогда
			Типы.Добавить(Ссылка);
		КонецЕсли;
	КонецЦикла;
	Возврат Типы;

КонецФункции

// Тип времени в окне по умолчанию: «Клиент (УД)».
//
// Возвращаемое значение:
//  ПеречислениеСсылка.гем_ТипыВремени
//
Функция ТипВремениПоУмолчанию() Экспорт

	Возврат Перечисления.гем_ТипыВремени.КлиентУдаленныйДоступ;

КонецФункции

#КонецОбласти
