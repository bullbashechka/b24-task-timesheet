#Область ПрограммныйИнтерфейс

// Строка, по которой ищут задачу в списке окна: номер, перевод строки и название в нормализованном виде.
// Перевод строки не даёт найти текст на стыке номера и названия.
//
// Параметры:
//  Номер - Число
//  Название - Строка
//
// Возвращаемое значение:
//  Строка
//
Функция КлючСтроки(Номер, Название) Экспорт

	Возврат Формат(Номер, "ЧГ=0") + Символы.ПС + НормализованныйТекст(Название);

КонецФункции

// Подходит ли строка списка под текст поиска: вхождение без учёта регистра, «е» и «ё» не различаются.
// Поиск обрезается до МаксимальнаяДлинаПоиска; пустой поиск подходит всем строкам.
//
// Параметры:
//  КлючСтроки - Строка - см. КлючСтроки
//  ТекстПоиска - Строка, Неопределено
//
// Возвращаемое значение:
//  Булево
//
Функция ПодходитПодПоиск(КлючСтроки, ТекстПоиска) Экспорт

	Если ТипЗнч(ТекстПоиска) <> Тип("Строка") Тогда
		Возврат Истина;
	КонецЕсли;

	Поиск = НормализованныйТекст(Лев(ТекстПоиска, МаксимальнаяДлинаПоиска()));
	Возврат Поиск = "" Или СтрНайти(КлючСтроки, Поиск) > 0;

КонецФункции

// Порядок строк списка для Сортировать() таблицы значений и данных формы.
//
// Параметры:
//  Вид - Строка - «Активность» (по умолчанию), «КрайнийСрок» или «Номер».
//
// Возвращаемое значение:
//  Строка
//
Функция ПорядокСортировки(Вид) Экспорт

	Если Вид = "КрайнийСрок" Тогда
		Возврат "КлючСрока Возр, Номер Убыв";
	ИначеЕсли Вид = "Номер" Тогда
		Возврат "Номер Убыв";
	КонецЕсли;
	Возврат "Активность Убыв, Номер Убыв";

КонецФункции

// Текст в списке, когда под поиск ничего не подошло (Ф3).
Функция ТекстНичегоНеНайдено() Экспорт

	Возврат НСтр("ru = 'Ничего не найдено. Введите номер или ссылку на задачу.'");

КонецФункции

// Длина поиска по списку: длиннее не нужно, лишнее отбрасывается.
Функция МаксимальнаяДлинаПоиска() Экспорт

	Возврат 100;

КонецФункции

// Длина поля «номер / ссылка на задачу»: ссылка Битрикс24 заметно короче.
Функция МаксимальнаяДлинаНомера() Экспорт

	Возврат 300;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НормализованныйТекст(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Результат = СтрЗаменить(СтрЗаменить(Текст, Символы.ПС, " "), Символы.ВК, " ");
	Возврат СтрЗаменить(НРег(СокрЛП(Результат)), "ё", "е");

КонецФункции

#КонецОбласти
