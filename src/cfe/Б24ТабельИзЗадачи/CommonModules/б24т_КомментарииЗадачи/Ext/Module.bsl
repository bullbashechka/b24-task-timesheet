// Комментарии задачи для ИИ (Ф15): чтение чата задачи Битрикс24 и отбор сообщений. Модуль только читает: единственный
// метод — im.dialog.messages.get; в чат ничего не пишется и прочитанным не отмечается. Чистка текста, пароли и пределы
// символов — в б24т_СодержаниеИИ.КомментарииДляИИ: здесь отбираются сообщения и ставятся пометки.

#Область ПрограммныйИнтерфейс

// Сколько последних сообщений чата просматривается (Ф15): более ранние не передаются.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумСообщений() Экспорт

	Возврат 200;

КонецФункции

// Читает комментарии задачи из её чата: порции по 50 от новых к старым через LAST_ID, не больше 200 сообщений. Срок
// общий с проверкой задачи: клиент тот же, с его СрокОкончания (Ф9, 15 секунд).
//
// Отбор (Ф15, решения этапа 23): системные сообщения (автор 0), удалённые и сообщения ботов не передаются; сообщения,
// написанные после дня табеля, тоже. Сообщение дня табеля помечено «за день», сообщение самого сотрудника — «свой».
// День считается по времени 1С: дата Битрикс24 переводится смещением 1С от UTC (б24т_Задачи.ДатаБитрикс24).
//
// Параметры:
//  Клиент - Структура - клиент Битрикс24 (б24т_Битрикс24.НовыйКлиент), которым читалась задача.
//  Задача - Соответствие - ответ tasks.task.get с полем chatId.
//  ДатаТабеля - Дата
//  ИДСотрудника - Число - номер сотрудника в Битрикс24; в результат не попадает.
//  Смещение - Число, Неопределено - секунд от UTC; по умолчанию смещение сеанса 1С (б24т_Задачи.СмещениеВремени).
//
// Возвращаемое значение:
//  Структура:
//   * Получены - Булево - Ложь: комментарии получить не удалось (нет права, отказ в доступе к чату, Битрикс24 не
//     ответил, истёк срок, в ответе о задаче нет номера чата). У задачи без чата — Истина: комментариев просто нет.
//   * Оборвано - Булево - первая порция пришла, следующая — нет: передаётся то, что получено.
//   * НеВсе - Булево - просмотрены не все сообщения чата (предел 200 или обрыв).
//   * Причина - Строка - для журнала регистрации: вид ошибки, код и HTTP-статус, без текстов.
//   * Сообщения - Массив из Структура - от старых к новым:
//    ** Текст - Строка - как в Битрикс24, с оформлением.
//    ** ЗаДень - Булево - написан в день табеля.
//    ** Свой - Булево - написан самим сотрудником.
//
Функция КомментарииЗадачи(Клиент, Задача, ДатаТабеля, ИДСотрудника, Смещение = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Получены", Ложь);
	Результат.Вставить("Оборвано", Ложь);
	Результат.Вставить("НеВсе", Ложь);
	Результат.Вставить("Причина", "");
	Результат.Вставить("Сообщения", Новый Массив);

	Чат = НомерЧата(Задача);
	Если Чат = Неопределено Тогда
		// Поля нет — сломался запрос задачи: администратор должен это увидеть, а не получить тексты без комментариев.
		Результат.Причина = НСтр("ru = 'в ответе Битрикс24 нет номера чата задачи'");
		Возврат Результат;
	КонецЕсли;
	Если Чат = 0 Тогда
		Результат.Получены = Истина;
		Возврат Результат;
	КонецЕсли;

	Полученные = Новый Массив;
	Боты = Новый Соответствие;
	ПоследнийИД = 0;
	Пока Полученные.Количество() < МаксимумСообщений() Цикл
		Параметры = Новый Структура;
		Параметры.Вставить("DIALOG_ID", "chat" + Формат(Чат, "ЧГ=0"));
		Параметры.Вставить("LIMIT", РазмерПорции());
		Если ПоследнийИД > 0 Тогда
			Параметры.Вставить("LAST_ID", ПоследнийИД);
		КонецЕсли;
		Ответ = б24т_Битрикс24.Вызвать(Клиент, "im.dialog.messages.get", Параметры);
		Если Не Ответ.Успех Тогда
			Результат.Причина = ПричинаОшибки(Ответ.Ошибка);
			Если Полученные.Количество() > 0 Тогда
				Результат.Оборвано = Истина;
				Результат.НеВсе = Истина;
			КонецЕсли;
			Прервать;
		КонецЕсли;
		Порция = СообщенияОтвета(Ответ.Результат, Боты);
		Для Каждого Сообщение Из Порция Цикл
			Полученные.Добавить(Сообщение);
		КонецЦикла;
		Если Порция.Количество() < РазмерПорции() Тогда
			Прервать;
		КонецЕсли;
		ПоследнийИД = НаименьшийИД(Порция);
		Если ПоследнийИД = 0 Тогда
			Прервать;
		КонецЕсли;
		Если Полученные.Количество() >= МаксимумСообщений() Тогда
			Результат.НеВсе = Истина;
		КонецЕсли;
	КонецЦикла;

	// Битрикс24 отдаёт больше LIMIT, если в чате есть непрочитанные: лишние старые сообщения не берутся.
	Если Полученные.Количество() > МаксимумСообщений() Тогда
		Результат.НеВсе = Истина;
	КонецЕсли;
	Результат.Получены = Полученные.Количество() > 0 Или ПустаяСтрока(Результат.Причина);
	Если Смещение = Неопределено Тогда
		Смещение = б24т_Задачи.СмещениеВремени();
	КонецЕсли;
	Результат.Сообщения = ОтобранныеСообщения(Полученные, Боты, ДатаТабеля, ИДСотрудника, Смещение);
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РазмерПорции()

	Возврат 50;

КонецФункции

// Номер чата задачи: Число; 0 — у задачи нет чата (null или 0); Неопределено — поля chatId в ответе нет.
Функция НомерЧата(Задача)

	Если ТипЗнч(Задача) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	ЕстьПоле = Ложь;
	Для Каждого Поле Из Задача Цикл
		Если Поле.Ключ = "chatId" Тогда
			ЕстьПоле = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьПоле Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЧислоИзЗначения(Задача["chatId"]);

КонецФункции

// Сообщения порции в порядке ответа (новые первыми); боты из users запоминаются в Боты.
Функция СообщенияОтвета(Результат, Боты)

	Сообщения = Новый Массив;
	Если ТипЗнч(Результат) <> Тип("Соответствие") Тогда
		Возврат Сообщения;
	КонецЕсли;
	// «Пользователи» — общий модуль БСП: так локальную переменную назвать нельзя.
	Участники = Результат["users"];
	Если ТипЗнч(Участники) = Тип("Массив") Тогда
		Для Каждого Участник Из Участники Цикл
			Если ТипЗнч(Участник) = Тип("Соответствие") И Участник["bot"] = Истина Тогда
				Боты.Вставить(ЧислоИзЗначения(Участник["id"]), Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Список = Результат["messages"];
	Если ТипЗнч(Список) = Тип("Массив") Тогда
		Для Каждого Сообщение Из Список Цикл
			Если ТипЗнч(Сообщение) = Тип("Соответствие") Тогда
				Сообщения.Добавить(Сообщение);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Сообщения;

КонецФункции

Функция НаименьшийИД(Порция)

	Наименьший = 0;
	Для Каждого Сообщение Из Порция Цикл
		ИД = ЧислоИзЗначения(Сообщение["id"]);
		Если ИД > 0 И (Наименьший = 0 Или ИД < Наименьший) Тогда
			Наименьший = ИД;
		КонецЕсли;
	КонецЦикла;
	Возврат Наименьший;

КонецФункции

// Комментарии от старых к новым: только текст и пометки. Полученные идут от новых к старым (порядок ответа).
Функция ОтобранныеСообщения(Полученные, Боты, ДатаТабеля, ИДСотрудника, Смещение)

	НачалоДняТабеля = НачалоДня(ДатаТабеля);
	КонецДняТабеля = КонецДня(ДатаТабеля);
	Отобранные = Новый Массив;
	Просмотреть = Мин(Полученные.Количество(), МаксимумСообщений());
	Для Номер = 1 По Просмотреть Цикл
		Сообщение = Полученные[Просмотреть - Номер];
		Автор = ЧислоИзЗначения(Сообщение["author_id"]);
		Если Автор = 0 Или Боты[Автор] = Истина Или Удалено(Сообщение) Тогда
			Продолжить;
		КонецЕсли;
		Написано = б24т_Задачи.ДатаБитрикс24(Сообщение["date"], Смещение);
		Если Не ЗначениеЗаполнено(Написано) Или Написано > КонецДняТабеля Тогда
			Продолжить;
		КонецЕсли;
		Текст = Сообщение["text"];
		Комментарий = Новый Структура;
		Комментарий.Вставить("Текст", ?(ТипЗнч(Текст) = Тип("Строка"), Текст, ""));
		Комментарий.Вставить("ЗаДень", Написано >= НачалоДняТабеля);
		Комментарий.Вставить("Свой", Автор = ИДСотрудника);
		Отобранные.Добавить(Комментарий);
	КонецЦикла;
	Возврат Отобранные;

КонецФункции

// У удалённого сообщения params.IS_DELETED = «Y»; params бывает и пустым массивом, и объектом.
Функция Удалено(Сообщение)

	Параметры = Сообщение["params"];
	Возврат ТипЗнч(Параметры) = Тип("Соответствие") И Параметры["IS_DELETED"] = "Y";

КонецФункции

Функция ЧислоИзЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Если ТипЗнч(Значение) = Тип("Строка") И Значение <> "" Тогда
		Цифры = СтрЗаменить(СокрЛП(Значение), " ", "");
		Для Позиция = 1 По СтрДлина(Цифры) Цикл
			Если СтрНайти("0123456789", Сред(Цифры, Позиция, 1)) = 0 Тогда
				Возврат 0;
			КонецЕсли;
		КонецЦикла;
		Возврат ?(Цифры = "", 0, Число(Цифры));
	КонецЕсли;
	Возврат 0;

КонецФункции

// Причина для журнала регистрации: вид ошибки, код Битрикс24 и HTTP-статус, без описания (в нём может быть текст).
Функция ПричинаОшибки(Ошибка)

	Если Ошибка = Неопределено Тогда
		Возврат НСтр("ru = 'неизвестная ошибка'");
	КонецЕсли;
	Части = Новый Массив;
	Части.Добавить(Ошибка.Вид);
	Если Не ПустаяСтрока(Ошибка.Код) Тогда
		Части.Добавить(Ошибка.Код);
	КонецЕсли;
	Части.Добавить(?(Ошибка.КодСостояния = 0, НСтр("ru = 'нет ответа'"), "HTTP " + Формат(Ошибка.КодСостояния, "ЧГ=0")));
	Возврат СтрСоединить(Части, ", ");

КонецФункции

#КонецОбласти
