#Область ПрограммныйИнтерфейс

// Отправляет POST с JSON на адрес запроса и возвращает код состояния и тело ответа.
// Единственное место расширения, где есть HTTP-соединение. Исключения платформы не обрабатывает:
// их текст может содержать адрес вебхука, поэтому его маскирует вызывающий модуль б24т_Битрикс24.
//
// Параметры:
//  Запрос - Структура:
//   * Адрес - Строка - https://‹портал›/rest/‹номер›/‹ключ›/‹метод›.json
//   * Тело - Строка - JSON.
//   * Таймаут - Число - секунд.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число
//   * Тело - Строка
//
Функция ВыполнитьЗапрос(Запрос) Экспорт

	НачалоПути = СтрНайти(Запрос.Адрес, "/", НаправлениеПоиска.СНачала, 9);
	Сервер = Сред(Запрос.Адрес, 9, НачалоПути - 9);
	Путь = Сред(Запрос.Адрес, НачалоПути);

	// Без второго параметра сертификат сервера не проверялся бы.
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС);
	Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
	Соединение = Новый HTTPСоединение(Сервер, , , , Прокси, Запрос.Таймаут, ЗащищенноеСоединение);

	HTTPЗапрос = Новый HTTPЗапрос(Путь);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(Запрос.Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	// ОтправитьДляОбработки — это POST. Переадресацию платформа не выполняет: 3xx разбирает вызывающий модуль.
	HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", HTTPОтвет.КодСостояния);
	Результат.Вставить("Тело", HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Возврат Результат;

КонецФункции

#КонецОбласти
