#Область ПрограммныйИнтерфейс

// Список задач сотрудника для окна «Заполнить из задачи Битрикс24» (Ф3). Сначала выполняются проверки доступа Ф2
// (б24т_Доступ.ПроверитьДоступ), затем задачи загружаются из Битрикс24 двумя запросами: «постановщик или исполнитель»
// и «соисполнитель» (они не объединяются в один: условие «соисполнитель» внутри «или» теряет задачи без соисполнителей).
// Вебхук видит и чужие задачи, поэтому роль и проект каждой задачи перепроверяются здесь. Номер сотрудника в Битрикс24
// определяется проверкой доступа, а не берётся из данных формы, и в результат не попадает.
//
// Параметры:
//  Сотрудник - СправочникСсылка.ФизическиеЛица - сотрудник из данных формы табеля.
//  ДатаТабеля - Дата - дата табеля из данных формы; от неё считаются 30 дней.
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - только тесты, см. б24т_Доступ.ПроверитьПодменуДляТестов.
//  Клиент - Структура, Неопределено - только тесты.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * ОтказВДоступе - Булево - не прошла проверка Ф2: окно показывает только сообщение.
//   * Сообщение - Строка - при неудаче; список при этом пуст.
//   * Задачи - Массив из Структура - см. СтрокаСписка, по убыванию активности. Контрагент каждой задачи определён (Ф6).
//   * Усечено - Булево - достигнут предел выборки.
//   * Предупреждение - Строка - текст над списком при усечении.
//   * Подпись - Строка - подпись под списком.
//   * НадписьРежимаТестирования - Строка - только в режиме тестирования.
//
Функция СписокЗадач(Сотрудник, ДатаТабеля, Пользователь = Неопределено, Клиент = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("ОтказВДоступе", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Задачи", Новый Массив);
	Результат.Вставить("Усечено", Ложь);
	Результат.Вставить("Предупреждение", "");
	Результат.Вставить("Подпись", "");
	Результат.Вставить("НадписьРежимаТестирования", "");

	Доступ = б24т_Доступ.ПроверитьДоступ(Сотрудник, Пользователь, Клиент);
	Если Не Доступ.Успех Тогда
		Результат.ОтказВДоступе = Истина;
		Результат.Сообщение = Доступ.Сообщение;
		Возврат Результат;
	КонецЕсли;
	Контекст = Доступ.Контекст;

	Если Клиент = Неопределено Тогда
		Клиент = б24т_Битрикс24.НовыйКлиент();
	КонецЕсли;
	б24т_Битрикс24.УстановитьПределВремени(Клиент, ПределВремениЗагрузки());

	ДатаОтсчёта = ?(ТипЗнч(ДатаТабеля) = Тип("Дата") И ЗначениеЗаполнено(ДатаТабеля), ДатаТабеля, ТекущаяДатаСеанса());
	Граница = ГраницаЗавершения(ДатаОтсчёта);
	Смещение = СмещениеВремени();

	Загруженные = Новый Соответствие;
	Для НомерЗапроса = 1 По 2 Цикл
		Ответ = б24т_Битрикс24.ВызватьВсеСтраницы(Клиент, "tasks.task.list",
			ПараметрыСписка(НомерЗапроса, Контекст, Граница), "tasks");
		Если Не Ответ.Успех Тогда
			Результат.Сообщение = б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка);
			Возврат Результат;
		КонецЕсли;
		Результат.Усечено = Результат.Усечено Или Ответ.Усечено;
		Для Каждого Задача Из Ответ.Результат Цикл
			Если ТипЗнч(Задача) = Тип("Соответствие") И Загруженные[ТекстЗначения(Задача["id"])] = Неопределено Тогда
				Загруженные.Вставить(ТекстЗначения(Задача["id"]), Задача);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Подходящие = Новый Массив;
	Для Каждого Пара Из Загруженные Цикл
		Задача = Пара.Значение;
		Если ДопускЗадачи(Задача, Контекст).Допущена И ПопадаетВСписок(Задача, Граница, Смещение) Тогда
			Подходящие.Добавить(Задача);
		КонецЕсли;
	КонецЦикла;

	Компании = НазванияКомпаний(Клиент, Подходящие);
	Если Не Компании.Успех Тогда
		Результат.Сообщение = Компании.Сообщение;
		Возврат Результат;
	КонецЕсли;
	Названия = Компании.Названия;

	// Контрагенты только для задач, которые остались в списке: чужим задачам компания и реквизиты не запрашиваются.
	Контрагенты = б24т_Контрагенты.КонтрагентыЗадач(Клиент, Подходящие, Названия);
	Если Не Контрагенты.Успех Тогда
		Результат.Сообщение = Контрагенты.Сообщение;
		Возврат Результат;
	КонецЕсли;

	Строки = Новый Массив;
	Для Каждого Задача Из Подходящие Цикл
		Строки.Добавить(СтрокаСписка(Задача, Контекст.ИДПользователя, Названия, Смещение,
			Контрагенты.Контрагенты[НомерЗадачи(Задача)]));
	КонецЦикла;

	Результат.Задачи = Отсортированные(Строки, "Активность");
	Результат.Подпись = ПодписьСписка(ДатаОтсчёта);
	Если Результат.Усечено Тогда
		Результат.Предупреждение = НСтр("ru = 'Показаны не все задачи. Если нужной нет, введите её номер или ссылку'");
	КонецЕсли;
	Если Контекст.РежимТестирования Тогда
		Результат.НадписьРежимаТестирования = НадписьРежимаТестирования(Контекст.НазваниеПроекта);
	КонецЕсли;
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Выбор задачи по номеру или ссылке (Ф3). Порядок проверок: разбор ввода, доступ Ф2, существование задачи,
// проект в режиме тестирования (Ф8), роль сотрудника (Ф2). Правило «30 дней» здесь не действует.
// Название и компания чужой задачи (где сотрудник не участвует) не возвращаются. Вызывается и при добавлении
// строки в табель: номер задачи из данных формы на веру не принимается.
//
// Параметры:
//  Сотрудник - СправочникСсылка.ФизическиеЛица - сотрудник из данных формы табеля.
//  Текст - Строка - ввод сотрудника: номер или ссылка на карточку задачи.
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - только тесты.
//  Клиент - Структура, Неопределено - только тесты.
//
// Возвращаемое значение:
//  Структура:
//   * Итог - Строка - «Выбрана», «Отклонена» (сообщение про ввод или задачу) или «Ошибка» (проверка Ф2, Битрикс24).
//   * Сообщение - Строка
//   * Номер - Число - разобранный номер, 0, если ввод не разобран.
//   * Задача - Неопределено, Структура:
//    ** Номер - Число
//    ** Название - Строка
//    ** МояРоль - Строка
//    ** Контрагент - СправочникСсылка.Контрагенты - пустая ссылка, если контрагент не определён (Ф6).
//    ** БИН - Строка - номер компании, пусто, если его нет.
//    ** ТекстКонтрагента - Строка - «найден в 1С по БИН ‹номер›» или причина по Ф6.
//
Функция ЗадачаПоНомеру(Сотрудник, Текст, Пользователь = Неопределено, Клиент = Неопределено) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Итог", "Отклонена");
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Номер", 0);
	Результат.Вставить("Задача", Неопределено);

	Номер = РазобратьНомерИлиСсылку(Текст);
	Если Номер = 0 Тогда
		Результат.Сообщение = НСтр("ru = 'Введите номер задачи или ссылку на задачу Битрикс24'");
		Возврат Результат;
	КонецЕсли;
	Результат.Номер = Номер;

	Доступ = б24т_Доступ.ПроверитьДоступ(Сотрудник, Пользователь, Клиент);
	Если Не Доступ.Успех Тогда
		Результат.Итог = "Ошибка";
		Результат.Сообщение = Доступ.Сообщение;
		Возврат Результат;
	КонецЕсли;

	Если Клиент = Неопределено Тогда
		Клиент = б24т_Битрикс24.НовыйКлиент();
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("taskId", Номер);
	Параметры.Вставить("select", ПоляЗадачи());
	Ответ = б24т_Битрикс24.Вызвать(Клиент, "tasks.task.get", Параметры);
	Если Не Ответ.Успех Тогда
		Результат.Итог = "Ошибка";
		Результат.Сообщение = б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка);
		Возврат Результат;
	КонецЕсли;

	// Несуществующая задача приходит как result: [] без ошибки.
	Задача = ?(ТипЗнч(Ответ.Результат) = Тип("Соответствие"), Ответ.Результат["task"], Неопределено);
	Если ТипЗнч(Задача) <> Тип("Соответствие") Или ТекстЗначения(Задача["id"]) <> Формат(Номер, "ЧГ=0") Тогда
		Результат.Сообщение = СтрШаблон(НСтр("ru = 'Задача №%1 не найдена в Битрикс24'"), Формат(Номер, "ЧГ=0"));
		Возврат Результат;
	КонецЕсли;

	Допуск = ДопускЗадачи(Задача, Доступ.Контекст);
	Если Не Допуск.Допущена Тогда
		Результат.Сообщение = Допуск.Сообщение;
		Возврат Результат;
	КонецЕсли;

	// Компания и реквизиты запрашиваются только для допущенной задачи.
	Компании = НазванияКомпаний(Клиент, СтрокаВМассив(Задача));
	Если Не Компании.Успех Тогда
		Результат.Итог = "Ошибка";
		Результат.Сообщение = Компании.Сообщение;
		Возврат Результат;
	КонецЕсли;
	Контрагенты = б24т_Контрагенты.КонтрагентыЗадач(Клиент, СтрокаВМассив(Задача), Компании.Названия);
	Если Не Контрагенты.Успех Тогда
		Результат.Итог = "Ошибка";
		Результат.Сообщение = Контрагенты.Сообщение;
		Возврат Результат;
	КонецЕсли;
	Контрагент = Контрагенты.Контрагенты[НомерЗадачи(Задача)];

	Результат.Итог = "Выбрана";
	Результат.Задача = Новый Структура;
	Результат.Задача.Вставить("Номер", Номер);
	Результат.Задача.Вставить("Название", ТекстЗначения(Задача["title"]));
	Результат.Задача.Вставить("МояРоль", ПредставлениеРолей(Допуск.Роли));
	Результат.Задача.Вставить("Контрагент", Контрагент.Контрагент);
	Результат.Задача.Вставить("БИН", Контрагент.БИН);
	Результат.Задача.Вставить("ТекстКонтрагента", Контрагент.Текст);
	Возврат Результат;

КонецФункции

// Смещение местного времени 1С относительно UTC в секундах (с точностью до 15 минут). Время Битрикс24 переводится
// этим же сдвигом, которым 1С отличает «сейчас» от UTC, поэтому результат не зависит от базы часовых поясов платформы.
//
// Возвращаемое значение:
//  Число
//
Функция СмещениеВремени() Экспорт

	Разница = ТекущаяДатаСеанса() - ТекущаяУниверсальнаяДата();
	Возврат Окр(Разница / 900, 0, РежимОкругления.Окр15как20) * 900;

КонецФункции

// Дата из ответа Битрикс24 («2026-10-15T20:40:55+05:00») в местном времени, сдвинутом на Смещение от UTC.
//
// Параметры:
//  Значение - Строка, Null, Неопределено - значение поля.
//  Смещение - Число - секунд от UTC, на которые сдвигается результат.
//
// Возвращаемое значение:
//  Дата - пустая дата, если значение не разобрано.
//
Функция ДатаБитрикс24(Значение, Смещение) Экспорт

	Пустая = Дата(1, 1, 1);
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Пустая;
	КонецЕсли;

	Текст = СокрЛП(Значение);
	Если СтрДлина(Текст) < 19 Тогда
		Возврат Пустая;
	КонецЕсли;
	Если Сред(Текст, 5, 1) <> "-" Или Сред(Текст, 8, 1) <> "-" Или Сред(Текст, 14, 1) <> ":" Или Сред(Текст, 17, 1) <> ":"
		Или (Сред(Текст, 11, 1) <> "T" И Сред(Текст, 11, 1) <> " ") Тогда
		Возврат Пустая;
	КонецЕсли;

	Цифры = Лев(Текст, 4) + Сред(Текст, 6, 2) + Сред(Текст, 9, 2) + Сред(Текст, 12, 2) + Сред(Текст, 15, 2) + Сред(Текст, 18, 2);
	Если Не СостоитИзЦифр(Цифры) Тогда
		Возврат Пустая;
	КонецЕсли;

	Попытка
		ДатаИсточника = Дата(Цифры);
	Исключение
		Возврат Пустая;
	КонецПопытки;

	Пояс = Сред(Текст, 20);
	Если Лев(Пояс, 1) = "." Тогда
		Позиция = 2;
		Пока Позиция <= СтрДлина(Пояс) И СтрНайти("0123456789", Сред(Пояс, Позиция, 1)) > 0 Цикл
			Позиция = Позиция + 1;
		КонецЦикла;
		Пояс = Сред(Пояс, Позиция);
	КонецЕсли;

	Если Пояс = "" Тогда
		Возврат ДатаИсточника;
	КонецЕсли;
	СекундыПояса = СекундыПояса(Пояс);
	Если СекундыПояса = Неопределено Тогда
		Возврат Пустая;
	КонецЕсли;
	Возврат ДатаИсточника - СекундыПояса + Смещение;

КонецФункции

// Роли пользователя в задаче: постановщик, исполнитель, соисполнитель (в таком порядке). Наблюдатель ролью не считается.
// Поля *Data не используются: у задачи без таких участников Битрикс24 присылает вместо объекта пустой массив.
//
// Параметры:
//  Задача - Соответствие - задача из ответа Битрикс24.
//  ИДПользователя - Число
//
// Возвращаемое значение:
//  Массив из Строка - строчными буквами.
//
Функция РолиВЗадаче(Задача, ИДПользователя) Экспорт

	Роли = Новый Массив;
	ИД = Формат(ИДПользователя, "ЧГ=0");

	Если ТекстЗначения(Задача["createdBy"]) = ИД Тогда
		Роли.Добавить("постановщик");
	КонецЕсли;
	Если ТекстЗначения(Задача["responsibleId"]) = ИД Тогда
		Роли.Добавить("исполнитель");
	КонецЕсли;

	Соисполнители = Задача["accomplices"];
	Если ТипЗнч(Соисполнители) = Тип("Массив") Тогда
		Для Каждого Соисполнитель Из Соисполнители Цикл
			Если ТекстЗначения(Соисполнитель) = ИД Тогда
				Роли.Добавить("соисполнитель");
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Возврат Роли;

КонецФункции

// Роли для колонки «Моя роль»: через запятую, первая буква заглавная.
//
// Параметры:
//  Роли - Массив из Строка - см. РолиВЗадаче
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеРолей(Роли) Экспорт

	Текст = СтрСоединить(Роли, ", ");
	Возврат ВРег(Лев(Текст, 1)) + Сред(Текст, 2);

КонецФункции

// Название статуса по коду для колонки «Статус». Битрикс24 присылает только код. Незнакомый код показывается как есть.
//
// Параметры:
//  Код - Строка, Число
//
// Возвращаемое значение:
//  Строка
//
Функция НазваниеСтатуса(Код) Экспорт

	Ключ = ТекстЗначения(Код);
	Названия = Новый Соответствие;
	Названия.Вставить("1", НСтр("ru = 'Новая'"));
	Названия.Вставить("2", НСтр("ru = 'Ждёт выполнения'"));
	Названия.Вставить("3", НСтр("ru = 'Выполняется'"));
	Названия.Вставить("4", НСтр("ru = 'Ждёт контроля'"));
	Названия.Вставить("5", НСтр("ru = 'Завершена'"));
	Названия.Вставить("6", НСтр("ru = 'Отложена'"));
	Названия.Вставить("7", НСтр("ru = 'Отклонена'"));
	Название = Названия[Ключ];
	Возврат ?(Название = Неопределено, Ключ, Название);

КонецФункции

// Номера компаний CRM из «Элементов CRM» задачи (UF_CRM_TASK = ["CO_<id>", "D_<id>", …]). Сделки, контакты и другие
// элементы не учитываются.
//
// Параметры:
//  Задача - Соответствие
//
// Возвращаемое значение:
//  Массив из Число - без повторов, в порядке следования.
//
Функция ИДКомпанийЗадачи(Задача) Экспорт

	Результат = Новый Массив;
	Элементы = Задача["ufCrmTask"];
	Если ТипЗнч(Элементы) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;

	Известные = Новый Соответствие;
	Для Каждого Элемент Из Элементы Цикл
		Если ТипЗнч(Элемент) <> Тип("Строка") Или Не СтрНачинаетсяС(Элемент, "CO_") Тогда
			Продолжить;
		КонецЕсли;
		Цифры = Сред(Элемент, 4);
		Если Не СостоитИзЦифр(Цифры) Или СтрДлина(Цифры) > 10 Тогда
			Продолжить;
		КонецЕсли;
		ИД = Число(Цифры);
		Если ИД <= 0 Или Известные[ИД] <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Известные.Вставить(ИД, Истина);
		Результат.Добавить(ИД);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Компании задачи, которые есть в CRM: компания, которой нет среди Названия, удалена и не считается. Это правило общее
// для колонки «Компания CRM» и для определения контрагента (Ф6).
//
// Параметры:
//  ИДКомпаний - Массив из Число - см. ИДКомпанийЗадачи
//  Названия - Соответствие - номер компании (Число) в название.
//
// Возвращаемое значение:
//  Массив из Число
//
Функция СуществующиеКомпании(ИДКомпаний, Названия) Экспорт

	Существующие = Новый Массив;
	Для Каждого ИД Из ИДКомпаний Цикл
		Если Названия[ИД] <> Неопределено Тогда
			Существующие.Добавить(ИД);
		КонецЕсли;
	КонецЦикла;
	Возврат Существующие;

КонецФункции

// Номер задачи из ответа Битрикс24.
//
// Параметры:
//  Задача - Соответствие
//
// Возвращаемое значение:
//  Число - 0, если номера нет.
//
Функция НомерЗадачи(Задача) Экспорт

	Возврат ЧислоИзЦифр(ТекстЗначения(Задача["id"]));

КонецФункции

// Колонка «Компания CRM»: название, «—» или «N компаний». Компания, которой нет среди Названия (удалена из CRM),
// не считается.
//
// Параметры:
//  ИДКомпаний - Массив из Число - см. ИДКомпанийЗадачи
//  Названия - Соответствие - номер компании (Число) в название.
//
// Возвращаемое значение:
//  Строка
//
Функция ПредставлениеКомпаний(ИДКомпаний, Названия) Экспорт

	Существующие = СуществующиеКомпании(ИДКомпаний, Названия);

	Если Существующие.Количество() = 0 Тогда
		Возврат "—";
	ИначеЕсли Существующие.Количество() = 1 Тогда
		Название = Названия[Существующие[0]];
		Возврат ?(ПустаяСтрока(Название), НСтр("ru = '(без названия)'"), Название);
	КонецЕсли;

	Количество = Существующие.Количество();
	Остаток10 = Количество % 10;
	Остаток100 = Количество % 100;
	Если Остаток100 >= 11 И Остаток100 <= 14 Тогда
		Слово = НСтр("ru = 'компаний'");
	ИначеЕсли Остаток10 = 1 Тогда
		Слово = НСтр("ru = 'компания'");
	ИначеЕсли Остаток10 >= 2 И Остаток10 <= 4 Тогда
		Слово = НСтр("ru = 'компании'");
	Иначе
		Слово = НСтр("ru = 'компаний'");
	КонецЕсли;
	Возврат Формат(Количество, "ЧГ=0") + " " + Слово;

КонецФункции

// Начало периода, с которого показываются завершённые задачи: начало дня даты табеля минус 30 дней (Ф3).
// Весь день границы включается, время суток табеля роли не играет.
//
// Параметры:
//  ДатаТабеля - Дата
//
// Возвращаемое значение:
//  Дата
//
Функция ГраницаЗавершения(ДатаТабеля) Экспорт

	Возврат НачалоДня(ДатаТабеля) - 30 * 86400;

КонецФункции

// Попадает ли задача в список: не завершена (статус не «Завершена»; «Ждёт контроля» и «Отложена» — не завершены) или
// завершена не раньше Границы. Даты сравниваются как моменты времени.
//
// Параметры:
//  Задача - Соответствие
//  Граница - Дата - см. ГраницаЗавершения; в том же времени, что и Смещение.
//  Смещение - Число - см. ДатаБитрикс24
//
// Возвращаемое значение:
//  Булево
//
Функция ПопадаетВСписок(Задача, Граница, Смещение) Экспорт

	Если ТекстЗначения(Задача["status"]) <> "5" Тогда
		Возврат Истина;
	КонецЕсли;

	Завершена = ДатаБитрикс24(Задача["closedDate"], Смещение);
	Возврат ЗначениеЗаполнено(Завершена) И Завершена >= Граница;

КонецФункции

// Подпись под списком (Ф3).
//
// Параметры:
//  ДатаТабеля - Дата
//
// Возвращаемое значение:
//  Строка
//
Функция ПодписьСписка(ДатаТабеля) Экспорт

	Возврат СтрШаблон(
		НСтр("ru = 'Незавершённые задачи и задачи, завершённые с %1, где вы постановщик, исполнитель или соисполнитель'"),
		Формат(ГраницаЗавершения(ДатаТабеля), "ДФ=dd.MM.yyyy"));

КонецФункции

// Надпись над списком в режиме тестирования (Ф8).
Функция НадписьРежимаТестирования(НазваниеПроекта) Экспорт

	Возврат СтрШаблон(НСтр("ru = 'Режим тестирования: показаны только задачи проекта «%1»'"), НазваниеПроекта);

КонецФункции

// Можно ли заполнять табель по задаче. Сначала режим тестирования (Ф8), затем роль (Ф2): так для задачи другого
// проекта сообщение не зависит от роли сотрудника.
//
// Параметры:
//  Задача - Соответствие
//  Контекст - Структура - см. б24т_Доступ.ПроверитьДоступ: ИДПользователя, РежимТестирования,
//    ПроектДляТестирования, НазваниеПроекта.
//
// Возвращаемое значение:
//  Структура:
//   * Допущена - Булево
//   * Сообщение - Строка - при отказе.
//   * Роли - Массив из Строка - см. РолиВЗадаче
//
Функция ДопускЗадачи(Задача, Контекст) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Допущена", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Роли", Новый Массив);

	Если Контекст.РежимТестирования
		И ТекстЗначения(Задача["groupId"]) <> Формат(Контекст.ПроектДляТестирования, "ЧГ=0") Тогда
		Результат.Сообщение = СтрШаблон(
			НСтр("ru = 'В режиме тестирования доступны только задачи проекта «%1»'"), Контекст.НазваниеПроекта);
		Возврат Результат;
	КонецЕсли;

	Роли = РолиВЗадаче(Задача, Контекст.ИДПользователя);
	Если Роли.Количество() = 0 Тогда
		Результат.Сообщение =
			НСтр("ru = 'Заполнять табель по задаче могут только постановщик, исполнитель и соисполнители'");
		Возврат Результат;
	КонецЕсли;

	Результат.Допущена = Истина;
	Результат.Роли = Роли;
	Возврат Результат;

КонецФункции

// Номер задачи из ввода сотрудника: номер («10180», «#10180», «№ 10 180») или ссылка на карточку задачи Битрикс24
// (…/tasks/task/view/10180/ и …/tasks/task/edit/10180/, с хвостом после «?» или «#» или без него).
// Домен ссылки не проверяется: роль и проект проверяются по самой задаче.
//
// Параметры:
//  Текст - Строка
//
// Возвращаемое значение:
//  Число - номер задачи, 0, если введено не число и не ссылка на задачу.
//
Функция РазобратьНомерИлиСсылку(Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или СтрДлина(Текст) > б24т_ЗадачиКлиентСервер.МаксимальнаяДлинаНомера() Тогда
		Возврат 0;
	КонецЕсли;

	Ввод = СокрЛП(СтрЗаменить(Текст, Символы.НПП, " "));
	Если Ввод = "" Тогда
		Возврат 0;
	КонецЕсли;

	Нижний = НРег(Ввод);
	Метки = Новый Массив;
	Метки.Добавить("/tasks/task/view/");
	Метки.Добавить("/tasks/task/edit/");
	Для Каждого Метка Из Метки Цикл
		Позиция = СтрНайти(Нижний, Метка);
		Если Позиция > 0 Тогда
			Возврат НомерПослеМетки(Ввод, Позиция + СтрДлина(Метка));
		КонецЕсли;
	КонецЦикла;

	Если Лев(Ввод, 1) = "#" Или Лев(Ввод, 1) = "№" Тогда
		Ввод = Сред(Ввод, 2);
	КонецЕсли;
	Цифры = СтрЗаменить(СокрЛП(Ввод), " ", "");
	Возврат ЧислоИзЦифр(Цифры);

КонецФункции

// Строка списка задач для окна: только простые значения.
//
// Параметры:
//  Задача - Соответствие
//  ИДПользователя - Число
//  Названия - Соответствие - название компании по её номеру (Число).
//  Смещение - Число - см. ДатаБитрикс24
//  Контрагент - Структура, Неопределено - запись б24т_Контрагенты.КонтрагентыЗадач; Неопределено — контрагент не определялся.
//
// Возвращаемое значение:
//  Структура:
//   * Номер - Число
//   * Название - Строка
//   * МояРоль - Строка
//   * КрайнийСрок - Дата - пустая дата, если срока нет.
//   * КрайнийСрокПредставление - Строка - дата или «без срока».
//   * КлючСрока - Дата - для сортировки: задачи без срока позже любых.
//   * Статус - Строка
//   * КомпанияCRM - Строка
//   * Активность - Дата
//   * КлючПоиска - Строка - см. б24т_ЗадачиКлиентСервер.КлючСтроки
//   * Контрагент - СправочникСсылка.Контрагенты - пустая ссылка, если контрагент не определён.
//   * БИН - Строка
//   * ТекстКонтрагента - Строка
//
Функция СтрокаСписка(Задача, ИДПользователя, Названия, Смещение, Контрагент = Неопределено) Экспорт

	Номер = НомерЗадачи(Задача);
	Название = ТекстЗначения(Задача["title"]);
	КрайнийСрок = ДатаБитрикс24(Задача["deadline"], Смещение);
	ЕстьСрок = ЗначениеЗаполнено(КрайнийСрок);

	Строка = Новый Структура;
	Строка.Вставить("Номер", Номер);
	Строка.Вставить("Название", Название);
	Строка.Вставить("МояРоль", ПредставлениеРолей(РолиВЗадаче(Задача, ИДПользователя)));
	Строка.Вставить("КрайнийСрок", КрайнийСрок);
	Строка.Вставить("КрайнийСрокПредставление", ?(ЕстьСрок, Формат(КрайнийСрок, "ДФ=dd.MM.yyyy"), НСтр("ru = 'без срока'")));
	Строка.Вставить("КлючСрока", ?(ЕстьСрок, КрайнийСрок, Дата(3999, 12, 31, 23, 59, 59)));
	Строка.Вставить("Статус", НазваниеСтатуса(Задача["status"]));
	Строка.Вставить("КомпанияCRM", ПредставлениеКомпаний(ИДКомпанийЗадачи(Задача), Названия));
	Строка.Вставить("Активность", ДатаБитрикс24(Задача["activityDate"], Смещение));
	Строка.Вставить("КлючПоиска", б24т_ЗадачиКлиентСервер.КлючСтроки(Номер, Название));
	Строка.Вставить("Контрагент", ?(Контрагент = Неопределено, Справочники.Контрагенты.ПустаяСсылка(), Контрагент.Контрагент));
	Строка.Вставить("БИН", ?(Контрагент = Неопределено, "", Контрагент.БИН));
	Строка.Вставить("ТекстКонтрагента", ?(Контрагент = Неопределено, "", Контрагент.Текст));
	Возврат Строка;

КонецФункции

// Строки списка в порядке выбранной сортировки.
//
// Параметры:
//  Задачи - Массив из Структура - см. СтрокаСписка
//  Вид - Строка - см. б24т_ЗадачиКлиентСервер.ПорядокСортировки
//
// Возвращаемое значение:
//  Массив из Структура
//
Функция Отсортированные(Задачи, Вид) Экспорт

	Поля = ПоляСтрокиСписка();
	Таблица = Новый ТаблицаЗначений;
	Для Каждого Поле Из СтрРазделить(Поля, ",") Цикл
		Таблица.Колонки.Добавить(Поле);
	КонецЦикла;
	Для Каждого Задача Из Задачи Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Задача);
	КонецЦикла;
	Таблица.Сортировать(б24т_ЗадачиКлиентСервер.ПорядокСортировки(Вид));

	Результат = Новый Массив;
	Для Каждого Строка Из Таблица Цикл
		Задача = Новый Структура(Поля);
		ЗаполнитьЗначенияСвойств(Задача, Строка);
		Результат.Добавить(Задача);
	КонецЦикла;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Общий предел времени на загрузку списка, секунд (и на два запроса задач, и на названия компаний).
Функция ПределВремениЗагрузки()

	Возврат 60;

КонецФункции

Функция ПоляСтрокиСписка()

	Возврат "Номер,Название,МояРоль,КрайнийСрок,КрайнийСрокПредставление,КлючСрока,Статус,КомпанияCRM,Активность,КлючПоиска,"
		+ "Контрагент,БИН,ТекстКонтрагента";

КонецФункции

Функция СтрокаВМассив(Элемент)

	Результат = Новый Массив;
	Результат.Добавить(Элемент);
	Возврат Результат;

КонецФункции

Функция ПоляЗадачи()

	Возврат СтрРазделить("ID,TITLE,CREATED_BY,RESPONSIBLE_ID,ACCOMPLICES,STATUS,GROUP_ID,UF_CRM_TASK,DEADLINE,"
		+ "CLOSED_DATE,ACTIVITY_DATE", ",");

КонецФункции

// Параметры tasks.task.list. Ключи с «::» и «!» — только у Соответствия, не у Структуры. Номер сотрудника передаётся
// явно: у вебхука свой владелец, и без отбора пришли бы его задачи. Границу завершения Битрикс24 получает с запасом
// в сутки: он читает дату в часовом поясе владельца вебхука, а точный отбор делает 1С.
Функция ПараметрыСписка(НомерЗапроса, Контекст, Граница)

	Фильтр = Новый Соответствие;
	Если НомерЗапроса = 1 Тогда
		Роли = Новый Соответствие;
		Роли.Вставить("::LOGIC", "OR");
		Роли.Вставить("CREATED_BY", Контекст.ИДПользователя);
		Роли.Вставить("RESPONSIBLE_ID", Контекст.ИДПользователя);
		Фильтр.Вставить("::SUBFILTER-R", Роли);
	Иначе
		Фильтр.Вставить("ACCOMPLICE", Контекст.ИДПользователя);
	КонецЕсли;

	Статус = Новый Соответствие;
	Статус.Вставить("::LOGIC", "OR");
	Статус.Вставить("!REAL_STATUS", 5);
	Статус.Вставить(">=CLOSED_DATE", Формат(Граница - 86400, "ДФ='dd.MM.yyyy HH:mm:ss'"));
	Фильтр.Вставить("::SUBFILTER-ST", Статус);

	Если Контекст.РежимТестирования Тогда
		Фильтр.Вставить("GROUP_ID", Контекст.ПроектДляТестирования);
	КонецЕсли;

	Порядок = Новый Соответствие;
	Порядок.Вставить("ID", "desc");

	Параметры = Новый Структура;
	Параметры.Вставить("filter", Фильтр);
	Параметры.Вставить("select", ПоляЗадачи());
	Параметры.Вставить("order", Порядок);
	Возврат Параметры;

КонецФункции

// Названия компаний всех задач списка одним запросом (с постраничной выборкой). Компании нет в ответе — она удалена.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Сообщение - Строка - при ошибке Битрикс24.
//   * Названия - Соответствие - название по номеру компании (Число).
//
Функция НазванияКомпаний(Клиент, Задачи)

	Результат = Новый Структура("Успех, Сообщение, Названия", Ложь, "", Новый Соответствие);
	Названия = Результат.Названия;
	ИДКомпаний = Новый Массив;
	Известные = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		Для Каждого ИД Из ИДКомпанийЗадачи(Задача) Цикл
			Если Известные[ИД] = Неопределено Тогда
				Известные.Вставить(ИД, Истина);
				ИДКомпаний.Добавить(ИД);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Если ИДКомпаний.Количество() = 0 Тогда
		Результат.Успех = Истина;
		Возврат Результат;
	КонецЕсли;

	Параметры = Новый Структура;
	Параметры.Вставить("filter", Новый Структура("ID", ИДКомпаний));
	Параметры.Вставить("select", СтрРазделить("ID,TITLE", ","));
	Ответ = б24т_Битрикс24.ВызватьВсеСтраницы(Клиент, "crm.company.list", Параметры);
	Если Не Ответ.Успех Тогда
		Результат.Сообщение = б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка);
		Возврат Результат;
	КонецЕсли;

	Для Каждого Компания Из Ответ.Результат Цикл
		Если ТипЗнч(Компания) = Тип("Соответствие") Тогда
			ИД = ЧислоИзЦифр(ТекстЗначения(Компания["ID"]));
			Если ИД > 0 Тогда
				Названия.Вставить(ИД, ТекстЗначения(Компания["TITLE"]));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Число после метки в ссылке: от 1 до 10 цифр, дальше конец текста, «/», «?» или «#». В ссылке нет пробелов.
Функция НомерПослеМетки(Ссылка, Начало)

	Для Позиция = 1 По СтрДлина(Ссылка) Цикл
		Символ = Сред(Ссылка, Позиция, 1);
		Если Символ = " " Или Символ = Символы.Таб Или Символ = Символы.ПС Или Символ = Символы.ВК Тогда
			Возврат 0;
		КонецЕсли;
	КонецЦикла;

	Позиция = Начало;
	Пока Позиция <= СтрДлина(Ссылка) И СтрНайти("0123456789", Сред(Ссылка, Позиция, 1)) > 0 Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Позиция = Начало Или Позиция - Начало > 10 Тогда
		Возврат 0;
	КонецЕсли;
	Если Позиция <= СтрДлина(Ссылка) И СтрНайти("/?#", Сред(Ссылка, Позиция, 1)) = 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат ЧислоИзЦифр(Сред(Ссылка, Начало, Позиция - Начало));

КонецФункции

// Число из строки, где только цифры (не больше 10); иначе 0.
Функция ЧислоИзЦифр(Текст)

	Если Не СостоитИзЦифр(Текст) Или СтрДлина(Текст) > 10 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Текст);

КонецФункции

Функция СостоитИзЦифр(Текст)

	Если Текст = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти("0123456789", Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Пояс «Z», «+05:00», «-0330» или «+05» в секундах; Неопределено, если запись не разобрана.
Функция СекундыПояса(Пояс)

	Если Пояс = "Z" Или Пояс = "z" Тогда
		Возврат 0;
	КонецЕсли;

	Знак = Лев(Пояс, 1);
	Если Знак <> "+" И Знак <> "-" Тогда
		Возврат Неопределено;
	КонецЕсли;

	Цифры = СтрЗаменить(Сред(Пояс, 2), ":", "");
	Если Не СостоитИзЦифр(Цифры) Или (СтрДлина(Цифры) <> 2 И СтрДлина(Цифры) <> 4) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Часы = Число(Лев(Цифры, 2));
	Минуты = ?(СтрДлина(Цифры) = 4, Число(Сред(Цифры, 3, 2)), 0);
	Возврат (Часы * 3600 + Минуты * 60) * ?(Знак = "-", -1, 1);

КонецФункции

// Текст значения поля Битрикс24: числа и строки; null и прочее — пустая строка.
Функция ТекстЗначения(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат "";

КонецФункции

#КонецОбласти
