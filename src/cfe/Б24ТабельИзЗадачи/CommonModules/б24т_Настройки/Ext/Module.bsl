// Полный адрес вебхука для проверки подключения и представления в форме. Наружу модуля не отдаётся.
// Тот же владелец и ключ читает б24т_Битрикс24.
Функция АдресИзХранилища()

	УстановитьПривилегированныйРежим(Истина);
	Адрес = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючАдреса());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(Адрес = Неопределено, "", Адрес);

