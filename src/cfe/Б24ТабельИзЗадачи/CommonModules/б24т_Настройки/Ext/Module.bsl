// Текст «Проверить ИИ» по ошибке клиента OpenAI (Ф13).
Функция ТекстОшибкиПроверкиИИ(Ошибка, Модель)

	Причина = Ошибка.Причина;
	Если Причина = б24т_OpenAI.ПричинаКлючОтклонён() Тогда
		Возврат НСтр("ru = 'OpenAI отклоняет ключ.'");
	ИначеЕсли Причина = б24т_OpenAI.ПричинаМодельНедоступна() Тогда
		Возврат СтрШаблон(НСтр("ru = 'Модель %1 недоступна для этого ключа.'"), Модель);
	ИначеЕсли Причина = б24т_OpenAI.ПричинаНетСредств() Тогда
		Возврат НСтр("ru = 'На счёте OpenAI закончились средства или достигнут лимит расходов.'");
	ИначеЕсли Причина = б24т_OpenAI.ПричинаНетКлюча() Тогда
		Возврат НСтр("ru = 'Не указан ключ OpenAI.'");
	ИначеЕсли Причина = б24т_OpenAI.ПричинаНетОтвета() Тогда
		Возврат НСтр("ru = 'Нет ответа от api.openai.com. Проверьте, что серверу 1С открыт доступ к нему.'");
	КонецЕсли;
	Возврат НСтр("ru = 'ИИ недоступен. Попробуйте позже'");

КонецФункции

Функция ТекстОшибкиПроверки(Ошибка)

	Если Ошибка.Вид = б24т_Битрикс24.ВидОшибкиНеНастроено() Тогда
		Возврат НСтр("ru = 'Битрикс24 отклоняет адрес вебхука.'");
	КонецЕсли;
	Возврат б24т_Битрикс24.ТекстОшибки(Ошибка);

КонецФункции

// Право «Чат и уведомления» есть, если проверочный чат отдан или Битрикс24 отказал в доступе к нему (ACCESS_ERROR):
// так он отвечает на чужой или несуществующий чат, когда метод вебхуку разрешён.
Функция ЕстьИлиНетПраваЧата(Ответ)

	Если Ответ.Успех Или (Ответ.Ошибка <> Неопределено И Ответ.Ошибка.Код = "ACCESS_ERROR") Тогда
		Возврат НСтр("ru = 'есть'");
	КонецЕсли;
	Возврат НСтр("ru = 'нет'");

КонецФункции

Функция ПроверкаПрава(Ключ, Метод, Параметры)

	Проверка = Новый Структура;
	Проверка.Вставить("Ключ", Ключ);
	Проверка.Вставить("Метод", Метод);
	Проверка.Вставить("Параметры", Параметры);
	Возврат Проверка;

КонецФункции

