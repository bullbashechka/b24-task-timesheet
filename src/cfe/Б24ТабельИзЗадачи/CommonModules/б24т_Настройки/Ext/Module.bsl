// Имя и фамилия создателя вебхука или «с ID ‹номер›», если права «Пользователи» нет или пользователя не нашли.
Функция ОписаниеВладельца(Ответ, Номер)

	Если Ответ.Успех И ТипЗнч(Ответ.Результат) = Тип("Массив") И Ответ.Результат.Количество() > 0 Тогда
		Пользователь = Ответ.Результат[0];
		Имя = СокрЛП(СокрЛП(Пользователь["NAME"]) + " " + СокрЛП(Пользователь["LAST_NAME"]));
		Если Не ПустаяСтрока(Имя) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'с ID %1'"), Формат(Номер, "ЧГ=0"));

КонецФункции

Функция СостоитИз(Текст, Допустимые)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Допустимые, Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция СимволыКлюча()

	Возврат "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";

