#Область ПрограммныйИнтерфейс

// Настройки интеграции для окна заполнения. Адреса вебхука в структуре нет.
// Читаются в привилегированном режиме: обычным сотрудникам права на константы и безопасное хранилище не даются.
//
// Возвращаемое значение:
//  Структура:
//   * Настроено - Булево - адрес вебхука указан.
//   * РежимТестирования - Булево
//   * ПроектДляТестирования - Число - ID проекта Битрикс24, 0 — не указан.
//
Функция Настройки() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Результат = Новый Структура;
	Результат.Вставить("Настроено", ЗначениеЗаполнено(АдресИзХранилища()));
	Результат.Вставить("РежимТестирования", Константы.б24т_РежимТестирования.Получить() = Истина);
	Результат.Вставить("ПроектДляТестирования", Константы.б24т_ПроектДляТестирования.Получить());
	Возврат Результат;

КонецФункции

// Полный адрес вебхука. Вызывает только REST-клиент Битрикс24.
//
// Возвращаемое значение:
//  Строка - пустая строка, если адрес не указан.
//
Функция АдресВебхука() Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Возврат АдресИзХранилища();

КонецФункции

// Приводит адрес к виду https://‹портал›/rest/‹номер›/‹ключ›/.
// Убирает пробелы по краям и имя метода в конце (адрес-пример из Битрикс24).
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Строка - пустая строка, если адрес неверного формата.
//
Функция НормализованныйАдресВебхука(Адрес) Экспорт

	Части = РазобранныйАдрес(Адрес);
	Если Части = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат "https://" + Части.Хост + "/rest/" + Части.Номер + "/" + Части.Ключ + "/";

КонецФункции

// Адрес со скрытым ключом для показа в форме настроек: https://‹портал›/rest/‹номер›/***/.
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Строка - пустая строка для пустого адреса; «***» для адреса, который не разбирается.
//
Функция ПредставлениеАдресаВебхука(Адрес) Экспорт

	Если ПустаяСтрока(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Части = РазобранныйАдрес(Адрес);
	Если Части = Неопределено Тогда
		Возврат "***";
	КонецЕсли;
	Возврат "https://" + Части.Хост + "/rest/" + Части.Номер + "/***/";

КонецФункции

// Данные для формы настроек. Полного адреса в них нет.
//
// Возвращаемое значение:
//  Структура:
//   * ПредставлениеАдреса - Строка
//   * РежимТестирования - Булево
//   * ПроектДляТестирования - Число
//
Функция ДанныеФормыНастроек() Экспорт

	ПроверитьПраваНаНастройку();

	Настройки = Настройки();
	Результат = Новый Структура;
	Результат.Вставить("ПредставлениеАдреса", ПредставлениеАдресаВебхука(АдресВебхука()));
	Результат.Вставить("РежимТестирования", Настройки.РежимТестирования);
	Результат.Вставить("ПроектДляТестирования", Настройки.ПроектДляТестирования);
	Возврат Результат;

КонецФункции

// Проверяет и записывает настройки. При любой ошибке ничего не записывается.
//
// Параметры:
//  Изменения - Структура:
//   * НовыйАдрес - Строка - пусто — адрес не менять.
//   * УдалитьАдрес - Булево - стереть адрес; новый адрес важнее.
//   * РежимТестирования - Булево
//   * ПроектДляТестирования - Число
//  Пользователь - Неопределено, СправочникСсылка.Пользователи - чьи права проверяются; по умолчанию текущий.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Поле - Строка - имя реквизита формы.
//   * Текст - Строка
//
Функция ЗаписатьНастройки(Изменения, Пользователь = Неопределено) Экспорт

	ПроверитьПраваНаНастройку(Пользователь);

	Ошибки = Новый Массив;

	НовыйАдрес = "";
	Если Не ПустаяСтрока(Изменения.НовыйАдрес) Тогда
		НовыйАдрес = НормализованныйАдресВебхука(Изменения.НовыйАдрес);
		Если ПустаяСтрока(НовыйАдрес) Тогда
			Ошибки.Добавить(Ошибка("НовыйАдресВебхука",
				НСтр("ru = 'Адрес вебхука должен иметь вид https://‹портал›/rest/‹номер›/‹ключ›/'")));
		КонецЕсли;
	КонецЕсли;

	Если Изменения.РежимТестирования И Не ЗначениеЗаполнено(Изменения.ПроектДляТестирования) Тогда
		Ошибки.Добавить(Ошибка("ПроектДляТестирования", НСтр("ru = 'Укажите ID проекта для тестирования'")));
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		Возврат Ошибки;
	КонецЕсли;

	Было = Настройки();
	УдаляетсяАдрес = ПустаяСтрока(НовыйАдрес) И Изменения.УдалитьАдрес И Было.Настроено;
	Изменено = Новый Массив;
	Если Не ПустаяСтрока(НовыйАдрес) Или УдаляетсяАдрес Тогда
		Изменено.Добавить("адрес вебхука");
	КонецЕсли;
	Если Было.РежимТестирования <> Изменения.РежимТестирования Тогда
		Изменено.Добавить("режим тестирования");
	КонецЕсли;
	Если Было.ПроектДляТестирования <> Изменения.ПроектДляТестирования Тогда
		Изменено.Добавить("проект для тестирования");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Константы.б24т_РежимТестирования.Установить(Изменения.РежимТестирования);
		Константы.б24т_ПроектДляТестирования.Установить(Изменения.ПроектДляТестирования);
		Если Не ПустаяСтрока(НовыйАдрес) Тогда
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецХранилища(), НовыйАдрес, КлючАдреса());
		ИначеЕсли Изменения.УдалитьАдрес Тогда
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючАдреса());
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		"Настройки интеграции записаны. Изменено: " + ?(Изменено.Количество() = 0, "ничего",
		СтрСоединить(Изменено, ", ")));

	Возврат Ошибки;

КонецФункции

// Проверяет, что пользователь может открывать и менять настройки: у него полные права.
//
// Параметры:
//  Пользователь - Неопределено, СправочникСсылка.Пользователи - по умолчанию текущий.
//
Процедура ПроверитьПраваНаНастройку(Пользователь = Неопределено) Экспорт

	Если Не Пользователи.ЭтоПолноправныйПользователь(Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Нарушение прав доступа'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает адрес на хост, номер и ключ. Хост приводится к нижнему регистру.
//
// Возвращаемое значение:
//  Неопределено - адрес неверного формата.
//  Структура:
//   * Хост - Строка
//   * Номер - Строка
//   * Ключ - Строка
//
Функция РазобранныйАдрес(Знач Адрес)

	Адрес = СокрЛП(Адрес);
	Если НРег(Лев(Адрес, 8)) <> "https://" Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Хост, rest, номер, ключ и необязательное последнее звено: имя метода или пустое после слеша в конце.
	Части = СтрРазделить(Сред(Адрес, 9), "/", Истина);
	Если Части.Количество() < 4 Или Части.Количество() > 5 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хост = НРег(Части[0]);
	Если Хост = "" Или Лев(Хост, 1) = "." Или Не СостоитИз(Хост, СимволыХоста()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[1] <> "rest" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[2] = "" Или Не СостоитИз(Части[2], "0123456789") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[3] = "" Или Не СостоитИз(Части[3], СимволыКлюча()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части.Количество() = 5 И Части[4] <> "" И Не СостоитИз(Части[4], СимволыИмениМетода()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Номер", Части[2]);
	Результат.Вставить("Ключ", Части[3]);
	Возврат Результат;

КонецФункции

Функция СостоитИз(Текст, Допустимые)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Допустимые, Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция СимволыКлюча()

	Возврат "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";

КонецФункции

Функция СимволыХоста()

	Возврат СимволыКлюча() + "-.";

КонецФункции

Функция СимволыИмениМетода()

	Возврат СимволыКлюча() + "_.";

КонецФункции

Функция Ошибка(Поле, Текст)

	Результат = Новый Структура;
	Результат.Вставить("Поле", Поле);
	Результат.Вставить("Текст", Текст);
	Возврат Результат;

КонецФункции

// Вызывать в привилегированном режиме.
Функция АдресИзХранилища()

	Адрес = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючАдреса());
	Возврат ?(Адрес = Неопределено, "", Адрес);

КонецФункции

Функция ВладелецХранилища()

	Возврат "Б24ТабельИзЗадачи";

КонецФункции

Функция КлючАдреса()

	Возврат "АдресВебхука";

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат "Б24ТабельИзЗадачи.Настройки";

КонецФункции

#КонецОбласти
