// Имя и фамилия создателя вебхука или «с ID ‹номер›», если права «Пользователи» нет или пользователя не нашли.
Функция ОписаниеВладельца(Ответ, Номер)

	Если Ответ.Успех И ТипЗнч(Ответ.Результат) = Тип("Массив") И Ответ.Результат.Количество() > 0 Тогда
		Пользователь = Ответ.Результат[0];
		Имя = СокрЛП(СокрЛП(Пользователь["NAME"]) + " " + СокрЛП(Пользователь["LAST_NAME"]));
		Если Не ПустаяСтрока(Имя) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'с ID %1'"), Формат(Номер, "ЧГ=0"));

КонецФункции

Функция СостоитИз(Текст, Допустимые)

	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Если СтрНайти(Допустимые, Сред(Текст, Позиция, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

Функция СимволыКлюча()

	Возврат "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ";

КонецФункции

Функция СимволыХоста()

	Возврат СимволыКлюча() + "-.";

КонецФункции

Функция СимволыИмениМетода()

	Возврат СимволыКлюча() + "_.";

КонецФункции

Функция Ошибка(Поле, Текст)

	Результат = Новый Структура;
	Результат.Вставить("Поле", Поле);
	Результат.Вставить("Текст", Текст);
	Возврат Результат;

КонецФункции

// Полный адрес вебхука для проверки подключения и представления в форме. Наружу модуля не отдаётся.
// Тот же владелец и ключ читает б24т_Битрикс24.
Функция АдресИзХранилища()

	УстановитьПривилегированныйРежим(Истина);
	Адрес = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючАдреса());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(Адрес = Неопределено, "", Адрес);

КонецФункции

// Настройки ИИ, как они сохранены.
//
// Возвращаемое значение:
//  Структура:
//   * ИспользоватьИИ - Булево
//   * Модель - Строка - сохранённая или, если не указана, по умолчанию.
//   * Указания - Строка
//   * Примеры - Строка
//   * ПередаватьКомментарии - Булево
//   * КлючСохранён - Булево
//   * ПредставлениеКлюча - Строка
//
Функция ТекущиеНастройкиИИ()

	Результат = Новый Структура;
	УстановитьПривилегированныйРежим(Истина);
	Результат.Вставить("ИспользоватьИИ", Константы.б24т_ИспользоватьИИ.Получить() = Истина);
	УстановитьПривилегированныйРежим(Ложь);
	Для Каждого Элемент Из НастройкиЗапросаИИ() Цикл
		Результат.Вставить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;

	Ключ = КлючИзХранилища();
	Результат.Вставить("КлючСохранён", Не ПустаяСтрока(Ключ));
	Результат.Вставить("ПредставлениеКлюча", ПредставлениеКлючаOpenAI(Ключ));
	Возврат Результат;

КонецФункции

// Читает только флажок и ключ: указания и примеры занимают до 14 тысяч символов, для признака они не нужны.
Функция ИИДоступен()

	УстановитьПривилегированныйРежим(Истина);
	ФлажокВключён = Константы.б24т_ИспользоватьИИ.Получить() = Истина;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат ФлажокВключён И Не ПустаяСтрока(КлючИзХранилища()) И Не РаботаСВнешнимиРесурсамиЗаблокирована();

КонецФункции

// БСП заблокировала работу с внешними ресурсами: базу скопировали или перенесли и администратор ещё не подтвердил,
// что это рабочая база. Запросы к OpenAI в такой базе не идут.
Функция РаботаСВнешнимиРесурсамиЗаблокирована()

	УстановитьПривилегированныйРежим(Истина);
	Заблокирована = РегламентныеЗаданияСервер.РаботаСВнешнимиРесурсамиЗаблокирована();
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Заблокирована;

КонецФункции

// Проверяет настройки ИИ из изменений формы и приводит их к виду для записи. Свойство, которого нет в изменениях,
// значит «не менять».
//
// Параметры:
//  Изменения - Структура - см. ЗаписатьНастройки.
//  Было - Структура - см. ТекущиеНастройкиИИ.
//  Ошибки - Массив из Структура - сюда добавляются найденные нарушения.
//
// Возвращаемое значение:
//  Структура:
//   * НовыйКлюч - Строка - пусто, если ключ не меняется.
//   * УдалитьКлюч - Булево - ключ будет стёрт; Ложь, если вводится новый.
//   * ИспользоватьИИ - Булево
//   * Модель - Строка
//   * Указания - Строка
//   * Примеры - Строка
//   * ПередаватьКомментарии - Булево
//
Функция ПроверенныеНастройкиИИ(Изменения, Было, Ошибки)

	НовыйКлюч = СокрЛП(СвойствоИзменений(Изменения, "НовыйКлюч", ""));
	Если Не ПустаяСтрока(НовыйКлюч) Тогда
		ТекстОшибки = ТекстОшибкиКлюча(НовыйКлюч);
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			Ошибки.Добавить(Ошибка("НовыйКлючOpenAI", ТекстОшибки));
		КонецЕсли;
	КонецЕсли;
	УдалитьКлюч = ПустаяСтрока(НовыйКлюч) И СвойствоИзменений(Изменения, "УдалитьКлюч", Ложь) = Истина;

	ИспользоватьИИ = СвойствоИзменений(Изменения, "ИспользоватьИИ", Было.ИспользоватьИИ) = Истина;
	КлючБудет = Не ПустаяСтрока(НовыйКлюч) Или (Было.КлючСохранён И Не УдалитьКлюч);
	Если ИспользоватьИИ И Не КлючБудет Тогда
		Ошибки.Добавить(Ошибка("НовыйКлючOpenAI", НСтр("ru = 'Укажите ключ OpenAI'")));
	КонецЕсли;

	Модель = Было.Модель;
	Если Изменения.Свойство("МодельИИ") Тогда
		Модель = СокрЛП(Изменения.МодельИИ);
		Если Модель = "" Тогда
			Модель = МодельИИПоУмолчанию();
		ИначеЕсли Не НазваниеМоделиВерно(Модель) Тогда
			Ошибки.Добавить(Ошибка("МодельИИ",
				НСтр("ru = 'Название модели может содержать только латинские буквы, цифры и знаки . - _ :'")));
		КонецЕсли;
	КонецЕсли;

	Указания = Было.Указания;
	Если Изменения.Свойство("УказанияДляИИ") Тогда
		Указания = СокрЛП(Изменения.УказанияДляИИ);
		Если СтрДлина(Указания) > 4000 Тогда
			Ошибки.Добавить(Ошибка("УказанияДляИИ", СтрШаблон(
				НСтр("ru = 'Дополнительные указания для ИИ — не длиннее 4000 символов, сейчас %1'"),
				Формат(СтрДлина(Указания), "ЧГ=0"))));
		КонецЕсли;
	КонецЕсли;

	Примеры = Было.Примеры;
	Если Изменения.Свойство("ПримерыСтрокТабеля") Тогда
		Примеры = СокрЛП(Изменения.ПримерыСтрокТабеля);
		Если СтрДлина(Примеры) > 10000 Тогда
			Ошибки.Добавить(Ошибка("ПримерыСтрокТабеля", СтрШаблон(
				НСтр("ru = 'Примеры строк табеля — не длиннее 10 000 символов, сейчас %1'"),
				Формат(СтрДлина(Примеры), "ЧГ=0"))));
		ИначеЕсли СодержитБИН(Примеры) Или СодержитАдресПочты(Примеры) Тогда
			Ошибки.Добавить(Ошибка("ПримерыСтрокТабеля",
				НСтр("ru = 'В примерах строк табеля есть БИН, ИИН или e-mail. Замените их'")));
		КонецЕсли;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("НовыйКлюч", НовыйКлюч);
	Результат.Вставить("УдалитьКлюч", УдалитьКлюч);
	Результат.Вставить("ИспользоватьИИ", ИспользоватьИИ);
	Результат.Вставить("Модель", Модель);
	Результат.Вставить("Указания", Указания);
	Результат.Вставить("Примеры", Примеры);
	Результат.Вставить("ПередаватьКомментарии",
		СвойствоИзменений(Изменения, "ПередаватьКомментарииИИ", Было.ПередаватьКомментарии) = Истина);
	Возврат Результат;

КонецФункции

Функция СвойствоИзменений(Изменения, Имя, ЗначениеПоУмолчанию)

	Значение = Неопределено;
	Если Изменения.Свойство(Имя, Значение) Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;

КонецФункции

// Ключ OpenAI начинается с «sk-» и состоит из латинских букв, цифр, «-» и «_». Ключ администратора организации
// («sk-admin-…») управляет всем счётом, для запросов он не годится.
//
// Возвращаемое значение:
//  Строка - текст ошибки, пусто — ключ подходит.
//
Функция ТекстОшибкиКлюча(Ключ)

	Если СтрДлина(Ключ) <= 3 Или Лев(Ключ, 3) <> "sk-" Или Не СостоитИз(Ключ, СимволыКлюча() + "-_") Тогда
		Возврат НСтр("ru = 'Ключ OpenAI должен начинаться с sk- и не содержать пробелов и русских букв'");
	КонецЕсли;
	Если Лев(Ключ, 9) = "sk-admin-" Тогда
		Возврат НСтр("ru = 'Это ключ администратора OpenAI. Создайте ключ API проекта'");
	КонецЕсли;
	Возврат "";

КонецФункции

Функция НазваниеМоделиВерно(Название)

	Возврат СтрДлина(Название) <= 100 И СостоитИз(Название, СимволыКлюча() + ".-_:");

КонецФункции

// Есть ли в тексте БИН или ИИН: 12 цифр и больше подряд. Цифры могут идти группами через одиночный пробел,
// как в «2345 1261 2395».
Функция СодержитБИН(Текст)

	Цифр = 0;
	ПослеПробела = Ложь;
	Для Позиция = 1 По СтрДлина(Текст) Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			Цифр = Цифр + 1;
			ПослеПробела = Ложь;
			Если Цифр >= 12 Тогда
				Возврат Истина;
			КонецЕсли;
		ИначеЕсли Символ = " " И Цифр > 0 И Не ПослеПробела Тогда
			ПослеПробела = Истина;
		Иначе
			Цифр = 0;
			ПослеПробела = Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Есть ли в тексте адрес электронной почты: перед «@» непробельный символ, после него слово с точкой внутри.
Функция СодержитАдресПочты(Текст)

	Номер = 1;
	Позиция = СтрНайти(Текст, "@", НаправлениеПоиска.СНачала, 1, Номер);
	Пока Позиция > 0 Цикл
		Если Позиция > 1 И Не ПустаяСтрока(Сред(Текст, Позиция - 1, 1)) И ЕстьТочкаВСлове(Текст, Позиция + 1) Тогда
			Возврат Истина;
		КонецЕсли;
		Номер = Номер + 1;
		Позиция = СтрНайти(Текст, "@", НаправлениеПоиска.СНачала, 1, Номер);
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Есть ли в слове, которое начинается с позиции Начало, точка не первым и не последним символом.
Функция ЕстьТочкаВСлове(Текст, Начало)

	Длина = СтрДлина(Текст);
	Для Позиция = Начало По Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		Если ПустаяСтрока(Символ) Тогда
			Прервать;
		КонецЕсли;
		Если Символ = "." И Позиция > Начало И Позиция < Длина И Не ПустаяСтрока(Сред(Текст, Позиция + 1, 1)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Ключ OpenAI из безопасного хранилища. Наружу модуля не отдаётся; тот же ключ будет читать клиент OpenAI.
Функция КлючИзХранилища()

	УстановитьПривилегированныйРежим(Истина);
	Ключ = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючЗаписиOpenAI());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат ?(Ключ = Неопределено, "", Ключ);

