#Область ПрограммныйИнтерфейс

// Настройки интеграции для окна заполнения. Адреса вебхука в структуре нет: полный адрес читает только REST-клиент.
// Читаются в привилегированном режиме: обычным сотрудникам права на константы и безопасное хранилище не даются.
//
// Возвращаемое значение:
//  Структура:
//   * Настроено - Булево - адрес вебхука указан.
//   * РежимТестирования - Булево
//   * ПроектДляТестирования - Число - ID проекта Битрикс24, 0 — не указан.
//
Функция Настройки() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Настроено", ЗначениеЗаполнено(АдресИзХранилища()));
	УстановитьПривилегированныйРежим(Истина);
	Результат.Вставить("РежимТестирования", Константы.б24т_РежимТестирования.Получить() = Истина);
	Результат.Вставить("ПроектДляТестирования", Константы.б24т_ПроектДляТестирования.Получить());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

КонецФункции

// Приводит адрес к виду https://‹портал›.bitrix24.‹зона›/rest/‹номер›/‹ключ›/.
// Убирает пробелы по краям и имя метода в конце (адрес-пример из Битрикс24). Принимает только облачный Битрикс24.
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Строка - пустая строка, если адрес неверного формата.
//
Функция НормализованныйАдресВебхука(Адрес) Экспорт

	Части = РазобранныйАдрес(Адрес);
	Если Части = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат "https://" + Части.Хост + "/rest/" + Части.Номер + "/" + Части.Ключ + "/";

КонецФункции

// Адрес со скрытым ключом для показа в форме настроек: https://‹портал›/rest/‹номер›/***/.
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Строка - пустая строка для пустого адреса; «***» для адреса, который не разбирается.
//
Функция ПредставлениеАдресаВебхука(Адрес) Экспорт

	Если ПустаяСтрока(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	Части = РазобранныйАдрес(Адрес);
	Если Части = Неопределено Тогда
		Возврат "***";
	КонецЕсли;
	Возврат "https://" + Части.Хост + "/rest/" + Части.Номер + "/***/";

КонецФункции

// Прячет вебхук в тексте (журнал регистрации, исключение платформы, сообщение): путь «/rest/‹номер›/‹ключ›» целиком
// и ключ отдельно, где бы он ни встретился.
//
// Параметры:
//  Текст - Строка
//  Адрес - Строка - адрес вебхука, как он лежит в настройках или введён в форме.
//
// Возвращаемое значение:
//  Строка
//
Функция СкрытьКлючВебхука(Знач Текст, Адрес) Экспорт

	Если ПустаяСтрока(Текст) Или ПустаяСтрока(Адрес) Тогда
		Возврат Текст;
	КонецЕсли;

	Части = РазобранныйАдрес(Адрес);
	Если Части = Неопределено Тогда
		Возврат СтрЗаменить(Текст, СокрЛП(Адрес), "[вебхук]");
	КонецЕсли;

	Текст = СтрЗаменить(Текст, "/rest/" + Части.Номер + "/" + Части.Ключ, "[вебхук]");
	Возврат СтрЗаменить(Текст, Части.Ключ, "***");

КонецФункции

// Номер пользователя Битрикс24, создавшего вебхук: он стоит в адресе после «/rest/».
//
// Параметры:
//  Адрес - Строка
//
// Возвращаемое значение:
//  Число - 0, если адрес неверного формата.
//
Функция НомерВладельцаВебхука(Адрес) Экспорт

	Части = РазобранныйАдрес(Адрес);
	Возврат ?(Части = Неопределено, 0, Число(Части.Номер));

КонецФункции

// Проверяет подключение к Битрикс24 и возвращает строки результата для формы настроек (Ф8). Ничего не записывает.
// Проверяется адрес из поля ввода, а если поле пустое — сохранённый.
//
// Параметры:
//  Параметры - Структура - как у ЗаписатьНастройки:
//   * НовыйАдрес - Строка
//   * УдалитьАдрес - Булево
//   * РежимТестирования - Булево
//   * ПроектДляТестирования - Число
//  Пользователь - Неопределено, СправочникСсылка.Пользователи - чьи права проверяются; по умолчанию текущий.
//    Другого пользователя передают только тесты, см. б24т_Доступ.ПроверитьПодменуДляТестов.
//  Клиент - Неопределено, Структура - клиент Битрикс24 (в тестах — с заглушкой транспорта); его адрес заменяется проверяемым.
//
// Возвращаемое значение:
//  Массив из Строка
//
Функция ПроверитьПодключение(Параметры, Пользователь = Неопределено, Клиент = Неопределено) Экспорт

	б24т_Доступ.ПроверитьПодменуДляТестов(Пользователь, Клиент);
	ПроверитьПраваНаНастройку(Пользователь);

	Адрес = "";
	Если Не ПустаяСтрока(Параметры.НовыйАдрес) Тогда
		Адрес = НормализованныйАдресВебхука(Параметры.НовыйАдрес);
		Если ПустаяСтрока(Адрес) Тогда
			Возврат СтрокиРезультата(НСтр("ru = 'Адрес вебхука должен иметь вид https://‹портал›.bitrix24.‹зона›/rest/‹номер›/‹ключ›/'"));
		КонецЕсли;
	ИначеЕсли Не Параметры.УдалитьАдрес Тогда
		Адрес = АдресИзХранилища();
	КонецЕсли;
	Если ПустаяСтрока(Адрес) Тогда
		Возврат СтрокиРезультата(НСтр("ru = 'Не указан адрес вебхука.'"));
	КонецЕсли;

	Если Клиент = Неопределено Тогда
		Клиент = б24т_Битрикс24.НовыйКлиент("б24т_ТранспортHTTPS", Адрес);
	Иначе
		Клиент.АдресВебхука = Адрес;
	КонецЕсли;

	Администратор = б24т_Битрикс24.Вызвать(Клиент, "user.admin");
	Если Не Администратор.Успех Тогда
		Возврат СтрокиРезультата(ТекстОшибкиПроверки(Администратор.Ошибка));
	КонецЕсли;

	// Права вебхука видны по тому, какие из методов отвечают. Порядок вызовов — порядок в тестах.
	ПроектПроверяется = Параметры.РежимТестирования И ЗначениеЗаполнено(Параметры.ПроектДляТестирования);
	Проверки = Новый Массив;
	Проверки.Добавить(ПроверкаПрава("Пользователи", "user.get",
		Новый Структура("FILTER", Отбор("ID", НомерВладельцаВебхука(Адрес)))));
	Проверки.Добавить(ПроверкаПрава("Задачи", "tasks.task.list",
		Новый Структура("filter, select", Отбор("ID", 0), СтрРазделить("ID", ","))));
	Проверки.Добавить(ПроверкаПрава("CRM", "crm.company.list",
		Новый Структура("filter, select", Отбор("ID", СтрРазделить("999999999", ",")), СтрРазделить("ID", ","))));
	// Без режима тестирования название проекта не нужно, поэтому право «Рабочие группы» проверяется несуществующим ID.
	Проверки.Добавить(ПроверкаПрава("Группы", "sonet_group.get",
		Новый Структура("FILTER", Отбор("ID", ?(ПроектПроверяется, Параметры.ПроектДляТестирования, 999999999)))));

	Ответы = Новый Структура;
	Для Каждого Проверка Из Проверки Цикл
		Ответ = б24т_Битрикс24.Вызвать(Клиент, Проверка.Метод, Проверка.Параметры);
		Если Не Ответ.Успех И Ответ.Ошибка.Вид = б24т_Битрикс24.ВидОшибкиНедоступен() Тогда
			Возврат СтрокиРезультата(б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка));
		КонецЕсли;
		Ответы.Вставить(Проверка.Ключ, Ответ);
	КонецЦикла;

	Владелец = ОписаниеВладельца(Ответы.Пользователи, НомерВладельцаВебхука(Адрес));

	Строки = Новый Массив;
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Подключение работает. Вебхук создан пользователем %1.'"), Владелец));
	Строки.Добавить(СтрШаблон(НСтр("ru = 'Права вебхука: Задачи — %1, CRM — %2, Пользователи — %3, Рабочие группы — %4.'"),
		ЕстьИлиНет(Ответы.Задачи), ЕстьИлиНет(Ответы.CRM), ЕстьИлиНет(Ответы.Пользователи), ЕстьИлиНет(Ответы.Группы)));
	Если Администратор.Результат <> Истина Тогда
		Строки.Добавить(СтрШаблон(НСтр("ru = 'У пользователя %1 нет прав администратора Битрикс24. Сотрудники не смогут заполнять табель из задач.'"),
			Владелец));
	КонецЕсли;
	Если ПроектПроверяется И Ответы.Группы.Успех Тогда
		Если Ответы.Группы.Результат.Количество() > 0 Тогда
			Строки.Добавить(СтрШаблон(НСтр("ru = 'Проект для тестирования: «%1».'"), Ответы.Группы.Результат[0]["NAME"]));
		Иначе
			Строки.Добавить(СтрШаблон(НСтр("ru = 'Проект для тестирования с ID %1 не найден.'"),
				Формат(Параметры.ПроектДляТестирования, "ЧГ=0")));
		КонецЕсли;
	КонецЕсли;
	Возврат Строки;

КонецФункции

// Данные для формы настроек. Полного адреса в них нет.
//
// Возвращаемое значение:
//  Структура:
//   * ПредставлениеАдреса - Строка
//   * РежимТестирования - Булево
//   * ПроектДляТестирования - Число
//   * Предупреждения - Строка - по строке на предупреждение, см. ПредупрежденияОРасширениях; пусто — их нет.
//
Функция ДанныеФормыНастроек() Экспорт

	ПроверитьПраваНаНастройку();

	Настройки = Настройки();
	Результат = Новый Структура;
	Результат.Вставить("ПредставлениеАдреса", ПредставлениеАдресаВебхука(АдресИзХранилища()));
	Результат.Вставить("РежимТестирования", Настройки.РежимТестирования);
	Результат.Вставить("ПроектДляТестирования", Настройки.ПроектДляТестирования);
	Результат.Вставить("Предупреждения", СтрСоединить(ПредупрежденияОРасширениях(УстановленныеРасширения()), Символы.ПС));
	Возврат Результат;

КонецФункции

// Предупреждения для формы настроек (Ф8): в базе стоят тестовые расширения или у расширения выключена защита
// от опасных действий.
//
// Параметры:
//  Расширения - Массив из Структура:
//   * Имя - Строка
//   * ЗащитаВключена - Булево
//
// Возвращаемое значение:
//  Массив из Строка - сначала о защите, затем о тестовых расширениях в порядке их следования.
//
Функция ПредупрежденияОРасширениях(Расширения) Экспорт

	Строки = Новый Массив;
	Для Каждого Расширение Из Расширения Цикл
		Если Расширение.Имя = "Б24ТабельИзЗадачи" И Не Расширение.ЗащитаВключена Тогда
			Строки.Добавить(НСтр("ru = 'У расширения «Б24: табель из задачи» отключена защита от опасных действий.'"));
		КонецЕсли;
	КонецЦикла;
	Тестовые = СтрРазделить("YAXUNIT,Б24ТабельИзЗадачиТесты", ",");
	Для Каждого Расширение Из Расширения Цикл
		Если Тестовые.Найти(Расширение.Имя) <> Неопределено Тогда
			Строки.Добавить(СтрШаблон(
				НСтр("ru = 'В базе установлено тестовое расширение «%1». В рабочей базе его быть не должно.'"),
				Расширение.Имя));
		КонецЕсли;
	КонецЦикла;
	Возврат Строки;

КонецФункции

// Проверяет и записывает настройки. При любой ошибке ничего не записывается.
//
// Параметры:
//  Изменения - Структура:
//   * НовыйАдрес - Строка - пусто — адрес не менять.
//   * УдалитьАдрес - Булево - стереть адрес; новый адрес важнее.
//   * РежимТестирования - Булево
//   * ПроектДляТестирования - Число
//  Пользователь - Неопределено, СправочникСсылка.Пользователи - чьи права проверяются; по умолчанию текущий.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Поле - Строка - имя реквизита формы.
//   * Текст - Строка
//
Функция ЗаписатьНастройки(Изменения, Пользователь = Неопределено) Экспорт

	ПроверитьПраваНаНастройку(Пользователь);

	Ошибки = Новый Массив;

	НовыйАдрес = "";
	Если Не ПустаяСтрока(Изменения.НовыйАдрес) Тогда
		НовыйАдрес = НормализованныйАдресВебхука(Изменения.НовыйАдрес);
		Если ПустаяСтрока(НовыйАдрес) Тогда
			Ошибки.Добавить(Ошибка("НовыйАдресВебхука",
				НСтр("ru = 'Адрес вебхука должен иметь вид https://‹портал›.bitrix24.‹зона›/rest/‹номер›/‹ключ›/'")));
		КонецЕсли;
	КонецЕсли;

	Если Изменения.РежимТестирования И Не ЗначениеЗаполнено(Изменения.ПроектДляТестирования) Тогда
		Ошибки.Добавить(Ошибка("ПроектДляТестирования", НСтр("ru = 'Укажите ID проекта для тестирования'")));
	КонецЕсли;

	Если Ошибки.Количество() > 0 Тогда
		Возврат Ошибки;
	КонецЕсли;

	Было = Настройки();
	УдаляетсяАдрес = ПустаяСтрока(НовыйАдрес) И Изменения.УдалитьАдрес И Было.Настроено;
	Изменено = Новый Массив;
	Если Не ПустаяСтрока(НовыйАдрес) Или УдаляетсяАдрес Тогда
		Изменено.Добавить("адрес вебхука");
	КонецЕсли;
	Если Было.РежимТестирования <> Изменения.РежимТестирования Тогда
		Изменено.Добавить("режим тестирования");
	КонецЕсли;
	Если Было.ПроектДляТестирования <> Изменения.ПроектДляТестирования Тогда
		Изменено.Добавить("проект для тестирования");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Константы.б24т_РежимТестирования.Установить(Изменения.РежимТестирования);
		Константы.б24т_ПроектДляТестирования.Установить(Изменения.ПроектДляТестирования);
		Если Не ПустаяСтрока(НовыйАдрес) Тогда
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ВладелецХранилища(), НовыйАдрес, КлючАдреса());
		ИначеЕсли Изменения.УдалитьАдрес Тогда
			ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ВладелецХранилища(), КлючАдреса());
		КонецЕсли;
		УстановитьПривилегированныйРежим(Ложь);
		ЗафиксироватьТранзакцию();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Информация, , ,
		"Настройки интеграции записаны. Изменено: " + ?(Изменено.Количество() = 0, "ничего",
		СтрСоединить(Изменено, ", ")));

	Возврат Ошибки;

КонецФункции

// Проверяет, что пользователь может открывать и менять настройки: у него полные права.
//
// Параметры:
//  Пользователь - Неопределено, СправочникСсылка.Пользователи - по умолчанию текущий.
//
Процедура ПроверитьПраваНаНастройку(Пользователь = Неопределено) Экспорт

	б24т_Доступ.ПроверитьПодменуДляТестов(Пользователь);
	Если Не Пользователи.ЭтоПолноправныйПользователь(Пользователь) Тогда
		ВызватьИсключение НСтр("ru = 'Нарушение прав доступа'");
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает адрес на хост, номер и ключ. Хост приводится к нижнему регистру.
//
// Возвращаемое значение:
//  Неопределено - адрес неверного формата.
//  Структура:
//   * Хост - Строка
//   * Номер - Строка
//   * Ключ - Строка
//
Функция РазобранныйАдрес(Знач Адрес)

	Адрес = СокрЛП(Адрес);
	Если НРег(Лев(Адрес, 8)) <> "https://" Тогда
		Возврат Неопределено;
	КонецЕсли;

	// Хост, rest, номер, ключ и необязательное последнее звено: имя метода или пустое после слеша в конце.
	Части = СтрРазделить(Сред(Адрес, 9), "/", Истина);
	Если Части.Количество() < 4 Или Части.Количество() > 5 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Хост = НРег(Части[0]);
	Если Не ЭтоПорталБитрикс24(Хост) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[1] <> "rest" Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[2] = "" Или Не СостоитИз(Части[2], "0123456789") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части[3] = "" Или Не СостоитИз(Части[3], СимволыКлюча()) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Части.Количество() = 5 И Части[4] <> "" И Не СостоитИз(Части[4], СимволыИмениМетода()) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Хост", Хост);
	Результат.Вставить("Номер", Части[2]);
	Результат.Вставить("Ключ", Части[3]);
	Возврат Результат;

КонецФункции

// Хост облачного Битрикс24: ‹имя›.bitrix24.‹зона›, зона из одной или двух меток (bitrix24.kz, bitrix24.com.br).
// Другие хосты не принимаются: по чужому адресу ушли бы e-mail сотрудников, а ответы чужого сервера решали бы доступ.
Функция ЭтоПорталБитрикс24(Хост)

	Если Не СостоитИз(Хост, СимволыХоста()) Тогда
		Возврат Ложь;
	КонецЕсли;
	Метки = СтрРазделить(Хост, ".", Истина);
	Если Метки.Количество() < 3 Или Метки.Количество() > 4 Или Метки[1] <> "bitrix24" Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Метки[0] = "" Или Не СостоитИз(Метки[0], СимволыКлюча() + "-") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 2 По Метки.ВГраница() Цикл
		Если Метки[Номер] = "" Или Не СостоитИз(Метки[Номер], "abcdefghijklmnopqrstuvwxyz") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Имя и защита от опасных действий каждого расширения в базе.
Функция УстановленныеРасширения()

	Результат = Новый Массив;
	УстановитьПривилегированныйРежим(Истина);
	Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
		Результат.Добавить(Новый Структура("Имя, ЗащитаВключена", Расширение.Имя,
			Расширение.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях));
	КонецЦикла;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;

КонецФункции

