#Область ПрограммныйИнтерфейс

// Приводит e-mail к виду для сравнения: без пробелов по краям и в нижнем регистре (Ф2).
//
// Параметры:
//  Адрес - Строка - e-mail из 1С или Битрикс24.
//
// Возвращаемое значение:
//  Строка
//
Функция НормализованныйEmail(Адрес) Экспорт

	Возврат НРег(СокрЛП(Адрес));

КонецФункции

// Адреса для поиска сотрудника: из представлений контактной информации убираются пробелы по краям, пустые строки
// и повторы без учёта регистра. Если в одной строке несколько адресов через «;» или «,», они делятся.
// Формат адреса не проверяется: неверный адрес просто не найдётся.
//
// Параметры:
//  Представления - Массив из Строка - значения колонки Представление контактной информации физического лица.
//
// Возвращаемое значение:
//  Массив из Строка - адреса в написании из карточки, в порядке следования.
//
Функция АдресаИзПредставлений(Представления) Экспорт

	Адреса = Новый Массив;
	Известные = Новый Соответствие;
	Для Каждого Представление Из Представления Цикл
		Для Каждого Часть Из СтрРазделить(СтрЗаменить(Представление, ";", ","), ",") Цикл
			Адрес = СокрЛП(Часть);
			Ключ = НормализованныйEmail(Адрес);
			Если Ключ = "" Или Известные[Ключ] <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Известные.Вставить(Ключ, Истина);
			Адреса.Добавить(Адрес);
		КонецЦикла;
	КонецЦикла;
	Возврат Адреса;

КонецФункции

// Пользователи Битрикс24 из ответа user.get, чей e-mail совпадает с одним из адресов сотрудника.
// Битрикс24 ищет EMAIL по шаблону (знаки «_» и «%» заменяют символы) и не убирает пробелы, поэтому совпадение
// проверяется здесь: без учёта регистра и пробелов по краям. Неактивные пользователи не подходят.
//
// Параметры:
//  ПользователиБитрикс24 - Массив из Соответствие - поле result ответа user.get.
//  Адреса - Массив из Строка - адреса сотрудника.
//
// Возвращаемое значение:
//  Массив из Соответствие - подошедшие пользователи, каждый один раз.
//
Функция ПодходящиеПользователи(ПользователиБитрикс24, Адреса) Экспорт

	Допустимые = Новый Соответствие;
	Для Каждого Адрес Из Адреса Цикл
		Допустимые.Вставить(НормализованныйEmail(Адрес), Истина);
	КонецЦикла;

	Подходящие = Новый Массив;
	Для Каждого Пользователь Из ПользователиБитрикс24 Цикл
		Если Пользователь["ACTIVE"] <> Истина Или ТипЗнч(Пользователь["EMAIL"]) <> Тип("Строка") Тогда
			Продолжить;
		КонецЕсли;
		Если Допустимые[НормализованныйEmail(Пользователь["EMAIL"])] <> Неопределено Тогда
			Подходящие.Добавить(Пользователь);
		КонецЕсли;
	КонецЦикла;
	Возврат Подходящие;

КонецФункции

#КонецОбласти
