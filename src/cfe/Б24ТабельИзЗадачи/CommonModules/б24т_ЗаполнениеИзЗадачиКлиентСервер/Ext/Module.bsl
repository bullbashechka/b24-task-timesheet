#Область ПрограммныйИнтерфейс

// Время начала по умолчанию (Ф4): окончание строки табеля с самым поздним временем начала; при равных начальных
// временах берётся самое позднее окончание. Табель без строк — 09:00. Если у этой строки нет окончания — пустое время.
// 00:00 в табеле значит «не указано», как и пустое время.
//
// Параметры:
//  Строки - Массив из Структура - строки табеля из данных формы: НомерСтроки, ВремяНач, ВремяКон.
//
// Возвращаемое значение:
//  Дата - время (дата 01.01.0001).
//
Функция ВремяНачалаПоУмолчанию(Строки) Экспорт

	Если Строки.Количество() = 0 Тогда
		Возврат ВремяИзСекунд(9 * 3600);
	КонецЕсли;

	ЛучшееНачало = -1;
	ЛучшееОкончание = 0;
	Для Каждого Строка Из Строки Цикл
		Начало = СекундыСуток(Строка.ВремяНач);
		Окончание = СекундыСуток(Строка.ВремяКон);
		Если Начало > ЛучшееНачало Или Начало = ЛучшееНачало И Окончание > ЛучшееОкончание Тогда
			ЛучшееНачало = Начало;
			ЛучшееОкончание = Окончание;
		КонецЕсли;
	КонецЦикла;
	Возврат ВремяИзСекунд(ЛучшееОкончание);

КонецФункции

// Предупреждение о пересечении со строкой табеля (Ф4). С окончанием интервалы пересекаются, если начало каждого раньше
// окончания другого, поэтому касание концов не пересечение. Без окончания пересечением считается начало внутри другой
// строки: не раньше её начала и раньше её окончания. Строки табеля без начала или без окончания не участвуют. Из
// пересекающихся берётся строка с наименьшим номером.
//
// Параметры:
//  Начало - Дата - время начала новой строки.
//  Окончание - Дата - время окончания новой строки, пустое, если не указано.
//  Строки - Массив из Структура - строки табеля: НомерСтроки, ВремяНач, ВремяКон.
//
// Возвращаемое значение:
//  Строка - текст предупреждения, пусто, если пересечения нет.
//
Функция Пересечение(Начало, Окончание, Строки) Экспорт

	Нач = СекундыСуток(Начало);
	Кон = СекундыСуток(Окончание);
	Если Нач = 0 Или Кон <> 0 И Кон <= Нач Тогда
		Возврат "";
	КонецЕсли;

	Найденная = Неопределено;
	Для Каждого Строка Из Строки Цикл
		СтрокаНач = СекундыСуток(Строка.ВремяНач);
		СтрокаКон = СекундыСуток(Строка.ВремяКон);
		Если СтрокаНач = 0 Или СтрокаКон <= СтрокаНач Тогда
			Продолжить;
		КонецЕсли;
		Если Кон = 0 Тогда
			Пересекается = СтрокаНач <= Нач И Нач < СтрокаКон;
		Иначе
			Пересекается = Нач < СтрокаКон И СтрокаНач < Кон;
		КонецЕсли;
		Если Пересекается И (Найденная = Неопределено Или Строка.НомерСтроки < Найденная.НомерСтроки) Тогда
			Найденная = Строка;
		КонецЕсли;
	КонецЦикла;

	Если Найденная = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Пересекается со строкой №%1 (%2–%3)'"), Формат(Найденная.НомерСтроки, "ЧГ=0"),
		ПредставлениеВремени(Найденная.ВремяНач), ПредставлениеВремени(Найденная.ВремяКон));

КонецФункции

// Подсказки у полей времени (Ф4).
//
// Параметры:
//  Начало - Дата
//  Окончание - Дата
//
// Возвращаемое значение:
//  Структура:
//   * ОшибкаНачала - Строка - пусто, если ошибки нет.
//   * ОшибкаОкончания - Строка - пусто, если ошибки нет.
//
Функция ОшибкиВремени(Начало, Окончание) Экспорт

	Ошибки = Новый Структура("ОшибкаНачала, ОшибкаОкончания", "", "");
	Нач = СекундыСуток(Начало);
	Кон = СекундыСуток(Окончание);
	Если Нач = 0 Тогда
		Ошибки.ОшибкаНачала = НСтр("ru = 'Укажите время начала'");
	ИначеЕсли Кон <> 0 И Кон <= Нач Тогда
		Ошибки.ОшибкаОкончания = НСтр("ru = 'Время окончания должно быть позже времени начала'");
	КонецЕсли;
	Возврат Ошибки;

КонецФункции

// Доступна ли «Добавить в табель» (Ф4): выбрана задача и время указано верно. Пересечение кнопку не блокирует.
//
// Параметры:
//  Выбор - Структура - см. НовыйВыбор
//  Начало - Дата
//  Окончание - Дата
//
// Возвращаемое значение:
//  Булево
//
Функция МожноДобавить(Выбор, Начало, Окончание) Экспорт

	Ошибки = ОшибкиВремени(Начало, Окончание);
	Возврат Выбор.Номер > 0 И Ошибки.ОшибкаНачала = "" И Ошибки.ОшибкаОкончания = "";

КонецФункции

// Выбранная в окне задача. Хранится в реквизитах формы по полям; структура нужна правилам и тестам.
//
// Возвращаемое значение:
//  Структура:
//   * Номер - Число - 0, если задача не выбрана.
//   * Источник - Строка - «Список», «Номер» или пусто.
//   * Название - Строка
//   * Контрагент - СправочникСсылка.Контрагенты - пустая ссылка, если контрагент не определён (Ф6).
//   * ТекстКонтрагента - Строка - «найден в 1С по БИН ‹номер›» или причина по Ф6.
//   * ЗаменитьСодержание - Булево - последний переход выбора просит заменить «Содержание» названием задачи.
//
Функция НовыйВыбор() Экспорт

	Выбор = Новый Структура;
	Выбор.Вставить("Номер", 0);
	Выбор.Вставить("Источник", "");
	Выбор.Вставить("Название", "");
	Выбор.Вставить("Контрагент", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	Выбор.Вставить("ТекстКонтрагента", "");
	Выбор.Вставить("ЗаменитьСодержание", Ложь);
	Возврат Выбор;

КонецФункции

// Выбор задачи щелчком по строке списка. «Содержание» заменяется названием, если задача другая: повторный выбор той же
// задачи изменённое сотрудником «Содержание» не затирает.
//
// Параметры:
//  Выбор - Структура - прежний выбор, см. НовыйВыбор
//  СтрокаСписка - Структура - Номер, Название, Контрагент, ТекстКонтрагента (см. б24т_Задачи.СтрокаСписка).
//
// Возвращаемое значение:
//  Структура - новый выбор
//
Функция ВыбратьИзСписка(Выбор, СтрокаСписка) Экспорт

	Итог = ВыборИзЗадачи(СтрокаСписка, "Список");
	Итог.ЗаменитьСодержание = СтрокаСписка.Номер <> Выбор.Номер;
	Возврат Итог;

КонецФункции

// Результат поиска по номеру или ссылке (б24т_Задачи.ЗадачаПоНомеру) в выборе (Ф3). Выбрана — задача выбрана (строка
// списка не подсвечивается); Отклонена — прежний выбор снят; Ошибка (Битрикс24 не ответил) — прежний выбор сохранён.
//
// Параметры:
//  Выбор - Структура - прежний выбор
//  Результат - Структура - Итог, Сообщение, Задача (см. б24т_Задачи.ЗадачаПоНомеру).
//
// Возвращаемое значение:
//  Структура:
//   * Выбор - Структура - новый выбор
//   * Сообщение - Строка - сообщение под полем номера, пусто при успехе.
//
Функция ПрименитьРезультатНомера(Выбор, Результат) Экспорт

	Применено = Новый Структура("Выбор, Сообщение", Неопределено, "");
	Если Результат.Итог = "Выбрана" Тогда
		Применено.Выбор = ВыборИзЗадачи(Результат.Задача, "Номер");
		Применено.Выбор.ЗаменитьСодержание = Результат.Задача.Номер <> Выбор.Номер;
		Возврат Применено;
	КонецЕсли;

	Применено.Сообщение = Результат.Сообщение;
	Если Результат.Итог = "Отклонена" Тогда
		Применено.Выбор = НовыйВыбор();
	Иначе
		Применено.Выбор = КопияВыбора(Выбор);
	КонецЕсли;
	Возврат Применено;

КонецФункции

// Перепроверка выбранной задачи при «Добавить в табель» (б24т_Задачи.ЗадачаПоНомеру с номером выбора). Выбрана — строку
// можно добавлять, в неё идёт контрагент, показанный в окне; Отклонена — выбор снят; Ошибка (Битрикс24 не ответил) —
// выбор сохранён, строка не добавляется.
//
// Параметры:
//  Выбор - Структура - текущий выбор
//  Результат - Структура - Итог, Сообщение (см. б24т_Задачи.ЗадачаПоНомеру).
//
// Возвращаемое значение:
//  Структура:
//   * Выбор - Структура
//   * Сообщение - Строка
//   * Добавить - Булево
//
Функция ПрименитьПерепроверку(Выбор, Результат) Экспорт

	Применено = Новый Структура("Выбор, Сообщение, Добавить", КопияВыбора(Выбор), "", Ложь);
	Если Результат.Итог = "Выбрана" Тогда
		Применено.Добавить = Истина;
		Возврат Применено;
	КонецЕсли;

	Применено.Сообщение = Результат.Сообщение;
	Если Результат.Итог = "Отклонена" Тогда
		Применено.Выбор = НовыйВыбор();
	КонецЕсли;
	Возврат Применено;

КонецФункции

// Надпись под полем номера: «Выбрана задача №‹номер›», пусто, если задача не выбрана. Номер без разделителя групп.
//
// Параметры:
//  Выбор - Структура
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстВыбора(Выбор) Экспорт

	Если Выбор.Номер = 0 Тогда
		Возврат "";
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = 'Выбрана задача №%1'"), Формат(Выбор.Номер, "ЧГ=0"));

КонецФункции

// Данные строки табеля, которые окно возвращает при «Добавить в табель» (Ф5).
//
// Параметры:
//  Выбор - Структура
//  ТипВремени - ПеречислениеСсылка.гем_ТипыВремени
//  Начало - Дата
//  Окончание - Дата - пустое, если не указано.
//  Содержание - Строка
//
// Возвращаемое значение:
//  Структура:
//   * IDБ24 - Строка - номер задачи.
//   * ТипВремени - ПеречислениеСсылка.гем_ТипыВремени
//   * ВремяНач - Дата
//   * ВремяКон - Дата
//   * Содержание - Строка
//   * Контрагент - СправочникСсылка.Контрагенты - пустая ссылка, если не найден.
//   * КонтрагентНайден - Булево - если нет, после добавления открывается выбор контрагента.
//
Функция ДанныеСтроки(Выбор, ТипВремени, Начало, Окончание, Содержание) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("IDБ24", Формат(Выбор.Номер, "ЧГ=0"));
	Данные.Вставить("ТипВремени", ТипВремени);
	Данные.Вставить("ВремяНач", Начало);
	Данные.Вставить("ВремяКон", Окончание);
	Данные.Вставить("Содержание", Содержание);
	Данные.Вставить("Контрагент", Выбор.Контрагент);
	Данные.Вставить("КонтрагентНайден", ЗначениеЗаполнено(Выбор.Контрагент));
	Возврат Данные;

КонецФункции

// Время для выбора из списка в полях времени: 00:05–23:55 с шагом 5 минут. 00:00 не предлагается: в табеле оно
// значит «не указано».
//
// Возвращаемое значение:
//  Массив из Дата
//
Функция СписокВремён() Экспорт

	Список = Новый Массив;
	Для Шаг = 1 По 287 Цикл
		Список.Добавить(ВремяИзСекунд(Шаг * 300));
	КонецЦикла;
	Возврат Список;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыборИзЗадачи(Задача, Источник)

	Выбор = НовыйВыбор();
	Выбор.Номер = Задача.Номер;
	Выбор.Источник = Источник;
	Выбор.Название = Задача.Название;
	Выбор.Контрагент = Задача.Контрагент;
	Выбор.ТекстКонтрагента = Задача.ТекстКонтрагента;
	Возврат Выбор;

КонецФункции

// Копия выбора без просьбы заменить «Содержание»: сохранённый выбор «Содержание» не меняет.
Функция КопияВыбора(Выбор)

	Копия = НовыйВыбор();
	ЗаполнитьЗначенияСвойств(Копия, Выбор);
	Копия.ЗаменитьСодержание = Ложь;
	Возврат Копия;

КонецФункции

// Секунды от начала суток; 0 для пустого времени.
Функция СекундыСуток(Время)

	Если ТипЗнч(Время) <> Тип("Дата") Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Час(Время) * 3600 + Минута(Время) * 60 + Секунда(Время);

КонецФункции

Функция ВремяИзСекунд(Секунды)

	Возврат Дата(1, 1, 1) + Секунды;

КонецФункции

Функция ПредставлениеВремени(Время)

	Возврат Формат(Время, "ДФ=HH:mm");

КонецФункции

#КонецОбласти
