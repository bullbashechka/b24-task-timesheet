#Область ПрограммныйИнтерфейс

// Отправляет запрос в OpenAI Responses API (POST https://api.openai.com/v1/responses) и возвращает код состояния,
// тело ответа и идентификатор запроса. Адрес зашит здесь и из параметров не берётся: ключ OpenAI не уйдёт на другой
// сервер, даже если в вызывающем коде ошибка. Единственное место расширения, где ключ попадает в HTTP-заголовок.
// Исключения платформы не обрабатывает: их текст маскирует вызывающий модуль б24т_OpenAI.
//
// Параметры:
//  Запрос - Структура:
//   * Тело - Строка - JSON.
//   * Ключ - Строка - ключ API OpenAI.
//   * Таймаут - Число - секунд.
//
// Возвращаемое значение:
//  Структура:
//   * КодСостояния - Число
//   * Тело - Строка
//   * ИдентификаторЗапроса - Строка - заголовок x-request-id; пусто, если его нет.
//
Функция ВыполнитьЗапрос(Запрос) Экспорт

	// Без второго параметра сертификат сервера не проверялся бы.
	ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(Неопределено, Новый СертификатыУдостоверяющихЦентровОС);
	Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси("https");
	Соединение = Новый HTTPСоединение("api.openai.com", , , , Прокси, Запрос.Таймаут, ЗащищенноеСоединение);

	HTTPЗапрос = Новый HTTPЗапрос("/v1/responses");
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Запрос.Ключ);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.Заголовки.Вставить("Accept", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(Запрос.Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);

	// ОтправитьДляОбработки — это POST.
	HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);

	Тело = HTTPОтвет.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);

	Результат = Новый Структура;
	Результат.Вставить("КодСостояния", HTTPОтвет.КодСостояния);
	Результат.Вставить("Тело", ?(Тело = Неопределено, "", Тело));
	Результат.Вставить("ИдентификаторЗапроса", ЗначениеЗаголовка(HTTPОтвет.Заголовки, "x-request-id"));
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заголовок ответа без учёта регистра имени.
Функция ЗначениеЗаголовка(Заголовки, Имя)

	Для Каждого Заголовок Из Заголовки Цикл
		Если НРег(Заголовок.Ключ) = Имя Тогда
			Возврат Строка(Заголовок.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

#КонецОбласти
