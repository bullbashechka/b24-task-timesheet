// Служебный символ, которым при разборе помечается конец ячейки таблицы. Из исходного текста он убирается.
Функция МаркерЯчейки()

	Возврат Символ(1);

КонецФункции

// Текст Битрикс24 с BB-кодом без тегов. Переносы строк, пункты списка и ячейки таблицы остаются в тексте (в виде
// переноса, «- » и маркера ячейки); окончательный вид им придаёт ПриведенныеСтроки.
Функция ТекстИзБитриксКода(Текст)

	Части = Новый Массив;
	Верхний = ВРег(Текст);
	Длина = СтрДлина(Текст);
	Позиция = 1;
	// Внутри строки таблицы переносы между ячейками в исходнике — просто пробелы: строка таблицы остаётся одной строкой.
	ВСтрокеТаблицы = Ложь;
	Пока Позиция <= Длина Цикл
		Найдено = СтрНайти(Текст, "[", НаправлениеПоиска.СНачала, Позиция);
		Если Найдено = 0 Тогда
			Части.Добавить(ТекстВСтроке(Сред(Текст, Позиция), ВСтрокеТаблицы));
			Прервать;
		КонецЕсли;
		Части.Добавить(ТекстВСтроке(Сред(Текст, Позиция, Найдено - Позиция), ВСтрокеТаблицы));

		Закрытие = СтрНайти(Текст, "]", НаправлениеПоиска.СНачала, Найдено);
		Описание = Неопределено;
		Если Закрытие > 0 И Закрытие - Найдено <= 200 Тогда
			Описание = ОписаниеТегаБитрикса(Сред(Текст, Найдено + 1, Закрытие - Найдено - 1));
		КонецЕсли;
		Если Описание = Неопределено Тогда
			// Не тег: скобка остаётся текстом, разбор идёт с символа после неё.
			Части.Добавить("[");
			Позиция = Найдено + 1;
			Продолжить;
		КонецЕсли;

		Позиция = Закрытие + 1;
		Если Описание.Имя = "TR" Тогда
			ВСтрокеТаблицы = Не Описание.Закрывающий;
		КонецЕсли;
		Если Описание.Закрывающий Тогда
			Части.Добавить(ЗаменаЗакрывающегоТега(Описание.Имя));
		Иначе
			Части.Добавить(ЗаменаОткрывающегоТега(Описание.Имя));
			Если Описание.Имя = "IMG" Или Описание.Имя = "VIDEO" Тогда
				// Содержимое картинки и видео (адрес) не нужно: пропускается до закрывающего тега, если он есть.
				КонецТега = СтрНайти(Верхний, "[/" + Описание.Имя + "]", НаправлениеПоиска.СНачала, Позиция);
				Если КонецТега > 0 Тогда
					Позиция = КонецТега + СтрДлина(Описание.Имя) + 3;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат СтрСоединить(Части);

КонецФункции

// Текст комментария для ИИ: без блоков цитат и оформления, с одинарными пробелами, со скрытыми паролями.
Функция ТекстКомментария(Знач Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат "";
	КонецЕсли;
	Если СтрДлина(Текст) > ПределСимволовРазбора() Тогда
		Текст = Лев(Текст, ПределСимволовРазбора());
	КонецЕсли;
	Текст = СтрЗаменить(Текст, МаркерЯчейки(), "");
	Текст = БезЦитат(Текст);
	Текст = ПриведенныеСтроки(ТекстИзБитриксКода(Текст));
	Возврат СкрытьПароли(Текст);

КонецФункции

// Убирает блоки, которые вставляет «Цитировать» в чате Битрикс24: линия из дефисов, «Имя [дата]», текст, линия.
// Линия без пары убирается одна.
Функция БезЦитат(Текст)

	Строки = СтрРазделить(СтрЗаменить(Текст, Символы.ВК, ""), Символы.ПС, Истина);
	Оставить = Новый Массив;
	Номер = 0;
	Пока Номер < Строки.Количество() Цикл
		Если Не ЭтоЛинияЦитаты(Строки[Номер]) Тогда
			Оставить.Добавить(Строки[Номер]);
			Номер = Номер + 1;
			Продолжить;
		КонецЕсли;
		Пара = Номер + 1;
		Пока Пара < Строки.Количество() И Не ЭтоЛинияЦитаты(Строки[Пара]) Цикл
			Пара = Пара + 1;
		КонецЦикла;
		Номер = ?(Пара < Строки.Количество(), Пара + 1, Номер + 1);
	КонецЦикла;
	Возврат СтрСоединить(Оставить, Символы.ПС);

КонецФункции

// Линия цитаты — строка из одних дефисов, не меньше десяти.
Функция ЭтоЛинияЦитаты(Строка)

	Линия = СокрЛП(Строка);
	Возврат СтрДлина(Линия) >= 10 И СтрЗаменить(Линия, "-", "") = "";

КонецФункции

Функция ТекстВСтроке(Текст, ВСтрокеТаблицы)

	Возврат ?(ВСтрокеТаблицы, СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, " "), Символы.ПС, " "), Текст);

КонецФункции

// Разбирает текст между «[» и «]».
//
// Возвращаемое значение:
//  Неопределено - это не известный тег Битрикс24 (текст остаётся как есть);
//  Структура: Имя (в верхнем регистре), Закрывающий (Булево).
//
Функция ОписаниеТегаБитрикса(Знач Тег)

	Если СтрНайти(Тег, "[") > 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Закрывающий = Лев(Тег, 1) = "/";
	Если Закрывающий Тогда
		Тег = Сред(Тег, 2);
	КонецЕсли;
	Конец = СтрДлина(Тег) + 1;
	Для Номер = 1 По СтрДлина(Тег) Цикл
		Знак = Сред(Тег, Номер, 1);
		Если Знак = "=" Или Знак = " " Тогда
			Конец = Номер;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Имя = ВРег(Лев(Тег, Конец - 1));
	Если СтрНайти("," + ИменаТеговБитрикса() + ",", "," + Имя + ",") = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("Имя", Имя);
	Результат.Вставить("Закрывающий", Закрывающий);
	Возврат Результат;

КонецФункции

Функция ИменаТеговБитрикса()

	// Вторая строка — теги чата (комментарии, Ф15): ссылка на чат, кнопки, звонок, иконка, дата, перенос строки.
	Возврат "B,I,U,S,COLOR,SIZE,FONT,SUP,SUB,URL,USER,DISK,IMG,VIDEO,"
		+ "QUOTE,CODE,P,CENTER,LEFT,RIGHT,JUSTIFY,SPOILER,LIST,*,TABLE,TR,TD,TH,"
		+ "CHAT,PCH,CALL,SEND,PUT,CONTEXT,ICON,BR,TIMESTAMP";

КонецФункции

Функция ЗаменаОткрывающегоТега(Имя)

	Если Имя = "*" Тогда
		Возврат Символы.ПС + "- ";
	КонецЕсли;
	Если СтрНайти(",QUOTE,CODE,P,CENTER,LEFT,RIGHT,JUSTIFY,SPOILER,LIST,TABLE,TR,BR,", "," + Имя + ",") > 0 Тогда
		Возврат Символы.ПС;
	КонецЕсли;
	Возврат "";

КонецФункции

Функция ЗаменаЗакрывающегоТега(Имя)

	Если Имя = "TD" Или Имя = "TH" Тогда
		Возврат МаркерЯчейки();
	КонецЕсли;
	Если СтрНайти(",QUOTE,CODE,P,CENTER,LEFT,RIGHT,JUSTIFY,SPOILER,LIST,TABLE,TR,", "," + Имя + ",") > 0 Тогда
		Возврат Символы.ПС;
	КонецЕсли;
	Возврат "";

КонецФункции

// Текст из HTML: теги убраны (блочные дают перенос строки, <li> — «- », конец ячейки — маркер), коды символов
// расшифрованы. «<» без буквы после неё — обычный знак.
Функция ТекстИзHTML(Знач Текст)

	// Перенос строки в исходнике HTML — обычный пробел; настоящие переносы дают теги <br>, <p>, <li>.
	Текст = СтрЗаменить(СтрЗаменить(Текст, Символы.ВК, " "), Символы.ПС, " ");
	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Найдено = СтрНайти(Текст, "<", НаправлениеПоиска.СНачала, Позиция);
		Если Найдено = 0 Тогда
			Части.Добавить(Сред(Текст, Позиция));
			Прервать;
		КонецЕсли;
		Части.Добавить(Сред(Текст, Позиция, Найдено - Позиция));

		Закрытие = СтрНайти(Текст, ">", НаправлениеПоиска.СНачала, Найдено);
		Следующий = Сред(Текст, Найдено + 1, 1);
		НачалоТега = Следующий = "/" Или Следующий = "!" Или (ВРег(Следующий) <> НРег(Следующий));
		Если Закрытие = 0 Или Не НачалоТега Тогда
			Части.Добавить("<");
			Позиция = Найдено + 1;
			Продолжить;
		КонецЕсли;

		Тег = Сред(Текст, Найдено + 1, Закрытие - Найдено - 1);
		Закрывающий = Лев(Тег, 1) = "/";
		Части.Добавить(ЗаменаТегаHTML(ИмяТегаHTML(Тег), Закрывающий));
		Позиция = Закрытие + 1;
	КонецЦикла;

	Возврат РасшифрованныеКодыHTML(СтрСоединить(Части));

КонецФункции

Функция ИмяТегаHTML(Знач Тег)

	Если Лев(Тег, 1) = "/" Тогда
		Тег = Сред(Тег, 2);
	КонецЕсли;
	Конец = СтрДлина(Тег) + 1;
	Для Номер = 1 По СтрДлина(Тег) Цикл
		Знак = Сред(Тег, Номер, 1);
		Если Знак = " " Или Знак = "/" Или Знак = Символы.ПС Или Знак = Символы.Таб Тогда
			Конец = Номер;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат ВРег(Лев(Тег, Конец - 1));

КонецФункции

Функция ЗаменаТегаHTML(Имя, Закрывающий)

	Если Имя = "LI" Тогда
		Возврат ?(Закрывающий, Символы.ПС, Символы.ПС + "- ");
	КонецЕсли;
	Если Имя = "TD" Или Имя = "TH" Тогда
		Возврат ?(Закрывающий, МаркерЯчейки(), "");
	КонецЕсли;
	Если СтрНайти(",BR,P,DIV,TR,UL,OL,TABLE,H1,H2,H3,H4,H5,H6,BLOCKQUOTE,HR,PRE,", "," + Имя + ",") > 0 Тогда
		Возврат Символы.ПС;
	КонецЕсли;
	Возврат "";

КонецФункции

// Расшифровывает &nbsp; &quot; &apos; &lt; &gt; &amp; и числовые коды (&#171; &#xAB;). Неизвестное остаётся как есть.
// &amp; расшифровывается последним: «&amp;lt;» должно стать «&lt;», а не «<».
Функция РасшифрованныеКодыHTML(Знач Текст)

	Если СтрНайти(Текст, "&") = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Части = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Найдено = СтрНайти(Текст, "&#", НаправлениеПоиска.СНачала, Позиция);
		Если Найдено = 0 Тогда
			Части.Добавить(Сред(Текст, Позиция));
			Прервать;
		КонецЕсли;
		Части.Добавить(Сред(Текст, Позиция, Найдено - Позиция));
		Закрытие = СтрНайти(Текст, ";", НаправлениеПоиска.СНачала, Найдено);
		Код = -1;
		Если Закрытие > 0 И Закрытие - Найдено <= 8 Тогда
			Код = КодСимволаHTML(Сред(Текст, Найдено + 2, Закрытие - Найдено - 2));
		КонецЕсли;
		Если Код < 9 Или Код > 65535 Тогда
			Части.Добавить("&#");
			Позиция = Найдено + 2;
		Иначе
			Части.Добавить(Символ(Код));
			Позиция = Закрытие + 1;
		КонецЕсли;
	КонецЦикла;

	Текст = СтрСоединить(Части);
	Текст = СтрЗаменить(Текст, "&nbsp;", " ");
	Текст = СтрЗаменить(Текст, "&quot;", """");
	Текст = СтрЗаменить(Текст, "&apos;", "'");
	Текст = СтрЗаменить(Текст, "&lt;", "<");
	Текст = СтрЗаменить(Текст, "&gt;", ">");
	Возврат СтрЗаменить(Текст, "&amp;", "&");

КонецФункции

// Число по записи кода символа HTML без «&#» и «;»: «171» или «xAB». -1, если запись неверна.
Функция КодСимволаHTML(Запись)

	Если ПустаяСтрока(Запись) Тогда
		Возврат -1;
	КонецЕсли;
	Основание = 10;
	Если ВРег(Лев(Запись, 1)) = "X" Тогда
		Основание = 16;
		Запись = Сред(Запись, 2);
		Если ПустаяСтрока(Запись) Тогда
			Возврат -1;
		КонецЕсли;
	КонецЕсли;

	Результат = 0;
	Для Номер = 1 По СтрДлина(Запись) Цикл
		Цифра = СтрНайти("0123456789ABCDEF", ВРег(Сред(Запись, Номер, 1))) - 1;
		Если Цифра < 0 Или Цифра >= Основание Тогда
			Возврат -1;
		КонецЕсли;
		Результат = Результат * Основание + Цифра;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Приводит текст к виду для ИИ: переносы — только ПС, пробелы схлопнуты, строки обрезаны по краям, пустых строк нет.
// Строка с маркерами ячеек становится строкой таблицы: ячейки через « | » без хвостовой пустой ячейки.
Функция ПриведенныеСтроки(Знач Текст)

	Текст = СтрЗаменить(Текст, Символы.ВК + Символы.ПС, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.ВК, Символы.ПС);
	Текст = СтрЗаменить(Текст, Символы.НПП, " ");
	Текст = СтрЗаменить(Текст, Символы.Таб, " ");

	Строки = Новый Массив;
	Для Каждого ТекстСтроки Из СтрРазделить(Текст, Символы.ПС) Цикл
		Если СтрНайти(ТекстСтроки, МаркерЯчейки()) > 0 Тогда
			ТекстСтроки = СтрокаТаблицы(ТекстСтроки);
		Иначе
			ТекстСтроки = СхлопнутыеПробелы(СокрЛП(ТекстСтроки));
		КонецЕсли;
		Если ТекстСтроки <> "" Тогда
			Строки.Добавить(ТекстСтроки);
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Строки, Символы.ПС);

КонецФункции

Функция СтрокаТаблицы(ТекстСтроки)

	Ячейки = СтрРазделить(ТекстСтроки, МаркерЯчейки());
	Если ПустаяСтрока(Ячейки[Ячейки.ВГраница()]) Тогда
		Ячейки.Удалить(Ячейки.ВГраница());
	КонецЕсли;

	ЕстьТекст = Ложь;
	Для Номер = 0 По Ячейки.ВГраница() Цикл
		Ячейки[Номер] = СхлопнутыеПробелы(СокрЛП(Ячейки[Номер]));
		ЕстьТекст = ЕстьТекст Или Ячейки[Номер] <> "";
	КонецЦикла;
	Если Не ЕстьТекст Тогда
		Возврат "";
	КонецЕсли;
	Возврат СхлопнутыеПробелы(СтрСоединить(Ячейки, " | "));

КонецФункции

Функция СхлопнутыеПробелы(Знач Текст)

	Пока СтрНайти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Начало текста не длиннее Максимум символов; слово, которое не поместилось целиком, отбрасывается.
Функция ОбрезанноеПоСлову(Текст, Максимум)

	Начало = Лев(Текст, Максимум);
	Следующий = Сред(Текст, Максимум + 1, 1);
	Если Следующий <> " " И Следующий <> Символы.ПС Тогда
		Позиция = Максимум;
		Пока Позиция >= 1 Цикл
			Знак = Сред(Начало, Позиция, 1);
			Если Знак = " " Или Знак = Символы.ПС Тогда
				Начало = Лев(Начало, Позиция - 1);
				Прервать;
			КонецЕсли;
			Позиция = Позиция - 1;
		КонецЦикла;
	КонецЕсли;
	Возврат СокрП(Начало);

КонецФункции

// Записи среза последних регистра формулировок на дату: Соответствие «шифр → описание». Описание может быть пустым
// (формулировка снята), поэтому пустые записи остаются в соответствии — по ним видно, что шифр на эту дату был.
Функция ЗаписиСреза(Дата)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Формулировки.Шифр КАК Шифр,
	|	Формулировки.Описание КАК Описание
	|ИЗ
	|	РегистрСведений.ГЕМ_ШаблоныДляЗаполненияТабелей.СрезПоследних(&Дата) КАК Формулировки";

	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.Шифр, ?(Выборка.Описание = Неопределено, "", Выборка.Описание));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Предел токенов ответа (токены рассуждения входят в него). Выбран по живому прогону 18.6 на уровне «low»: самый длинный
// ответ набора — 320 токенов, из них 273 рассуждение. Предел рассчитан не на набор, а на самый длинный возможный ответ:
// текст в 1000 символов (около 450 токенов), служебные поля схемы (около 100) и рассуждение с двойным запасом над
// наблюдавшимся. Лишнее не тратится: оплачиваются только использованные токены.
Функция МаксимумТокеновОтвета()

	Возврат 1600;

КонецФункции

Функция СхемаТипа(ИмяТипа)

	Схема = Новый Структура;
	Схема.Вставить("type", ИмяТипа);
	Возврат Схема;

КонецФункции

Функция СхемаМассиваСтрок()

	Схема = СхемаТипа("array");
	Схема.Вставить("items", СхемаТипа("string"));
	Возврат Схема;

КонецФункции

// Текст настройки без пробелов по краям; не строка — пусто.
Функция ТекстНастройки(Значение)

	Возврат ?(ТипЗнч(Значение) = Тип("Строка"), СокрЛП(Значение), "");

КонецФункции

// Раздел указаний: пустая строка, заголовок, пояснение, текст.
Функция РазделЗапроса(Заголовок, Пояснение, Текст)

	Возврат Символы.ПС + Символы.ПС + "# " + Заголовок + Символы.ПС + Пояснение + Символы.ПС + Текст;

КонецФункции

// Раздел стандартных формулировок. Список — JSON-массив одной строкой, последней в запросе; пустой список меняет задание
// на «только по правилам».
Функция РазделФормулировок(Формулировки)

	Если ТипЗнч(Формулировки) <> Тип("Массив") Или Формулировки.Количество() = 0 Тогда
		Возврат РазделЗапроса("Стандартные формулировки",
			НСтр("ru = 'Список стандартных формулировок пуст: пиши текст только своими словами по правилам (own_words — true, codes — пустой массив).'"),
			"");
	КонецЕсли;

	Список = Новый Массив;
	Для Каждого Формулировка Из Формулировки Цикл
		Список.Добавить(Новый Структура("code, text", Формулировка.Шифр, Формулировка.Описание));
	КонецЦикла;
	Возврат РазделЗапроса("Стандартные формулировки",
		НСтр("ru = 'JSON-массив: code — шифр формулировки, text — её текст. Выбирай и используй их по правилам выше.'"),
		ТекстJSONВОднуСтроку(Список));

КонецФункции

// Значение в JSON одной строкой: переносы и кавычки внутри текстов экранируются, символы не заменяются кодами.
Функция ТекстJSONВОднуСтроку(Значение)

	Писатель = Новый ЗаписьJSON;
	Писатель.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Писатель, Значение);
	Возврат Писатель.Закрыть();

КонецФункции

// Приведение ответа ИИ (Ф11, 18.1)

// Строка без маркера списка в начале: «- », «* », «• », «– », «— ». Минус без пробела («-5») маркером не считается.
Функция БезМаркераСписка(Знач ТекстСтроки)

	Для Каждого Маркер Из СтрРазделить("-,*,•,–,—", ",") Цикл
		Если СтрНачинаетсяС(ТекстСтроки, Маркер + " ") Тогда
			Возврат СокрЛ(Сред(ТекстСтроки, СтрДлина(Маркер) + 2));
		КонецЕсли;
	КонецЦикла;
	Возврат ТекстСтроки;

КонецФункции

// Строка с точкой в конце: запятая, точка с запятой и двоеточие в конце отбрасываются; если строка не кончается на «.»,
// «!», «?» или «…», ставится точка. Пустая строка остаётся пустой.
Функция СТочкойВКонце(Знач ТекстСтроки)

	ТекстСтроки = СокрЛП(ТекстСтроки);
	Пока ТекстСтроки <> "" И СтрНайти(",;:", Прав(ТекстСтроки, 1)) > 0 Цикл
		ТекстСтроки = СокрП(Лев(ТекстСтроки, СтрДлина(ТекстСтроки) - 1));
	КонецЦикла;
	Если ТекстСтроки = "" Или СтрНайти(".!?…", Прав(ТекстСтроки, 1)) > 0 Тогда
		Возврат ТекстСтроки;
	КонецЕсли;
	Возврат ТекстСтроки + ".";

КонецФункции

// Строка без необязательных мест «(название ИБ)», «(........)» и «(если надо)» вместе с пробелами перед ними. Скобки
// с другим содержимым, в том числе обязательные места «(чей ПК)», остаются.
Функция БезНеобязательныхМест(Знач ТекстСтроки)

	Позиция = 1;
	// Начальная позиция поиска не может быть за концом строки: после места в конце текста Позиция = длина + 1.
	Пока Позиция <= СтрДлина(ТекстСтроки) Цикл
		Открывающая = СтрНайти(ТекстСтроки, "(", , Позиция);
		Если Открывающая = 0 Тогда
			Прервать;
		КонецЕсли;
		Закрывающая = СтрНайти(ТекстСтроки, ")", , Открывающая);
		Если Закрывающая = 0 Тогда
			Прервать;
		КонецЕсли;

		Внутри = Сред(ТекстСтроки, Открывающая + 1, Закрывающая - Открывающая - 1);
		Если СтрНайти(Внутри, "(") > 0 Тогда
			// Вложенная скобка: проверяется ближайшая открывающая.
			Позиция = Открывающая + 1;
		ИначеЕсли ЭтоНеобязательноеМесто(Внутри) Тогда
			НачалоМеста = Открывающая;
			Пока НачалоМеста > 1 И Сред(ТекстСтроки, НачалоМеста - 1, 1) = " " Цикл
				НачалоМеста = НачалоМеста - 1;
			КонецЦикла;
			ТекстСтроки = Лев(ТекстСтроки, НачалоМеста - 1) + Сред(ТекстСтроки, Закрывающая + 1);
			Позиция = НачалоМеста;
		Иначе
			Позиция = Закрывающая + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СокрЛП(СхлопнутыеПробелы(ТекстСтроки));

КонецФункции

// Скобки с таким содержимым — необязательное место для заполнения (Ф11): без значения оно убирается.
Функция ЭтоНеобязательноеМесто(Внутри)

	Верхний = ВРег(Внутри);
	Возврат Верхний = "НАЗВАНИЕ ИБ" Или Верхний = "ЕСЛИ НАДО"
		Или СтрДлина(Внутри) >= 3 И СтрЗаменить(Внутри, ".", "") = "";

КонецФункции

// «Иванов И. И.» → «Иванов И.И.»: после фамилии (прописная и строчные буквы) два инициала подряд склеиваются.
Функция ИнициалыБезПробела(Знач Текст)

	Слова = СтрРазделить(Текст, " ");
	Результат = Новый Массив;
	Номер = 0;
	Пока Номер <= Слова.ВГраница() Цикл
		Результат.Добавить(Слова[Номер]);
		Если Номер + 2 <= Слова.ВГраница() И ПохожеНаФамилию(Слова[Номер]) И ЭтоИнициал(Слова[Номер + 1])
			И НачинаетсяСИнициала(Слова[Номер + 2]) Тогда
			Результат.Добавить(Слова[Номер + 1] + Слова[Номер + 2]);
			Номер = Номер + 3;
		Иначе
			Номер = Номер + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Результат, " ");

КонецФункции

// Слово из прописной и строчных русских букв («Иванов»). Аббревиатура («ЭСФ») фамилией не считается.
Функция ПохожеНаФамилию(Слово)

	Если СтрДлина(Слово) < 2 Или Не ЭтоПрописнаяКириллица(Сред(Слово, 1, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 2 По СтрДлина(Слово) Цикл
		Если Не ЭтоСтрочнаяКириллица(Сред(Слово, Номер, 1)) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// Ровно инициал: прописная русская буква и точка.
Функция ЭтоИнициал(Слово)

	Возврат СтрДлина(Слово) = 2 И ЭтоПрописнаяКириллица(Сред(Слово, 1, 1)) И Сред(Слово, 2, 1) = ".";

КонецФункции

// Слово начинается с инициала («И.», «И.,», «И.)»): за точкой не идёт буква или цифра.
Функция НачинаетсяСИнициала(Слово)

	Возврат СтрДлина(Слово) >= 2 И ЭтоПрописнаяКириллица(Сред(Слово, 1, 1)) И Сред(Слово, 2, 1) = "."
		И Не ЭтоБукваИлиЦифра(Сред(Слово, 3, 1));

КонецФункции

// «2026 г.» → «2026г.», «31.12.2025 г.» → «31.12.2025г.», «2026г..» → «2026г.» (вторая точка — конец предложения, а не
// ещё одна точка сокращения). «2026 года» не меняется.
Функция ГодСлитно(Знач Текст)

	Результат = Новый Массив;
	Длина = СтрДлина(Текст);
	Номер = 1;
	Пока Номер <= Длина Цикл
		Знак = Сред(Текст, Номер, 1);
		Если Знак = " " И Номер > 1 И ЭтоЦифра(Сред(Текст, Номер - 1, 1)) И Сред(Текст, Номер + 1, 2) = "г."
			И Не ЭтоБукваИлиЦифра(Сред(Текст, Номер + 3, 1)) Тогда
			Номер = Номер + 1;
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Знак);
		Номер = Номер + 1;
	КонецЦикла;
	Текст = СтрСоединить(Результат);

	Результат = Новый Массив;
	Длина = СтрДлина(Текст);
	Номер = 1;
	Пока Номер <= Длина Цикл
		Знак = Сред(Текст, Номер, 1);
		Если Знак = "г" И Номер > 1 И ЭтоЦифра(Сред(Текст, Номер - 1, 1)) И Сред(Текст, Номер + 1, 2) = ".."
			И Сред(Текст, Номер + 3, 1) <> "." Тогда
			Результат.Добавить("г.");
			Номер = Номер + 3;
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Знак);
		Номер = Номер + 1;
	КонецЦикла;
	Возврат СтрСоединить(Результат);

КонецФункции

// «работа по извещениям» → «работа по Извещениям»; «обязательство по Извещениям» → «обязательство по извещениям».
Функция РегистрИзвещений(Знач Текст)

	Текст = РегистрСлова(Текст, "работа по ", "извещениям", "Извещениям");
	Возврат РегистрСлова(Текст, "обязательство по ", "извещениям", "извещениям");

КонецФункции

// Слово после начала фразы получает нужный регистр. Фраза ищется без учёта регистра и только целыми словами.
Функция РегистрСлова(Знач Текст, Начало, Слово, Правильно)

	Образец = ВРег(Начало + Слово);
	ВерхнийТекст = ВРег(Текст);
	Позиция = СтрНайти(ВерхнийТекст, Образец);
	Пока Позиция > 0 Цикл
		После = Позиция + СтрДлина(Образец);
		Если (Позиция = 1 Или Не ЭтоБукваИлиЦифра(Сред(Текст, Позиция - 1, 1)))
			И Не ЭтоБукваИлиЦифра(Сред(Текст, После, 1)) Тогда
			Текст = Лев(Текст, Позиция - 1 + СтрДлина(Начало)) + Правильно + Сред(Текст, После);
		КонецЕсли;
		Позиция = СтрНайти(ВерхнийТекст, Образец, , Позиция + 1);
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Пробелы внутри адреса сайта и e-mail: «openai . com» → «openai.com». Адрес — метки через точки (вокруг точек могут
// быть пробелы), оканчивающиеся зоной kz, ru, com, org, net, рф или қаз; после зоны идут конец текста, пробел или знак
// из «/ : ? # ) , ; ! ? . …» (как в боте проверки табелей). Конец предложения и имя файла адресом не считаются.
Функция АдресаБезПробелов(Знач Текст)

	Для Каждого Зона Из СтрРазделить("KZ,RU,COM,ORG,NET,РФ,ҚАЗ", ",") Цикл
		Начало = 1;
		Пока Начало <= СтрДлина(Текст) Цикл
			Позиция = СтрНайти(ВРег(Текст), Зона, , Начало);
			Если Позиция = 0 Тогда
				Прервать;
			КонецЕсли;

			Начало = Позиция + 1;
			Границы = ГраницыАдреса(Текст, Позиция, СтрДлина(Зона));
			Если Границы = Неопределено Тогда
				Продолжить;
			КонецЕсли;

			Адрес = Сред(Текст, Границы.НачалоАдреса, Границы.КонецАдреса - Границы.НачалоАдреса + 1);
			Если СтрНайти(Адрес, " ") = 0 Тогда
				Продолжить;
			КонецЕсли;
			Адрес = СтрЗаменить(Адрес, " ", "");
			Текст = Лев(Текст, Границы.НачалоАдреса - 1) + Адрес + Сред(Текст, Границы.КонецАдреса + 1);
			Начало = Границы.НачалоАдреса + СтрДлина(Адрес);
		КонецЦикла;
	КонецЦикла;
	Возврат Текст;

КонецФункции

// Границы адреса, который оканчивается зоной в данной позиции: Неопределено, если это не адрес. От зоны идём назад:
// пробелы, точка, пробелы, метка из букв, цифр и «-», и так, пока перед меткой снова стоит точка.
Функция ГраницыАдреса(Текст, ПозицияЗоны, ДлинаЗоны)

	КонецЗоны = ПозицияЗоны + ДлинаЗоны - 1;
	Следующий = Сред(Текст, КонецЗоны + 1, 1);
	Если Следующий <> "" И СтрНайти(" /:?#),;!?.…" + Символы.ПС + Символы.Таб + Символы.НПП, Следующий) = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;

	НачалоАдреса = 0;
	Позиция = ПозицияЗоны - 1;
	Пока Истина Цикл
		Пока Позиция >= 1 И Сред(Текст, Позиция, 1) = " " Цикл
			Позиция = Позиция - 1;
		КонецЦикла;
		Если Позиция < 1 Или Сред(Текст, Позиция, 1) <> "." Тогда
			Прервать;
		КонецЕсли;

		Позиция = Позиция - 1;
		Пока Позиция >= 1 И Сред(Текст, Позиция, 1) = " " Цикл
			Позиция = Позиция - 1;
		КонецЦикла;
		КонецМетки = Позиция;
		Пока Позиция >= 1 И (ЭтоБукваИлиЦифра(Сред(Текст, Позиция, 1)) Или Сред(Текст, Позиция, 1) = "-") Цикл
			Позиция = Позиция - 1;
		КонецЦикла;
		Если Позиция = КонецМетки Тогда
			Прервать;
		КонецЕсли;
		НачалоАдреса = Позиция + 1;
	КонецЦикла;

	Если НачалоАдреса = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("НачалоАдреса, КонецАдреса", НачалоАдреса, КонецЗоны);

КонецФункции

// Текст не длиннее 1000 символов: по концу последнего целого предложения, а если его нет — по последнему целому слову
// с точкой (одна позиция остаётся на точку).
Функция ОбрезанныйДоМаксимума(Знач Текст)

	Предел = МаксимумСимволовСодержания();
	Если СтрДлина(Текст) <= Предел Тогда
		Возврат Текст;
	КонецЕсли;

	Позиция = Предел;
	Пока Позиция >= 1 Цикл
		Если ЭтоКонецПредложения(Текст, Позиция) Тогда
			Возврат Лев(Текст, Позиция);
		КонецЕсли;
		Позиция = Позиция - 1;
	КонецЦикла;
	Возврат СТочкойВКонце(ОбрезанноеПоСлову(Текст, Предел - 1));

КонецФункции

// В позиции «.», «!», «?» или «…», за которым идут пробел и прописная буква, а слово перед знаком — не одна буква
// (инициал). «300ф. за» (строчная буква) и «3кв. 2026» (цифра) предложение не заканчивают.
Функция ЭтоКонецПредложения(Текст, Позиция)

	Если СтрНайти(".!?…", Сред(Текст, Позиция, 1)) = 0 Или Сред(Текст, Позиция + 1, 1) <> " "
		Или Не ЭтоПрописнаяБуква(Сред(Текст, Позиция + 2, 1)) Тогда
		Возврат Ложь;
	КонецЕсли;

	НачалоСлова = Позиция;
	Пока НачалоСлова > 1 И Сред(Текст, НачалоСлова - 1, 1) <> " " Цикл
		НачалоСлова = НачалоСлова - 1;
	КонецЦикла;
	Возврат Позиция - НачалоСлова > 1;

КонецФункции

Функция ЭтоЦифра(Символ)

	Возврат Символ <> "" И СтрНайти("0123456789", Символ) > 0;

КонецФункции

Функция ЭтоБукваИлиЦифра(Символ)

	Возврат Символ <> "" И (ЭтоЦифра(Символ) Или ВРег(Символ) <> НРег(Символ));

КонецФункции

Функция ЭтоПрописнаяБуква(Символ)

	Возврат Символ <> "" И ВРег(Символ) = Символ И НРег(Символ) <> Символ;

КонецФункции

Функция ЭтоПрописнаяКириллица(Символ)

	Если Символ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ);
	Возврат Код >= 1040 И Код <= 1071 Или Код = 1025;

КонецФункции

Функция ЭтоСтрочнаяКириллица(Символ)

	Если Символ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ);
	Возврат Код >= 1072 И Код <= 1103 Или Код = 1105;

КонецФункции

// Пароли (Ф15, 23.6)

// Где в тексте значение пароля после слова-ключа, кончающегося перед Позиция: Структура Начало и Конец (позиция после
// значения) или Неопределено, если пароля нет. Сначала ищется знак «:», «=», «-», «—» сразу за словом или через
// одно-три слова той же строки; поиск обрывается на слове с точкой, запятой, «;», «!» или «?» в конце. Без знака —
// первое слово, если в нём есть латиница или цифры, или значение в кавычках.
Функция ГраницыПароля(Текст, Позиция)

	Длина = СтрДлина(Текст);
	П = ПослеПробеловСтроки(Текст, Позиция);
	Если П > Длина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Символ = Сред(Текст, П, 1);
	Если ЭтоЗнакПароля(Символ) Тогда
		Возврат ЗначениеПослеЗнака(Текст, П + 1);
	КонецЕсли;
	Если СтрНайти(".,;!?)", Символ) > 0 Или ЭтоПереводСтроки(Символ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПервоеСлово = Неопределено;
	Т = П;
	Для НомерСлова = 1 По 3 Цикл
		Т = ПослеПробеловСтроки(Текст, Т);
		Если Т > Длина Или ЭтоПереводСтроки(Сред(Текст, Т, 1)) Тогда
			Прервать;
		КонецЕсли;
		Если НомерСлова = 1 И ЭтоОткрывающаяКавычка(Сред(Текст, Т, 1)) Тогда
			Возврат ЗначениеВКавычках(Текст, Т);
		КонецЕсли;
		КонецСлова = Т;
		Пока КонецСлова <= Длина И Не ЭтоПробел(Сред(Текст, КонецСлова, 1)) Цикл
			КонецСлова = КонецСлова + 1;
		КонецЦикла;
		СловоЦеликом = Сред(Текст, Т, КонецСлова - Т);
		Если СловоЦеликом = "-" Или СловоЦеликом = "—" Или СловоЦеликом = "–" Тогда
			Возврат ЗначениеПослеЗнака(Текст, Т + 1);
		КонецЕсли;
		Для Номер = 1 По СтрДлина(СловоЦеликом) Цикл
			Знак = Сред(СловоЦеликом, Номер, 1);
			Если Знак = ":" Или Знак = "=" Тогда
				Возврат ЗначениеПослеЗнака(Текст, Т + Номер);
			КонецЕсли;
		КонецЦикла;
		Слово = ГраницыЗначения(Текст, Т);
		Если НомерСлова = 1 Тогда
			ПервоеСлово = Слово;
			// Цифры в первом слове — почти наверняка пароль: дальше знак не ищется («пароль Qwerty123 для входа: да»).
			Если Слово <> Неопределено И ПохожеНаПароль(Сред(Текст, Слово.Начало, Слово.Конец - Слово.Начало), Истина) Тогда
				Возврат Слово;
			КонецЕсли;
		КонецЕсли;
		Если СтрНайти(".,;!?", Прав(СловоЦеликом, 1)) > 0 Тогда
			Прервать;
		КонецЕсли;
		Т = КонецСлова;
	КонецЦикла;

	Если ПервоеСлово <> Неопределено
		И ПохожеНаПароль(Сред(Текст, ПервоеСлово.Начало, ПервоеСлово.Конец - ПервоеСлово.Начало), Ложь) Тогда
		Возврат ПервоеСлово;
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

// Значение после знака: пробелы и переносы строк пропускаются, значение в кавычках берётся целиком.
Функция ЗначениеПослеЗнака(Текст, Позиция)

	Длина = СтрДлина(Текст);
	П = Позиция;
	Пока П <= Длина И ЭтоПробел(Сред(Текст, П, 1)) Цикл
		П = П + 1;
	КонецЦикла;
	Если П > Длина Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если ЭтоОткрывающаяКавычка(Сред(Текст, П, 1)) Тогда
		Возврат ЗначениеВКавычках(Текст, П);
	КонецЕсли;
	Возврат ГраницыЗначения(Текст, П);

КонецФункции

// Значение без кавычек: до пробела, запятой или «;»; точки и закрывающие скобки в конце в значение не входят.
Функция ГраницыЗначения(Текст, Начало)

	Длина = СтрДлина(Текст);
	Конец = Начало;
	Пока Конец <= Длина Цикл
		Символ = Сред(Текст, Конец, 1);
		Если ЭтоПробел(Символ) Или Символ = "," Или Символ = ";" Тогда
			Прервать;
		КонецЕсли;
		Конец = Конец + 1;
	КонецЦикла;
	Пока Конец > Начало И СтрНайти(".)", Сред(Текст, Конец - 1, 1)) > 0 Цикл
		Конец = Конец - 1;
	КонецЦикла;
	Если Конец = Начало Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец", Начало, Конец);

КонецФункции

// Значение в кавычках: от открывающей до парной закрывающей, сами кавычки остаются; нет закрывающей — до конца строки.
Функция ЗначениеВКавычках(Текст, ПозицияКавычки)

	Длина = СтрДлина(Текст);
	Открывающая = Сред(Текст, ПозицияКавычки, 1);
	Закрывающие = ?(Открывающая = "«", "»", ?(Открывающая = "„" Или Открывающая = "“", "“”", Открывающая));
	Начало = ПозицияКавычки + 1;
	Конец = Начало;
	Пока Конец <= Длина Цикл
		Символ = Сред(Текст, Конец, 1);
		Если СтрНайти(Закрывающие, Символ) > 0 Или ЭтоПереводСтроки(Символ) Тогда
			Прервать;
		КонецЕсли;
		Конец = Конец + 1;
	КонецЦикла;
	Если Конец = Начало Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Начало, Конец", Начало, Конец);

КонецФункции

// Слово после ключа без знака считается паролем, если в нём есть латиница или цифры (ТолькоЦифры — только цифры)
// и это не название программы, которое часто стоит рядом со словом «пароль».
Функция ПохожеНаПароль(Слово, ТолькоЦифры)

	Если СтрРазделить("1С,1C,RDP,VPN,WINDOWS,WI-FI,WIFI", ",").Найти(ВРег(Слово)) <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Номер = 1 По СтрДлина(Слово) Цикл
		Символ = Сред(Слово, Номер, 1);
		Если ЭтоЦифра(Символ) Или (Не ТолькоЦифры И ЭтоЛатиница(Символ)) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

Функция ЭтоСловоПароля(Слово)

	Возврат СтрРазделить("пароль,пароля,паролю,паролем,паролём,пароле,пароли,паролей,паролям,паролями,паролях,"
		+ "password,pass,passwd,пасс,pwd", ",").Найти(НРег(Слово)) <> Неопределено;

КонецФункции

// Буква слова-ключа: латиница или кириллица (Ё и ё тоже).
Функция ЭтоБукваПароля(Символ)

	Возврат Символ <> "" И ВРег(Символ) <> НРег(Символ);

КонецФункции

Функция ЭтоЛатиница(Символ)

	Если Символ = "" Тогда
		Возврат Ложь;
	КонецЕсли;
	Код = КодСимвола(Символ);
	Возврат Код >= 65 И Код <= 90 Или Код >= 97 И Код <= 122;

КонецФункции

Функция ЭтоЗнакПароля(Символ)

	Возврат Символ <> "" И СтрНайти(":=-—–", Символ) > 0;

КонецФункции

Функция ЭтоОткрывающаяКавычка(Символ)

	Возврат Символ <> "" И СтрНайти("""«„“'", Символ) > 0;

КонецФункции

Функция ЭтоПробел(Символ)

	Возврат Символ = " " Или Символ = Символы.Таб Или Символ = Символы.НПП Или ЭтоПереводСтроки(Символ);

КонецФункции

Функция ЭтоПереводСтроки(Символ)

	Возврат Символ = Символы.ПС Или Символ = Символы.ВК;

КонецФункции

// Позиция после пробелов и табуляций той же строки (перевод строки не пропускается).
Функция ПослеПробеловСтроки(Текст, Позиция)

	Длина = СтрДлина(Текст);
	П = Позиция;
	Пока П <= Длина Цикл
		Символ = Сред(Текст, П, 1);
		Если Символ <> " " И Символ <> Символы.Таб И Символ <> Символы.НПП Тогда
			Прервать;
		КонецЕсли;
		П = П + 1;
	КонецЦикла;
	Возврат П;

КонецФункции

// Места для заполнения (Ф11, Ф12, 18.2)

// Места по постоянным признакам: таблица с колонками Начало и Длина (позиция в тексте и длина записи).
Функция ПостоянныеМеста(Текст)

	Места = Новый ТаблицаЗначений;
	Места.Колонки.Добавить("Начало");
	Места.Колонки.Добавить("Длина");

	ДобавитьМестаВСкобках(Места, Текст);
	ДобавитьМестаВКавычках(Места, Текст);
	Для Каждого Серия Из СерииЗнака(Текст, "?") Цикл
		ДобавитьМесто(Места, Серия.НачалоСерии, Серия.КонецСерии - Серия.НачалоСерии + 1);
	КонецЦикла;
	Для Каждого Серия Из СерииЗнака(Текст, ".") Цикл
		ДобавитьТочечноеМесто(Места, Текст, Серия);
	КонецЦикла;
	Возврат Места;

КонецФункции

// Место добавляется, только если не задевает уже найденные: одно и то же место считается один раз.
Процедура ДобавитьМесто(Места, Начало, Длина)

	КонецЗаписи = Начало + Длина - 1;
	Для Каждого Имеющееся Из Места Цикл
		Если Не (Имеющееся.Начало + Имеющееся.Длина - 1 < Начало Или КонецЗаписи < Имеющееся.Начало) Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	Место = Места.Добавить();
	Место.Начало = Начало;
	Место.Длина = Длина;

КонецПроцедуры

// Все вхождения записи в текст, которые не задевают найденные места.
Процедура ДобавитьВхожденияМеста(Места, Текст, Запись)

	Позиция = СтрНайти(Текст, Запись);
	Пока Позиция > 0 Цикл
		ДобавитьМесто(Места, Позиция, СтрДлина(Запись));
		Следующая = Позиция + СтрДлина(Запись);
		Если Следующая > СтрДлина(Текст) Тогда
			Прервать;
		КонецЕсли;
		Позиция = СтрНайти(Текст, Запись, , Следующая);
	КонецЦикла;

КонецПроцедуры

// Подсказки в скобках: «(чей ПК)», «(рег.номер)», «(рег номер)», «(указать сколько и какие ПК)», а также необязательные
// «(название ИБ)», «(если надо)» и «(........)». Скобки с другим содержимым — настоящее значение, не место.
Процедура ДобавитьМестаВСкобках(Места, Текст)

	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) Цикл
		Открывающая = СтрНайти(Текст, "(", , Позиция);
		Если Открывающая = 0 Тогда
			Прервать;
		КонецЕсли;
		Закрывающая = СтрНайти(Текст, ")", , Открывающая);
		Если Закрывающая = 0 Тогда
			Прервать;
		КонецЕсли;

		Внутри = Сред(Текст, Открывающая + 1, Закрывающая - Открывающая - 1);
		Если СтрНайти(Внутри, "(") > 0 Тогда
			Позиция = Открывающая + 1;
		Иначе
			Если ЭтоПодсказкаВСкобках(Внутри) Тогда
				ДобавитьМесто(Места, Открывающая, Закрывающая - Открывающая + 1);
			КонецЕсли;
			Позиция = Закрывающая + 1;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ЭтоПодсказкаВСкобках(Внутри)

	Возврат ЭтоНеобязательноеМесто(Внутри) Или ПодсказкиВСкобках().Найти(ВРег(Внутри)) <> Неопределено;

КонецФункции

// Обязательные подсказки в скобках, прописными: сравнение идёт без учёта регистра.
Функция ПодсказкиВСкобках()

	Подсказки = Новый Массив;
	Подсказки.Добавить("ЧЕЙ ПК");
	Подсказки.Добавить("РЕГ.НОМЕР");
	Подсказки.Добавить("РЕГ НОМЕР");
	Подсказки.Добавить("УКАЗАТЬ СКОЛЬКО И КАКИЕ ПК");
	Возврат Подсказки;

КонецФункции

// Подсказка в кавычках: ПК "чей" (сами кавычки входят в место).
Процедура ДобавитьМестаВКавычках(Места, Текст)

	Образец = """ЧЕЙ""";
	ВерхнийТекст = ВРег(Текст);
	Позиция = СтрНайти(ВерхнийТекст, Образец);
	Пока Позиция > 0 Цикл
		ДобавитьМесто(Места, Позиция, СтрДлина(Образец));
		Следующая = Позиция + СтрДлина(Образец);
		Если Следующая > СтрДлина(ВерхнийТекст) Тогда
			Прервать;
		КонецЕсли;
		Позиция = СтрНайти(ВерхнийТекст, Образец, , Следующая);
	КонецЦикла;

КонецПроцедуры

// Серии из трёх и более одинаковых знаков подряд: структуры НачалоСерии и КонецСерии (позиции знаков).
Функция СерииЗнака(Текст, Знак)

	Серии = Новый Массив;
	Длина = СтрДлина(Текст);
	Номер = 1;
	Пока Номер <= Длина Цикл
		Если Сред(Текст, Номер, 1) <> Знак Тогда
			Номер = Номер + 1;
			Продолжить;
		КонецЕсли;

		КонецСерии = Номер;
		Пока КонецСерии < Длина И Сред(Текст, КонецСерии + 1, 1) = Знак Цикл
			КонецСерии = КонецСерии + 1;
		КонецЦикла;
		Если КонецСерии - Номер + 1 >= 3 Тогда
			Серии.Добавить(Новый Структура("НачалоСерии, КонецСерии", Номер, КонецСерии));
		КонецЕсли;
		Номер = КонецСерии + 1;
	КонецЦикла;
	Возврат Серии;

КонецФункции

// Серия точек — место, только если она стоит на месте значения: «...кв.» (серия и «кв.» сразу за ней) или «3.0.....»
// (перед серией «цифры.цифры»). Многоточие в обычном тексте и «г..» местом не считаются.
Процедура ДобавитьТочечноеМесто(Места, Текст, Серия)

	Если Сред(Текст, Серия.КонецСерии + 1, 3) = "кв." Тогда
		ДобавитьМесто(Места, Серия.НачалоСерии, Серия.КонецСерии - Серия.НачалоСерии + 4);
		Возврат;
	КонецЕсли;

	// Цифры, точка, цифры перед серией.
	Позиция = Серия.НачалоСерии - 1;
	Пока Позиция >= 1 И ЭтоЦифра(Сред(Текст, Позиция, 1)) Цикл
		Позиция = Позиция - 1;
	КонецЦикла;
	Если Позиция = Серия.НачалоСерии - 1 Или Позиция < 1 Или Сред(Текст, Позиция, 1) <> "." Тогда
		Возврат;
	КонецЕсли;

	Позиция = Позиция - 1;
	КонецЦифр = Позиция;
	Пока Позиция >= 1 И ЭтоЦифра(Сред(Текст, Позиция, 1)) Цикл
		Позиция = Позиция - 1;
	КонецЦикла;
	Если Позиция = КонецЦифр Тогда
		Возврат;
	КонецЕсли;
	ДобавитьМесто(Места, Позиция + 1, Серия.КонецСерии - Позиция);

КонецПроцедуры

// Место, названное ИИ, принимается, если оно похоже на подсказку, есть в тексте и в одной из формулировок и не входит
// в известные «не места».
Функция ПринимаетсяНазванноеМесто(Название, Текст, Формулировки)

	Если ТипЗнч(Название) <> Тип("Строка") Или Не ПохожеНаПодсказку(Название) Или ЭтоНеМесто(Название)
		Или СтрНайти(Текст, Название) = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	Если ТипЗнч(Формулировки) = Тип("Массив") Тогда
		Для Каждого Формулировка Из Формулировки Цикл
			Если СтрНайти(Формулировка.Описание, Название) > 0 Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Ложь;

КонецФункции

// Подсказка — запись целиком в скобках «(…)», в кавычках «"…"» или в «ёлочках» ««…»».
Функция ПохожеНаПодсказку(Запись)

	Если СтрДлина(Запись) < 3 Тогда
		Возврат Ложь;
	КонецЕсли;

	Первый = Лев(Запись, 1);
	Последний = Прав(Запись, 1);
	Возврат Первый = "(" И Последний = ")" Или Первый = """" И Последний = """" Или Первый = "«" И Последний = "»";

КонецФункции

Функция ЭтоНеМесто(Запись)

	Верхний = ВРег(Запись);
	Для Каждого НеМесто Из НеМеста() Цикл
		Если ВРег(НеМесто) = Верхний Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;

КонецФункции

// Записи формулировок, которые похожи на подсказки, но уже содержат настоящее значение: местами для заполнения они не
// считаются, даже если ИИ назвал их незаполненными (Ф11).
Функция НеМеста()

	Записи = Новый Массив;
	Записи.Добавить("(продление)");
	Записи.Добавить("(новая)");
	Записи.Добавить("(30 МРП)");
	Записи.Добавить("(БУ/НУ)");
	Записи.Добавить("(1С:WebKassa)");
	Записи.Добавить("(Номенклатура, Контрагенты, Физ. лица, Сотрудники, Ед. изм., Банки)");
	Записи.Добавить("""НДС""");
	Записи.Добавить("""НДС к возмещению""");
	Записи.Добавить("""Налог на добавленную стоимость""");
	Записи.Добавить("""Заработная плата""");
	Записи.Добавить("""Приём на работу""");
	Записи.Добавить("""1С:Бухгалтерия 8 для Казахстана""");
	Записи.Добавить("""Аналитика учета соответствия""");
	Возврат Записи;

КонецФункции

// Разбор ответа ИИ (18.3)

// JSON из текста как Соответствие; не JSON, пусто и не строка — Неопределено. Текст исключения платформы не сохраняется:
// в нём может оказаться кусок ответа.
Функция РазобранныйJSON(Текст)

	Если ТипЗнч(Текст) <> Тип("Строка") Или ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Возврат Данные;

КонецФункции

// Только строковые элементы массива.
Функция СтроковыеЭлементы(Массив)

	Результат = Новый Массив;
	Если ТипЗнч(Массив) = Тип("Массив") Тогда
		Для Каждого Элемент Из Массив Цикл
			Если ТипЗнч(Элемент) = Тип("Строка") Тогда
				Результат.Добавить(Элемент);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Шифры формулировок, которые получил ИИ: Соответствие «шифр → Истина».
Функция ШифрыФормулировок(Формулировки)

	Шифры = Новый Соответствие;
	Если ТипЗнч(Формулировки) = Тип("Массив") Тогда
		Для Каждого Формулировка Из Формулировки Цикл
			Шифры.Вставить(Формулировка.Шифр, Истина);
		КонецЦикла;
	КонецЕсли;
	Возврат Шифры;

КонецФункции

#КонецОбласти
