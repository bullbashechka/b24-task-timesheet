//
// Возвращаемое значение:
//  Число
//
Функция МаксимумСимволовКомментариев() Экспорт

	Возврат 6000;

КонецФункции

// Наибольшее число символов одного комментария (Ф15, решение 5А этапа 23): от более длинного уходит начало.
//
// Возвращаемое значение:
//  Число
//
Функция МаксимумСимволовКомментария() Экспорт

	Возврат 1500;

КонецФункции

// Комментарии задачи для ИИ (Ф15) из отобранных сообщений чата (б24т_КомментарииЗадачи.КомментарииЗадачи).
// У каждого убирается блок «Цитировать» (линия из дефисов, имя автора с датой, старый текст, линия; решение 9А),
// оформление — как у описания (упоминание становится именем, файлы, картинки и видео убираются, теги чата тоже),
// скрываются пароли (СкрытьПароли). Комментарий, в котором не осталось текста, не передаётся. Комментарий длиннее
// 1500 символов обрезается по целому слову с пометкой. Всего уходит не больше 6000 символов: набираются от новых
// к старым, самые старые отбрасываются.
//
// Параметры:
//  Сообщения - Массив из Структура - от старых к новым: Текст, ЗаДень, Свой.
//  НеВсе - Булево - чат просмотрен не весь (предел 200 сообщений или обрыв): ИИ узнает, что получил не все.
//
// Возвращаемое значение:
//  Структура:
//   * Комментарии - Массив из Структура - от старых к новым:
//    ** Текст - Строка
//    ** ЗаДень - Булево
//    ** Свой - Булево
//    ** Обрезан - Булево - комментарий длиннее 1500 символов, передано его начало.
//   * Обрезаны - Булево - ИИ получил не все комментарии.
//   * Символов - Число - символов в переданных комментариях.
//
Функция КомментарииДляИИ(Сообщения, НеВсе) Экспорт

	Очищенные = Новый Массив;
	Если ТипЗнч(Сообщения) = Тип("Массив") Тогда
		Для Каждого Сообщение Из Сообщения Цикл
			Текст = ТекстКомментария(Сообщение.Текст);
			Если Текст = "" Тогда
				Продолжить;
			КонецЕсли;
			Обрезан = СтрДлина(Текст) > МаксимумСимволовКомментария();
			Если Обрезан Тогда
				Текст = ОбрезанноеПоСлову(Текст, МаксимумСимволовКомментария());
			КонецЕсли;
			Очищенные.Добавить(Новый Структура("Текст, ЗаДень, Свой, Обрезан", Текст, Сообщение.ЗаДень = Истина,
				Сообщение.Свой = Истина, Обрезан));
		КонецЦикла;
	КонецЕсли;

	// Набираются от новых к старым: при превышении предела отбрасываются самые старые.
	Первый = Очищенные.Количество();
	Символов = 0;
	Пока Первый > 0 И Символов + СтрДлина(Очищенные[Первый - 1].Текст) <= МаксимумСимволовКомментариев() Цикл
		Символов = Символов + СтрДлина(Очищенные[Первый - 1].Текст);
		Первый = Первый - 1;
	КонецЦикла;

	Комментарии = Новый Массив;
	Для Номер = Первый + 1 По Очищенные.Количество() Цикл
		Комментарии.Добавить(Очищенные[Номер - 1]);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Комментарии", Комментарии);
	Результат.Вставить("Обрезаны", НеВсе = Истина Или Первый > 0);
	Результат.Вставить("Символов", Символов);
	Возврат Результат;

КонецФункции

// Скрывает пароли в тексте, который уходит ИИ (Ф15; решения 1А, 2А этапа 23): в названии, описании, комментариях
// и черновике. Слово-ключ — «пароль» в любой форме, «password», «pass», «passwd», «пасс» или «pwd» отдельным словом
// в любом регистре. Если после него (сразу или через одно-три слова той же строки) стоит «:», «=», «-» или «—»,
// значение после знака до пробела, запятой или точки с запятой (точка в конце не входит) заменяется на «***»;
// значение в кавычках — целиком, кавычки остаются. Если знака нет, скрывается следующее слово, только если в нём есть
// латинские буквы или цифры и это не название программы («1С», «RDP», «VPN», «Windows», «Wi-Fi»). Остальной текст
// не меняется: БИН, номера версий и регистрационные номера нужны для формулировок.
//
// Параметры:
//  Текст - Строка, Неопределено
//
// Возвращаемое значение:
//  Строка - пусто, если передана не строка.
//
Функция СкрытьПароли(Знач Текст) Экспорт

	Если ТипЗнч(Текст) <> Тип("Строка") Или Текст = "" Тогда
		Возврат "";
	КонецЕсли;

	Части = Новый Массив;
	НачалоКуска = 1;
	Длина = СтрДлина(Текст);
	Позиция = 1;
	Пока Позиция <= Длина Цикл
		Символ = Сред(Текст, Позиция, 1);
		// Слово-ключ — только целое слово: перед ним не буква и не цифра («Компасс» и «1пароль» не ключи).
		Если Не ЭтоБукваПароля(Символ) Или (Позиция > 1 И ЭтоБукваИлиЦифра(Сред(Текст, Позиция - 1, 1))) Тогда
			Позиция = Позиция + 1;
			Продолжить;
		КонецЕсли;
		КонецСлова = Позиция;
		Пока КонецСлова <= Длина И ЭтоБукваПароля(Сред(Текст, КонецСлова, 1)) Цикл
			КонецСлова = КонецСлова + 1;
		КонецЦикла;
		Слово = Сред(Текст, Позиция, КонецСлова - Позиция);
		Позиция = КонецСлова;
		Если Не ЭтоСловоПароля(Слово) Или ЭтоЦифра(Сред(Текст, Позиция, 1)) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ГраницыПароля(Текст, Позиция);
		Если Значение <> Неопределено Тогда
			Части.Добавить(Сред(Текст, НачалоКуска, Значение.Начало - НачалоКуска));
			Части.Добавить("***");
			НачалоКуска = Значение.Конец;
			Позиция = Значение.Конец;
		КонецЕсли;
	КонецЦикла;
	Части.Добавить(Сред(Текст, НачалоКуска));
	Возврат СтрСоединить(Части, "");

КонецФункции

