// Создаёт клиента Битрикс24. Клиент живёт только на сервере: не передавать его на клиент 1С и не хранить в данных формы,
// в нём адрес вебхука.
//
// Параметры:
//  Транспорт - Строка - имя общего модуля с функцией ВыполнитьЗапрос(Запрос); в тестах — заглушка.
//  АдресВебхука - Строка, Неопределено - по умолчанию из настроек.
//
// Возвращаемое значение:
//  Структура:
//   * Транспорт - Строка
//   * АдресВебхука - Строка
//   * Вызовы - Массив - заполняет заглушка транспорта.
//   * ПаузаПовтора - Число - секунд перед единственным повтором.
//   * МаксимумСтраниц - Число - предохранитель постраничной выборки.
//   * Таймаут - Число - секунд на один запрос.
//
Функция НовыйКлиент(Транспорт = "б24т_ТранспортHTTPS", АдресВебхука = Неопределено) Экспорт

	Клиент = Новый Структура;
	Клиент.Вставить("Транспорт", Транспорт);
	Клиент.Вставить("АдресВебхука", ?(АдресВебхука = Неопределено, б24т_Настройки.АдресВебхука(), АдресВебхука));
	Клиент.Вставить("Вызовы", Новый Массив);
	Клиент.Вставить("ПаузаПовтора", 2);
	Клиент.Вставить("МаксимумСтраниц", 40);
	Клиент.Вставить("Таймаут", 30);
	Возврат Клиент;

КонецФункции

// Вызывает метод Битрикс24. Разрешены только методы чтения; любой другой метод — исключение, запрос не отправляется.
// Ошибки Битрикс24 исключениями не бросаются, они возвращаются в Ошибка.
//
// Параметры:
//  Клиент - см. НовыйКлиент
//  Метод - Строка - например, «user.get».
//  Параметры - Структура, Соответствие, Неопределено - тело запроса; для ключей вроде «::SUBFILTER-R» нужно Соответствие.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Результат - Произвольный - поле result ответа.
//   * Следующая - Число, Неопределено - поле next, смещение следующей страницы.
//   * Всего - Число, Неопределено - поле total.
//   * Ошибка - Неопределено, Структура:
//    ** Вид - Строка - см. ВидОшибки*.
//    ** Код - Строка - поле error; у ошибок самого метода может быть пустым.
//    ** Описание - Строка
//    ** КодСостояния - Число - HTTP, 0 если ответа не было.
//    ** Повторять - Булево
//
Функция Вызвать(Клиент, Метод, Параметры = Неопределено) Экспорт

	Если РазрешённыеМетоды().Найти(Метод) = Неопределено Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Метод Битрикс24 ""%1"" не разрешён: функция только читает данные.'"), Метод);
	КонецЕсли;

	Если ПустаяСтрока(Клиент.АдресВебхука) Тогда
		Результат = НовыйРезультат();
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНеНастроено(), "", НСтр("ru = 'Адрес вебхука не указан'"), 0, Ложь);
		Возврат Результат;
	КонецЕсли;

	Тело = ТелоЗапроса(Параметры);

	Для НомерПопытки = 1 По 2 Цикл
		Ответ = ОтправитьЗапрос(Клиент, Метод, Тело);
		Результат = РазобранныйОтвет(Ответ, Клиент.АдресВебхука);
		ЗаписатьОбращение(Клиент, Метод, Параметры, Ответ, Результат, НомерПопытки);
		Если Результат.Успех Или Не Результат.Ошибка.Повторять Или НомерПопытки = 2 Тогда
			Прервать;
		КонецЕсли;
		Пауза(Клиент.ПаузаПовтора);
	КонецЦикла;

	Возврат Результат;

КонецФункции

// Вызывает метод-список по всем страницам и склеивает элементы. Элементы с одним id (ID) попадают в результат один раз:
// пока идут страницы, задача могла поменять место.
//
// Параметры:
//  Клиент - см. НовыйКлиент
//  Метод - Строка
//  Параметры - Структура, Соответствие, Неопределено - без start.
//  ИмяСписка - Строка - ключ массива в result («tasks» у tasks.task.list); пусто — result и есть массив.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево - ошибка на любой странице делает ошибкой всю выборку.
//   * Результат - Массив
//   * Усечено - Булево - остановлено на предельном числе страниц.
//   * Ошибка - см. Вызвать
//
Функция ВызватьВсеСтраницы(Клиент, Метод, Параметры, ИмяСписка = "") Экспорт

	Итог = Новый Структура;
	Итог.Вставить("Успех", Ложь);
	Итог.Вставить("Результат", Новый Массив);
	Итог.Вставить("Усечено", Ложь);
	Итог.Вставить("Ошибка", Неопределено);

	Известные = Новый Соответствие;
	Старт = 0;
	Для НомерСтраницы = 1 По Клиент.МаксимумСтраниц Цикл
		Ответ = Вызвать(Клиент, Метод, ПараметрыСтраницы(Параметры, Старт));
		Если Не Ответ.Успех Тогда
			Итог.Ошибка = Ответ.Ошибка;
			Возврат Итог;
		КонецЕсли;

		Для Каждого Элемент Из ЭлементыСписка(Ответ.Результат, ИмяСписка) Цикл
			Идентификатор = ИдентификаторЭлемента(Элемент);
			Если Идентификатор <> Неопределено Тогда
				Если Известные[Идентификатор] <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Известные.Вставить(Идентификатор, Истина);
			КонецЕсли;
			Итог.Результат.Добавить(Элемент);
		КонецЦикла;

		Если Ответ.Следующая = Неопределено Тогда
			Итог.Успех = Истина;
			Возврат Итог;
		КонецЕсли;
		Старт = Ответ.Следующая;
	КонецЦикла;

	Итог.Успех = Истина;
	Итог.Усечено = Истина;
	ЗаписьЖурналаРегистрации(ИмяСобытияОбращения(), УровеньЖурналаРегистрации.Предупреждение, , ,
		СтрШаблон("%1: выборка остановлена на %2 страницах, получено %3", Метод, Клиент.МаксимумСтраниц,
		Итог.Результат.Количество()));
	Возврат Итог;

КонецФункции

// Текст для сотрудника по ошибке клиента. Тексты совпадают с PRD.
//
// Параметры:
//  Ошибка - см. Вызвать
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстОшибки(Ошибка) Экспорт

	Если Ошибка.Вид = ВидОшибкиНедоступен() Тогда
		Возврат НСтр("ru = 'Битрикс24 недоступен. Попробуйте позже'");
	ИначеЕсли Ошибка.Вид = ВидОшибкиНеНастроено() Тогда
		Возврат НСтр("ru = 'Не настроено подключение к Битрикс24. Обратитесь к администратору'");
	КонецЕсли;
	Возврат НСтр("ru = 'Битрикс24 вернул ошибку. Обратитесь к администратору'");

КонецФункции

// Ждёт указанное число секунд. Вызывается и как фоновое задание, поэтому экспортная.
//
// Параметры:
//  Секунд - Число
//
Процедура Пауза(Секунд) Экспорт

	Если Секунд <= 0 Тогда
		Возврат;
	КонецЕсли;

	// Тот же приём, что в БСП (ИнтернетПоддержкаПользователей.Пауза): фоновое задание ждёт само себя.
	ФоновоеЗадание = ПолучитьТекущийСеансИнформационнойБазы().ПолучитьФоновоеЗадание();
	Если ФоновоеЗадание = Неопределено Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("б24т_Битрикс24.Пауза", Параметры);
	КонецЕсли;
	ФоновоеЗадание.ОжидатьЗавершенияВыполнения(Секунд);

КонецПроцедуры

#КонецОбласти

