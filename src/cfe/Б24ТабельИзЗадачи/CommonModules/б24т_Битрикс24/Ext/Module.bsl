КонецФункции

Функция НовыйРезультат()

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Результат", Неопределено);
	Результат.Вставить("Следующая", Неопределено);
	Результат.Вставить("Всего", Неопределено);
	Результат.Вставить("Ошибка", Неопределено);
	Возврат Результат;

КонецФункции

Функция НоваяОшибка(Вид, Код, Описание, КодСостояния, Повторять)

	Ошибка = Новый Структура;
	Ошибка.Вставить("Вид", Вид);
	Ошибка.Вставить("Код", Код);
	Ошибка.Вставить("Описание", Описание);
	Ошибка.Вставить("КодСостояния", КодСостояния);
	Ошибка.Вставить("Повторять", Повторять);
	Возврат Ошибка;

КонецФункции

Функция ТелоЗапроса(Параметры)

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, ?(Параметры = Неопределено, Новый Структура, Параметры));
	Возврат Запись.Закрыть();

КонецФункции

// Один обмен с транспортом. Исключение транспорта (таймаут, обрыв) превращается в текст без адреса вебхука.
Функция ОтправитьЗапрос(Клиент, Метод, Тело)

	Транспорт = ОбщегоНазначения.ОбщийМодуль(Клиент.Транспорт);

	Адрес = Клиент.АдресВебхука;
	Если Прав(Адрес, 1) <> "/" Тогда
		Адрес = Адрес + "/";
	КонецЕсли;

	Запрос = Новый Структура;
	Запрос.Вставить("Метод", Метод);
	Запрос.Вставить("Адрес", Адрес + Метод + ".json");
	Запрос.Вставить("Тело", Тело);
	Запрос.Вставить("Таймаут", Клиент.Таймаут);
	Запрос.Вставить("Клиент", Клиент);

	Ответ = Новый Структура("КодСостояния, Тело, ТекстИсключения, Секунд", 0, "", Неопределено, 0);
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Попытка
		Результат = Транспорт.ВыполнитьЗапрос(Запрос);
		Ответ.КодСостояния = Результат.КодСостояния;
		Ответ.Тело = Результат.Тело;
	Исключение
		Ответ.ТекстИсключения = б24т_Настройки.СкрытьКлючВебхука(
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), Клиент.АдресВебхука);
	КонецПопытки;
	Ответ.Секунд = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
	Возврат Ответ;

КонецФункции

// Превращает ответ транспорта в результат вызова. Успех определяется по телу, а не по HTTP-статусу:
// ошибка метода («Not found») приходит с пустым кодом, а ответ на удалённую задачу вообще без ошибки.
Функция РазобранныйОтвет(Ответ, АдресВебхука)

	Результат = НовыйРезультат();

	Если Ответ.ТекстИсключения <> Неопределено Тогда
		Результат.Ошибка = НоваяОшибка(ВидОшибкиНедоступен(), "", Ответ.ТекстИсключения, 0, Ложь);
		Возврат Результат;
	КонецЕсли;

	Статус = Ответ.КодСостояния;
	Данные = ПрочитатьТелоОтвета(Ответ.Тело);

	Если Данные = Неопределено Или (Данные["error"] = Неопределено И Данные["result"] = Неопределено) Тогда
		Результат.Ошибка = ОшибкаНеОтветаБитрикс24(Статус);
		Возврат Результат;
	КонецЕсли;

	Если Данные["error"] <> Неопределено Тогда
		Код = Строка(Данные["error"]);
		Описание = ?(Данные["error_description"] = Неопределено, "", Строка(Данные["error_description"]));
		Описание = б24т_Настройки.СкрытьКлючВебхука(Описание, АдресВебхука);
		Результат.Ошибка = ОшибкаПоКоду(Код, Описание, Статус);
		Возврат Результат;
	КонецЕсли;

	Результат.Успех = Истина;
	Результат.Результат = Данные["result"];
	Результат.Следующая = Данные["next"];
	Результат.Всего = Данные["total"];
	Возврат Результат;

КонецФункции

// Тело ответа как Соответствие или Неопределено, если это не JSON-объект (страница прокси, пустое тело).
Функция ПрочитатьТелоОтвета(Тело)

	Если ПустаяСтрока(Тело) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Тело);
		Данные = ПрочитатьJSON(Чтение, Истина);
		Чтение.Закрыть();
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Возврат ?(ТипЗнч(Данные) = Тип("Соответствие"), Данные, Неопределено);

КонецФункции

// Ответ без тела Битрикс24: сбой прокси или сервера (повторяем), переадресация или отказ (нужно чинить адрес).
Функция ОшибкаНеОтветаБитрикс24(Статус)

	Описание = СтрШаблон(НСтр("ru = 'HTTP %1, ответ не в формате Битрикс24'"), Формат(Статус, "ЧГ=0"));
	Если Статус >= 500 Тогда
		Возврат НоваяОшибка(ВидОшибкиНедоступен(), "", Описание, Статус, Истина);
	ИначеЕсли Статус >= 300 И Статус < 500 И Статус <> 429 Тогда
		Возврат НоваяОшибка(ВидОшибкиНеНастроено(), "", Описание, Статус, Ложь);
	КонецЕсли;
	Возврат НоваяОшибка(ВидОшибкиНедоступен(), "", Описание, Статус, Ложь);

КонецФункции

Функция ОшибкаПоКоду(Код, Описание, Статус)

	Если Код = "QUERY_LIMIT_EXCEEDED" Или Код = "INTERNAL_SERVER_ERROR" Или Код = "ERROR_UNEXPECTED_ANSWER"
		Или Статус >= 500 Тогда
		Возврат НоваяОшибка(ВидОшибкиНедоступен(), Код, Описание, Статус, Истина);
	ИначеЕсли Код = "OPERATION_TIME_LIMIT" Или Статус = 429 Тогда
		Возврат НоваяОшибка(ВидОшибкиНедоступен(), Код, Описание, Статус, Ложь);
	ИначеЕсли КодыОтказаВДоступе().Найти(Код) <> Неопределено Или Статус = 401 Или Статус = 403 Тогда
		Возврат НоваяОшибка(ВидОшибкиНеНастроено(), Код, Описание, Статус, Ложь);
	КонецЕсли;
	Возврат НоваяОшибка(ВидОшибкиМетода(), Код, Описание, Статус, Ложь);

КонецФункции

Функция ПараметрыСтраницы(Параметры, Старт)

	Результат = Новый Соответствие;
	Если Параметры <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Параметры Цикл
			Результат.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	Результат.Вставить("start", Старт);
	Возврат Результат;

КонецФункции

Функция ЭлементыСписка(Результат, ИмяСписка)

	Если ИмяСписка <> "" Тогда
		Элементы = ?(ТипЗнч(Результат) = Тип("Соответствие"), Результат[ИмяСписка], Неопределено);
	Иначе
		Элементы = Результат;
	КонецЕсли;
	Возврат ?(ТипЗнч(Элементы) = Тип("Массив"), Элементы, Новый Массив);

КонецФункции

Функция ИдентификаторЭлемента(Элемент)

	Если ТипЗнч(Элемент) <> Тип("Соответствие") Тогда
		Возврат Неопределено;
	КонецЕсли;
	Идентификатор = Элемент["id"];
	Возврат ?(Идентификатор = Неопределено, Элемент["ID"], Идентификатор);

КонецФункции

// Сколько записей пришло: для списка — его размер, для словаря со списком задач — число задач, иначе одна.
Функция ЧислоЗаписей(Результат)

	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Возврат Результат.Количество();
	ИначеЕсли ТипЗнч(Результат) = Тип("Соответствие") И ТипЗнч(Результат["tasks"]) = Тип("Массив") Тогда
		Возврат Результат["tasks"].Количество();
	КонецЕсли;
	Возврат ?(Результат = Неопределено, 0, 1);

КонецФункции

// Пишет запись об обращении и, если оно не удалось, запись об ошибке. Содержимое ответа в журнал не попадает.
Процедура ЗаписатьОбращение(Клиент, Метод, Параметры, Ответ, Результат, НомерПопытки)

	Статус = ?(Ответ.ТекстИсключения = Неопределено, "HTTP " + Формат(Ответ.КодСостояния, "ЧГ=0"), "нет ответа");
	Текст = СтрШаблон("%1: %2, %3 с", Метод, Статус, Формат(Ответ.Секунд, "ЧДЦ=2; ЧГ=0"));
	Если Результат.Успех Тогда
		Текст = Текст + СтрШаблон(", получено %1", ЧислоЗаписей(Результат.Результат));
		Если Результат.Всего <> Неопределено Тогда
			Текст = Текст + СтрШаблон(", всего %1", Формат(Результат.Всего, "ЧГ=0"));
		КонецЕсли;
	КонецЕсли;
	Если НомерПопытки > 1 Тогда
		Текст = Текст + ", повторный запрос";
	КонецЕсли;
	Текст = Текст + ". Параметры: " + Лев(ТелоЗапроса(Параметры), 2000);

	ЗаписьЖурналаРегистрации(ИмяСобытияОбращения(), УровеньЖурналаРегистрации.Информация, , ,
		б24т_Настройки.СкрытьКлючВебхука(Текст, Клиент.АдресВебхука));

	Если Результат.Успех Тогда
		Возврат;
	КонецЕсли;

	Ошибка = Результат.Ошибка;
	Уровень = ?(Ошибка.Вид = ВидОшибкиМетода(), УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Ошибка);
	ТекстЗаписиОшибки = СтрШаблон("%1: %2, код ""%3"", %4. Вид ошибки: %5%6", Метод, Статус, Ошибка.Код, Ошибка.Описание,
		Ошибка.Вид, ?(Ошибка.Повторять И НомерПопытки = 1, ". Будет повторный запрос", ""))
		+ ". Параметры: " + Лев(ТелоЗапроса(Параметры), 500);
	ЗаписьЖурналаРегистрации(ИмяСобытияОшибки(), Уровень, , ,
		б24т_Настройки.СкрытьКлючВебхука(ТекстЗаписиОшибки, Клиент.АдресВебхука));

КонецПроцедуры

#КонецОбласти
