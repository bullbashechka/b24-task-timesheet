#Область ПрограммныйИнтерфейс

// Контрагенты 1С для задач (Ф6). Контрагент определяется только по компании CRM, привязанной к задаче: название задачи
// и название компании в поиске не участвуют. Сопоставление идёт по номеру из реквизитов компании (БИН, ИИН или ИНН)
// и полю «БИН/ИИН» контрагента. Для задач с одной существующей компанией реквизиты запрашиваются одним вызовом
// на 50 компаний; у задач без компании и с несколькими компаниями Битрикс24 не вызывается.
// Вызывать только для задач, которые сотрудник вправе выбрать (роль и проект уже проверены): иначе чужая задача
// раскрыла бы название компании и номер.
//
// Параметры:
//  Клиент - Структура - клиент Битрикс24, см. б24т_Битрикс24.НовыйКлиент.
//  Задачи - Массив из Соответствие - задачи из ответа Битрикс24.
//  Названия - Соответствие - название компании по её номеру (Число); компании нет в соответствии — она удалена из CRM.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Сообщение - Строка - при ошибке Битрикс24.
//   * Контрагенты - Соответствие - по номеру задачи (Число):
//    ** Контрагент - СправочникСсылка.Контрагенты - пустая ссылка, если контрагент не определён.
//    ** БИН - Строка - номер компании, пусто, если его нет.
//    ** Текст - Строка - «найден в 1С по БИН ‹номер›» или причина по Ф6.
//
Функция КонтрагентыЗадач(Клиент, Задачи, Названия) Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успех", Ложь);
	Результат.Вставить("Сообщение", "");
	Результат.Вставить("Контрагенты", Новый Соответствие);

	КомпанииЗадач = Новый Соответствие;
	НужныеКомпании = Новый Массив;
	Известные = Новый Соответствие;
	Для Каждого Задача Из Задачи Цикл
		Компании = б24т_Задачи.СуществующиеКомпании(б24т_Задачи.ИДКомпанийЗадачи(Задача), Названия);
		КомпанииЗадач.Вставить(б24т_Задачи.НомерЗадачи(Задача), Компании);
		Если Компании.Количество() = 1 И Известные[Компании[0]] = Неопределено Тогда
			Известные.Вставить(Компании[0], Истина);
			НужныеКомпании.Добавить(Компании[0]);
		КонецЕсли;
	КонецЦикла;

	Реквизиты = Новый Массив;
	Пачка = Новый Массив;
	Для Каждого ИД Из НужныеКомпании Цикл
		Пачка.Добавить(ИД);
		Если Пачка.Количество() = РазмерПачкиКомпаний() Тогда
			Сообщение = ЗагрузитьРеквизиты(Клиент, Пачка, Реквизиты);
			Если Сообщение <> "" Тогда
				Результат.Сообщение = Сообщение;
				Возврат Результат;
			КонецЕсли;
			Пачка = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Пачка.Количество() > 0 Тогда
		Сообщение = ЗагрузитьРеквизиты(Клиент, Пачка, Реквизиты);
		Если Сообщение <> "" Тогда
			Результат.Сообщение = Сообщение;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;

	НомераКомпаний = Новый Соответствие;
	Номера = Новый Массив;
	Для Каждого ИД Из НужныеКомпании Цикл
		Номер = НомерИзРеквизитов(Реквизиты, ИД);
		НомераКомпаний.Вставить(ИД, Номер);
		Если Номер <> "" И Номера.Найти(Номер) = Неопределено Тогда
			Номера.Добавить(Номер);
		КонецЕсли;
	КонецЦикла;
	НайденныеКонтрагенты = КонтрагентыПоНомерам(Номера);

	Для Каждого Пара Из КомпанииЗадач Цикл
		Компании = Пара.Значение;
		Если Компании.Количество() = 0 Тогда
			Запись = НовыйРезультат("", ТекстНетКомпании());
		ИначеЕсли Компании.Количество() > 1 Тогда
			Запись = НовыйРезультат("", ТекстНесколькоКомпаний());
		ИначеЕсли НомераКомпаний[Компании[0]] = "" Тогда
			Запись = НовыйРезультат("", ТекстНетНомера(Названия[Компании[0]]));
		Иначе
			Номер = НомераКомпаний[Компании[0]];
			Найденные = НайденныеКонтрагенты[Номер];
			Запись = РезультатПоНомеру(Номер, ?(Найденные = Неопределено, Новый Массив, Найденные));
		КонецЕсли;
		Результат.Контрагенты.Вставить(Пара.Ключ, Запись);
	КонецЦикла;

	Результат.Успех = Истина;
	Возврат Результат;

КонецФункции

// Номер для сопоставления: из строки остаются только цифры, лишние пробелы, точки и буквы отбрасываются.
// Ведущий ноль сохраняется, поэтому номер всегда текст.
//
// Параметры:
//  Значение - Строка, Null, Неопределено - значение поля реквизита.
//
// Возвращаемое значение:
//  Строка - пустая строка, если цифр нет или значение не строка.
//
Функция НормализованныйНомер(Значение) Экспорт

	Цифры = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Для Позиция = 1 По СтрДлина(Значение) Цикл
			Символ = Сред(Значение, Позиция, 1);
			Если СтрНайти("0123456789", Символ) > 0 Тогда
				Цифры.Добавить(Символ);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат СтрСоединить(Цифры, "");

КонецФункции

// Номер компании из её реквизитов: первый в порядке карточки (SORT, затем ID как числа) активный реквизит компании,
// где одно из полей БИН, ИИН, ИНН содержит цифры; в нём берётся первое такое поле в этом порядке.
// Реквизиты других компаний, контактов и отключённые (ACTIVE = «N») не используются.
//
// Параметры:
//  Реквизиты - Массив из Соответствие - ответ crm.requisite.list.
//  ИДКомпании - Число
//
// Возвращаемое значение:
//  Строка - номер только из цифр, пусто, если его нет ни в одном реквизите.
//
Функция НомерИзРеквизитов(Реквизиты, ИДКомпании) Экспорт

	ИДТекст = Формат(ИДКомпании, "ЧГ=0");
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Сортировка");
	Таблица.Колонки.Добавить("ИД");
	Таблица.Колонки.Добавить("Реквизит");
	Для Каждого Реквизит Из Реквизиты Цикл
		Если ТипЗнч(Реквизит) <> Тип("Соответствие")
			Или ТекстПоля(Реквизит["ENTITY_TYPE_ID"]) <> "4"
			Или ТекстПоля(Реквизит["ENTITY_ID"]) <> ИДТекст
			Или ТекстПоля(Реквизит["ACTIVE"]) = "N" Тогда
			Продолжить;
		КонецЕсли;
		Строка = Таблица.Добавить();
		Строка.Сортировка = ЧислоПоля(Реквизит["SORT"]);
		Строка.ИД = ЧислоПоля(Реквизит["ID"]);
		Строка.Реквизит = Реквизит;
	КонецЦикла;
	Таблица.Сортировать("Сортировка, ИД");

	Для Каждого Строка Из Таблица Цикл
		Для Каждого Поле Из СтрРазделить("RQ_BIN,RQ_IIN,RQ_INN", ",") Цикл
			Номер = НормализованныйНомер(Строка.Реквизит[Поле]);
			Если Номер <> "" Тогда
				Возврат Номер;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат "";

КонецФункции

// Контрагенты 1С с этими номерами в поле «БИН/ИИН» (пробелы по краям поля в 1С не мешают). Помеченные на удаление
// не учитываются. Запрос выполняется с учётом прав пользователя: он находит только тех, кого может выбрать и сам.
//
// Параметры:
//  Номера - Массив из Строка
//
// Возвращаемое значение:
//  Соответствие - номер в массив ссылок СправочникСсылка.Контрагенты; номера без контрагентов в нём нет.
//
Функция КонтрагентыПоНомерам(Номера) Экспорт

	Результат = Новый Соответствие;
	Если Номера.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	К.Ссылка КАК Ссылка,
		|	СокрЛП(К.ИНН) КАК Номер
		|ИЗ
		|	Справочник.Контрагенты КАК К
		|ГДЕ
		|	НЕ К.ПометкаУдаления
		|	И СокрЛП(К.ИНН) В (&Номера)";
	Запрос.УстановитьПараметр("Номера", Номера);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Найденные = Результат[Выборка.Номер];
		Если Найденные = Неопределено Тогда
			Найденные = Новый Массив;
			Результат.Вставить(Выборка.Номер, Найденные);
		КонецЕсли;
		Найденные.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Результат для компании с номером: один контрагент подставляется, ни одного или несколько — причина по Ф6.
//
// Параметры:
//  Номер - Строка - номер компании.
//  Найденные - Массив из СправочникСсылка.Контрагенты
//
// Возвращаемое значение:
//  Структура - см. КонтрагентыЗадач, значение соответствия.
//
Функция РезультатПоНомеру(Номер, Найденные) Экспорт

	Если Найденные.Количество() = 1 Тогда
		Результат = НовыйРезультат(Номер, СтрШаблон(НСтр("ru = 'найден в 1С по БИН %1'"), Номер));
		Результат.Контрагент = Найденные[0];
	ИначеЕсли Найденные.Количество() = 0 Тогда
		Результат = НовыйРезультат(Номер,
			СтрШаблон(НСтр("ru = 'Контрагент с БИН %1 не найден в 1С — выберите контрагента вручную'"), Номер));
	Иначе
		Результат = НовыйРезультат(Номер,
			СтрШаблон(НСтр("ru = 'В 1С несколько контрагентов с БИН %1 — выберите нужного вручную'"), Номер));
	КонецЕсли;
	Возврат Результат;

КонецФункции

// Возвращаемое значение:
//  Строка
//
Функция ТекстНетКомпании() Экспорт

	Возврат НСтр("ru = 'В задаче не указана компания CRM — выберите контрагента вручную'");

КонецФункции

// Возвращаемое значение:
//  Строка
//
Функция ТекстНесколькоКомпаний() Экспорт

	Возврат НСтр("ru = 'В задаче несколько компаний CRM — выберите контрагента вручную'");

КонецФункции

// Параметры:
//  НазваниеКомпании - Строка - пустое название заменяется на «(без названия)».
//
// Возвращаемое значение:
//  Строка
//
Функция ТекстНетНомера(НазваниеКомпании) Экспорт

	Название = ?(ПустаяСтрока(НазваниеКомпании), НСтр("ru = '(без названия)'"), НазваниеКомпании);
	Возврат СтрШаблон(НСтр("ru = 'У компании «%1» не заполнен БИН — выберите контрагента вручную'"), Название);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Сколько компаний спрашивается в одном запросе реквизитов.
Функция РазмерПачкиКомпаний()

	Возврат 50;

КонецФункции

Функция НовыйРезультат(Номер, Текст)

	Результат = Новый Структура;
	Результат.Вставить("Контрагент", Справочники.Контрагенты.ПустаяСсылка());
	Результат.Вставить("БИН", Номер);
	Результат.Вставить("Текст", Текст);
	Возврат Результат;

КонецФункции

// Реквизиты компаний пачки (со всеми страницами) добавляются в Реквизиты. Возвращает текст ошибки или пустую строку.
Функция ЗагрузитьРеквизиты(Клиент, ИДКомпаний, Реквизиты)

	Фильтр = Новый Структура;
	Фильтр.Вставить("ENTITY_TYPE_ID", 4);
	Фильтр.Вставить("ENTITY_ID", ИДКомпаний);

	Порядок = Новый Структура;
	Порядок.Вставить("SORT", "ASC");
	Порядок.Вставить("ID", "ASC");

	Параметры = Новый Структура;
	Параметры.Вставить("filter", Фильтр);
	Параметры.Вставить("select", СтрРазделить("ID,ENTITY_TYPE_ID,ENTITY_ID,SORT,ACTIVE,RQ_BIN,RQ_IIN,RQ_INN", ","));
	Параметры.Вставить("order", Порядок);

	Ответ = б24т_Битрикс24.ВызватьВсеСтраницы(Клиент, "crm.requisite.list", Параметры);
	Если Не Ответ.Успех Тогда
		Возврат б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка);
	КонецЕсли;
	Для Каждого Реквизит Из Ответ.Результат Цикл
		Реквизиты.Добавить(Реквизит);
	КонецЦикла;
	Возврат "";

КонецФункции

// Текст значения поля Битрикс24: строки и числа; null и прочее — пустая строка.
Функция ТекстПоля(Значение)

	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Возврат СокрЛП(Значение);
	ИначеЕсли ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Формат(Значение, "ЧГ=0");
	КонецЕсли;
	Возврат "";

КонецФункции

// Число из поля Битрикс24 (SORT, ID); 0, если число не разобрано.
Функция ЧислоПоля(Значение)

	Цифры = НормализованныйНомер(ТекстПоля(Значение));
	Если Цифры = "" Или СтрДлина(Цифры) > 10 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Число(Цифры);

КонецФункции

#КонецОбласти
