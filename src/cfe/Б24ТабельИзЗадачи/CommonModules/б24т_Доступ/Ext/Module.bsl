#Область ПрограммныйИнтерфейс

// Проверки при открытии окна «Заполнить из задачи Битрикс24» (Ф2). Порядок как в таблице Ф2: сначала проверки в 1С,
// затем обращения к Битрикс24; первая же неудача возвращает сообщение. Результат ничего не запоминает: проверки
// выполняются заново при каждом открытии окна. Адреса вебхука в результате нет.
//
// Параметры:
//  Сотрудник - СправочникСсылка.ФизическиеЛица - сотрудник из данных формы табеля (табель может быть не записан).
//  Пользователь - СправочникСсылка.Пользователи, Неопределено - по умолчанию вошедший в программу.
//  Клиент - см. б24т_Битрикс24.НовыйКлиент; по умолчанию настоящий, в тестах — с заглушкой транспорта.
//
// Возвращаемое значение:
//  Структура:
//   * Успех - Булево
//   * Сообщение - Строка - текст для сотрудника, пусто при успехе.
//   * Контекст - Неопределено, Структура:
//    ** ИДПользователя - Число - пользователь Битрикс24, найденный по e-mail сотрудника.
//    ** РежимТестирования - Булево
//    ** ПроектДляТестирования - Число
//    ** НазваниеПроекта - Строка - только в режиме тестирования.
//
Функция ПроверитьДоступ(Сотрудник, Пользователь = Неопределено, Клиент = Неопределено) Экспорт

	Если Пользователь = Неопределено Тогда
		Пользователь = Пользователи.АвторизованныйПользователь();
	КонецЕсли;

	ТекущиеНастройки = б24т_Настройки.Настройки();
	Если Не ТекущиеНастройки.Настроено Тогда
		Возврат Отказ(ТекстНеНастроено());
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Отказ(НСтр("ru = 'Сначала укажите сотрудника в табеле'"));
	КонецЕсли;

	Данные = ДанныеПользователя1С(Пользователь);
	Если Не ЗначениеЗаполнено(Данные.ФизическоеЛицо) Тогда
		Возврат Отказ(НСтр("ru = 'Ваш пользователь 1С не связан с физическим лицом. Обратитесь к администратору'"));
	КонецЕсли;

	Если Сотрудник <> Данные.ФизическоеЛицо Тогда
		Возврат Отказ(НСтр("ru = 'Заполнять из задачи Битрикс24 можно только свой табель'"));
	КонецЕсли;

	Если Данные.Адреса.Количество() = 0 Тогда
		Возврат Отказ(СтрШаблон(
			НСтр("ru = 'В карточке физического лица %1 не указан e-mail. Обратитесь к администратору'"), Данные.ФИО));
	КонецЕсли;

	Если Клиент = Неопределено Тогда
		Клиент = б24т_Битрикс24.НовыйКлиент();
	КонецЕсли;

	// Без прав администратора у создателя вебхука список задач молча оказался бы неполным.
	Ответ = б24т_Битрикс24.Вызвать(Клиент, "user.admin");
	Если Не Ответ.Успех Тогда
		Возврат Отказ(б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка));
	КонецЕсли;
	Если Ответ.Результат <> Истина Тогда
		Возврат ОтказСЗаписьюВЖурнал(ТекстНеНастроено(),
			НСтр("ru = 'Создатель вебхука не администратор Битрикс24: user.admin вернул «нет»'"));
	КонецЕсли;

	// Битрикс24 ищет EMAIL по шаблону, поэтому подошедших пользователей отбирает б24т_Сопоставление.
	Отбор = Новый Структура;
	Отбор.Вставить("EMAIL", Данные.Адреса);
	Отбор.Вставить("ACTIVE", Истина);
	Отбор.Вставить("USER_TYPE", "employee");
	Ответ = б24т_Битрикс24.Вызвать(Клиент, "user.get", Новый Структура("FILTER", Отбор));
	Если Не Ответ.Успех Тогда
		Возврат Отказ(б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка));
	КонецЕсли;

	Найденные = ?(ТипЗнч(Ответ.Результат) = Тип("Массив"), Ответ.Результат, Новый Массив);
	Подходящие = б24т_Сопоставление.ПодходящиеПользователи(Найденные, Данные.Адреса);
	Если Подходящие.Количество() = 0 Тогда
		Возврат Отказ(СтрШаблон(НСтр("ru = 'В Битрикс24 нет пользователя с e-mail %1. Обратитесь к администратору'"),
			СтрСоединить(Данные.Адреса, ", ")));
	ИначеЕсли Подходящие.Количество() > 1 Тогда
		Возврат ОтказНесколькоПользователей(Подходящие);
	КонецЕсли;

	Контекст = Новый Структура;
	Контекст.Вставить("ИДПользователя", Число(Строка(Подходящие[0]["ID"])));
	Контекст.Вставить("РежимТестирования", ТекущиеНастройки.РежимТестирования);
	Контекст.Вставить("ПроектДляТестирования", ТекущиеНастройки.ПроектДляТестирования);
	Контекст.Вставить("НазваниеПроекта", "");

	Если ТекущиеНастройки.РежимТестирования Тогда
		Ответ = б24т_Битрикс24.Вызвать(Клиент, "sonet_group.get",
			Новый Структура("FILTER", Новый Структура("ID", ТекущиеНастройки.ПроектДляТестирования)));
		Если Не Ответ.Успех Тогда
			Возврат Отказ(б24т_Битрикс24.ТекстОшибки(Ответ.Ошибка));
		КонецЕсли;
		Проекты = ?(ТипЗнч(Ответ.Результат) = Тип("Массив"), Ответ.Результат, Новый Массив);
		Если Проекты.Количество() = 0 Или ТипЗнч(Проекты[0]) <> Тип("Соответствие") Тогда
			Возврат ОтказСЗаписьюВЖурнал(ТекстНеНастроено(), СтрШаблон(
				НСтр("ru = 'Проект для тестирования с ID %1 не найден в Битрикс24'"),
				Формат(ТекущиеНастройки.ПроектДляТестирования, "ЧГ=0")));
		КонецЕсли;
		Контекст.НазваниеПроекта = Строка(Проекты[0]["NAME"]);
	КонецЕсли;

	Результат = НовыйРезультат(Истина, "");
	Результат.Контекст = Контекст;
	Возврат Результат;

КонецФункции

// Данные 1С для проверок: физическое лицо пользователя, его наименование и все e-mail (вид «Электронная почта»).
// Читаются в привилегированном режиме и только для физического лица этого пользователя: у обычного сотрудника
// может не быть прав на контактную информацию физических лиц.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи
//
// Возвращаемое значение:
//  Структура:
//   * ФизическоеЛицо - СправочникСсылка.ФизическиеЛица - пустая ссылка, если пользователь не связан с физлицом.
//   * ФИО - Строка - наименование физического лица.
//   * Адреса - Массив из Строка - см. б24т_Сопоставление.АдресаИзПредставлений
//
Функция ДанныеПользователя1С(Пользователь) Экспорт

	Данные = Новый Структура;
	Данные.Вставить("ФизическоеЛицо", Справочники.ФизическиеЛица.ПустаяСсылка());
	Данные.Вставить("ФИО", "");
	Данные.Вставить("Адреса", Новый Массив);

	Если ТипЗнч(Пользователь) <> Тип("СправочникСсылка.Пользователи") Тогда
		Возврат Данные;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Физлицо = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Пользователь, "ФизическоеЛицо");
	Если ЗначениеЗаполнено(Физлицо) Тогда
		Данные.ФизическоеЛицо = Физлицо;
		Данные.ФИО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Физлицо, "Наименование");

		Владельцы = Новый Массив;
		Владельцы.Добавить(Физлицо);
		Контакты = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(Владельцы,
			Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты,
			Справочники.ВидыКонтактнойИнформации.EMailФизическиеЛица);
		Данные.Адреса = б24т_Сопоставление.АдресаИзПредставлений(Контакты.ВыгрузитьКолонку("Представление"));
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Данные;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйРезультат(Успех, Сообщение)

	Результат = Новый Структура;
	Результат.Вставить("Успех", Успех);
	Результат.Вставить("Сообщение", Сообщение);
	Результат.Вставить("Контекст", Неопределено);
	Возврат Результат;

КонецФункции

Функция Отказ(Сообщение)

	Возврат НовыйРезультат(Ложь, Сообщение);

КонецФункции

// Отказ, причину которого сотрудник не поймёт из сообщения: администратор найдёт её в журнале регистрации.
Функция ОтказСЗаписьюВЖурнал(Сообщение, ПричинаДляЖурнала)

	ЗаписьЖурналаРегистрации(ИмяСобытияЖурнала(), УровеньЖурналаРегистрации.Предупреждение, , , ПричинаДляЖурнала);
	Возврат Отказ(Сообщение);

КонецФункции

Функция ОтказНесколькоПользователей(Подходящие)

	Адреса = Новый Массив;
	Номера = Новый Массив;
	Известные = Новый Соответствие;
	Для Каждого Пользователь Из Подходящие Цикл
		Номера.Добавить(Строка(Пользователь["ID"]));
		Ключ = б24т_Сопоставление.НормализованныйEmail(Пользователь["EMAIL"]);
		Если Известные[Ключ] = Неопределено Тогда
			Известные.Вставить(Ключ, Истина);
			Адреса.Добавить(СокрЛП(Пользователь["EMAIL"]));
		КонецЕсли;
	КонецЦикла;

	СписокАдресов = СтрСоединить(Адреса, ", ");
	Возврат ОтказСЗаписьюВЖурнал(
		СтрШаблон(НСтр("ru = 'В Битрикс24 несколько пользователей с e-mail %1. Обратитесь к администратору'"),
			СписокАдресов),
		СтрШаблон(НСтр("ru = 'По адресам сотрудника в Битрикс24 найдено несколько пользователей (ID: %1), e-mail: %2'"),
			СтрСоединить(Номера, ", "), СписокАдресов));

КонецФункции

Функция ТекстНеНастроено()

	Возврат б24т_Битрикс24.ТекстОшибки(Новый Структура("Вид", б24т_Битрикс24.ВидОшибкиНеНастроено()));

КонецФункции

Функция ИмяСобытияЖурнала()

	Возврат "Б24ТабельИзЗадачи.Доступ";

КонецФункции

#КонецОбласти
