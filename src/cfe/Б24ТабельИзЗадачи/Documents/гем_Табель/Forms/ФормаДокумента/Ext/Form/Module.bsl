// Вход в окно «Заполнить из задачи Битрикс24» (Ф1) и добавление строки по его результату (Ф5). Кнопка стоит в командной панели таблицы «Табель» и доступна тогда
// же, когда «Добавить»: ПриОткрытии формы выключает панель, если нет прав на изменение табеля; в табеле только для
// просмотра кнопка недоступна. Команда не помечена «ИзменяетСохраняемыеДанные»: платформа в этом случае помечала бы
// табель изменённым уже при нажатии, и «Отмена» оставляла бы вопрос о записи; недоступность в режиме просмотра задана
// кодом. Строку считают процедуры исходной формы (ОбработкаФормы, Пересчет, ОбновитьПодвал), код расчёта не копируется;
// документ не записывается.

&НаКлиенте
Процедура б24т_ПриОткрытииПосле(Отказ) Экспорт

	Элементы.б24т_ЗаполнитьИзЗадачи.Доступность = Не ТолькоПросмотр;

КонецПроцедуры

&НаКлиенте
Процедура б24т_ЗаполнитьИзЗадачи(Команда) Экспорт

	Если Не б24т_ОкноДоступно() Тогда
		Возврат;
	КонецЕсли;

	// Строка, которую сотрудник ещё вводит, должна попасть в данные формы до того, как окно считает время.
	Элементы.Табель.ЗакончитьРедактированиеСтроки(Ложь);

	ОписаниеОповещения = Новый ОписаниеОповещения("б24т_ПослеЗакрытияОкна", ЭтотОбъект);
	ОткрытьФорму("Документ.гем_Табель.Форма.б24т_ЗаполнениеИзЗадачи", б24т_ПараметрыОкна(), ЭтаФорма,
		ЭтаФорма.УникальныйИдентификатор, , , ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

// Окно можно открыть, только если можно добавить строку: табель не только для просмотра, а командная панель таблицы
// (в ней «Добавить») доступна — её выключает ПриОткрытии исходной формы для не автора без полных прав (С8).
//
// Возвращаемое значение:
//  Булево
//
&НаКлиенте
Функция б24т_ОкноДоступно() Экспорт

	Возврат Не ТолькоПросмотр И Элементы.Табель.КоманднаяПанель.Доступность;

КонецФункции

// Параметры окна из данных открытой формы, а не из базы: табель может быть не записан или изменён.
//
// Возвращаемое значение:
//  Структура:
//   * ДатаТабеля - Дата
//   * Сотрудник - СправочникСсылка.ФизическиеЛица
//   * СтрокиТабеля - Массив из Структура - НомерСтроки, ВремяНач, ВремяКон строк на момент нажатия.
//
&НаКлиенте
Функция б24т_ПараметрыОкна() Экспорт

	Строки = Новый Массив;
	Для Каждого СтрокаТабеля Из Объект.Табель Цикл
		Строки.Добавить(Новый Структура("НомерСтроки, ВремяНач, ВремяКон",
			СтрокаТабеля.НомерСтроки, СтрокаТабеля.ВремяНач, СтрокаТабеля.ВремяКон));
	КонецЦикла;
	Возврат Новый Структура("ДатаТабеля, Сотрудник, СтрокиТабеля", Объект.Дата, Объект.Сотрудник, Строки);

КонецФункции

// Окно закрыто. Без результата («Отмена», крестик, Esc) табель остаётся таким, каким был: форма не менялась. С
// результатом добавляется строка; если контрагент не найден и тип времени «Клиент…», открывается его выбор (Ф5).
&НаКлиенте
Процедура б24т_ПослеЗакрытияОкна(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если б24т_ДобавитьСтроку(Результат) = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не Результат.КонтрагентНайден И б24т_ЗаполнениеИзЗадачиКлиентСервер.ВыбиратьКонтрагента(Результат.ТипВремени) Тогда
		Элементы.Табель.ТекущийЭлемент = Элементы.ТабельКонтрагент;
		б24т_ЖдётВыбораКонтрагента = Истина;
		// Платформа возвращает фокус в табель уже после закрытия окна: пауза не даёт ей перебить окно выбора.
		ПодключитьОбработчикОжидания("б24т_ОткрытьВыборКонтрагента", 0.1, Истина);
	КонецЕсли;

КонецПроцедуры

// Добавляет строку по результату окна (Ф5): табель сортируется, как перед «Добавить»; новая строка встаёт на своё место,
// значения остальных строк не меняются. Поля заполняются из окна, расчёт делают процедуры исходной формы так же, как при
// ручном вводе; остальные поля остаются как у строки от «Добавить». Документ не записывается.
//
// Параметры:
//  Данные - Структура - б24т_ЗаполнениеИзЗадачиКлиентСервер.ДанныеСтроки.
//
// Возвращаемое значение:
//  ДанныеФормыЭлементКоллекции, Неопределено - добавленная строка; Неопределено, если форма не разрешила добавление.
//
&НаКлиенте
Функция б24т_ДобавитьСтроку(Данные) Экспорт

	Отказ = Ложь;
	ТабельПередНачаломДобавления(Элементы.Табель, Отказ, Ложь, Ложь, Ложь, Неопределено);
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;

	Начала = Новый Массив;
	Для Каждого СтрокаТабеля Из Объект.Табель Цикл
		Начала.Добавить(СтрокаТабеля.ВремяНач);
	КонецЦикла;
	Индекс = б24т_ЗаполнениеИзЗадачиКлиентСервер.ИндексНовойСтроки(Начала, Данные.ВремяНач);

	Стр = Объект.Табель.Вставить(Индекс);
	Стр.ВремяНач = Данные.ВремяНач;
	Стр.ВремяКон = Данные.ВремяКон;
	Стр.ТипВремени = Данные.ТипВремени;
	Стр.Контрагент = Данные.Контрагент;
	Стр.Содержание = Данные.Содержание;
	Стр.б24т_IDБ24 = Данные.IDБ24;

	ОбработкаФормы(Стр);
	Пересчет(Стр);
	ОбновитьПодвал();

	Элементы.Табель.ТекущаяСтрока = Стр.ПолучитьИдентификатор();
	ТекущийЭлемент = Элементы.Табель;
	Модифицированность = Истина;
	Возврат Стр;

КонецФункции

// Обработчик ожидания: открывает выбор контрагента в ячейке «Контрагент» новой строки.
&НаКлиенте
Процедура б24т_ОткрытьВыборКонтрагента() Экспорт

	Если Не Открыта() Или Не б24т_ЖдётВыбораКонтрагента Тогда
		Возврат;
	КонецЕсли;
	б24т_ЖдётВыбораКонтрагента = Ложь;
	Элементы.Табель.ТекущийЭлемент = Элементы.ТабельКонтрагент;
	Элементы.Табель.ИзменитьСтроку();
	ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора", , Элементы.ТабельКонтрагент);

КонецПроцедуры
