#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	б24т_Настройки.ПроверитьПраваНаНастройку();

	Данные = б24т_Настройки.ДанныеФормыНастроек();
	ПредставлениеАдреса = Данные.ПредставлениеАдреса;
	РежимТестирования = Данные.РежимТестирования;
	ПроектДляТестирования = Данные.ПроектДляТестирования;

	Элементы.ПроектДляТестирования.Доступность = РежимТестирования;
	Элементы.НадписьСохранённогоАдреса.Заголовок = ТекстНадписиАдреса(ПредставлениеАдреса, УдалитьАдрес);
	Элементы.КнопкаУдалитьАдрес.Доступность = Не ПустаяСтрока(ПредставлениеАдреса);
	Элементы.НадписьПредупреждений.Заголовок = Данные.Предупреждения;
	Элементы.НадписьПредупреждений.Видимость = Не ПустаяСтрока(Данные.Предупреждения);

	ИспользоватьИИ = Данные.ИспользоватьИИ;
	ПередаватьКомментарииИИ = Данные.ПередаватьКомментарииИИ;
	ПредставлениеКлюча = Данные.ПредставлениеКлюча;
	МодельИИ = Данные.МодельИИ;
	УказанияДляИИ = Данные.УказанияДляИИ;
	ПримерыСтрокТабеля = Данные.ПримерыСтрокТабеля;
	Элементы.НадписьСохранённогоКлюча.Заголовок = ТекстНадписиКлюча(ПредставлениеКлюча, УдалитьКлюч);
	Элементы.КнопкаУдалитьКлюч.Доступность = Не ПустаяСтрока(ПредставлениеКлюча);
	Элементы.НадписьКопииБазы.Видимость = Данные.БазаПохожаНаКопию;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НовыйАдресВебхукаПриИзменении(Элемент)

	// Новый адрес заменит старый, поэтому ранее нажатое «Удалить адрес» больше не нужно.
	Если Не ПустаяСтрока(НовыйАдресВебхука) Тогда
		УдалитьАдрес = Ложь;
	КонецЕсли;
	ОбновитьОтображениеАдреса();

КонецПроцедуры

&НаКлиенте
Процедура РежимТестированияПриИзменении(Элемент) Экспорт

	Элементы.ПроектДляТестирования.Доступность = РежимТестирования;

КонецПроцедуры

&НаКлиенте
Процедура НовыйКлючOpenAIПриИзменении(Элемент) Экспорт

	// Новый ключ заменит старый, поэтому ранее нажатое «Удалить ключ» больше не нужно.
	Если Не ПустаяСтрока(НовыйКлючOpenAI) Тогда
		УдалитьКлюч = Ложь;
	КонецЕсли;
	ОбновитьОтображениеКлюча();
	СкрытьРезультатПроверкиИИ();

КонецПроцедуры

&НаКлиенте
Процедура МодельИИПриИзменении(Элемент) Экспорт

	СкрытьРезультатПроверкиИИ();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьИЗакрытьЗавершение();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьАдресКоманда(Команда) Экспорт

	НовыйАдресВебхука = "";
	УдалитьАдрес = Истина;
	Модифицированность = Истина;
	ОбновитьОтображениеАдреса();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьКлючКоманда(Команда) Экспорт

	НовыйКлючOpenAI = "";
	УдалитьКлюч = Истина;
	СкрытьРезультатПроверкиИИ();
	// Без ключа ИИ не работает: при записи флажок с удалённым ключом не пройдёт проверку.
	ИспользоватьИИ = Ложь;
	Модифицированность = Истина;
	ОбновитьОтображениеКлюча();

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда) Экспорт

	Элементы.КнопкаПроверитьПодключение.Доступность = Ложь;
	Элементы.НадписьРезультатаПроверки.Видимость = Истина;
	Элементы.НадписьРезультатаПроверки.Заголовок = НСтр("ru = 'Проверка подключения…'");
	// Проверка занимает несколько секунд: пауза даёт форме показать надпись до обращения к серверу.
	ПодключитьОбработчикОжидания("ПоказатьРезультатПроверки", 0.1, Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИИ(Команда) Экспорт

	Элементы.КнопкаПроверитьИИ.Доступность = Ложь;
	Элементы.НадписьРезультатаПроверкиИИ.Видимость = Истина;
	Элементы.НадписьРезультатаПроверкиИИ.Заголовок = НСтр("ru = 'Проверка ИИ…'");
	// Ответ OpenAI занимает несколько секунд: пауза даёт форме показать надпись до обращения к серверу.
	ПодключитьОбработчикОжидания("ПроверитьИИОбработчикОжидания", 0.1, Истина);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоказатьРезультатПроверки() Экспорт

	Элементы.КнопкаПроверитьПодключение.Доступность = Истина;
	Элементы.НадписьРезультатаПроверки.Видимость = Истина;
	Элементы.НадписьРезультатаПроверки.Заголовок = ПроверитьПодключениеНаСервере();

КонецПроцедуры

// Запрос к OpenAI идёт только из открытой формы: форма, полученная без открытия (тесты), его не отправит.
&НаКлиенте
Процедура ПроверитьИИОбработчикОжидания() Экспорт

	Если Не Открыта() Тогда
		Возврат;
	КонецЕсли;
	ПоказатьРезультатПроверкиИИ();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРезультатПроверкиИИ() Экспорт

	Элементы.КнопкаПроверитьИИ.Доступность = Истина;
	Элементы.НадписьРезультатаПроверкиИИ.Видимость = Истина;
	Элементы.НадписьРезультатаПроверкиИИ.Заголовок = ПроверитьИИНаСервере();

КонецПроцедуры

// Результат прежней проверки относится к прежнему ключу или модели: после их изменения он не показывается.
&НаКлиенте
Процедура СкрытьРезультатПроверкиИИ()

	Элементы.НадписьРезультатаПроверкиИИ.Видимость = Ложь;

КонецПроцедуры

&НаСервере
Функция ПроверитьИИНаСервере()

	Значения = Новый Структура;
	Значения.Вставить("НовыйКлюч", НовыйКлючOpenAI);
	Значения.Вставить("УдалитьКлюч", УдалитьКлюч);
	Значения.Вставить("МодельИИ", МодельИИ);
	Возврат б24т_Настройки.ПроверитьИИ(Значения);

КонецФункции

&НаСервере
Функция ПроверитьПодключениеНаСервере()

	Значения = Новый Структура;
	Значения.Вставить("НовыйАдрес", НовыйАдресВебхука);
	Значения.Вставить("УдалитьАдрес", УдалитьАдрес);
	Значения.Вставить("РежимТестирования", РежимТестирования);
	Значения.Вставить("ПроектДляТестирования", ПроектДляТестирования);
	Возврат СтрСоединить(б24т_Настройки.ПроверитьПодключение(Значения), Символы.ПС);

КонецФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	Если Не ЗаписатьНаСервере() Тогда
		Возврат;
	КонецЕсли;

	// Не показывать подтверждение закрытия ещё раз.
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере()

	Изменения = Новый Структура;
	Изменения.Вставить("НовыйАдрес", НовыйАдресВебхука);
	Изменения.Вставить("УдалитьАдрес", УдалитьАдрес);
	Изменения.Вставить("РежимТестирования", РежимТестирования);
	Изменения.Вставить("ПроектДляТестирования", ПроектДляТестирования);
	Изменения.Вставить("НовыйКлюч", НовыйКлючOpenAI);
	Изменения.Вставить("УдалитьКлюч", УдалитьКлюч);
	Изменения.Вставить("ИспользоватьИИ", ИспользоватьИИ);
	Изменения.Вставить("МодельИИ", МодельИИ);
	Изменения.Вставить("УказанияДляИИ", УказанияДляИИ);
	Изменения.Вставить("ПримерыСтрокТабеля", ПримерыСтрокТабеля);
	Изменения.Вставить("ПередаватьКомментарииИИ", ПередаватьКомментарииИИ);

	Ошибки = б24т_Настройки.ЗаписатьНастройки(Изменения);
	Для Каждого Ошибка Из Ошибки Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Ошибка.Текст;
		Сообщение.ПутьКДанным = Ошибка.Поле;
		Сообщение.Сообщить();
	КонецЦикла;
	Возврат Ошибки.Количество() = 0;

КонецФункции

&НаКлиенте
Процедура ОбновитьОтображениеАдреса()

	Элементы.НадписьСохранённогоАдреса.Заголовок = ТекстНадписиАдреса(ПредставлениеАдреса, УдалитьАдрес);
	Элементы.КнопкаУдалитьАдрес.Доступность = Не ПустаяСтрока(ПредставлениеАдреса) И Не УдалитьАдрес;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеКлюча()

	Элементы.НадписьСохранённогоКлюча.Заголовок = ТекстНадписиКлюча(ПредставлениеКлюча, УдалитьКлюч);
	Элементы.КнопкаУдалитьКлюч.Доступность = Не ПустаяСтрока(ПредставлениеКлюча) И Не УдалитьКлюч;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстНадписиКлюча(ПредставлениеКлюча, УдалитьКлюч)

	Если ПустаяСтрока(ПредставлениеКлюча) Или УдалитьКлюч Тогда
		Возврат НСтр("ru = 'Не указан'");
	КонецЕсли;
	Возврат НСтр("ru = 'Ключ сохранён: '") + ПредставлениеКлюча;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстНадписиАдреса(ПредставлениеАдреса, УдалитьАдрес)

	Если ПустаяСтрока(ПредставлениеАдреса) Или УдалитьАдрес Тогда
		Возврат НСтр("ru = 'Не указан'");
	КонецЕсли;
	Возврат НСтр("ru = 'Сохранён: '") + ПредставлениеАдреса;

КонецФункции

#КонецОбласти
