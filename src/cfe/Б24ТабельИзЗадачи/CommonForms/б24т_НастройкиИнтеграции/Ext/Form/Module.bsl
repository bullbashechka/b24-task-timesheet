#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	б24т_Настройки.ПроверитьПраваНаНастройку();

	Данные = б24т_Настройки.ДанныеФормыНастроек();
	ПредставлениеАдреса = Данные.ПредставлениеАдреса;
	РежимТестирования = Данные.РежимТестирования;
	ПроектДляТестирования = Данные.ПроектДляТестирования;

	Элементы.ПроектДляТестирования.Доступность = РежимТестирования;
	Элементы.НадписьСохранённогоАдреса.Заголовок = ТекстНадписиАдреса(ПредставлениеАдреса, УдалитьАдрес);
	Элементы.КнопкаУдалитьАдрес.Доступность = Не ПустаяСтрока(ПредставлениеАдреса);

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НовыйАдресВебхукаПриИзменении(Элемент)

	// Новый адрес заменит старый, поэтому ранее нажатое «Удалить адрес» больше не нужно.
	Если Не ПустаяСтрока(НовыйАдресВебхука) Тогда
		УдалитьАдрес = Ложь;
	КонецЕсли;
	ОбновитьОтображениеАдреса();

КонецПроцедуры

&НаКлиенте
Процедура РежимТестированияПриИзменении(Элемент) Экспорт

	Элементы.ПроектДляТестирования.Доступность = РежимТестирования;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)

	ЗаписатьИЗакрытьЗавершение();

КонецПроцедуры

&НаКлиенте
Процедура УдалитьАдресКоманда(Команда) Экспорт

	НовыйАдресВебхука = "";
	УдалитьАдрес = Истина;
	Модифицированность = Истина;
	ОбновитьОтображениеАдреса();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт

	Если Не ЗаписатьНаСервере() Тогда
		Возврат;
	КонецЕсли;

	// Не показывать подтверждение закрытия ещё раз.
	Модифицированность = Ложь;
	Закрыть();

КонецПроцедуры

&НаСервере
Функция ЗаписатьНаСервере()

	Изменения = Новый Структура;
	Изменения.Вставить("НовыйАдрес", НовыйАдресВебхука);
	Изменения.Вставить("УдалитьАдрес", УдалитьАдрес);
	Изменения.Вставить("РежимТестирования", РежимТестирования);
	Изменения.Вставить("ПроектДляТестирования", ПроектДляТестирования);

	Ошибки = б24т_Настройки.ЗаписатьНастройки(Изменения);
	Для Каждого Ошибка Из Ошибки Цикл
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = Ошибка.Текст;
		Сообщение.ПутьКДанным = Ошибка.Поле;
		Сообщение.Сообщить();
	КонецЦикла;
	Возврат Ошибки.Количество() = 0;

КонецФункции

&НаКлиенте
Процедура ОбновитьОтображениеАдреса()

	Элементы.НадписьСохранённогоАдреса.Заголовок = ТекстНадписиАдреса(ПредставлениеАдреса, УдалитьАдрес);
	Элементы.КнопкаУдалитьАдрес.Доступность = Не ПустаяСтрока(ПредставлениеАдреса) И Не УдалитьАдрес;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстНадписиАдреса(ПредставлениеАдреса, УдалитьАдрес)

	Если ПустаяСтрока(ПредставлениеАдреса) Или УдалитьАдрес Тогда
		Возврат НСтр("ru = 'Не указан'");
	КонецЕсли;
	Возврат НСтр("ru = 'Сохранён: '") + ПредставлениеАдреса;

КонецФункции

#КонецОбласти
